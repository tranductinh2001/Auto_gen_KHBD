. Tin học và định hướng nghề nghiệp", "lesson_id": "Bài 17", "lesson_title": "Tin học và thế giới nghề nghiệp", "page_num": "89", "source_file": "SGK Tin học 9 Kết nối tri thức.pdf"}, {"grade_level": "Lớp 9", "chapter_title": "Chủ đề F: Giải quyết vấn đề với sự trợ giúp của máy tính / Hướng nghiệp với tin học", "lesson_id": "Bài học (Tiếp theo)", "lesson_title": "Giới thiệu nghề nghiệp trong lĩnh vực tin học (Bình đẳng giới trong ngành tin học và Định hướng nghề nghiệp)", "page_num": "92", "source_file": "SGK Tin học 9 Kết nối tri thức.pdf"}, {"grade_level": "Lớp 9", "chapter_title": "Thông tin bản quyền và xuất bản sách Tin học 9", "lesson_id": "Trang thông tin xuất bản", "lesson_title": "Thông tin bản quyền, biên tập và xuất bản sách SGK Tin học 9", "page_num": "94", "source_file": "SGK Tin học 9 Kết nối tri thức.pdf"}] AS row
MERGE (g:Grade {grade_level: toString(row.grade_level)})
MERGE (c:Chapter {id: toString(row.grade_level) + '_' + toString(row.chapter_title)})
ON CREATE SET c.title = toString(row.chapter_title)
MERGE (g)-[:HAS_CHAPTER]->(c)
MERGE (l:Lesson {id: toString(row.grade_level) + '_' + toString(row.lesson_id)})
ON CREATE SET l.lesson_id = toString(row.lesson_id),
              l.title = toString(row.lesson_title),
              l.page = toString(row.page_num),
              l.source_file = toString(row.source_file)
MERGE (c)-[:HAS_LESSON]->(l);

// --- 3. NẠP YÊU CẦU CẦN ĐẠT (237 YCCĐ) ---
UNWIND [{"grade_level": "Lớp 6", "lesson_id": "Bài 1", "requirement_code": "YC01", "requirement_content": "Nhận biết được sự khác nhau giữa thông tin và dữ liệu."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "requirement_code": "YC02", "requirement_content": "Phân biệt được thông tin và vật mang tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "requirement_code": "YC03", "requirement_content": "Nêu được ví dụ minh hoạ tầm quan trọng của thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "requirement_code": "YC04", "requirement_content": "Nêu được ví dụ minh hoạ mối quan hệ giữa thông tin và dữ liệu."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "requirement_code": "YC01", "requirement_content": "Nêu được các bước cơ bản trong xử lí thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "requirement_code": "YC02", "requirement_content": "Giải thích được máy tính là công cụ hiệu quả để xử lí thông tin. Nêu được ví dụ minh hoạ cụ thể."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "requirement_code": "YC01", "requirement_content": "Nhận biết và nêu được các thành phần chính của máy tính gồm thiết bị vào, bộ xử lí, thiết bị ra và bộ nhớ để thực hiện các bước xử lí thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "requirement_code": "YC02", "requirement_content": "Phân biệt được chức năng của thiết bị vào, thiết bị ra, bộ xử lí và bộ nhớ trong hoạt động xử lí thông tin của máy tính."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "requirement_code": "YC01", "requirement_content": "Giải thích được việc có thể biểu diễn thông tin chỉ với hai kí hiệu 0 và 1."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "requirement_code": "YC02", "requirement_content": "Biết được bit là đơn vị nhỏ nhất trong lưu trữ thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "requirement_code": "YC03", "requirement_content": "Nêu được tên và độ lớn của các đơn vị cơ bản đo dung lượng thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "requirement_code": "YC04", "requirement_content": "Ước lượng được khả năng lưu trữ của các thiết bị nhớ thông dụng như đĩa quang, đĩa từ, thẻ nhớ,..."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "requirement_code": "YC01", "requirement_content": "Hiểu được khái niệm tổng quan về mạng máy tính và Internet, vai trò của việc kết nối các thiết bị trong đời sống."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "requirement_code": "YC01", "requirement_content": "Biết được mạng máy tính là gì và lợi ích của nó trong cuộc sống."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "requirement_code": "YC02", "requirement_content": "Kể được tên những thành phần chính của một mạng máy tính."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "requirement_code": "YC03", "requirement_content": "Nêu được ví dụ cụ thể về trường hợp mạng không dây tiện dụng hơn mạng có dây."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "requirement_code": "YC01", "requirement_content": "Nêu được vai trò và lợi ích của Internet trong đời sống, học tập và xã hội."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "requirement_code": "YC02", "requirement_content": "Nhận biết được một số hoạt động nên và không nên làm khi sử dụng Internet."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "requirement_code": "YC01", "requirement_content": "Biết cách sử dụng trình duyệt để truy cập trang web và khai thác thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "requirement_code": "YC01", "requirement_content": "Biết cách nhập địa chỉ trang web và sử dụng các nút điều hướng trên trình duyệt web để xem thông tin thời tiết và thời sự."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "requirement_code": "YC02", "requirement_content": "Thực hiện được thao tác nháy chuột vào các liên kết để xem chi tiết thông tin và lưu trang web vào Bookmark."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "requirement_code": "YC01", "requirement_content": "Hiểu được tầm quan trọng của việc bảo vệ thông tin cá nhân và tài khoản cá nhân."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "requirement_code": "YC02", "requirement_content": "Nhận biết các thông điệp lừa đảo hoặc mang nội dung xấu trên mạng và biết cách phòng tránh."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 5", "requirement_code": "YC01", "requirement_content": "Làm quen với các công cụ ứng dụng tin học bao gồm sơ đồ tư duy, định dạng văn bản, trình bày thông tin ở dạng bảng, tìm kiếm và thay thế."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 5", "requirement_code": "YC02", "requirement_content": "Thực hành tổng hợp để hoàn thiện sản phẩm thực tế là sổ lưu niệm."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "requirement_code": "YC01", "requirement_content": "Biết cách sử dụng phần mềm để tạo sơ đồ tư duy ghi lại nội dung kiến thức và tổ chức thông tin hiệu quả."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "requirement_code": "YC02", "requirement_content": "Vận dụng sơ đồ tư duy để tóm tắt nội dung về an toàn thông tin trên Internet."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 11", "requirement_code": "YC01", "requirement_content": "Nêu được các chức năng đặc trưng của những phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 11", "requirement_code": "YC02", "requirement_content": "Trình bày được tác dụng của công cụ căn lề, định dạng văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 11", "requirement_code": "YC03", "requirement_content": "Thực hiện được việc định dạng văn bản, trình bày trang văn bản và in."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "requirement_code": "YC01", "requirement_content": "Biết cách thực hiện định dạng đoạn văn bản bao gồm căn lề, thay đổi khoảng cách giữa các dòng và giữa các đoạn."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "requirement_code": "YC02", "requirement_content": "Hiểu và biết cách thực hiện định dạng trang văn bản bao gồm chọn hướng trang, đặt lề trang và lựa chọn khổ giấy."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "requirement_code": "YC01", "requirement_content": "Biết cách thiết đặt trang văn bản (lề trên, lề dưới, lề trái, lề phải, hướng trang)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "requirement_code": "YC02", "requirement_content": "Thực hiện được các thao tác in văn bản ra giấy."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "requirement_code": "YC01", "requirement_content": "Biết cách khởi động phần mềm soạn thảo văn bản và nhập nội dung văn bản, chèn hình ảnh."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "requirement_code": "YC02", "requirement_content": "Thực hiện được các thao tác căn lề các đoạn văn bản trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "requirement_code": "YC03", "requirement_content": "Thực hiện được các thao tác chọn hướng trang và chọn lề trang văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác chọn hướng trang và chọn lề trang trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "requirement_code": "YC02", "requirement_content": "Vận dụng các kiến thức và kỹ năng soạn thảo văn bản để tạo và định dạng hoàn chỉnh các văn bản thực tế như đơn xin nghỉ học, sổ lưu niệm."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "requirement_code": "YC01", "requirement_content": "Biết được ưu điểm của việc trình bày thông tin ở dạng bảng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "requirement_code": "YC02", "requirement_content": "Trình bày được thông tin ở dạng bảng bằng phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "requirement_code": "YC01", "requirement_content": "Trình bày được thông tin ở dạng bảng và nhận biết lợi ích của bảng trong việc biểu diễn, so sánh, tìm kiếm và tổng hợp thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "requirement_code": "YC02", "requirement_content": "Thực hiện được thao tác tạo bảng, chọn số cột, số hàng và nhập dữ liệu vào ô trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác tạo bảng, chỉnh sửa bảng gồm gộp ô và thay đổi kích thước cột, hàng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "requirement_code": "YC03", "requirement_content": "Thực hiện các thao tác định dạng văn bản, chèn hình ảnh, bảng và sử dụng tính năng tìm kiếm, thay thế."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "requirement_code": "YC02", "requirement_content": "Xem lại, kiểm tra và hoàn thiện nội dung, hình thức trình bày của cuốn sổ lưu niệm."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 6", "requirement_code": "YC01", "requirement_content": "Hiểu và nắm bắt các nội dung chính của chủ đề bao gồm thuật toán, các cấu trúc điều khiển và chương trình máy tính."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "requirement_code": "YC01", "requirement_content": "Vận dụng được kiến thức về thuật toán, sơ đồ khối để giải quyết các bài toán thực tế, xác định đầu vào, đầu ra và mô tả thuật toán bằng cách liệt kê hoặc sơ đồ khối."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "requirement_code": "YC02", "requirement_content": "Biết cách đọc và hiểu một chương trình đơn giản viết bằng ngôn ngữ lập trình trực quan Scratch."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6 - Thực hành", "requirement_code": "YC03", "requirement_content": "Vận dụng kiến thức về thuật toán và chương trình để giải quyết bài toán thực tế bằng sơ đồ khối và chương trình Scratch."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "requirement_code": "YC01", "requirement_content": "Nhận biết và phân biệt được sự đa dạng của các thiết bị vào, thiết bị ra và thiết bị có cả hai chức năng vào - ra trong thực tế."}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "requirement_code": "YC01", "requirement_content": "Biết cách kết nối các thiết bị ngoại vi với thân máy tính đúng cổng và an toàn."}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "requirement_code": "YC02", "requirement_content": "Tuân thủ các nguyên tắc an toàn khi cấp nguồn điện và sử dụng thiết bị máy tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "requirement_code": "YC01", "requirement_content": "Giải thích được sơ lược chức năng điều khiển và quản lí của hệ điều hành."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "requirement_code": "YC02", "requirement_content": "Phân biệt được hệ điều hành với phần mềm ứng dụng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "requirement_code": "YC03", "requirement_content": "Nêu được tên một số phần mềm ứng dụng đã sử dụng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "requirement_code": "YC04", "requirement_content": "Giải thích được phần mở rộng của tên tệp, cho biết tệp thuộc loại gì, nêu được ví dụ minh họa."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "requirement_code": "YC01", "requirement_content": "Nhận biết được phần mềm ứng dụng và các loại tệp dữ liệu thông qua phần mở rộng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "requirement_code": "YC01", "requirement_content": "Phân biệt được hệ điều hành và phần mềm ứng dụng, nêu rõ vai trò và sự khác biệt giữa chúng trong việc vận hành máy tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "requirement_code": "YC02", "requirement_content": "Nhận biết được phần mềm ứng dụng và các loại tệp tương thích với phần mềm trong các tình huống thực tế."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "requirement_code": "YC01", "requirement_content": "Biết cách đặt tên tệp và thư mục sao cho dễ nhớ, trực quan và khoa học."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "requirement_code": "YC02", "requirement_content": "Hiểu và thực hiện được các biện pháp bảo vệ dữ liệu như sao lưu dữ liệu (sao lưu cục bộ và sao lưu từ xa)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "requirement_code": "YC03", "requirement_content": "Nhận biết và sử dụng các phần mềm diệt virus để bảo vệ an toàn cho máy tính và dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác đổi tên, di chuyển, sao chép và xoá thư mục, tệp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "requirement_code": "YC02", "requirement_content": "Nêu được một số chức năng cơ bản của mạng xã hội. Nhận biết được một số website là mạng xã hội."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "requirement_code": "YC03", "requirement_content": "Sử dụng được một số chức năng cơ bản của một mạng xã hội để giao lưu và chia sẻ thông tin."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "requirement_code": "YC04", "requirement_content": "Nêu được ví dụ cụ thể về hậu quả của việc sử dụng thông tin vào mục đích sai trái."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "requirement_code": "YC01", "requirement_content": "Thực hiện được giao tiếp qua mạng theo đúng quy tắc và bằng ngôn ngữ lịch sự, thể hiện ứng xử có văn hoá."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "requirement_code": "YC02", "requirement_content": "Nêu được ví dụ truy cập không hợp lệ vào các nguồn thông tin; biết cách ứng xử hợp lí khi gặp những thông tin trên mạng có nội dung xấu, không phù hợp lứa tuổi."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "requirement_code": "YC03", "requirement_content": "Biết được tác hại của bệnh nghiện Internet, từ đó có ý thức phòng tránh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "requirement_code": "YC04", "requirement_content": "Biết nhờ người lớn giúp đỡ, tư vấn khi cần thiết trong quá trình ứng xử trên mạng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "requirement_code": "YC01", "requirement_content": "Nêu được một số chức năng cơ bản của phần mềm bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "requirement_code": "YC02", "requirement_content": "Thực hiện được một số thao tác đơn giản: chọn phông chữ, căn chỉnh dữ liệu trong ô tính, thay đổi độ rộng cột."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác chỉnh sửa, định dạng dữ liệu, đổi tên trang tính và lưu bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "requirement_code": "YC02", "requirement_content": "Vận dụng được kiến thức về bảng tính điện tử để giải quyết các bài toán thực tế và trả lời câu hỏi luyện tập, vận dụng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "requirement_code": "YC01", "requirement_content": "Biết cách nhập và sử dụng công thức trong bảng tính để thực hiện các phép toán."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "requirement_code": "YC02", "requirement_content": "Hiểu và phân biệt được cách nhập giá trị trực tiếp và cách sử dụng địa chỉ ô tính trong công thức để đảm bảo tính toán tự động."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "requirement_code": "YC01", "requirement_content": "Biết cách nhập và sử dụng hàm trong bảng tính điện tử để tính toán."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "requirement_code": "YC01", "requirement_content": "Thực hiện được thao tác nhập và sao chép dữ liệu, chèn thêm hàng/cột trong bảng tính điện tử."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "requirement_code": "YC02", "requirement_content": "Sử dụng thành thạo các hàm tính toán cơ bản như SUM, AVERAGE để xử lý dữ liệu thực tế."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "requirement_code": "YC01", "requirement_content": "Biết cách định dạng dữ liệu cho trang tính bao gồm định dạng chữ in đậm, màu nền cho hàng tiêu đề và các ô chứa dữ liệu tổng hợp để làm nổi bật."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "requirement_code": "YC02", "requirement_content": "Vận dụng được các hàm tính toán trong bảng tính điện tử (như hàm SUM) để giải quyết các bài toán thực tế về tổng hợp và phân tích dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "requirement_code": "YC01", "requirement_content": "Biết và thực hiện được một số chức năng định dạng dữ liệu số và trình bày bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "requirement_code": "YC02", "requirement_content": "Áp dụng được một số hàm tính toán dữ liệu như SUM, COUNT, AVERAGE, MIN, MAX vào dự án Trường học xanh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "requirement_code": "YC01", "requirement_content": "Biết cách thiết lập định dạng hiển thị ngày tháng của Việt Nam trong phần mềm bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "requirement_code": "YC02", "requirement_content": "Hiểu và thực hiện được các phép tính cộng, trừ với dữ liệu ngày tháng trong bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "requirement_code": "YC03", "requirement_content": "Tìm hiểu và phân biệt được việc định dạng dữ liệu và trình bày bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác hoàn thiện bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "requirement_code": "YC02", "requirement_content": "Thực hành hoàn thiện dự án."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "requirement_code": "YC03", "requirement_content": "Sử dụng được bảng tính điện tử để giải quyết một vài công việc cụ thể đơn giản."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "requirement_code": "YC01", "requirement_content": "Thực hiện được thao tác tạo bài trình chiếu có trang tiêu đề và các trang nội dung có tiêu đề trang."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "requirement_code": "YC02", "requirement_content": "Biết cách sử dụng cấu trúc phân cấp trong bài trình chiếu với phần mềm Microsoft PowerPoint."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "requirement_code": "YC01", "requirement_content": "Sao chép được dữ liệu từ tệp văn bản sang trang trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "requirement_code": "YC02", "requirement_content": "Đưa được hình ảnh minh hoạ vào bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "requirement_code": "YC03", "requirement_content": "Biết sử dụng các định dạng cho văn bản, ảnh minh hoạ một cách hợp lí."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "requirement_code": "YC01", "requirement_content": "Biết đưa hiệu ứng động vào bài trình chiếu và sử dụng hiệu ứng một cách hợp lí."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "requirement_code": "YC02", "requirement_content": "Biết cách tổng hợp, sắp xếp các nội dung đã có thành một bài trình chiếu hoàn chỉnh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "requirement_code": "YC01", "requirement_content": "Giải thích được thuật toán tìm kiếm tuần tự."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "requirement_code": "YC02", "requirement_content": "Biểu diễn và mô phỏng được hoạt động của thuật toán tìm kiếm tuần tự trên một bộ dữ liệu vào có kích thước nhỏ."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "requirement_code": "YC01", "requirement_content": "Giải thích được thuật toán tìm kiếm nhị phân."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "requirement_code": "YC02", "requirement_content": "Biểu diễn và mô phỏng được hoạt động của thuật toán tìm kiếm nhị phân trên một bộ dữ liệu vào có kích thước nhỏ."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "requirement_code": "YC03", "requirement_content": "Giải thích được mối liên quan giữa sắp xếp và tìm kiếm, nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "requirement_code": "YC01", "requirement_content": "Giải thích được một vài thuật toán sắp xếp cơ bản."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "requirement_code": "YC02", "requirement_content": "Biểu diễn và mô phỏng được hoạt động của thuật toán sắp xếp với bộ dữ liệu đầu vào có kích thước nhỏ."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "requirement_code": "YC03", "requirement_content": "Nêu được ý nghĩa của việc chia một bài toán thành những bài toán nhỏ hơn."}, {"grade_level": "Lớp 8", "lesson_id": "Bìa sách", "requirement_code": "YC01", "requirement_content": "Nhận diện bộ sách giáo khoa Tin học lớp 8 thuộc bộ sách Kết nối tri thức với cuộc sống của Nhà xuất bản Giáo dục Việt Nam."}, {"grade_level": "Lớp 8", "lesson_id": "HD01", "requirement_code": "YC01", "requirement_content": "Nắm vững cấu trúc sách giáo khoa Tin học bao gồm các phần mục tiêu, khởi động, nội dung bài học, luyện tập và vận dụng để học tập hiệu quả."}, {"grade_level": "Lớp 8", "lesson_id": "MỤC LỤC", "requirement_code": "YC01", "requirement_content": "Nắm bắt tổng quan cấu trúc chương trình, các chủ đề, tên bài học và số trang tương ứng của sách giáo khoa Tin học lớp 9."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "requirement_code": "YC01", "requirement_content": "Nêu được ví dụ cụ thể cho thấy máy tính làm thay đổi sâu sắc cuộc sống của con người trong các lĩnh vực y tế, giáo dục, kinh tế, quốc phòng và an toàn xã hội."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "requirement_code": "YC02", "requirement_content": "Phân tích được sự khác nhau trong hoạt động học tập khi chưa có và khi có các thiết bị công nghệ số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "requirement_code": "YC03", "requirement_content": "Nhận biết được các ứng dụng thông minh của thế hệ máy tính mới và đưa ra dự báo về ứng dụng của máy tính trong tương lai."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "requirement_code": "YC01", "requirement_content": "Nêu được các đặc điểm của thông tin số: đa dạng, được thu thập ngày càng nhanh và nhiều, được lưu trữ với dung lượng khổng lồ bởi nhiều tổ chức và cá nhân, có tính bản quyền, có độ tin cậy rất khác nhau, có các công cụ tìm kiếm, chuyển đổi, truyền và xử lí hiệu quả."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "requirement_code": "YC02", "requirement_content": "Trình bày được tầm quan trọng của việc biết khai thác các nguồn thông tin đáng tin cậy, nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "requirement_code": "YC03", "requirement_content": "Xác định được tính đáng tin cậy của thông tin để đưa ra kết luận và quyết định đúng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "requirement_code": "YC01", "requirement_content": "Sử dụng được công cụ tìm kiếm, xử lí và trao đổi thông tin trong môi trường số. Nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "requirement_code": "YC02", "requirement_content": "Chủ động tìm kiếm được thông tin để thực hiện nhiệm vụ cụ thể."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "requirement_code": "YC03", "requirement_content": "Đánh giá được lợi ích của thông tin tìm được trong giải quyết vấn đề, nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "requirement_code": "YC01", "requirement_content": "Tạo bài trình chiếu theo cấu trúc đã định."}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "requirement_code": "YC02", "requirement_content": "Biên tập nội dung bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "requirement_code": "YC03", "requirement_content": "Chia sẻ bài trình chiếu trong môi trường số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "requirement_code": "YC01", "requirement_content": "Nêu được sự cần thiết phải tuân thủ đạo đức, pháp luật và văn hoá trong môi trường số khi tạo ra và chia sẻ sản phẩm số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "requirement_code": "YC02", "requirement_content": "Nhận biết và phân biệt được các hành vi vi phạm đạo đức, pháp luật hoặc chuẩn mực văn hoá khi sử dụng công nghệ kĩ thuật số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "requirement_code": "YC01", "requirement_content": "Giải thích được sự thay đổi địa chỉ tương đối trong công thức khi sao chép công thức."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "requirement_code": "YC02", "requirement_content": "Giải thích được sự khác nhau giữa địa chỉ tương đối và địa chỉ tuyệt đối của một ô tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "requirement_code": "YC03", "requirement_content": "Sử dụng được phần mềm bảng tính trợ giúp giải quyết bài toán thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "requirement_code": "YC04", "requirement_content": "Sao chép được dữ liệu từ các tệp văn bản, trang trình chiếu sang trang tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "requirement_code": "YC01", "requirement_content": "Biết cách sử dụng chức năng sắp xếp và lọc dữ liệu trên bảng tính điện tử để giải quyết các bài toán thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "requirement_code": "YC01", "requirement_content": "Biết cách sắp xếp dữ liệu theo nhiều tiêu chí trên phần mềm bảng tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "requirement_code": "YC02", "requirement_content": "Hiểu và thực hiện được chức năng lọc dữ liệu theo một tiêu chí và nhiều tiêu chí trên bảng tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "requirement_code": "YC01", "requirement_content": "Thực hiện tạo và định dạng bảng dữ liệu trên phần mềm bảng tính điện tử."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "requirement_code": "YC02", "requirement_content": "Thực hiện sắp xếp dữ liệu theo một hoặc nhiều tiêu chí (tăng dần, giảm dần)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "requirement_code": "YC03", "requirement_content": "Thực hiện lọc dữ liệu nâng cao theo nhiều tiêu chí và lọc theo điều kiện (Number Filters, Text Filters)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "requirement_code": "YC01", "requirement_content": "Nêu được một số tình huống thực tế cần sử dụng các chức năng tạo biểu đồ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "requirement_code": "YC02", "requirement_content": "Thực hiện được các thao tác tạo biểu đồ của phần mềm bảng tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác: tạo danh sách dạng liệt kê; chèn thêm, xoá bỏ, co dãn hình ảnh; vẽ hình đồ hoạ trong văn bản,..."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "requirement_code": "YC02", "requirement_content": "Tạo được sản phẩm là văn bản có tính thẩm mĩ phục vụ nhu cầu thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "requirement_code": "YC03", "requirement_content": "Biết cách chèn ảnh minh họa, thay đổi lớp và kích thước ảnh trong văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "requirement_code": "YC01", "requirement_content": "Biết cách thêm và thay đổi màu sắc các đối tượng hình đồ hoạ, chèn hình ảnh vào văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "requirement_code": "YC02", "requirement_content": "Thực hành chỉnh sửa vị trí, màu sắc các đối tượng và lưu tệp văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác: đánh số trang, thêm đầu trang và chân trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "requirement_code": "YC02", "requirement_content": "Tạo được sản phẩm là văn bản có tính thẩm mĩ phục vụ nhu cầu thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "requirement_code": "YC01", "requirement_content": "Thực hiện được việc đánh số trang, thêm đầu trang và chân trang vào văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "requirement_code": "YC01", "requirement_content": "Chọn đặt được màu sắc, cỡ chữ hài hoà và hợp lí với nội dung."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "requirement_code": "YC02", "requirement_content": "Thực hiện được thao tác đánh số trang, thêm đầu trang và chân trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "requirement_code": "YC01", "requirement_content": "Tạo được bài trình chiếu mới và nhập nội dung cho bốn trang chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "requirement_code": "YC02", "requirement_content": "Định dạng văn bản trên trang chiếu, đặt màu sắc, cỡ chữ hài hoà và hợp lí với nội dung."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "requirement_code": "YC03", "requirement_content": "Đánh số trang, thêm đầu trang và chân trang (Header & Footer) cho bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11a", "requirement_code": "YC01", "requirement_content": "Biết cách chỉnh sửa bản mẫu (template) trong phần mềm trình chiếu để phù hợp với nội dung bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "requirement_code": "YC01", "requirement_content": "Nêu được một vài chức năng chính của phần mềm chỉnh sửa ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "requirement_code": "YC02", "requirement_content": "Thực hiện được các thao tác: mở tệp ảnh; đọc thông tin ảnh; phóng to, thu nhỏ, dịch chuyển ảnh; lưu tệp ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "requirement_code": "YC01", "requirement_content": "Biết các công cụ cắt, xoay, thay đổi kích thước ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "requirement_code": "YC02", "requirement_content": "Thực hiện được thao tác: cắt, xoay, thay đổi kích thước ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "requirement_code": "YC01", "requirement_content": "Biết cách điều chỉnh độ sáng và độ tương phản cho ảnh sử dụng phần mềm GIMP."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "requirement_code": "YC02", "requirement_content": "Thực hiện được các thao tác làm mờ hoặc làm sắc nét nền và vùng ảnh bằng công cụ Brush."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "requirement_code": "YC01", "requirement_content": "Tập hợp, bổ sung và chỉnh sửa ảnh từ các bài học trước để tạo một tờ rơi giới thiệu về trường."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "requirement_code": "YC02", "requirement_content": "Thực hiện tạo lớp mới, đặt tên lớp và ẩn/hiện lớp trong phần mềm xử lý ảnh GIMP."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "requirement_code": "YC01", "requirement_content": "Sử dụng được công cụ Gradient để đổ màu chuyển dần giữa màu nền và màu vẽ cho lớp ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "requirement_code": "YC02", "requirement_content": "Biết cách sắp xếp thứ tự các lớp ảnh (Layers) và thay đổi kích thước lớp ảnh bằng công cụ Scale."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "requirement_code": "YC03", "requirement_content": "Thực hiện trộn các lớp ảnh thành một lớp bằng lệnh Layer/Merge Down và xuất tệp ảnh bằng lệnh File/Export As."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "requirement_code": "YC01", "requirement_content": "Mô tả được kịch bản đơn giản dưới dạng thuật toán và tạo được một chương trình đơn giản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "requirement_code": "YC02", "requirement_content": "Hiểu được chương trình là dãy các lệnh điều khiển máy tính thực hiện một thuật toán."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "requirement_code": "YC01", "requirement_content": "Nhận biết được tập hợp giá trị của các kiểu dữ liệu cơ bản trong ngôn ngữ lập trình Scratch như số, sâu kí tự, lôgic."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "requirement_code": "YC02", "requirement_content": "Sử dụng được các phép toán cơ bản tương ứng với từng kiểu dữ liệu trong Scratch."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "requirement_code": "YC03", "requirement_content": "Viết được chương trình Scratch để giải quyết bài toán tính toán thực tế (như tính chu vi, diện tích hình tròn) có sử dụng hằng, biến và biểu thức."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "requirement_code": "YC01", "requirement_content": "Thể hiện được cấu trúc tuần tự, rẽ nhánh và lặp ở chương trình trong môi trường lập trình trực quan."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "requirement_code": "YC02", "requirement_content": "Sử dụng thành thạo các biến, khối lệnh điều kiện và khối lệnh lặp để giải quyết bài toán thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "requirement_code": "YC01", "requirement_content": "Chạy thử, tìm lỗi và sửa được lỗi cho chương trình."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "requirement_code": "YC02", "requirement_content": "Thực hiện được việc kiểm thử chương trình với các bộ dữ liệu khác nhau để cải tiến và hoàn thiện thuật toán."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "requirement_code": "YC01", "requirement_content": "Hiểu được vai trò của tin học trong việc tăng hiệu quả công việc ở nhiều ngành nghề khác nhau."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "requirement_code": "YC02", "requirement_content": "Nhận thức đúng đắn về bình đẳng giới trong sử dụng máy tính và các ngành nghề lĩnh vực tin học."}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "requirement_code": "YC01", "requirement_content": "Hiểu được cấu trúc chung của sách giáo khoa Tin học 9 và ý nghĩa của các biểu tượng, cấu phần trong mỗi bài học."}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "requirement_code": "YC02", "requirement_content": "Nhận biết các phần mềm thực hành chính được sử dụng và làm quen với ba nhân vật đồng hành xuyên suốt chương trình."}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "requirement_code": "YC01", "requirement_content": "Tiếp tục phát triển năng lực tin học và rèn luyện phẩm chất cần thiết để tham gia vào xã hội kĩ thuật số."}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "requirement_code": "YC02", "requirement_content": "Biết cách giải quyết vấn đề một cách khoa học, sử dụng thông tin hiệu quả và tạo ra những sản phẩm kĩ thuật số."}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "requirement_code": "YC03", "requirement_content": "Tìm hiểu thông tin về ngành nghề làm cơ sở cho việc lựa chọn nghề nghiệp theo khả năng và sở thích."}, {"grade_level": "Lớp 9", "lesson_id": "Mục lục", "requirement_code": "YC01", "requirement_content": "Nắm bắt cấu trúc chương trình môn Tin học lớp 9 bao gồm 6 chủ đề chính: Máy tính và cộng đồng, Tổ chức lưu trữ, tìm kiếm và trao đổi thông tin, Đạo đức, pháp luật và văn hoá trong môi trường số, Ứng dụng tin học, Giải quyết vấn đề với sự trợ giúp của máy tính, và Hướng nghiệp với tin học."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "requirement_code": "YC01", "requirement_content": "Nêu được ví dụ thực tế về ứng dụng của máy tính và công nghệ thông tin trong khoa học kĩ thuật, đời sống, y tế, nghiên cứu, giao thông và giải trí."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "requirement_code": "YC02", "requirement_content": "Trình bày được tác động của công nghệ thông tin lên giáo dục và xã hội."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "requirement_code": "YC01", "requirement_content": "Giải thích được sự cần thiết phải quan tâm đến chất lượng thông tin khi tìm kiếm, tiếp nhận và trao đổi thông tin. Nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "requirement_code": "YC02", "requirement_content": "Giải thích được tính mới, tính chính xác, tính đầy đủ, tính sử dụng được của thông tin. Nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 3", "requirement_code": "YC01", "requirement_content": "Tìm kiếm được thông tin để giải quyết vấn đề."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 3", "requirement_code": "YC02", "requirement_content": "Đánh giá được chất lượng thông tin trong giải quyết vấn đề."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "requirement_code": "YC01", "requirement_content": "Đánh giá được chất lượng thông tin tìm được dựa trên các tiêu chí: tính mới, tính chính xác, tính đầy đủ và tính sử dụng được."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "requirement_code": "YC02", "requirement_content": "Lựa chọn và sắp xếp danh sách các trường ưu tiên theo thứ tự phù hợp với năng lực và sở thích cá nhân."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "requirement_code": "YC01", "requirement_content": "Trình bày được một số tác động tiêu cực của công nghệ kĩ thuật số đối với đời sống con người và xã hội, nêu được ví dụ minh hoạ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "requirement_code": "YC02", "requirement_content": "Nêu được một số nội dung liên quan đến luật Công nghệ thông tin, nghị định về sử dụng dịch vụ Internet, các khía cạnh pháp lí của việc sở hữu, sử dụng và trao đổi thông tin."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "requirement_code": "YC03", "requirement_content": "Nêu được một số hành vi vi phạm pháp luật, trái đạo đức, thiếu văn hoá khi hoạt động trong môi trường số thông qua một vài ví dụ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "requirement_code": "YC01", "requirement_content": "Nhận biết các hành vi vi phạm pháp luật, trái đạo đức, thiếu văn hóa khi hoạt động trong môi trường số."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "requirement_code": "YC02", "requirement_content": "Biết cách ứng xử có trách nhiệm, tuân thủ pháp luật, tôn trọng bản quyền và giao tiếp có văn hóa trên mạng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 5", "requirement_code": "YC01", "requirement_content": "Nêu được ví dụ phần mềm mô phỏng. Nhận ra được ích lợi của phần mềm mô phỏng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "requirement_code": "YC01", "requirement_content": "Nhận biết và nêu được ví dụ về phần mềm mô phỏng trong học tập và đời sống."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "requirement_code": "YC02", "requirement_content": "Trình bày được lợi ích của phần mềm mô phỏng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "requirement_code": "YC01", "requirement_content": "Nêu được những kiến thức đã thu nhận từ việc khai thác một vài phần mềm mô phỏng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "requirement_code": "YC02", "requirement_content": "Nhận biết được sự mô phỏng thế giới thực nhờ máy tính có thể giúp con người khám phá tri thức và giải quyết vấn đề."}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "requirement_code": "YC01", "requirement_content": "Tương tác với phần mềm mô phỏng để quan sát sự chuyển hoá giữa các dạng năng lượng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "requirement_code": "YC02", "requirement_content": "Sử dụng phần mềm thí nghiệm ảo để lắp ráp mạch điện một chiều và đo cường độ dòng điện đi qua một điện trở."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 7", "requirement_code": "YC01", "requirement_content": "Sử dụng được bài trình chiếu và sơ đồ tư duy trong trao đổi thông tin và hợp tác."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 7", "requirement_code": "YC02", "requirement_content": "Biết được khả năng đính kèm văn bản, ảnh, video, trang tính vào sơ đồ tư duy."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "requirement_code": "YC01", "requirement_content": "Sử dụng được hình ảnh, biểu đồ, video một cách hợp lí."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "requirement_code": "YC02", "requirement_content": "Tạo được sơ đồ tư duy có đính kèm văn bản, hình ảnh, video và trang tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "requirement_code": "YC03", "requirement_content": "Tạo được bài trình chiếu có sử dụng hình ảnh, biểu đồ và video hợp lí."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "requirement_code": "YC01", "requirement_content": "Sử dụng được công cụ xác thực dữ liệu (Data Validation) của phần mềm bảng tính để giải quyết bài toán quản lí tài chính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "requirement_code": "YC02", "requirement_content": "Sử dụng được công cụ xác thực dữ liệu để giới hạn kiểu dữ liệu nhập vào (ví dụ: số lớn hơn 0) cho cột số tiền."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "requirement_code": "YC01", "requirement_content": "Sử dụng được hàm đếm theo điều kiện COUNTIF trong giải quyết bài toán thực tế về quản lí tài chính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "requirement_code": "YC01", "requirement_content": "Biết sử dụng hàm tính tổng theo điều kiện SUMIF để giải quyết bài toán quản lí tài chính gia đình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "requirement_code": "YC01", "requirement_content": "Sử dụng được hàm điều kiện IF trong giải quyết bài toán thực tiễn về quản lí tài chính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12", "requirement_code": "YC01", "requirement_content": "Biết cách sử dụng hàm điều kiện IF và hàm IF lồng nhau trong phần mềm bảng tính điện tử để xử lý dữ liệu theo các điều kiện khác nhau."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "requirement_code": "YC02", "requirement_content": "Biết cách bổ sung cột dữ liệu, tạo bảng tổng hợp và nhập công thức hàm trong phần mềm bảng tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "requirement_code": "YC01", "requirement_content": "Tạo được trang tính tổng hợp thông tin thu, chi gia đình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "requirement_code": "YC02", "requirement_content": "Hoàn thiện bảng tính quản lí tài chính gia đình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "requirement_code": "YC01", "requirement_content": "Nêu được một số chức năng và thực hiện được một số thao tác cơ bản trong sử dụng một phần mềm làm video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "requirement_code": "YC01", "requirement_content": "Biết được các bước để làm một video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "requirement_code": "YC02", "requirement_content": "Chuẩn bị được dữ liệu và dựng được video theo kịch bản."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "requirement_code": "YC01", "requirement_content": "Thực hiện được thao tác cắt ngắn đoạn video trên phần mềm biên tập video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "requirement_code": "YC02", "requirement_content": "Biết cách tạo đoạn hoạt hình từ hình ảnh và thay đổi thời gian hiển thị của ảnh trong dự án."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "requirement_code": "YC01", "requirement_content": "Dựng được video theo kịch bản bằng phần mềm Video Editor."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "requirement_code": "YC01", "requirement_content": "Biết cách thêm và chỉnh sửa âm lượng cho hiệu ứng âm thanh trong phần mềm biên tập video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "requirement_code": "YC02", "requirement_content": "Biết cách thêm bộ lọc (Filters) và điều chỉnh màu sắc, hiệu ứng hình ảnh cho video/hình ảnh trong dự án."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "requirement_code": "YC02", "requirement_content": "Thực hiện được thao tác thêm phụ đề vào video theo kịch bản."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "requirement_code": "YC01", "requirement_content": "Đưa được âm thanh từ tệp trên máy tính vào video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "requirement_code": "YC02", "requirement_content": "Thực hiện được một số thao tác nâng cao để dựng video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13", "requirement_code": "YC01", "requirement_content": "Thực hiện được các thao tác biên tập video cơ bản như loại bỏ thanh màu đen và chỉnh lại thời gian hiển thị dữ liệu, tiêu đề."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "requirement_code": "YC01", "requirement_content": "Biết cách thiết lập thời lượng hiển thị cho tiêu đề và hình ảnh trong video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "requirement_code": "YC02", "requirement_content": "Thực hiện được thao tác xuất video ra tệp có định dạng mp4 với chất lượng tuỳ chọn."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "requirement_code": "YC01", "requirement_content": "Trình bày được quá trình giải quyết vấn đề và mô tả được giải pháp dưới dạng thuật toán (hoặc bằng phương pháp liệt kê các bước hoặc bằng sơ đồ khối)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "requirement_code": "YC02", "requirement_content": "Mô tả được giải pháp thông qua thuật toán (ví dụ: thuật toán bám tường trong bài toán giải mê cung)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "requirement_code": "YC01", "requirement_content": "Mô tả được thuật toán bằng cách sử dụng các cấu trúc điều khiển cơ bản (tuần tự, rẽ nhánh và lặp)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "requirement_code": "YC02", "requirement_content": "Biết cách cài đặt thuật toán thành chương trình máy tính và thực hiện gỡ lỗi, hiệu chỉnh chương trình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "requirement_code": "YC01", "requirement_content": "Sử dụng được cấu trúc tuần tự, rẽ nhánh, lặp trong mô tả thuật toán."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "requirement_code": "YC02", "requirement_content": "Giải thích được chương trình là bản mô tả thuật toán bằng ngôn ngữ mà máy tính có thể hiểu và thực hiện."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "requirement_code": "YC01", "requirement_content": "Trình bày được công việc đặc thù và sản phẩm chính của người làm tin học trong ít nhất ba nhóm nghề."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "requirement_code": "YC02", "requirement_content": "Nêu và giải thích được ý kiến cá nhân (thích hay không thích,...) về một nhóm nghề nào đó."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "requirement_code": "YC03", "requirement_content": "Nhận biết được đặc trưng cơ bản của nhóm nghề thuộc hướng Tin học ứng dụng và nhóm nghề thuộc hướng Khoa học máy tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "requirement_code": "YC04", "requirement_content": "Tìm hiểu được (thông qua Internet và những kênh thông tin khác) công việc ở một số doanh nghiệp, công ty có sử dụng nhân lực thuộc các nhóm ngành đã được giới thiệu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "requirement_code": "YC05", "requirement_content": "Giải thích được cả nam và nữ đều có thể thích hợp với các ngành nghề trong lĩnh vực tin học."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "requirement_code": "YC01", "requirement_content": "Hiểu được vai trò của nữ giới trong lĩnh vực tin học, phá bỏ các định kiến giới tính và nhận thức đúng đắn về cơ hội nghề nghiệp bình đẳng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "requirement_code": "YC02", "requirement_content": "Phân tích và lựa chọn được định hướng nghề nghiệp trong lĩnh vực tin học phù hợp với năng lực, sở thích và nhu cầu cá nhân không phân biệt giới tính."}] AS row
MATCH (l:Lesson {id: toString(row.grade_level) + '_' + toString(row.lesson_id)})
MERGE (r:Requirement {id: toString(row.grade_level) + '_' + toString(row.lesson_id) + '_' + toString(row.requirement_code)})
ON CREATE SET r.code = toString(row.requirement_code),
              r.content = toString(row.requirement_content)
MERGE (l)-[:HAS_REQUIREMENT]->(r);

// --- 4. NẠP NỘI DUNG KIẾN THỨC CỐT LÕI (382 TRI THỨC) ---
UNWIND [{"grade_level": "Lớp 6", "lesson_id": "Bai_6_1", "knowledge_name": "Các nội dung chính của Chủ đề 1", "knowledge_content": "Chủ đề 1 bao gồm các nội dung chính sau:\n- Thông tin và dữ liệu\n- Xử lí thông tin\n- Thông tin trong máy tính"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "knowledge_name": "1. Thông tin và dữ liệu", "knowledge_content": "Thông tin là những hiểu biết của con người về thế giới xung quanh và về chính bản thân mình. Dữ liệu là những gì con người tiếp nhận để có được thông tin. Dữ liệu được thể hiện dưới dạng những con số, văn bản, hình ảnh, kí hiệu,... Vật mang tin là phương tiện được dùng để lưu trữ và truyền tải thông tin, ví dụ như giấy viết, đĩa CD, thẻ nhớ,..."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "knowledge_name": "Mối quan hệ giữa thông tin và dữ liệu", "knowledge_content": "Vì dữ liệu đem lại thông tin nên đôi khi 'dữ liệu' cũng được thay bằng 'thông tin'. Máy tính xử lí dữ liệu nhưng đôi khi người ta cũng nói là máy tính xử lí thông tin. Tuy vậy, thông tin và dữ liệu vẫn có những điểm khác nhau. Thông tin là dữ liệu được xử lí để trở thành có ý nghĩa, và thông tin luôn phụ thuộc vào con người. Tấm bảng ghi nội dung là vật mang tin, và những số chữ trên bảng là dữ liệu."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "knowledge_name": "2. Tầm quan trọng của thông tin", "knowledge_content": "Thông tin đem lại hiểu biết cho con người. Mọi hoạt động của con người đều cần đến thông tin. Thông tin đúng giúp con người đưa ra những lựa chọn tốt, giúp cho hoạt động của con người đạt hiệu quả. Thông tin còn có khả năng làm thay đổi hành động của con người."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "knowledge_name": "Hoạt động 2: Hỏi để có thông tin", "knowledge_content": "Lớp em sắp tổ chức một buổi dã ngoại. Hãy thảo luận nhóm để đưa ra các câu hỏi giúp tìm thông tin để chuẩn bị cho buổi dã ngoại đó:\n- Bình tìm thông tin về phong cảnh để lập kế hoạch chụp ảnh.\n- Khoa tìm thông tin về các trò chơi để quyết định chơi trò nào.\n- Dung tìm thông tin thời tiết để biết nên mặc quần áo như thế nào cho phù hợp.\n- Minh tìm thông tin về các di tích lịch sử để tham quan.\n- An tìm thông tin về những món ăn nhẹ để chuẩn bị mang theo."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "knowledge_name": "1. Xử lí thông tin", "knowledge_content": "Trong các hoạt động thực tế như cầu thủ bóng đá sút phạt đền, bộ não con người thực hiện một loạt thao tác phức tạp: quan sát vị trí thủ môn (thu nhận thông tin), phân tích, đánh giá, suy luận để chuyển hoá thông tin thành ý định (xử lí thông tin), ghi nhớ kết quả bước trước để thực hiện thao tác ở bước sau, và điều khiển cơ thể hành động. Trong mọi hoạt động của con người, bộ luôn thực hiện một nhiệm vụ rất quan trọng: xử lí thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "knowledge_name": "Các bước xử lí thông tin cơ bản của con người", "knowledge_content": "Xử lí thông tin gồm bốn hoạt động thành phần, còn được gọi là các bước xử lí thông tin cơ bản: Thu nhận thông tin (nhờ các giác quan như nghe, nhìn, chạm, nếm, ngửi); Lưu trữ thông tin (bộ não ghi nhớ lại, hoặc lưu trữ bằng cách ghi chép); Biến đổi thông tin (bộ não liên kết các thông tin đã có, so sánh, phân tích, thống kê, suy luận, giải thích... để đưa ra kết luận, quyết định); Truyền thông tin (thông tin được truyền đến các bộ phận cơ thể chuyển hoá thành hành vi hoặc được chia sẻ với người khác)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "knowledge_name": "2. Xử lí thông tin trong máy tính", "knowledge_content": "Ngày nay, thông tin không chỉ là sự hiểu biết của cá nhân mà đã trở thành tài nguyên của xã hội loài người, đem lại lợi ích to lớn. Chiếc máy kì diệu giúp con người xử lí nguồn tài nguyên đó chính là máy tính. Máy tính có đủ thành phần để có thể thực hiện được các thao tác: thu thập, lưu trữ, biến đổi và truyền thông tin:\n- Thiết bị vào để thu nhận thông tin: bàn phím, chuột, máy quét,...\n- Thiết bị ra để truyền hoặc chia sẻ thông tin: màn hình, máy in,...\n- Bộ xử lí để biến đổi thông tin bằng cách thực hiện chương trình máy tính do con người viết ra.\n- Bộ nhớ để lưu trữ thông tin: đĩa quang, đĩa từ, thẻ nhớ,..."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "knowledge_name": "1. Biểu diễn thông tin trong máy tính", "knowledge_content": "Trong Hoạt động 1, mỗi số từ 0 đến 7 có thể được chuyển thành một dãy các kí hiệu 0 và 1. Với những số lớn hơn thì có thể cần dãy nhiều hơn các kí hiệu 0 và 1 để mã hoá. Mỗi dãy các kí hiệu 0 và 1 như vậy được gọi là dãy bit. Mỗi kí hiệu của dãy bit được gọi là một bit (viết tắt từ Binary digIT). Bằng cách tương tự, người ta có thể chuyển một số bất kì thành một dãy bit."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "knowledge_name": "Biểu diễn thông tin trong máy tính", "knowledge_content": "Thông tin được biểu diễn trong máy tính bằng dãy các bit. Mỗi bit là một kí hiệu 0 hoặc 1, hay còn được gọi là chữ số nhị phân. Bit là đơn vị đo thông tin nhỏ nhất trong máy tính. Trong máy tính, thông tin dưới mọi dạng văn bản, hình ảnh, âm thanh,... đều được chuyển thành dãy bit. Số nhị phân là số được viết từ chỉ hai kí hiệu 0 và 1."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "knowledge_name": "2. Đơn vị đo thông tin", "knowledge_content": "Thông tin trong máy tính được tổ chức dưới dạng các tệp (tệp văn bản, tệp hình ảnh, tệp video,...). Các tệp được lưu trữ trong các thiết bị nhớ như thẻ nhớ, đĩa cứng,... Trong thực tế, người ta thường đo dung lượng thông tin bằng đơn vị byte (bằng 8 bit) và các lớn hơn như kilobyte (KB), megabyte (MB), gigabyte (GB), terabyte (TB)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "knowledge_name": "Đặc điểm và dung lượng các loại bộ nhớ ngoài", "knowledge_content": "Tuỳ theo chức năng của các bộ nhớ, dung lượng của chúng cũng khác nhau. Ví dụ, bộ nhớ trong của máy tính cá nhân, thường có dung lượng từ 2 GB đến 16 GB. Những máy tính chuyên dùng cho đồ hoạ hoặc phim ảnh có dung lượng bộ nhớ trong lớn hơn. Ngoài bộ nhớ trong, máy tính còn trao đổi dữ liệu với các bộ nhớ ngoài như thẻ nhớ, đĩa quang, đĩa cứng,... Đĩa quang loại compact (CD) thường có dung lượng khoảng 700 MB. Đĩa quang kĩ thuật số (DVD) thường được dùng để lưu trữ video, có dung lượng từ 4,7 GB đến 17 GB. Các ổ đĩa cứng hiện nay có dung lượng từ vài trăm GB đến vài TB được dùng để lưu trữ dữ liệu đa dạng. Thẻ nhớ là loại bộ nhớ được người sử dụng ưa thích vì chúng nhỏ gọn mà lưu trữ được nhiều dữ liệu. Ví dụ, thẻ nhớ có thể lưu trữ được hàng trăm GB hoặc cao hơn."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "knowledge_name": "Tổng quan về Mạng máy tính và Internet", "knowledge_content": "Chủ đề giới thiệu về mạng máy tính giúp các máy tính kết nối, chia sẻ thông tin với nhau và Internet kết nối toàn cầu các hệ thống mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "knowledge_name": "Khởi động và Khám phá", "knowledge_content": "Cuộc trò chuyện giữa An và Khoa về mạng giao thông đường bộ làm ví dụ thực tế mở đầu để học sinh làm quen với khái niệm mạng lưới, các thành phần kết nối và sự giao lưu kết nối trong đời sống, từ đó dẫn dắt sang khái niệm mạng lưới và mạng máy tính."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "knowledge_name": "1. Mạng máy tính là gì?", "knowledge_content": "Giống như mạng giao thông, các máy tính cũng được kết nối với nhau để tạo thành mạng máy tính. Chỉ cần hai máy tính kết nối với nhau là có một mạng máy tính. Người sử dụng mạng có thể trao đổi dữ liệu với nhau, chẳng hạn gửi một tệp ảnh từ máy tính của mình đến máy tính của bạn nếu hai máy tính đó được kết nối với nhau. Các thiết bị trên mạng có thể được chia sẻ, chẳng hạn chỉ có một máy in nhưng nếu có kết nối mạng thì ta có thể in từ một máy tính bất kì trong mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "knowledge_name": "Ghi nhớ: Mạng máy tính", "knowledge_content": "Hai hay nhiều máy tính và các thiết bị được kết nối để truyền thông tin cho nhau tạo thành một mạng máy tính. Lợi ích của mạng máy tính: Người sử dụng có thể liên lạc với nhau để trao đổi thông tin, chia sẻ dữ liệu và dùng chung các thiết bị trên mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "knowledge_name": "Đường truyền dữ liệu", "knowledge_content": "Đường truyền dữ liệu giống như đường vận chuyển trong mạng giao thông, có đường nhìn thấy và không nhìn thấy. Đường truyền dữ liệu nhìn thấy sử dụng dây dẫn mạng. Đường truyền dữ liệu không nhìn thấy sử dụng sóng vô tuyến như wifi, bluetooth,... Kết nối không dây thường được sử dụng trong các thiết bị di động như máy tính xách tay, điện thoại thông minh, tai nghe không dây,... Kết nối không dây giúp cho việc kết nối trở nên thuận tiện hơn. Các thiết bị trong mạng có thể linh hoạt thay đổi vị trí mà vẫn duy trì kết nối mạng. Chẳng hạn, khi đang di chuyển trên xe khách, hành khách có thể sử dụng điện thoại di động để truy cập Internet mà không cần dây nối. Kết nối không dây có thể thực hiện ở mọi địa hình, không gian. Việc lắp đặt và mở rộng mạng rất dễ dàng vì không cần phải đi dây và khoan đục tường. Việc không sử dụng dây trong kết nối mạng còn tránh được những sự cố như đứt dây do mưa bão hay đơn giản hơn là chuột cắn làm đường dây bị hư hại. Ngày nay, mạng không dây (có phí hoặc miễn phí) được cung cấp ở rất nhiều nơi, đặc biệt là những nơi công cộng như sân bay, nhà ga, trung tâm thương mại, trường học,... Người sử dụng có thể truy cập mạng một cách nhanh chóng và dễ dàng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "knowledge_name": "Đặc điểm chính của Internet", "knowledge_content": "Đặc điểm chính của Internet: tính toàn cầu, tính tương tác, tính dễ tiếp cận, tính không chủ sở hữu."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "knowledge_name": "3. Một số lợi ích của Internet", "knowledge_content": "Internet mang lại nhiều lợi ích thiết thực cho con người như: hỗ trợ học tập trực tuyến, tìm kiếm thông tin, xem phim, nghe nhạc, chơi trò chơi giải trí, giao lưu kết nối bạn bè qua thư điện tử và hỗ trợ quảng cáo, kinh doanh sản phẩm."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "Vai trò của Internet", "knowledge_content": "Ngày nay, Internet có vai trò rất quan trọng trong mọi hoạt động của xã hội, từ các lĩnh vực sản xuất, kinh doanh cho đến khoa học kĩ thuật, y tế, giáo dục, văn hoá, giải trí,... Internet cung cấp nhiều dịch vụ thông tin như: WWW, tìm kiếm, thư điện tử, điện thoại, phát thanh, truyền hình, mạng xã hội, lưu trữ, trao đổi dữ liệu, kinh doanh,... Ngoài ra, Internet còn cung cấp môi trường làm việc từ xa như: viết sách báo, học tập, dạy học, hội họp,... Nhờ vậy, Internet góp phần thúc đẩy xã hội phát triển."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "Lợi ích của Internet", "knowledge_content": "Trao đổi thông tin nhanh chóng, hiệu quả. Học tập và làm việc trực tuyến. Cung cấp nguồn tài liệu phong phú. Cung cấp các tiện ích phục vụ đời sống. Là phương tiện vui chơi, giải trí."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "Lưu ý khi sử dụng Internet", "knowledge_content": "Không nên truy cập Internet liên tục trong nhiều giờ."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "knowledge_name": "Các nội dung chính của Chủ đề 3", "knowledge_content": "Chủ đề bao gồm 3 nội dung trọng tâm: Mạng thông tin toàn cầu, Tìm kiếm thông tin trên Internet, và Thư điện tử."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "knowledge_name": "Trình duyệt và truy cập trang web", "knowledge_content": "Trình duyệt là phần mềm giúp người dùng truy cập các trang web trên Internet. Người sử dụng có thể theo các liên kết để khai thác thông tin từ các trang web."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "knowledge_name": "a) Mở trình duyệt", "knowledge_content": "Nháy đúp chuột vào biểu tượng trình duyệt. Nhập địa chỉ trang web vào ô địa chỉ. Nhấn phím Enter. Trang Bách khoa toàn thư mở được hiển thị như Hình 3.2."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "1. Xem thông tin thời tiết trên trang web", "knowledge_content": "Để xem thông tin thời tiết, nhập địa chỉ trang web của Trung tâm Dự báo Khí tượng Thuỷ văn Quốc gia (khituongvietnam.gov.vn) vào ô địa chỉ rồi nhấn phím Enter. Sử dụng các liên kết trên trang để xem tin cảnh báo thiên tai, dự báo thời tiết chi tiết hoặc xem tóm tắt thời tiết trong ngày."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "2. Xem thông tin thời sự trên trang web", "knowledge_content": "Để xem thông tin thời sự, nhập địa chỉ trang web của Đài Truyền hình Việt Nam (vtvgo.vn) vào ô địa chỉ rồi nhấn phím Enter. Nháy chuột vào các mục trên trang để xem trực tuyến, xem lịch phát sóng hoặc xem lại các bản tin thời sự."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "Tìm kiếm thông tin trên Internet", "knowledge_content": "Sử dụng máy tìm kiếm (ví dụ: Google) để tìm kiếm thông tin và hình minh hoạ bằng cách nhập địa chỉ trang web, gõ từ khoá cần tìm và nhấn phím Enter. Kết quả trả về gồm danh sách các liên kết, hình ảnh, tin tức hoặc video liên quan."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "Xem nội dung thư và đăng xuất", "knowledge_content": "Để xem nội dung thư, nháy chuột vào Tên người gửi hoặc Tiêu đề thư. Sau khi sử dụng xong, nháy chuột vào nút Đăng xuất để ra khỏi hộp thư điện tử nhằm tránh bị người khác sử dụng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "c) Soạn thư mới và gửi", "knowledge_content": "Các bước soạn thư mới và gửi bao gồm: (1) Nháy chuột vào nút Soạn thư, (2) Nhập địa chỉ hộp thư người nhận, (3) Nhập tiêu đề thư, (4) Nhập nội dung thư, (5) Nháy chuột vào nút Gửi hoặc gửi kèm tệp nếu cần."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "knowledge_name": "Khái quát về An toàn thông tin trên Internet", "knowledge_content": "Chủ đề 4 giới thiệu về các quy tắc đạo đức, pháp luật và văn hoá trong môi trường số, tập trung vào việc bảo mật thông tin cá nhân và an toàn khi sử dụng Internet."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "Tác hại, nguy cơ khi dùng Internet", "knowledge_content": "Các tác hại và nguy cơ khi dùng Internet bao gồm: Thông tin cá nhân bị lộ hoặc bị đánh cắp; Máy tính bị nhiễm virus hay mã độc; Bị lừa đảo, dụ dỗ, đe doạ, bắt nạt trên mạng; Tiếp nhận thông tin không chính xác; Nghiện Internet, nghiện trò chơi trên mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "knowledge_name": "Tầm quan trọng và bảo vệ thông tin cá nhân", "knowledge_content": "Thông tin cá nhân và tài khoản cần được bảo vệ để tránh bị lợi dụng hoặc gặp nguy hiểm khi rơi vào tay kẻ xấu. Các biện pháp bảo vệ bao gồm: đăng xuất tài khoản sau khi dùng xong, đặt mật khẩu mạnh (đủ dài, gồm chữ hoa, chữ thường, chữ số, kí tự đặc biệt), che mật khẩu khi nhập, nhờ người lớn hoặc chuyên gia cài đặt chương trình diệt virus, tránh dùng mạng công cộng kém bảo mật, không truy cập liên kết lạ, không mở thư điện tử và tệp đính kèm từ người không quen, không kết bạn và nhắn tin cho người lạ, không đồng ý tham gia các câu lạc bộ chưa rõ nguồn gốc trên mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "knowledge_name": "Nhận diện thông điệp lừa đảo hoặc mang nội dung xấu", "knowledge_content": "Các kẻ lừa đảo qua mạng thường dùng thư điện tử, tin nhắn giả mạo, yêu cầu kết bạn hoặc mời tham gia câu lạc bộ để dụ dỗ chia sẻ thông tin cá nhân, đánh cắp tài khoản và mật khẩu. Cần chặn tài khoản của kẻ xấu và thông báo với bố mẹ hoặc thầy cô giáo để nhận sự giúp đỡ."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "knowledge_name": "Chia sẻ thông tin an toàn", "knowledge_content": "Thông tin cá nhân chỉ nên chia sẻ cho người mình biết rõ và tin tưởng ở thế giới thực trong các trường hợp cần thiết. Internet có tính ẩn danh nên cần xác nhận lại qua điện thoại hoặc gặp trực tiếp trước khi chia sẻ. Thông tin trên mạng đến từ nhiều nguồn khác nhau, không có ai kiểm chứng, do đó cần tiếp nhận có chọn lọc, không chia sẻ thông tin từ những nguồn không tin tưởng, chỉ chia sẻ thông tin từ cơ quan, tổ chức chính thống để tránh lan truyền tin giả làm tổn thương người khác."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "Một số biện pháp bảo vệ thông tin, tài khoản cá nhân và chia sẻ thông tin an toàn", "knowledge_content": "Cài đặt và cập nhật phần mềm chống virus. Đặt mật khẩu mạnh. Bảo vệ mật khẩu. Đăng xuất các tài khoản khi đã dùng xong. Tránh dùng mạng công cộng. Không truy cập vào các liên kết lạ; không mở thư điện tử và tệp đính kèm gửi từ những người không quen; không kết bạn và nhắn tin cho người lạ. Không chia sẻ thông tin cá nhân và những thông tin chưa được kiểm chứng trên Internet; không lan truyền tin giả làm tổn thương người khác."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 5", "knowledge_name": "Giới thiệu Chủ đề 5: Ứng dụng tin học", "knowledge_content": "Chủ đề giới thiệu các nội dung chính bao gồm: Sơ đồ tư duy, Định dạng văn bản, Trình bày thông tin ở dạng bảng, Tìm kiếm và thay thế, cùng với phần Thực hành tổng hợp Hoàn thiện sổ lưu niệm."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "knowledge_name": "Khái niệm và lợi ích của sơ đồ tư duy", "knowledge_content": "Sơ đồ tư duy là phương pháp trình bày thông tin một cách trực quan bằng cách sử dụng văn bản, hình ảnh và các đường nối. Sơ đồ tư duy tận dụng tối đa khả năng ghi nhận hình ảnh của bộ não, giúp chúng ta dễ dàng ghi nhớ chi tiết, tổng hợp hay phân tích vấn đề. Sơ đồ tư duy do Tony Buzan (Quốc tịch Anh, sinh năm 1942) sáng tạo. Các thành phần chính của sơ đồ tư duy bao gồm: từ khóa, hình ảnh và đường nối. Lợi ích của sơ đồ tư duy gồm: nhìn thấy bức tranh tổng thể, dễ dàng ghi nhớ, thúc đẩy tư duy, tăng khả năng sáng tạo, đơn giản, dễ hiểu và tiết kiệm thời gian."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "Phần mềm tạo sơ đồ tư duy", "knowledge_content": "Có nhiều phần mềm chuyên dùng cho việc tạo sơ đồ tư duy như: MindMaple Lite, FreeMind, iMindMap, Mindmaple, Mind Manager,... Các phần mềm này cho phép chúng ta tạo sơ đồ tư duy dễ dàng, chính xác và nhanh chóng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "a) Khởi động phần mềm", "knowledge_content": "Sau khi khởi động, giao diện phần mềm MindMaple Lite được mở ra với các thanh công cụ, vùng làm việc và các tính năng hỗ trợ tạo chủ đề, định dạng, chèn hình ảnh."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "b) Tạo sơ đồ tư duy", "knowledge_content": "Thực hiện các bước tạo sơ đồ tư duy theo hướng dẫn trong hình: (1) Nháy chuột vào File, (2) Chọn New, (3) Chọn một mẫu, (4) Nháy chuột vào Create. Sơ đồ tư duy được tạo ra với chủ đề chính là một khung. Nháy chuột vào khung để nhập tên chủ đề."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "c) Tạo các chủ đề nhánh", "knowledge_content": "- Nháy chuột vào ô chứa chủ đề chính để chọn chủ đề chính.\n- Chọn Insert/Subtopic. Một chủ đề nhánh được tạo ra và nối với chủ đề chính vừa chọn.\n- Nháy chuột vào chủ đề nhánh vừa tạo để nhập tên.\n- Thực hiện tương tự để tạo các chủ đề nhánh khác của sơ đồ tư duy.\n- Chú ý: Tạo chủ đề nhánh cho chủ đề nào thì nháy chuột chọn chủ đề đó trước khi tạo."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "knowledge_name": "Ưu điểm của sơ đồ tư duy bằng phần mềm máy tính", "knowledge_content": "Phần mềm máy tính giúp tạo sơ đồ tư duy dễ dàng, nhanh chóng; dễ sửa chữa và điều chỉnh; nhanh chóng chia sẻ và trao đổi. Giúp ghi nhớ thông tin nhanh hơn, lâu hơn và dễ dàng nhớ lại khi cần thiết. Có thể in ra giấy hoặc chia sẻ qua Internet."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 11", "knowledge_name": "1. Phần mềm soạn thảo văn bản", "knowledge_content": "Phần mềm soạn thảo văn bản có thể được cài đặt trên máy tính hoặc chạy trực tuyến trên Internet. Có nhiều loại phần mềm soạn thảo văn bản khác nhau, chúng đều có các chức năng cơ bản sau đây:\n- Tạo và định dạng văn bản.\n- Biên tập, chỉnh sửa nội dung.\n- Lưu trữ văn bản.\n- In văn bản.\nĐể nâng cao hiệu quả sử dụng, phần mềm soạn thảo còn có một số chức năng nâng cao khác:\n- Xem lại và theo dõi sự thay đổi của tài liệu.\n- Lưu trữ tài liệu trên đám mây để có thể đồng bộ và lấy tài liệu từ máy tính, điện thoại di động hay máy tính bảng.\n- Làm việc cộng tác với người khác trên cùng một tài liệu mọi lúc mọi nơi.\nVới những chức năng này, chúng ta có thể sử dụng phần mềm soạn thảo văn bản để tạo ra các tài liệu khác nhau như cuốn sách, bài viết, báo cáo, bản tin, tờ rơi,..."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "knowledge_name": "2. Định dạng văn bản và in - a) Định dạng đoạn văn bản", "knowledge_content": "Đoạn văn bản là phần văn bản thường được phân cách bởi dấu ngắt đoạn (xuất hiện khi nhấn phím Enter). Việc định dạng giúp thay đổi cách trình bày của đoạn trong văn bản như tăng, giảm lề của đoạn, căn chỉnh lề, đặt khoảng cách giữa các dòng trong đoạn. Các lệnh định dạng đoạn nằm trong thẻ Home, ở nhóm lệnh Paragraph."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "knowledge_name": "2. Định dạng văn bản và in - b) Định dạng trang văn bản", "knowledge_content": "Để văn bản đẹp và có bố cục hài hoà, cần định dạng trang văn bản. Các lệnh định dạng trang văn bản nằm trong thẻ Page Layout, ở nhóm lệnh Page Setup. Các yêu cầu cơ bản khi trình bày trang văn bản gồm: Chọn hướng trang (Orientation) gồm trang đứng (Portrait) hay trang ngang (Landscape); Đặt lề trang (Margins) gồm lề trái (Left), lề phải (Right), lề trên (Top) và lề dưới (Bottom); Lựa chọn khổ giấy (Size) với khổ giấy phổ biến là khổ A4."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "knowledge_name": "c) In văn bản", "knowledge_content": "Sau khi hoàn thành việc tạo văn bản, em có thể in văn bản ra giấy. Để thực hiện công việc này, trong thẻ File, em chọn lệnh Print."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "knowledge_name": "a) Khởi động phần mềm và nhập nội dung", "knowledge_content": "Các bước thực hiện: Nháy đúp chuột vào biểu tượng phần mềm trên màn hình nền, nhập nội dung văn bản, chọn Insert/Picture để mở hộp thoại Insert Picture và chèn ảnh."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "knowledge_name": "b) Căn lề đoạn văn bản", "knowledge_content": "Trong văn bản, tiêu đề, hình ảnh và giới thiệu tên thường được căn lề giữa, phần văn bản còn lại được căn đều hai bên. Để thực hiện căn lề, chọn dòng nội dung, nháy chuột vào thẻ Home và chọn biểu tượng căn lề tương ứng (ví dụ: căn lề giữa)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "knowledge_name": "c) Chọn hướng trang, lề trang", "knowledge_content": "Giả sử muốn chọn hướng trang bài viết là hướng đứng (Portrait), mẫu đặt lề trang là Normal, thực hiện các thao tác thiết lập trang trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "knowledge_name": "Chọn hướng trang và lề trang", "knowledge_content": "Để thay đổi hướng trang, chọn thẻ Page Layout, tìm nhóm Page Setup, nháy chuột chọn Orientation và chọn hướng trang đứng Portrait hoặc ngang Landscape. Để chọn lề trang, chọn thẻ Page Layout, tìm nhóm Page Setup, nháy chuột chọn Margins và chọn mẫu đặt lề trang như Normal."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "knowledge_name": "Lưu tệp văn bản", "knowledge_content": "Chọn File/Save để lưu tệp văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "knowledge_name": "1. Trình bày thông tin ở dạng bảng", "knowledge_content": "Bảng được sử dụng để trình bày thông tin một cách cô đọng. Bảng cũng thường được sử dụng để ghi lại dữ liệu của công việc thống kê, điều tra, khảo sát,... Từ bảng dữ liệu, học sinh có thể dễ dàng tìm kiếm, so sánh, tổng hợp được thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "knowledge_name": "2. Tạo bảng", "knowledge_content": "Trong phần mềm soạn thảo văn bản, các lệnh tạo bảng nằm trong thẻ Insert ở nhóm lệnh Table. Cách mở cửa sổ Insert Table được thực hiện qua các bước: chọn Insert, chọn nút tam giác nhỏ bên dưới Table. \n- Di chuyển chuột bắt đầu từ góc trên, bên trái của cửa sổ Insert Table vừa mở ra để chọn số cột, số hàng cho bảng. Sau khi nháy chuột, bảng sẽ được chèn vào vị trí của con trỏ soạn thảo.\n- Để đưa dữ liệu vào bảng, đặt con trỏ soạn thảo vào ô và nhập dữ liệu. Ô của bảng có thể chứa tất cả các loại dữ liệu như văn bản, hình ảnh,...\n- Để di chuyển con trỏ soạn thảo, sử dụng các phím mũi tên lên, xuống, trái, phải trên bàn phím hoặc sử dụng chuột.\n- Căn chỉnh lề cho dữ liệu trong ô cũng tương tự như căn lề cho văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "knowledge_name": "a) Tạo bảng", "knowledge_content": "Xác định số cột, số hàng của bảng dựa trên thông tin cần trình bày. Có thể ước tính số cột, số hàng của bảng dựa trên số thành viên hoặc dữ liệu thực tế. Phần hướng dẫn thực hành tạo bảng gồm 4 cột và 4 hàng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "knowledge_name": "b) Chỉnh sửa bảng", "knowledge_content": "Để gộp nhiều ô thành một ô, chọn các ô cần gộp, trong nhóm thẻ Table Tools chọn thẻ Layout, sau đó trong nhóm lệnh Merge chọn Merge Cells. Để thay đổi độ rộng của cột hay độ cao của hàng, di chuyển con trỏ chuột vào đường biên cho đến khi xuất hiện mũi tên hai chiều rồi kéo thả chuột."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "knowledge_name": "2. Sử dụng công cụ tìm kiếm và thay thế - a) Tìm kiếm", "knowledge_content": "Công cụ Tìm kiếm giúp tìm kiếm từ hoặc cụm từ theo yêu cầu một cách nhanh chóng và chính xác. Thao tác tìm kiếm trong phần mềm Microsoft Word được thực hiện qua các bước: Nháy chuột vào thẻ Home; Trong nhóm lệnh Editing, chọn Find; Gõ từ, cụm từ cần tìm rồi nhấn phím Enter."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "knowledge_name": "b) Thay thế", "knowledge_content": "Trong văn bản, thay thế cụm từ 'dưa hấu' bằng từ 'xoài' được thực hiện theo bốn bước như sau: 1. Trong nhóm lệnh Editing, chọn Replace. 2. Gõ từ, cụm từ cần tìm. 3. Gõ từ, cụm từ thay thế. 4a. Nháy chuột vào nút để thay thế lần lượt từng từ hoặc cụm từ. 4b. Nháy chuột vào nút này để thay thế tất cả các từ trong toàn bộ văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "knowledge_name": "1. Tập hợp nội dung đã có", "knowledge_content": "Tập hợp các tệp văn bản chứa nội dung cuốn sổ lưu niệm của lớp (bài viết cảm nghĩ, danh sách thành viên,...) vào một tệp văn bản có tên Soluuniem.docx bằng cách sử dụng thẻ Insert, nhóm lệnh Text và chọn Object -> Text from File."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "knowledge_name": "2. Bổ sung thêm nội dung", "knowledge_content": "Xem lại sơ đồ tư duy trình bày nội dung cuốn sổ lưu niệm từ Bài 10 để rà soát, thu thập và bổ sung thông tin về thầy cô giáo, các hoạt động của lớp (thể thao, văn hoá, văn nghệ, tham quan,...). Thực hiện định dạng văn bản, căn chỉnh lề, định dạng hướng trang, chèn hình ảnh, bảng và sử dụng chức năng Tìm kiếm và Thay thế để chỉnh sửa văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "knowledge_name": "Bước 3. Tạo trang bìa cho cuốn sổ", "knowledge_content": "Để tạo trang bìa cho cuốn sổ lưu niệm, em thực hiện theo các bước: 1. Nháy chuột vào thẻ Insert; 2. Trong nhóm lệnh Pages, chọn Cover Page; 3. Chọn một mẫu trang bìa; 4. Sửa lại nội dung và thay hình trang bìa."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "knowledge_name": "Bước 4. Xem lại nội dung", "knowledge_content": "Xem lại nội dung cuốn sổ lưu niệm, trao đổi và thảo luận để đảm bảo cuốn sổ lưu niệm chung của cả lớp có nội dung đầy đủ và trình bày đẹp nhất."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 6", "knowledge_name": "Nội dung tổng quan Chủ đề 6", "knowledge_content": "Chủ đề tập trung vào ba nội dung cốt lõi: Thuật toán, Các cấu trúc điều khiển, và Chương trình máy tính, giúp học sinh làm quen với tư duy giải quyết vấn đề và lập trình."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "knowledge_name": "Khái niệm thuật toán", "knowledge_content": "Thuật toán là một dãy các chỉ dẫn rõ ràng, có trình tự sao cho khi thực hiện những chỉ dẫn này người ta giải quyết được vấn đề hoặc nhiệm vụ đã cho. Trong thuật toán, dữ liệu ban đầu được gọi là đầu vào (Input); kết quả nhận được là đầu ra (Output)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "knowledge_name": "2. Mô tả thuật toán", "knowledge_content": "Ngoài cách mô tả thuật toán bằng dùng ngôn ngữ tự nhiên để liệt kê các bước, người ta còn mô tả thuật toán bằng cách sử dụng sơ đồ khối. Sơ đồ khối của thuật toán gồm một số hình mô tả các bước và đường có mũi tên để chỉ trình tự thực hiện các bước của thuật toán."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "Mô tả thuật toán bằng sơ đồ khối", "knowledge_content": "Có hai cách để mô tả thuật toán là liệt kê các bước bằng ngôn ngữ tự nhiên và sử dụng sơ đồ khối. Sơ đồ khối của thuật toán là một sơ đồ gồm các hình mô tả các bước và đường có mũi tên để chỉ thứ tự thực hiện các bước của thuật toán.\n\nQuy ước các hình khối trong sơ đồ khối:\n- Hình bầu dục: Bắt đầu hoặc Kết thúc.\n- Hình bình hành: Đầu vào hoặc Đầu ra.\n- Hình chữ nhật: Bước xử lí.\n- Hình thoi: Bước kiểm tra điều kiện.\n- Mũi tên: Trình tự thực hiện."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "knowledge_name": "Luyện tập và Vận dụng thuật toán", "knowledge_content": "Củng cố kiến thức về khái niệm thuật toán, đầu vào (input), đầu ra (output), cách mô tả thuật toán bằng phương pháp liệt kê các bước và bằng sơ đồ khối sử dụng các hình khối chuẩn (hình bầu dục cho điểm bắt đầu/kết thúc, hình bình hành cho nhập/xuất dữ liệu, hình chữ nhật cho các phép tính hoặc xử lý)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "knowledge_name": "1. Cấu trúc rẽ nhánh dạng thiếu và dạng đủ", "knowledge_content": "Cấu trúc rẽ nhánh mô tả việc đánh giá điều kiện để thực hiện các hành động tương ứng. Cấu trúc rẽ nhánh dạng thiếu chỉ thực hiện một công việc khi điều kiện thỏa mãn (Đúng). Cấu trúc rẽ nhánh dạng đủ thực hiện một công việc khi điều kiện đúng và thực hiện công việc khác khi điều kiện sai. Cấu trúc tuần tự thực hiện lần lượt các lệnh theo trình tự từ bắt đầu đến kết thúc."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "knowledge_name": "2. Cấu trúc lặp", "knowledge_content": "Cấu trúc lặp dùng để mô tả các bước của thuật toán được thực hiện lặp lại nhiều lần. Trong cấu trúc lặp, bao giờ cũng có khâu kiểm tra điều kiện kết thúc quá trình lặp. Ba cấu trúc tuần tự, rẽ nhánh và lặp là đủ để mô tả mọi thuật toán."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "knowledge_name": "Chương trình máy tính", "knowledge_content": "Chương trình máy tính dựa trên các dữ liệu đầu vào, tiến hành các bước xử lí để trả lại kết quả đầu ra. Máy tính thực hiện công việc theo chương trình. Chương trình là mô tả thuật toán để máy tính \"hiểu\" và thực hiện được."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6 - Thực hành", "knowledge_name": "Nhiệm vụ thực hành tính số tiền lãi hoặc lỗ", "knowledge_content": "Ba bạn An, Minh, Khoa đã làm những tấm thiệp chúc mừng ngày Nhà giáo Việt Nam để bán lấy tiền mua sách tặng các bạn học sinh vùng khó khăn. Gọi số tiền bán được là a, số tiền mua vật liệu là b, cần tính toán số tiền lãi thu được hoặc số tiền bị lỗ."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "knowledge_name": "Cấu trúc điều khiển trong Scratch", "knowledge_content": "Cơ chế thực hiện lệnh trong Scratch bao gồm cấu trúc tuần tự, cấu trúc rẽ nhánh (nếu - thì / nếu - thì - không thì) và cấu trúc lặp (lặp lại n lần)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "knowledge_name": "Sự đa dạng của thiết bị vào - ra", "knowledge_content": "Nhắc đến thiết bị vào - ra của máy tính, ta thường nghĩ đến bàn phím, màn hình, chuột, máy in. Trên thực tế, thiết bị vào - ra được thiết kế rất đa dạng để đáp ứng các nhu cầu khác nhau của người sử dụng. Máy chiếu là thiết bị ra, dùng để hiển thị nội dung màn hình máy tính lên màn chiếu. Bộ điều khiển game là thiết bị đưa mệnh lệnh vào máy tính để điều khiển đối tượng trong một số trò chơi trên máy tính. Chuột máy tính có nhiều loại phong phú như chuột có dây, chuột không dây hoặc có thể được thay thế bằng một số thiết bị khác."}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "knowledge_name": "2. An toàn thiết bị - Kết nối thiết bị", "knowledge_content": "Máy tính là một hệ thống phức tạp, sử dụng điện, kết nối với nhiều thiết bị khác. Những thao tác không cẩn thận có thể gây ra sự cố, ảnh hưởng đến hoạt động bình thường của thiết bị và an toàn dữ liệu.\n- Đầu nối tai nghe (e) cần được cắm vào cổng (4). Nếu cắm nhầm đầu nối tai nghe vào cổng (5), em sẽ không nghe thấy âm thanh từ máy tính và có thể sẽ cho rằng thiết bị hoạt động không tốt.\n- Đầu nối dây màn hình (d) cần được cắm vào cổng (3). Nếu cắm vào cổng khác sẽ không lắp được và nếu cố gắng làm điều đó, em có thể sẽ làm hỏng đầu nối.\n- Cổng (7) là chuẩn kết nối USB được sử dụng cho nhiều thiết bị. Tuy nhiên, nếu cắm nhầm đầu kết nối khác vào cổng này có thể gây ra chập điện làm hỏng thiết bị.\n- Dây nguồn (f) cần được lắp vào cổng (8). Việc cấp nguồn điện cho máy tính cần được thực hiện sau khi các thiết bị đã được kết nối để đảm bảo an toàn điện.\nKhi sử dụng máy tính, em cần tuân theo những quy tắc an toàn để không gây ra lỗi. Một số lời khuyên cho những việc nên làm và không nên làm khi sử dụng máy tính được ghi trong Bảng 1.1."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "knowledge_name": "Quy tắc sử dụng máy tính an toàn", "knowledge_content": "• Đọc kĩ hướng dẫn của nhà sản xuất trước khi sử dụng thiết bị.\n• Kết nối các thiết bị đúng cách.\n• Giữ gìn nơi làm việc với máy tính gọn gàng, ngăn nắp, vệ sinh, khô ráo."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "knowledge_name": "Khái niệm phần mềm máy tính", "knowledge_content": "Sau khi kết nối các thiết bị phần cứng như bàn phím, màn hình, chuột,... vào thân máy chứa bộ xử lí, máy tính vẫn chưa hoạt động được. Máy tính còn cần phải có phần mềm để hoạt động. Phần mềm quản lí và điều khiển máy tính là hệ điều hành (Operating System). Các phần mềm giúp em xử lí những loại dữ liệu cụ thể như văn bản, âm thanh, hình ảnh,... được gọi chung là phần mềm ứng dụng (Application Software)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "knowledge_name": "1. Hệ điều hành", "knowledge_content": "Trong máy tính, hệ điều hành là phần mềm đóng vai trò kết nối giúp người sử dụng khai thác khả năng xử lí của máy tính. Máy tính cần có hệ điều hành để hoạt động. Nếu không có hệ điều hành, máy tính chỉ là một khối kim loại và dây dẫn, chẳng hoạt động gì. Những chức năng cơ bản của hệ điều hành là:\n- Quản lí các thiết bị và dữ liệu của máy tính, điều khiển chúng phối hợp hoạt động nhịp nhàng với nhau.\n- Cung cấp và quản lí môi trường trao đổi thông tin (giao diện) giữa người sử dụng và máy tính.\n- Cung cấp, quản lí môi trường cho phép người sử dụng chạy các phần mềm ứng dụng trên máy tính.\nKhông chỉ máy tính cần có hệ điều hành mà điện thoại thông minh hay máy tính bảng cũng cần phải có hệ điều hành để có thể cài đặt và chạy những ứng dụng khác."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "knowledge_name": "Hệ điều hành", "knowledge_content": "Hệ điều hành là phần mềm hệ thống quản lí và điều khiển hoạt động chung của máy tính, quản lí dữ liệu, cung cấp cho con người môi trường tương tác với máy tính và chạy các phần mềm ứng dụng. Có những hệ điều hành dành cho máy tính như Windows, Mac OS, Linux,... và những hệ điều hành dành cho điện thoại thông minh và máy tính bảng như iOS, Android,..."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "knowledge_name": "2. Phần mềm ứng dụng", "knowledge_content": "Phần mềm ứng dụng giúp con người thực hiện những công việc cụ thể, thể hiện được lợi ích của máy tính. Em đã biết một số phần mềm ứng dụng như phần mềm soạn thảo văn bản, phần mềm sơ đồ tư duy, phần mềm lập trình trực quan Scratch, trình duyệt,... Có những phần mềm được chạy trực tuyến từ Internet nhưng cũng có phần mềm cần phải cài đặt lên đĩa cứng mới có thể dùng được. Mỗi phần mềm ứng dụng hỗ trợ tạo và xử lí một số loại dữ liệu nhất định, với định dạng tệp riêng, được nhận ra nhờ phần mở rộng. Phần mở rộng gồm những kí tự sau dấu chấm cuối cùng trong tên tệp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "knowledge_name": "1. Khái niệm phần mềm ứng dụng", "knowledge_content": "Phần mềm ứng dụng là các chương trình máy tính cho phép người sử dụng thực hiện những công việc cụ thể và thường xử lí những loại dữ liệu cụ thể. Loại tệp được nhận biết nhờ phần mở rộng, gồm những kí tự sau dấu chấm cuối cùng trong tên tệp. Loại tệp cũng cho biết phần mềm ứng dụng nào có thể được dùng với nó."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "knowledge_name": "2. Phân biệt hệ điều hành và phần mềm ứng dụng", "knowledge_content": "Mặc dù cùng là phần mềm, nhưng hệ điều hành và phần mềm ứng dụng có vai trò khác nhau đối với sự vận hành của máy tính. Hệ điều hành là phần mềm được sử dụng để quản lí các thành phần của máy tính và điều khiển máy tính hoạt động. Phần mềm ứng dụng được dùng để thực hiện yêu cầu xử lí thông tin cụ thể của người sử dụng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "Nguyên tắc đặt tên tệp và thư mục", "knowledge_content": "Tên tệp và thư mục cần được đặt sao cho dễ nhớ, cho ta biết trong đó chứa những gì để công việc thuận lợi hơn. Chương trình máy tính được lưu trữ trên thiết bị nhớ giống như một tệp dữ liệu. Tệp chương trình máy tính trong hệ điều hành Windows thường có phần mở rộng .exe, .com, .bat, .msi."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "2. Các biện pháp bảo vệ dữ liệu", "knowledge_content": "Lưu trữ thông tin trong máy tính và trên Internet có nhiều rủi ro. Cần thực hiện các biện pháp bảo vệ để dữ liệu không bị mất, hỏng hoặc truy cập trái phép. a) Sao lưu dữ liệu: Dữ liệu cần được sao lưu thường xuyên. Sao lưu dữ liệu là tạo ra bản sao các tệp và thư mục rồi lưu chúng lên một thiết bị lưu trữ để khôi phục lại khi có sự cố. - Sao lưu cục bộ là bản sao được đặt trên cùng máy tính chứa bản gốc hoặc trên thiết bị lưu trữ như ổ cứng ngoài, USB... Giúp phục hồi nhanh chóng nhưng có rủi ro mất cả bản gốc lẫn bản sao nếu thiết bị bị thất lạc hoặc hỏng. - Sao lưu từ xa là bản sao được đặt bên ngoài máy tính chứa bản gốc (trên máy tính khác hoặc đưa lên Internet nhờ công nghệ đám mây), giúp dữ liệu an toàn ngay cả khi máy tính bị hỏng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "knowledge_name": "1. Ưu và nhược điểm của một số thiết bị lưu trữ", "knowledge_content": "Các thiết bị lưu trữ thông dụng bao gồm thẻ nhớ, USB (nhỏ gọn, tiện sử dụng, khá bền nhưng dễ thất lạc, dễ lây lan virus), đĩa quang CD/DVD (chi phí thấp, khó bị nhiễm virus nhưng dung lượng nhỏ, dễ hỏng dữ liệu), ổ cứng ngoài (dung lượng lớn, tiện sử dụng nhưng kích thước to nặng) và lưu trữ nhờ công nghệ đám mây (truy cập bất kỳ đâu có Internet, sao lưu từ xa nhưng cần kết nối Internet và có rủi ro về bảo mật)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "knowledge_name": "2. Tài khoản người sử dụng và mật khẩu", "knowledge_content": "Để bảo vệ dữ liệu, tránh bị người khác truy cập trái phép, cần đặt mật khẩu cho tài khoản trên máy tính. Mật khẩu mạnh thường dài ít nhất 8 kí tự, bao gồm cả chữ số, chữ in hoa, chữ thường và các kí tự đặc biệt như @, #, đồng thời không phải là từ thông thường. Mật khẩu yếu thường chứa tên cá nhân, từ quen thuộc hoặc ngày sinh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "knowledge_name": "3. Phần mềm diệt virus", "knowledge_content": "Phần mềm độc hại (virus, sâu, phần mềm gián điệp) có thể làm hỏng dữ liệu và chương trình máy tính. Phần mềm diệt virus được thiết kế để phát hiện và tiêu diệt virus, ngăn chặn các cuộc tấn công. Một số hệ điều hành được trang bị sẵn phần mềm diệt virus (như Windows Defender), ngoài ra còn có các phần mềm phổ biến như Kaspersky, AVG, Avira, Bkav, Avast."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "Bảo vệ và sao lưu dữ liệu", "knowledge_content": "Dữ liệu cần được sao lưu thường xuyên lên thiết bị lưu trữ ngoài máy tính chứa dữ liệu gốc để tránh bị mất hoặc bị hỏng dữ liệu. Việc đặt mật khẩu cho tài khoản người sử dụng trên máy tính và trên Internet sẽ giúp bảo vệ dữ liệu khỏi sự truy cập trái phép. Cần bảo vệ dữ liệu bằng cách không sử dụng phần mềm không rõ nguồn gốc và luôn bật chế độ bảo vệ máy tính của phần mềm diệt virus."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "b) Đổi tên, di chuyển, sao chép, xoá thư mục và tệp", "knowledge_content": "Việc đổi tên một thư mục được thực hiện bằng cách nháy nút phải chuột vào thư mục đó và chọn Rename. Di chuyển một thư mục có thể thực hiện bằng lệnh Cut và Paste. Sao chép một thư mục có thể thực hiện bằng lệnh Copy và Paste. Nháy nút phải chuột vào thư mục \"BìnhMinh\" và chọn Delete để xoá thư mục đó. Thực hiện tương tự để đổi tên, di chuyển, sao chép, xoá tệp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "1. Mạng xã hội - Kênh trao đổi thông tin phổ biến trên Internet", "knowledge_content": "Trong suốt chiều dài lịch sử, con người đã nghĩ ra nhiều cách trao đổi thông tin với nhau: dùng chim bồ câu đưa thư, gửi thư qua bưu điện, sử dụng điện báo, điện thoại,... Thế kỉ XX đã mang đến cho chúng ta Internet, giúp tạo ra nhiều kênh trao đổi thông tin rất hữu ích, nhanh chóng,... Một trong số đó là mạng xã hội. Từ khi Internet ra đời, việc trao đổi thông tin trên Internet ngày càng trở nên phổ biến và đóng vai trò quan trọng trong đời sống của chúng ta. Một số kênh trao đổi thông tin phổ biến trên Internet hiện nay là: thư điện tử, diễn đàn (Forum), mạng xã hội,... Thông tin trên Internet được liên tục cập nhật, chúng tồn tại với nhiều dạng khác nhau như dạng văn bản, hình ảnh, âm thanh, video, phần mềm,..."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "b) Mạng xã hội", "knowledge_content": "Mạng xã hội là một cộng đồng trực tuyến để mọi người có thể tương tác với nhau. Cách tổ chức mạng xã hội phổ biến nhất để người sử dụng tham gia là dưới dạng các website. Tuỳ theo mục đích, các trang mạng xã hội có thể cung cấp những cách thức giao tiếp khác nhau như: tin nhắn riêng tư, đưa ra nhận xét trên trang của bạn bè, đăng ảnh và video lên, thảo luận học tập, chơi trò chơi trực tuyến,... Ví dụ một số website mạng xã hội được phân loại theo mục đích như trong Bảng 4.1."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "Ghi nhớ và Cảnh báo an toàn", "knowledge_content": "• Thư điện tử, diễn đàn, mạng xã hội,... là những kênh trao đổi thông tin thông dụng trên Internet.\n• Tham gia mạng xã hội là tham gia một cộng đồng trực tuyến, nơi mọi người tương tác với nhau theo nhiều cách.\n• Mạng xã hội thường được tổ chức dưới dạng các website. Mỗi mạng xã hội thường có mục đích nhất định như: thảo luận, chia sẻ ảnh, video,...\n• Mạng xã hội luôn có tính hai mặt, tốt và xấu. Vì vậy, chúng ta cần cân nhắc và tìm hiểu kĩ trước khi quyết định tham gia. Một số mạng xã hội quy định độ tuổi tối thiểu được phép tham gia là thành viên, phổ biến là từ 13 tuổi trở lên.\n• Cần tránh xa các thông tin giả, thông tin đe doạ, bắt nạt,... gây hậu quả cho người khác hoặc cho chính bản thân mình."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "Ghi nhớ về sử dụng mạng xã hội", "knowledge_content": "Mạng xã hội giúp người sử dụng kết nối, giao lưu, chia sẻ và thảo luận các vấn đề mà họ quan tâm. Cần tuân thủ đúng các quy định khi sử dụng mạng xã hội và các kênh trao đổi thông tin trên Internet."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "Chia sẻ nội dung trên trang cá nhân", "knowledge_content": "Em có thể nhập nội dung văn bản vào hộp trạng thái hoặc có thể thêm ảnh, video từ máy tính của mình bằng cách nháy chuột vào Ảnh/Video. Nháy chuột vào nút Đăng/Post để hoàn thành việc chia sẻ nội dung."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "knowledge_name": "Kết nối với một bạn cùng lớp", "knowledge_content": "Bước 1. Tìm trang Facebook của bạn bằng cách nhập tên trên Facebook của bạn vào ô tìm kiếm."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "Kết bạn và tương tác trên mạng xã hội", "knowledge_content": "Bước 2: Khi tìm thấy trang Facebook của bạn, em nháy chuột vào ảnh đại diện để mở. Bước 3: Nháy chuột vào nút Thêm bạn bè để gửi yêu cầu kết bạn đến người đó. Nếu yêu cầu kết bạn được chấp nhận, em và bạn sẽ trở thành 'bạn bè trên Facebook'. Hai tài khoản sẽ tự động theo dõi nhau. Nghĩa là người này có thể thấy hoạt động của người kia và có thể tương tác với nhau."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "knowledge_name": "Vai trò của Internet và vấn đề ứng xử trên mạng", "knowledge_content": "Internet có vai trò to lớn trong cuộc sống hiện nay, tác động tích cực đến nhiều mặt của xã hội nhưng bên cạnh đó cũng có các tác động tiêu cực. Sự việc đau lòng liên quan đến sử dụng mạng thường do bắt nạt trên mạng, nghiện Internet, nghiện trò chơi trực tuyến. Ứng xử trên mạng có văn hoá và đúng quy tắc, sử dụng Internet hợp lí sẽ giúp mỗi chúng ta có một cuộc sống văn minh, an toàn hơn."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "knowledge_name": "1. Giao tiếp, ứng xử có văn hoá qua mạng", "knowledge_content": "Khi chưa có mạng Internet, phương thức giao tiếp chủ yếu là nói chuyện trực tiếp, gọi điện thoại, gửi thư qua bưu điện. Ngày nay, với sự phổ biến của Internet và mạng xã hội, giao tiếp qua mạng được nhiều người ưa thích sử dụng với các phương thức phổ biến như gửi và nhận thư điện tử, gửi và nhận tin nhắn, nói chuyện trực tuyến thông qua các ứng dụng, trên các diễn đàn, trên mạng xã hội. Các mối quan hệ qua mạng thường có phạm vi rộng, đa dạng và khó kiểm soát hơn trong đời thực. Vì vậy, để trở thành người giao tiếp lịch sự, ứng xử có văn hoá qua mạng, mỗi người cần xác định cho mình những điều nên và không nên."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "Giao tiếp có văn hóa trên mạng", "knowledge_content": "Luôn sử dụng ngôn ngữ lịch sự và ứng xử có văn hóa khi tham gia giao tiếp qua mạng. Cần tôn trọng mọi người, bảo vệ tài khoản cá nhân, không nói tục, chửi bậy, không đưa thông tin riêng tư của người khác lên mạng khi chưa được phép và biết tìm sự hỗ trợ từ người lớn khi gặp rắc rối."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "2. Làm gì khi gặp thông tin có nội dung xấu trên mạng?", "knowledge_content": "Trên Internet có hàng tỉ trang web, bên cạnh các trang hữu ích phục vụ học tập, giải trí thì có rất nhiều trang web chứa nội dung xấu, không phù hợp với lứa tuổi như trang web không lành mạnh, cờ bạc, chất gây nghiện, kích động bạo lực,... Cần tránh xa các trang web này. Sử dụng phần mềm chặn truy cập web xấu là một cách bảo vệ, tuy nhiên tự xây dựng ý thức tốt cho bản thân khi sử dụng mạng chính là công cụ bảo vệ tốt nhất."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "knowledge_name": "3. Tác hại và cách phòng tránh bệnh nghiện Internet", "knowledge_content": "Nếu thiếu ý thức, không quản lí đúng việc sử dụng thiết bị điện tử của mình, những tác hại tiềm tàng mà Internet gây ra là rất lớn. Chơi trò chơi điện tử quá nhiều, sử dụng mạng xã hội liên tục làm ảnh hưởng tới mối quan hệ với gia đình và bạn bè, tới việc học tập của bản thân. Một số tác hại ảnh hưởng tới người nghiện Internet là:\n- Thiếu giao tiếp với thế giới xung quanh: Sử dụng Internet quá nhiều thường dẫn tới việc chán ăn, sụt cân, không ngủ được. Kết quả là thể lực giảm sút, không muốn giao tiếp với ai, chỉ muốn một mình trong phòng với thiết bị kết nối Internet.\n- Khó tập trung vào công việc, học tập: Việc gián đoạn lặp đi lặp lại sẽ ảnh hưởng đến sự tập trung. Ví dụ, nếu cứ 10 phút chúng ta lại xem điện thoại hay kiểm tra tin nhắn trên mạng xã hội, liệu chúng ta có thể tập trung vào công việc, nhiệm vụ học tập của mình được không.\n- Tăng nguy cơ tham gia vào các vụ bắt nạt trên mạng: Người nghiện Internet dễ có hành vi hung hăng, cố ý làm tổn thương hoặc đe dọa nhằm vào người khác, biểu hiện dưới nhiều hình thức như phát tán tin đồn không đúng về người khác; để lại tin nhắn nói xấu người khác trên diễn đàn; chia sẻ ảnh và thông tin cá nhân của người khác mà không được sự đồng ý."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "Lời khuyên phòng tránh nghiện Internet", "knowledge_content": "Để không biến mình thành một người nghiện Internet, cần thực hiện các nhóm giải pháp: CHIA SẺ (tìm người tin tưởng để tâm sự như bố mẹ, thầy cô, bạn bè), RỜI XA (di chuyển máy tính khỏi phòng riêng, để ở không gian sinh hoạt chung), GIỚI HẠN (cài đặt phần mềm giới hạn thời gian sử dụng Internet), THEO ĐUỔI (tìm và theo đuổi những sở thích tốt như đọc sách, chơi thể thao, làm từ thiện). Dành thời gian với người thân và bạn bè, hạn chế để thiết bị kết nối Internet trong phòng riêng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "1. Giao diện phần mềm bảng tính", "knowledge_content": "Phần mềm bảng tính là phần mềm ứng dụng giúp em trình bày thông tin dưới dạng bảng một cách cô đọng và dễ so sánh, thực hiện các tính toán phổ biến (tính tổng, trung bình cộng, xác định giá trị lớn nhất, nhỏ nhất,...), vẽ các biểu đồ minh hoạ các số liệu tương ứng. Không chỉ thế, khi tính toán bằng phần mềm bảng tính, nếu dữ liệu gốc thay đổi, kết quả tính toán trên các số liệu đó sẽ được tự động cập nhật. Có rất nhiều phần mềm bảng tính khác nhau như Google Sheets, Microsoft Excel, Libre Calc,... và chúng đều có các chức năng tương tự nhau. Giao diện của các phần mềm bảng tính có dạng tương tự như Hình 6.1."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "Giao diện phần mềm bảng tính", "knowledge_content": "Phần mềm bảng tính giúp lưu lại và trình bày thông tin dưới dạng bảng, thực hiện các tính toán từ đơn giản đến phức tạp cũng như xây dựng các biểu đồ biểu diễn một cách trực quan các số liệu trong bảng. Các hàng của trang tính được đặt tên bằng các số: 1, 2, 3,... theo thứ tự từ trên xuống dưới. Các cột của trang tính được đặt tên bằng các chữ cái: A, B, C,... theo thứ tự từ trái sang phải. Giao của một hàng và một cột trên trang tính tạo thành một ô tính (gọi tắt là ô). Luôn có một ô tính là ô hiện thời mà chúng ta đang quan sát, đang nhập dữ liệu hoặc tính toán. Ô hiện thời luôn được đóng khung. Địa chỉ của ô hiện thời luôn hiển thị tại hộp địa chỉ nằm bên trái vùng nhập dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "Ô và vùng trên trang tính", "knowledge_content": "Mỗi ô trên trang tính được đánh địa chỉ theo cột và hàng, ví dụ A1, B3, C10,... Địa chỉ của ô được quy định là tên cột ghép với tên hàng. Nhiều ô liền kề tạo thành hình chữ nhật trên trang tính được gọi là vùng dữ liệu (gọi tắt là vùng). Vùng dữ liệu được đánh địa chỉ theo địa chỉ của ô góc trên bên trái và ô góc dưới bên phải, cách nhau bởi dấu \":\". Ví dụ B4:E11 là một địa chỉ của một vùng dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "Các thao tác chọn trên trang tính", "knowledge_content": "Các thao tác chọn (đánh dấu) một ô, hàng, cột, vùng trên trang tính:\n- Chọn một ô: Nháy chuột vào ô cần chọn.\n- Chọn một hàng: Nháy chuột vào tên hàng cần chọn.\n- Chọn một cột: Nháy chuột vào tên cột cần chọn.\n- Chọn một vùng: Kéo thả chuột từ một ô góc (ví dụ ô góc trên bên trái) đến ô ở góc đối diện (ô góc dưới bên phải). Ô chọn đầu tiên sẽ là ô hiện thời."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "Địa chỉ ô và địa chỉ vùng", "knowledge_content": "<địa chỉ ô> = <tên cột><tên hàng>\nNhiều ô liền kề tạo thành hình chữ nhật trên trang tính gọi là vùng.\n<địa chỉ vùng> = <địa chỉ ô góc trên bên trái> : <địa chỉ ô góc dưới bên phải>"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "2. Nhập, chỉnh sửa và định dạng dữ liệu trong trang tính - a) Cách nhập dữ liệu", "knowledge_content": "Bước 1. Nháy chuột vào ô muốn nhập.\nBước 2. Thực hiện việc nhập dữ liệu từ bàn phím (hoặc nháy chuột vào vùng nhập dữ liệu, sau đó mới tiến hành nhập dữ liệu từ bàn phím), nhập xong nhấn phím Enter.\nQuan sát Hình 6.5 ta thấy:\n- Dữ liệu văn bản sẽ tự động căn trái.\n- Dữ liệu số, ngày tháng,... sẽ tự động căn phải.\nKhi nhập dữ liệu vào ô, phần mềm sẽ tự động nhận biết, phân loại dữ liệu theo các kiểu dữ liệu khác nhau như văn bản, số, ngày tháng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "knowledge_name": "2. Nhập, chỉnh sửa và định dạng dữ liệu trong trang tính - b) Chỉnh sửa dữ liệu", "knowledge_content": "Muốn chỉnh sửa dữ liệu trong ô tính em thực hiện một trong hai cách sau:\n- Cách 1. Nháy đúp chuột vào ô cần sửa, con trỏ soạn thảo xuất hiện trong ô, tiến hành sửa dữ liệu và nhấn phím Enter để kết thúc.\n- Cách 2. Nháy chuột vào ô cần sửa, sau đó nháy chuột vào vùng nhập dữ liệu, con trỏ soạn thảo xuất hiện trong vùng nhập dữ liệu, tiến hành sửa dữ liệu và nhấn phím Enter để kết thúc."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "c) Định dạng dữ liệu", "knowledge_content": "Để định dạng dữ liệu trong một vùng của trang tính em thực hiện:\nBước 1. Chọn vùng dữ liệu.\nBước 2. Sử dụng các lệnh định dạng dữ liệu trong nhóm lệnh Font và Alignment của thẻ Home (Hình 6.6)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "3. THỰC HÀNH: NHẬP THÔNG TIN KHẢO SÁT DỰ ÁN TRƯỜNG HỌC XANH", "knowledge_content": "Nhiệm vụ: Nhập thông tin khảo sát ban đầu của dự án Trường học xanh.\nHướng dẫn (sử dụng phần mềm Microsoft Excel phiên bản 2016):\nBước 1. Mở phần mềm Microsoft Excel bằng cách nháy đúp chuột lên biểu tượng trên màn hình. Chọn Blank workbook để tạo một bảng tính mới.\nBước 2. Nhập dữ liệu khảo sát cho dự án Trường học xanh (Hình 6.7) bao gồm:\n- Nhập tại ô A1: DỰ ÁN TRƯỜNG HỌC XANH.\n- Nhập tại ô A2: Bảng 1. Khảo sát địa điểm trồng cây.\n- Các cột thông tin chính sẽ là: STT, Địa điểm, Loại cây."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "knowledge_name": "1. Chỉnh sửa và định dạng dữ liệu bảng tính", "knowledge_content": "Điều chỉnh độ rộng cột và độ cao hàng bằng cách đưa con trỏ chuột vào vạch giữa tên cột hoặc hàng rồi kéo thả chuột. Định dạng chữ in đậm, màu chữ, cỡ chữ, căn lề dữ liệu trong ô."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "knowledge_name": "2. Quản lý trang tính và tệp bảng tính", "knowledge_content": "Nháy đúp vào tên trang tính để đổi tên. Lưu lại bảng tính với lệnh File/Save hoặc tổ hợp phím Ctrl+S."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "knowledge_name": "Ký hiệu phép toán trong bảng tính", "knowledge_content": "Dữ liệu trong ô tính có thể thuộc kiểu văn bản, số, ngày tháng và công thức. Công thức luôn bắt đầu bằng dấu '=', sau đó là biểu thức toán học. Các ký hiệu phép toán trong phần mềm bảng tính gồm: Phép cộng (+), Phép trừ (-), Phép nhân (*), Phép chia (/), Phép lũy thừa (a^x)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "knowledge_name": "2. Công thức trong bảng tính", "knowledge_content": "Khi nhập công thức vào ô tính, nếu tính toán với giá trị từ các ô dữ liệu khác thì trong công thức cần ghi địa chỉ của ô dữ liệu tương ứng. Phần mềm bảng tính sẽ tự động tính toán và cập nhật kết quả nếu có thay đổi giá trị ở các ô địa chỉ."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "3. Sao chép ô tính chứa công thức", "knowledge_content": "Khi sao chép ô tính hoặc vùng có chứa công thức, các công thức sẽ được sao chép và chức năng tính toán tự động được bảo toàn. Địa chỉ ô trong công thức sẽ tự động thay đổi tương ứng với vị trí mới của ô tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "knowledge_name": "Cấu trúc và cách sử dụng hàm", "knowledge_content": "Mỗi hàm trong bảng tính sẽ được xác định bởi: Tên của hàm (ví dụ SUM) và Ý nghĩa hàm (ví dụ tính tổng). Các tham số của hàm có thể là dãy bao gồm các số, địa chỉ ô, địa chỉ vùng dữ liệu được viết cách nhau bởi dấu ',' hoặc ';'. Cách sử dụng hàm: =<tên hàm>(<các tham số>)"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "knowledge_name": "Cú pháp và cách nhập hàm", "knowledge_content": "Cách nhập hàm tương tự như cách nhập công thức. Cú pháp nhập hàm: =<tên hàm>(<các tham số>). Cần nhập chính xác tên của hàm và các tham số của hàm. Khi nhập thông tin vùng dữ liệu trong tham số của hàm có thể dùng chuột chọn các ô hoặc vùng này. Tên hàm có thể dùng chữ in hoa hoặc in thường."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "knowledge_name": "2. Một số hàm tính toán đơn giản", "knowledge_content": "Sử dụng các hàm SUM (tính tổng), AVERAGE (tính trung bình cộng), MIN (tìm giá trị nhỏ nhất), MAX (tìm giá trị lớn nhất), COUNT (đếm) để thực hiện các yêu cầu tính toán trong bảng tính. Lưu ý, tất cả các hàm này đều có cú pháp sử dụng tương tự như hàm SUM đã biết."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "knowledge_name": "Cú pháp một số hàm thông dụng trong bảng tính", "knowledge_content": "Phần mềm bảng tính cung cấp nhiều hàm thông dụng để tính toán dữ liệu: hàm SUM (tính tổng các giá trị số), hàm AVERAGE (tính trung bình cộng), hàm MIN (tìm giá trị nhỏ nhất), hàm MAX (tìm giá trị lớn nhất), hàm COUNT (đếm số các giá trị là số). Lưu ý: Tất cả các hàm trên đều chỉ xử lí các ô có dữ liệu số trong tham số của hàm, bỏ qua các ô chứa văn bản hoặc ô trống. Các phần mềm bảng tính thường dùng dấu chấm '.' để ngăn cách phần nguyên và phần thập phân, dùng dấu phẩy ',' để ngăn cách các chữ số hàng nghìn, hàng triệu,..."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "knowledge_name": "1. Nhập và sao chép dữ liệu", "knowledge_content": "Thao tác nhập dữ liệu vào các ô tính và sao chép vùng dữ liệu giữa các trang tính khác nhau nhằm phục vụ cho dự án tính toán."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "knowledge_name": "2. Sử dụng hàm tính toán trong bảng tính", "knowledge_content": "Sử dụng hàm SUM để tính tổng giá trị của một vùng dữ liệu và hàm AVERAGE để tính giá trị trung bình cộng. Kết hợp chèn thêm hàng trống để sắp xếp và tổ chức bố cục dữ liệu hợp lý."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "knowledge_name": "e) Định dạng dữ liệu cho trang tính", "knowledge_content": "- Định dạng chữ in đậm cho tiêu đề bảng.\n- Hàng tiêu đề (hàng 3) định dạng chữ in đậm và có nền màu vàng.\n- Định dạng chữ in đậm cho tất cả các ô chứa dữ liệu tổng hợp để làm nổi bật.\n- Lưu lại kết quả."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "1. Định dạng dữ liệu số", "knowledge_content": "Dữ liệu số trong bảng tính được hiểu là các số nguyên hoặc số thập phân (là số có phần số nguyên và phần thập phân). Tất cả các phần mềm bảng tính đều cho phép thiết lập cách định dạng thể hiện các số này. Ví dụ chỉ cho phép hiện bao nhiêu chữ số thập phân, hoặc quy định dùng dấu ',' phân tách hàng nghìn, hàng triệu,... Để thực hiện định dạng các số tại một ô hoặc vùng dữ liệu, em cần chọn vùng dữ liệu và chọn Home, nháy chuột vào mũi tên bên cạnh nhóm lệnh Number để mở cửa sổ Format Cells. Sau đó em nhập các tham số định dạng kiểu dữ liệu số thực trong cửa sổ Format Cells."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "b) Định dạng dữ liệu kiểu phần trăm", "knowledge_content": "Khi nói đến tỉ lệ phần trăm chúng ta hiểu là tỉ lệ giữa hai giá trị, ví dụ dự a/b. Muốn mô tả tỉ lệ này thành các số phần trăm, chúng ta sẽ tính (a/b) × 100(%). Phần mềm bảng tính có lệnh để hiển thị các giá trị (là tỉ lệ giữa hai số a, b nào đó) để giá trị này thể hiện trên bảng tính là số phần trăm. Thao tác định dạng dữ liệu kiểu phần trăm như sau: đánh dấu vùng dữ liệu, trong cửa sổ Format Cells, chọn Number, chọn kiểu Percentage, nháy chuột chọn OK."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "c) Định dạng dữ liệu ngày tháng", "knowledge_content": "Chúng ta đã biết các phần mềm bảng tính cho phép nhập dữ liệu ngày tháng theo khuôn dạng: mm/dd/yyyy, tức là nhập tháng, sau đó nhập ngày, sau đó là năm, các số cách nhau bởi dấu \"/\" hoặc \"-\". Mặc định dữ liệu ngày tháng cũng thể hiện trên màn hình dưới dạng \"mm/dd/yyyy\". Muốn thay đổi lại cách thể hiện ngày tháng, em thực hiện như sau: đánh dấu vùng dữ liệu, trong cửa sổ Format Cells em thực hiện các bước như Hình 9.5. Lưu ý: Việc chỉnh sửa chỉ thay đổi cách hiển thị, còn việc nhập dữ liệu vẫn cần tuân theo thứ tự mặc định của phần mềm."}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "knowledge_name": "Định dạng dữ liệu ngày tháng", "knowledge_content": "Dữ liệu ngày tháng có thể thực hiện các phép cộng với số nguyên (mỗi số nguyên được tính là một ngày) và phép trừ hai dữ liệu ngày tháng. Có thể định dạng dữ liệu số theo các kiểu khác nhau như xác định số chữ số thập phân, phân tách hàng nghìn, hàng triệu,..., định dạng theo kiểu phần trăm và định dạng dữ liệu ngày tháng của Việt Nam (dd/mm/yyyy)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "a) Các lệnh chèn, xoá, ẩn, hiện hàng và cột", "knowledge_content": "- Xoá hàng, cột: Nháy chuột vào tên của cột hoặc hàng để chọn cột hoặc hàng muốn xoá. Nháy nút phải chuột vào chỗ chọn, chọn Delete. Có thể chọn nhiều hàng (cột) để xoá đồng thời.\n- Chèn thêm một hàng, cột mới: Chọn hàng (dưới hàng muốn chèn) hoặc cột (bên phải cột muốn chèn). Nháy nút phải chuột vào chỗ chọn, chọn lệnh Insert.\n- Làm ẩn, hiện hàng hoặc cột: Trong khi làm việc, một số hàng hoặc cột của bảng tính có thể ẩn đi với mục đích làm gọn bảng tính, dễ quan sát. Khi cần em có thể hiển thị lại các hàng, cột đã ẩn bất cứ lúc nào. Muốn ẩn hàng hoặc cột, em chọn hàng hoặc cột, nháy nút phải chuột vào chỗ chọn và chọn Hide. Muốn hiển thị lại, em chọn các hàng, cột xung quanh vị trí hàng, cột bị ẩn đi, nháy nút phải chuột và chọn Unhide."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "b) Lệnh gộp các ô của một vùng dữ liệu", "knowledge_content": "Đánh dấu vùng dữ liệu (các ô muốn gộp), chọn Home/Alignment/Merge & Center.\nLưu ý: Sau khi gộp, ô kết quả sẽ có địa chỉ là ô đầu tiên bên trái của vùng đã gộp và lưu kết quả của ô này. Dữ liệu trong các ô khác sẽ bị xoá khi gộp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "3. Tính chất của các hàm trên bảng tính", "knowledge_content": "Các hàm tính toán của bảng tính điện tử như SUM, AVERAGE, COUNT, MIN, MAX sẽ chỉ tính toán trên các ô chứa dữ liệu số và bỏ qua các ô chứa dữ liệu dạng văn bản hoặc ô trống. Tính chất đặc biệt này giúp cho bảng dữ liệu theo dõi quá trình thực hiện dự án như Hình 9.12 sẽ luôn cho kết quả đúng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "c) Tính chi phí trồng mỗi loại cây và của toàn bộ dự án", "knowledge_content": "Cách thực hiện chèn thêm cột Đơn giá và Chi phí trong trang tính Excel. Nhập công thức tính toán Chi phí = Đơn giá × Tổng số cây. Sao chép công thức hoặc nhập trực tiếp công thức tới các ô tương ứng để tính tổng chi phí cho từng loại cây và toàn bộ dự án tại các ô N9, N17, N24, N25."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "knowledge_name": "d) Định dạng dữ liệu cho trang tính", "knowledge_content": "Thực hiện định dạng trang tính theo mẫu trực quan nhằm nâng cao tính thẩm mỹ và dễ đọc cho dữ liệu bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "1. Các thao tác hoàn thiện bảng tính - a) Các thao tác với trang tính", "knowledge_content": "Mỗi bảng tính bao gồm nhiều trang tính. Vị trí phía dưới của bảng tính là nơi hiện danh sách các trang tính.\n- Tạo trang tính mới: Nháy chuột vào biểu tượng dấu cộng (+) để tạo trang tính mới.\n- Xoá một trang tính: Nháy nút phải chuột vào tên trang tính rồi chọn Delete.\n- Chèn trang tính mới trước trang tính A: Nháy nút phải chuột vào tên trang tính A, chọn Insert/Worksheet rồi chọn OK.\n- Đổi tên trang tính: Nháy đúp chuột vào tên trang tính, nhập tên mới, nhấn phím Enter."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "Sao chép và di chuyển trang tính", "knowledge_content": "Để sao chép một trang tính sang vị trí mới: Nháy nút phải chuột vào tên trang tính và chọn lệnh Move or Copy... Cửa sổ Move or Copy xuất hiện, sau đó chọn vị trí muốn sao chép đến hoặc chọn 'move to end' để sao chép đến trang tính cuối cùng, tích chọn hoặc bỏ chọn 'Create a copy' và nhấn OK."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "b) Kẻ đường viền ô và khung bao quanh vùng dữ liệu", "knowledge_content": "Trên màn hình máy tính mỗi trang tính là một lưới các ô nhưng mặc định khi in dữ liệu thì các đường lưới không được in ra. Vì vậy, trước khi in dữ liệu của bảng tính em cần kẻ đường viền ô và khung bao quanh vùng dữ liệu nếu cần. Chọn vùng dữ liệu muốn kẻ đường viền ô, kẻ khung và chọn Format Cells. Trong cửa sổ Format Cells chọn trang Border, thiết lập các thông số kẻ đường viền, kẻ khung."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "Em cần nhớ", "knowledge_content": "Người sử dụng có thể thực hiện các thao tác đa dạng trên trang tính của bảng tính: đổi tên, tạo mới, chèn, sao chép, di chuyển hoặc xoá một trang tính. Nên kẻ khung các vùng dữ liệu trước khi tiến hành in hoặc trình bày dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "2. In dữ liệu trong bảng tính", "knowledge_content": "Có thể in trang tính hiện thời, hoặc toàn bộ bảng tính, hoặc có thể chỉ in vùng dữ liệu đang chọn, phần mềm sẽ tự động tính toán để in. Các bước in dữ liệu gồm: Bước 1. Đánh dấu vùng dữ liệu muốn in. Bước 2. Thực hiện lệnh File/Print để xuất hiện hộp thoại Print, nhập các thông số in trước khi chọn Print để in. Bước 3. Sau khi nhập các thông số in, nháy chuột lên nút lệnh Print để tiến hành in."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "b) Định dạng dữ liệu và trình bày trang tính", "knowledge_content": "- Thiết lập định dạng dữ liệu cho hai cột Trung bình và Chi phí như sau:\n+ Cột dữ liệu Trung bình: Thiết lập định dạng là số có hai chữ số thập phân.\n+ Cột dữ liệu Chi phí: Thiết lập định dạng là số không có chữ số thập phân (số chữ số thập phân bằng 0) và thiết lập chế độ hiển thị phân tách hàng nghìn, hàng triệu,...\n- Tại cột Loại cây (cột B) em gộp các ô cùng nhóm theo loại cây hoa, cây ăn quả, cây bóng mát.\n- Căn giữa cho dữ liệu trong các ô đã gộp theo cả chiều dọc và chiều ngang.\n- Tô màu nền cho các ô dữ liệu theo từng loại cây."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "knowledge_name": "c) Kẻ đường viền, kẻ khung", "knowledge_content": "- Đánh dấu toàn bộ vùng dữ liệu chính của trang tính (vùng A3:N25).\n- Kẻ đường viền cho các ô và kẻ khung cho vùng dữ liệu.\n- Thực hiện các thao tác căn chỉnh một lần nữa các cột và hàng của trang tính một cách thích hợp, có thể theo mẫu như Hình 10.6.\n- Lưu tệp.\nCông việc tính toán dữ liệu dự án đã hoàn thành. Em có thể in toàn bộ trang tính này hoặc sao chép dữ liệu sang phần mềm trình chiếu để trình bày trước lớp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "knowledge_name": "Nhiệm vụ tạo bài trình chiếu", "knowledge_content": "Tạo bài trình chiếu báo cáo kết quả thực hiện dự án Trường học xanh của nhóm. Bài trình chiếu có trang tiêu đề, các trang nội dung có tiêu đề trang, sử dụng cấu trúc phân cấp và lưu tệp với tên Truonghocxanh.pptx."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "knowledge_name": "Các bước tạo bài trình chiếu", "knowledge_content": "Sử dụng phần mềm trình chiếu Microsoft PowerPoint phiên bản 2016. Bước 1: Khởi động PowerPoint, phần mềm tự động tạo một bài trình chiếu mới với trang đầu tiên là trang tiêu đề (nhập tiêu đề, tên bài trình chiếu và phụ đề). Bước 2: Tạo các trang nội dung bằng cách nháy chuột vào New Slide để tạo trang mới, nháy chuột vào Layout để chọn mẫu bố trí cho trang, nhập tiêu đề của trang và nhập nội dung."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "knowledge_name": "b) Tạo cấu trúc phân cấp", "knowledge_content": "Để tạo cấu trúc phân cấp, thực hiện các bước sau:\nBước 1. Đặt con trỏ soạn thảo ở đầu dòng cần tạo cấu trúc phân cấp (nếu muốn tạo cấu trúc phân cấp giống nhau cho nhiều dòng, em chọn đồng thời các dòng đó).\nBước 2. Chọn lệnh Increase List Level (hoặc nhấn phím Tab) để tăng bậc phân cấp; Chọn lệnh Decrease List Level (hoặc nhấn tổ hợp phím Shift + Tab) để giảm bậc phân cấp.\nCác dòng được tăng cấp sẽ tự động dịch chuyển sang phải một khoảng và giảm cỡ chữ. Các dòng được giảm cấp sẽ tự động dịch chuyển sang trái một khoảng và tăng cỡ chữ."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "knowledge_name": "Thay đổi màu sắc, kí hiệu đầu dòng", "knowledge_content": "Phần mềm trình chiếu có sẵn các kí hiệu đầu dòng. Để thay đổi màu sắc, chọn kí hiệu đầu dòng tuỳ ý hoặc chuyển kí hiệu đầu dòng thành số thứ tự: Bước 1. Đặt con trỏ soạn thảo ở đầu dòng cần thay đổi kí hiệu. Bước 2. Chọn Home, nháy chuột vào mũi tên bên phải lệnh Bullets hoặc Numbering, chọn Bullets and Numbering... để mở hộp thoại Bullets and Numbering. Trong hộp thoại, chọn Bulleted để thay đổi kí hiệu, chọn Numbered để đánh số thứ tự, chọn Color để đổi màu cho kí hiệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "knowledge_name": "Lưu bài trình chiếu", "knowledge_content": "Lưu bài trình chiếu với tên tệp cụ thể (ví dụ: Truonghocxanh.pptx hoặc Baitaptinhoc7.pptx) để lưu lại các thay đổi và kết quả làm việc."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "1. Ảnh minh hoạ", "knowledge_content": "Hình ảnh là dạng thông tin trực quan và dễ gây ấn tượng nhất. Sử dụng hình ảnh minh hoạ cho nội dung trình bày sẽ giúp cho bài trình chiếu hấp dẫn và sinh động, thu hút sự chú ý của người nghe. Khi lựa chọn hình ảnh nên căn cứ vào hai yếu tố quan trọng sau: phù hợp với nội dung; có tính thẩm mĩ. Sẽ ấn tượng hơn nếu các hình ảnh trong trang chiếu có kích thước và vị trí hợp lí, kết hợp với nội dung thành một tổng thể hài hoà."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "2. Định dạng văn bản", "knowledge_content": "Các phần mềm trình chiếu đều có các công cụ định dạng văn bản giúp cho người sử dụng định dạng phông chữ, cỡ chữ, kiểu chữ, màu chữ, căn lề,... Cách sử dụng các công cụ định dạng văn bản của phần mềm trình chiếu tương tự như của phần mềm soạn thảo văn bản mà em đã học ở lớp 6. Để tạo được bài trình bày hiệu quả và chuyên nghiệp em cần chú ý: Phông chữ: Nên chọn phông đơn giản, dễ đọc (ví dụ: Arial, Calibri, Tahoma,...); Không nên sử dụng quá nhiều phông chữ trên một trang. Cỡ chữ: Tiêu đề nên dùng cỡ từ 40 đến 50, văn bản nên dùng cỡ từ 18 trở lên, tuỳ phông chữ. Kiểu chữ: Tiêu đề nên chọn kiểu chữ đậm, nội dung chọn kiểu chữ thường. Màu chữ: Màu chữ cần tương phản với màu nền của trang, không sử dụng quá nhiều màu chữ. Số lượng chữ trên trang: Không dùng quá nhiều chữ trên một trang. Mỗi trang chỉ nên có khoảng 5 đến 7 dòng. Nội dung trong mỗi trang chiếu chỉ nên tập trung vào một ý chính. Văn bản cần cô đọng, chọn lọc từ ngữ. Thông điệp chính hay những điều quan trọng nên được làm nổi bật và nhấn mạnh bằng cách dùng kiểu chữ đậm, màu,..."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "Sao chép dữ liệu từ tệp văn bản sang tệp trình chiếu", "knowledge_content": "Có thể sử dụng nội dung mô tả dự án đã lưu trong tệp văn bản (ví dụ Truonghocxanh.docx) để dùng cho bài trình chiếu nhằm đảm bảo thông tin thống nhất, chính xác và tiết kiệm thời gian soạn thảo.\nCác bước thực hiện:\nBước 1. Mở tệp văn bản.\nBước 2. Chọn phần dữ liệu cần sao chép rồi thực hiện lệnh Copy (chọn Home/Copy hoặc nhấn tổ hợp phím Ctrl + C).\nBước 3. Mở tệp trình chiếu.\nBước 4. Đặt con trỏ tại vị trí cần sao chép đến rồi thực hiện lệnh Paste (chọn Home/Paste hoặc nhấn tổ hợp phím Ctrl + V)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "b) Sử dụng các công cụ định dạng văn bản", "knowledge_content": "Các công cụ định dạng văn bản của phần mềm trình chiếu nằm trong thẻ Home. Sử dụng các công cụ định dạng văn bản, thêm kí hiệu đầu dòng,... để định dạng, đồng thời biên tập lại nội dung văn bản trong trang chiếu, chọn lọc từ ngữ, làm nổi bật ý chính,... để nội dung ngắn gọn, cô đọng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "c) Áp dụng các mẫu định dạng", "knowledge_content": "Phần mềm trình chiếu cung cấp nhiều mẫu định dạng (theme) được thiết kế sẵn trong nhóm Themes của thẻ Design giúp tạo các bài trình chiếu hấp dẫn, chuyên nghiệp và tiết kiệm thời gian. Khi di chuyển con trỏ chuột trên một mẫu, tên mẫu và kết quả áp dụng mẫu đó vào trang chiếu được thể hiện ngay trên màn hình."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "Lưu ý về chọn mẫu định dạng", "knowledge_content": "+ Nhấn giữ phím Ctrl để chọn đồng thời nhiều trang.\n+ Nếu không chọn trang thì mẫu sẽ được áp dụng cho tất cả các trang trong bài.\n+ Nháy chuột vào nút More trong nhóm Themes để xem thêm mẫu định dạng.\n+ Nháy chuột vào nút More trong nhóm Variants để thay đổi màu sắc, phông chữ, hiệu ứng, nền cho mẫu đã chọn.\n+ Nháy chuột vào nút Undo (hoặc nhấn tổ hợp phím Ctrl+Z) để khôi phục lại mẫu trước đó."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "d) Chèn hình ảnh vào trang chiếu", "knowledge_content": "Thao tác chèn hình ảnh vào trang chiếu tương tự như chèn hình ảnh vào tệp văn bản.\nCác bước thực hiện:\nBước 1. Chọn trang chiếu cần chèn hình ảnh.\nBước 2. Chọn Insert/Pictures để mở hộp thoại Insert Picture.\nBước 3. Chọn tệp ảnh, nháy chuột chọn nút Insert. Hình ảnh đã chọn được chèn vào trang chiếu.\nLưu ý: Em có thể chèn hình ảnh vào trang chiếu bằng cách sử dụng lệnh Copy và Paste."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "Sử dụng các công cụ định dạng cho hình ảnh", "knowledge_content": "Sau khi chèn hình ảnh vào trang chiếu, em có thể sử dụng các công cụ để: thay đổi vị trí và kích thước, thêm đường viền tạo khung, thay đổi lớp, cắt hình, quay hình,... Cách thay đổi lớp cho hình ảnh: Bước 1. Chọn hình ảnh. Bước 2. Chọn Format/Arrange/Send Backward (nếu muốn đưa hình ảnh lên lại lớp trên thì chọn Bring Forward). Cách thay đổi vị trí cho hình ảnh: Dùng chuột chọn hình ảnh, kéo thả đến vị trí mới. Cách thay đổi kích thước hình ảnh: Thực hiện kéo thả các nút điều khiển trên khung bao quanh hình ảnh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "knowledge_name": "1. Thêm đường viền cho hình ảnh", "knowledge_content": "Cách thực hiện thêm đường viền cho hình ảnh:\nBước 1. Chọn hình ảnh.\nBước 2. Chọn Format/Picture Styles/Picture Border rồi chọn màu đường viền, kiểu đường viền.\nEm có thể đặt nền màu xanh cho trang chiếu, đổi màu cho văn bản để được kết quả tương tự như Hình 12.10."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "knowledge_name": "1. Hiệu ứng động", "knowledge_content": "Hiệu ứng động trong bài trình chiếu là cách thức và thời điểm xuất hiện của các trang chiếu và các đối tượng trên trang chiếu (văn bản, hình ảnh, biểu đồ, âm thanh,...) khi trình chiếu. Có hai loại hiệu ứng động: Hiệu ứng cho các đối tượng trên trang chiếu, gọi là hiệu ứng cho đối tượng; Hiệu ứng cho các trang chiếu, gọi là hiệu ứng chuyển trang chiếu. Các phần mềm trình chiếu thường cung cấp nhiều hiệu ứng động cho đối tượng, những lựa chọn để điều khiển việc hiển thị đối tượng trên trang chiếu ở các mức độ khác nhau. Việc sử dụng hiệu ứng động giúp cho bài trình chiếu trở nên sinh động và hấp dẫn hơn, thu hút sự chú ý của người xem và tạo hiệu quả tốt trong việc truyền đạt thông tin. Tuy nhiên, việc sử dụng quá nhiều hoặc không phù hợp có thể gây hiệu ứng ngược, làm cho người nghe mất tập trung vào nội dung chính. Bởi vậy, cần cân nhắc sử dụng hiệu ứng cho hợp lí để tăng hiệu quả, hỗ trợ cho việc trình bày nội dung."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "knowledge_name": "Khái niệm hiệu ứng động", "knowledge_content": "Hiệu ứng động là cách thức và thời điểm xuất hiện của các trang chiếu và các đối tượng trên trang khi trình chiếu. Sử dụng hiệu ứng động giúp cho bài trình chiếu trở nên sinh động và hấp dẫn hơn, thu hút sự chú ý của người xem và tạo hiệu quả tốt trong việc truyền đạt thông tin. Hiệu ứng động nên được sử dụng một cách có chọn lọc để giúp tăng tính hiệu quả cho nội dung và tạo ấn tượng với người xem."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "knowledge_name": "b) Tạo hiệu ứng chuyển trang chiếu", "knowledge_content": "Các bước tạo hiệu ứng chuyển trang chiếu: 1. Chọn trang chiếu cần tạo hiệu ứng; 2. Chọn thẻ Transitions trên dải lệnh; 3. Chọn hiệu ứng chuyển trang; 4. Chọn âm thanh, thời lượng thực hiện hiệu ứng; 5. Xem trước hiệu ứng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "knowledge_name": "c) Sử dụng hiệu ứng hợp lí", "knowledge_content": "Trình bày càng đơn giản, rõ ràng thì càng thuyết phục. Dùng hiệu ứng chuyển trang thống nhất cho tất cả các trang. Chọn lọc hiệu ứng cho các đối tượng để bài thuyết trình hiệu quả hơn. Chỉ dùng âm thanh khi thật cần thiết."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "knowledge_name": "d) Hoàn thiện bài trình chiếu", "knowledge_content": "Xem lại bố cục, nội dung của bài báo cáo. Bố trí lại các đối tượng trên trang: khung văn bản, hình ảnh, bảng biểu,... Định dạng lại một số hình ảnh, căn lề văn bản (nếu cần). Sáng tạo thêm, phát huy khả năng hội hoạ trong cách trình bày bài báo cáo. Lưu lại kết quả làm việc."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "knowledge_name": "Thuật toán tìm kiếm tuần tự", "knowledge_content": "Trong cuộc sống, chúng ta thường xuyên phải tìm kiếm dữ liệu để biết về đối tượng trong hàng chục, hàng trăm, hàng nghìn, thậm chí hàng triệu nội dung liên quan đến nó. Thuật toán tìm kiếm giúp chúng ta tìm được dữ liệu cần thiết để có được thông tin ta cần một cách hiệu quả.\nTrong tình huống khởi động, công việc mà An cần làm có thể nêu thành bài toán tìm kiếm như sau:\n- Đầu vào: danh sách khách hàng; họ tên khách hàng cần tìm.\n- Đầu ra: địa chỉ của khách hàng cần tìm.\nAn thực hiện tìm kiếm lần lượt từ đầu đến cuối danh sách khách hàng. Cách tìm kiếm này gọi là tìm kiếm tuần tự. Với mỗi họ tên khách hàng trong danh sách, An kiểm tra xem có đúng họ tên khách hàng mà mẹ yêu cầu không, nếu đúng thì ghi ra địa chỉ và kết thúc công việc, còn không thì chuyển đến họ tên khách hàng tiếp theo. Nếu tìm hết danh sách mà vẫn không thấy thì thông báo là không tìm thấy và kết thúc. Như vậy, chừng nào chưa tìm thấy và chưa tìm hết thì còn tìm tiếp. Đây chính là cấu trúc lặp. Hai điều kiện cần kiểm tra để dừng vòng lặp là:\n- Điều kiện thứ nhất: kiểm tra họ tên khách hàng có đúng là họ tên cần tìm không.\n- Điều kiện thứ hai: kiểm tra đã hết danh sách chưa.\nCác bước thực hiện tìm kiếm địa chỉ khách hàng của An được mô tả ở sơ đồ khối trong Hình 14.1."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "Mô tả thuật toán tìm kiếm tuần tự bằng ngôn ngữ tự nhiên", "knowledge_content": "Bước 1. Xét vị trí đầu tiên của danh sách.\nBước 2. Nếu giá trị của phần tử ở vị trí đang xét bằng giá trị cần tìm thì chuyển sang Bước 4, nếu không thì chuyển đến vị trí tiếp theo.\nBước 3. Kiểm tra đã hết danh sách chưa. Nếu đã hết danh sách thì chuyển sang Bước 5, nếu chưa thì lặp lại từ Bước 2.\nBước 4. Trả lời \"Tìm thấy\" và chỉ ra vị trí phần tử tìm được; Kết thúc.\nBước 5. Trả lời \"Không tìm thấy\"; Kết thúc."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "knowledge_name": "Ghi nhớ thuật toán tìm kiếm tuần tự", "knowledge_content": "Thuật toán tìm kiếm tuần tự thực hiện tìm lần lượt từ đầu đến cuối danh sách, chừng nào chưa tìm thấy và chưa tìm hết thì còn tìm tiếp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "1. Thuật toán tìm kiếm nhị phân", "knowledge_content": "Khi danh sách khách hàng ngày càng nhiều, để thuận lợi cho việc tìm kiếm, danh sách cần được sắp xếp theo thứ tự (ví dụ: thứ tự chữ cái). Thuật toán tìm kiếm nhị phân thực hiện so sánh giá trị cần tìm với giá trị ở vị trí giữa của danh sách. Nếu bằng thì tìm thấy và dừng lại, nếu lớn hơn thì chỉ tìm ở nửa sau của danh sách, nếu nhỏ hơn thì tìm ở nửa đầu của danh sách. Lặp lại quá trình đó cho đến khi tìm thấy hoặc hết danh sách. Tại mỗi bước lặp, thuật toán tìm kiếm thu hẹp danh sách tìm kiếm chỉ còn một nửa, do đó có tên là tìm kiếm nhị phân (chia đôi)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "Minh họa thuật toán tìm kiếm nhị phân", "knowledge_content": "Các bước để An tìm khách hàng tên \"Trúc\" trong danh sách ở Hình 15.1 theo thuật toán tìm kiếm nhị phân: Bước 1. Xét vị trí ở giữa của dãy, đó là vị trí số 5 (giá trị là \"Mai\"). So sánh \"Trúc\" và \"Mai\". Vì \"T\" đứng sau \"M\" trong bảng chữ cái nên bỏ đi nửa đầu danh sách. Bước 2. Xét vị trí ở giữa của nửa sau của dãy là vị trí số 7 (giá trị là \"Trang\"). So sánh \"Trúc\" và \"Trang\". Vì \"Tru\" đứng sau \"Tra\" trong bảng chữ cái nên bỏ đi nửa đầu danh sách. Bước 3. Xét vị trí ở giữa của nửa sau còn lại của dãy, đó là vị trí số 8 (giá trị là \"Trúc\"). So sánh \"Trúc\" và \"Trúc\". Vì hai giá trị bằng nhau nên thuật toán kết thúc. Vì sau bước 3 đã tìm thấy tên khách hàng nên thuật toán kết thúc."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "Mô tả thuật toán tìm kiếm nhị phân bằng ngôn ngữ tự nhiên", "knowledge_content": "Giả sử danh sách (dãy) đã được sắp xếp theo thứ tự từ nhỏ đến lớn và gọi vùng tìm kiếm là đoạn danh sách mà thuật toán tìm kiếm trên đó. Ban đầu, vùng tìm kiếm là toàn bộ danh sách.\nBước 1. Nếu vùng tìm kiếm không có phần tử nào thì kết luận không tìm thấy và thuật toán kết thúc.\nBước 2. Xác định vị trí giữa của vùng tìm kiếm. Vị trí này chia vùng tìm kiếm thành hai nửa: nửa trước và nửa sau vị trí giữa.\nBước 3. Nếu giá trị cần tìm bằng giá trị của vị trí giữa thì kết luận \"giá trị cần tìm xuất hiện tại vị trí nào\" và kết thúc.\nBước 4. Nếu giá trị cần tìm nhỏ hơn giá trị của vị trí giữa thì vùng tìm kiếm mới được thu hẹp lại, chỉ còn nửa trước của dãy. Ngược lại (nếu giá trị cần tìm lớn hơn giá trị của vị trí giữa) vùng tìm kiếm mới được thu hẹp lại, chỉ còn nửa sau của dãy.\nBước 5. Lặp lại từ Bước 1 đến Bước 4 cho đến khi tìm thấy giá trị cần tìm (Bước 3) hoặc vùng tìm kiếm không còn phần tử nào (Bước 1).\nLưu ý: \"nửa trước\" và \"nửa sau\" không gồm phần tử giữa. Vị trí giữa của vùng tìm kiếm bằng phần nguyên của (vị trí đầu + vị trí cuối)/2. Trong trường hợp so sánh kí tự thì kí tự đứng trước là \"nhỏ hơn\" kí tự đứng sau trong bảng chữ cái."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "Thuật toán tìm kiếm nhị phân (Tóm tắt)", "knowledge_content": "• Thực hiện trên danh sách đã được sắp xếp theo thứ tự từ nhỏ đến lớn. Bắt đầu từ vị trí ở giữa danh sách.\n• Tại mỗi bước lặp, so sánh giá trị cần tìm với giá trị của vị trí giữa danh sách, nếu bằng thì dừng lại, nếu nhỏ hơn thì tìm trong nửa trước của danh sách, nếu lớn hơn thì tìm trong nửa sau của danh sách.\n• Chừng nào chưa tìm thấy và vùng tìm kiếm còn phần tử thì còn tìm tiếp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "2. Sắp xếp và tìm kiếm", "knowledge_content": "Trong ví dụ ở mục 1, khách hàng tên \"Trúc\" được tìm thấy sau 3 bước lặp thực hiện theo thuật toán tìm kiếm nhị phân, trong khi thuật toán tìm kiếm tuần tự phải thực hiện 8 bước lặp. Xét trường hợp có một khách hàng nào đó mà mẹ bạn An quên chưa ghi vào sổ, do đó tên khách hàng không có trong danh sách ở Hình 15.1. Khi phải tìm kiếm tên khách hàng này, thuật toán tìm kiếm tuần tự..."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "Ưu điểm của thuật toán tìm kiếm nhị phân", "knowledge_content": "Thuật toán tìm kiếm nhị phân thực hiện tìm kiếm nhanh hơn thuật toán tìm kiếm tuần tự. Có được ưu điểm này là do trước khi thực hiện tìm kiếm nhị phân, danh sách cần tìm đã được sắp xếp. Nhờ việc danh sách đã được sắp xếp, tại mỗi bước lặp, thuật toán tìm kiếm nhị phân thu hẹp được phạm vi tìm kiếm chỉ còn một nửa."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "knowledge_name": "Ghi nhớ", "knowledge_content": "Sắp xếp giúp cho việc tìm kiếm được thực hiện nhanh hơn."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "knowledge_name": "1. Thuật toán sắp xếp nổi bọt", "knowledge_content": "Trong cuộc sống hằng ngày và tin học, sắp xếp giúp cho việc tìm kiếm được thực hiện dễ dàng. Có nhiều thuật toán sắp xếp khác nhau, một trong số đó là thuật toán sắp xếp nổi bọt. Giả sử ta cần phải sắp xếp dãy các số 4, 2, 3, 1 để thu được dãy có thứ tự tăng dần. Thuật toán sắp xếp nổi bọt xét từng vị trí từ đầu đến cuối dãy. Tại mỗi vị trí được xét, thuật toán tìm phần tử nhỏ nhất trong những phần tử phía sau để đưa vào vị trí đó. Việc này được thực hiện bằng một vòng lặp, so sánh từng cặp phần tử cạnh nhau và hoán đổi nếu số ở phía sau nhỏ hơn. Các bước thực hiện được mô tả trong Hình 16.2, Hình 16.3, Hình 16.4. Việc hoán đổi được thực hiện giống như việc hoán đổi ở Hoạt động khởi động."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "knowledge_name": "Mô tả thuật toán sắp xếp nổi bọt", "knowledge_content": "Sau vòng lặp thứ ba, không có bất kì sự hoán đổi nào được thực hiện nữa nên thuật toán dừng lại. Danh sách được sắp xếp theo đúng thứ tự yêu cầu.\nMô tả thuật toán sắp xếp nổi bọt bằng ngôn ngữ tự nhiên:\nSắp xếp dãy số theo thứ tự tăng dần bằng thuật toán sắp xếp nổi bọt.\n1. Với vị trí đầu tiên, em thực hiện một vòng lặp như sau:\n1.1. So sánh hai phần tử đứng cạnh nhau theo thứ tự từ cuối dãy lên vị trí đầu tiên.\n1.2. Nếu phần tử đứng sau nhỏ hơn phần tử đứng trước thì đổi chỗ chúng cho nhau.\n1.3. Cuối vòng lặp em sẽ nhận được dãy số với phần tử nhỏ nhất nổi lên vị trí đầu tiên.\n2. Với vị trí thứ hai, em thực hiện một vòng lặp tương tự như trên.\n2.1. So sánh hai phần tử đứng cạnh nhau theo thứ tự từ cuối dãy lên vị trí thứ hai.\n2.2. Nếu phần tử đứng sau nhỏ hơn phần tử đứng trước thì đổi chỗ chúng cho nhau.\n2.3. Cuối vòng lặp em sẽ nhận được dãy số với phần tử nhỏ thứ nhì nổi lên vị trí thứ hai.\n3. Tương tự như trên với các vị trí thứ ba, thứ tư,... đến vị trí trước vị trí cuối cùng.\n4. Kết thúc, em sẽ nhận được dãy số đã được sắp xếp theo thứ tự từ nhỏ đến lớn."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "knowledge_name": "Sắp xếp nổi bọt", "knowledge_content": "Nổi bọt là thuật toán sắp xếp được thực hiện bằng cách hoán đổi nhiều lần các phần tử liền kề nếu giá trị của chúng không đúng thứ tự."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "knowledge_name": "2. Thuật toán sắp xếp chọn", "knowledge_content": "Một thuật toán sắp xếp khác có tên là sắp xếp chọn. Thuật toán sắp xếp chọn xét từng vị trí và đưa phần tử nhỏ nhất trong những phần tử phía sau vào vị trí đó. Dưới đây mô tả một phương án của thuật toán sắp xếp chọn, trong đó việc tìm phần tử nhỏ nhất được thực hiện bằng cách so sánh trực tiếp phần tử ở vị trí được xét với những phần tử ở phía sau nó và hoán đổi nếu phần tử phía sau nhỏ hơn. Các bước thực hiện được minh hoạ trong Hình 16.5."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "knowledge_name": "Mô tả thuật toán sắp xếp chọn bằng ngôn ngữ tự nhiên", "knowledge_content": "Sắp xếp dãy số theo thứ tự từ nhỏ đến lớn bằng thuật toán sắp xếp chọn:\n1. Với vị trí đầu tiên, em thực hiện một vòng lặp như sau:\n1.1. So sánh từng phần tử (kể từ vị trí thứ hai đến vị trí cuối cùng) với phần tử tại vị trí đầu tiên.\n1.2. Nếu phần tử được xét nhỏ hơn phần tử tại vị trí đầu tiên thì hoán đổi nó với phần tử tại vị trí đầu tiên.\n1.3. Cuối vòng lặp, em sẽ nhận được dãy số với phần tử nhỏ nhất được đưa về vị trí đầu tiên.\n2. Với vị trí thứ hai, em thực hiện một vòng lặp tương tự như trên.\n2.1. So sánh từng phần tử (kể từ vị trí thứ ba đến vị trí cuối cùng) với phần tử tại vị trí thứ hai.\n2.2. Nếu phần tử được xét nhỏ hơn phần tử tại vị trí thứ hai thì hoán đổi nó với phần tử tại vị trí thứ hai.\n2.3. Cuối vòng lặp, em sẽ nhận được dãy số với phần tử nhỏ thứ nhì được đưa về vị trí thứ hai.\n3. Tương tự như trên với các vị trí thứ ba, thứ tư,... đến vị trí trước vị trí cuối cùng.\n4. Kết thúc, em sẽ nhận được dãy số đã được sắp xếp theo thứ tự từ nhỏ đến lớn."}, {"grade_level": "Lớp 8", "lesson_id": "Bìa sách", "knowledge_name": "Thông tin sách giáo khoa Tin học 8", "knowledge_content": "Sách Tin học 8, thuộc bộ sách Kết nối tri thức với cuộc sống. Tác giả: Nguyễn Chí Công (Tổng Chủ biên), Hà Đặng Cao Tùng (Chủ biên), Phan Anh - Nguyễn Hải Châu, Hoàng Thị Mai - Nguyễn Thị Hoài Nam. Nhà xuất bản Giáo dục Việt Nam."}, {"grade_level": "Lớp 8", "lesson_id": "HD01", "knowledge_name": "Cấu trúc sách giáo khoa Tin học", "knowledge_content": "Sách giáo khoa Tin học gồm 6 chủ đề với 20 bài học. Trong đó, chủ đề Tin học ứng dụng có hai chủ đề con để lựa chọn là Soạn thảo văn bản và trình chiếu nâng cao (Bài 8a đến Bài 11a) và Làm quen với phần mềm chỉnh sửa ảnh (Bài 8b đến Bài 11b). Các bài học được xây dựng với cấu trúc thống nhất gồm: Mục tiêu, Khởi động, Nội dung bài học (Các hoạt động, Kiến thức mới, Hộp kiến thức, Câu hỏi), Luyện tập, và Vận dụng."}, {"grade_level": "Lớp 8", "lesson_id": "HD01", "knowledge_name": "Các phần mềm và nhân vật trong sách", "knowledge_content": "Sách sử dụng các phần mềm Microsoft Word, Microsoft Excel, Microsoft PowerPoint, phần mềm chỉnh sửa ảnh GIMP, ngôn ngữ lập trình trực quan Scratch để minh hoạ và hướng dẫn thực hành. Trong các đoạn hội thoại có ba nhân vật học sinh: An, Minh, Khoa đại diện cho ba mạch kiến thức: Học vấn số hoá phổ thông, Công nghệ thông tin và truyền thông, Khoa học máy tính."}, {"grade_level": "Lớp 8", "lesson_id": "Lời nói đầu", "knowledge_name": "Giới thiệu môn học Tin học 8", "knowledge_content": "Sách giáo khoa Tin học 8 tiếp nối các bài học của những năm học trước nhằm tiếp tục phát triển năng lực của học sinh trong lĩnh vực Tin học và rèn luyện các phẩm chất cần có để tham gia vào xã hội kĩ thuật số. Sách giới thiệu sự phát triển của công cụ tính toán, cách đánh giá và sử dụng thông tin, sử dụng công cụ xử lí dữ liệu dạng số, dạng văn bản, dạng hình ảnh để tạo và chia sẻ sản phẩm kĩ thuật số. Theo Chương trình GDPT 2018, Tin học 8 giúp học sinh viết các chương trình máy tính giải quyết bài toán hoặc tạo trò chơi đơn giản, nhận biết vai trò của máy tính trong việc nâng cao khả năng của con người và định hướng nghề nghiệp tương lai."}, {"grade_level": "Lớp 8", "lesson_id": "MỤC LỤC", "knowledge_name": "Cấu trúc sách SGK Tin học 9", "knowledge_content": "Sách bao gồm 6 chủ đề chính: Chủ đề 1 (Máy tính và cộng đồng), Chủ đề 2 (Tổ chức lưu trữ, tìm kiếm và trao đổi thông tin), Chủ đề 3 (Đạo đức, pháp luật và văn hoá trong môi trường số), Chủ đề 4 (Ứng dụng tin học), Chủ đề 5 (Giải quyết vấn đề với sự trợ giúp của máy tính), Chủ đề 6 (Hướng nghiệp với Tin học), cùng phần Bảng giải thích thuật ngữ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "Kiến trúc Von Neumann và phân chia các thế hệ máy tính", "knowledge_content": "Theo nguyên lí đó, máy tính cần được cấu tạo dựa trên kiến trúc Von Neumann, gồm bộ xử lí, bộ nhớ, các cổng kết nối với thiết bị vào – ra và đường truyền giữa các bộ phận đó như trong Hình 1.3. Trải qua nhiều giai đoạn, dựa trên những tiến bộ về công nghệ, máy tính điện tử có thể được phân chia thành năm thế hệ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "Thế hệ thứ nhất (1945 – 1955)", "knowledge_content": "Công nghệ đèn điện tử chân không đầu thế kỉ XX mau chóng thay thế rơ le điện cơ, đánh dấu kỉ nguyên đầu tiên của máy tính điện tử. Mỗi giây, chiếc ENIAC (Hình 1.4) có thể thực hiện 5000 phép tính cộng hoặc 350 phép tính nhân. Đặc điểm máy tính thế hệ đầu tiên: Thành phần điện tử chính: đèn điện tử chân không. Bộ nhớ chính: trống từ. Kích thước: rất lớn (thường chiếm một căn phòng). Thiết bị vào – ra: máy đọc và tạo thẻ đục lỗ. Ví dụ: Atanasoff-Berry Computer (ABC 1942), ENIAC (1943), EDVAC (1945),..."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "Thế hệ thứ hai (1955 – 1965)", "knowledge_content": "Bóng bán dẫn là một cải tiến lớn, tạo nên thế hệ máy tính mới, có kích thước nhỏ hơn thế hệ đầu tiên. Chúng cũng rẻ hơn, tiêu thụ ít điện năng hơn, đáng tin cậy hơn và chạy nhanh hơn so với các máy tính làm bằng đèn điện tử chân không. Máy tính thế hệ thứ hai nhanh hơn máy tính thế hệ trước hàng chục lần. Chẳng hạn, chiếc IBM 7090 có thể tính được 229 000 phép tính mỗi giây. Chiếc máy tính thế hệ thứ hai được đưa vào nước ta năm 1968 là MINSK 22 (Hình 1.5) được sản xuất tại nước cộng hoà Belarus vào khoảng năm 1965. Đặc điểm máy tính thế hệ thứ hai: Thành phần điện tử chính: bóng bán dẫn. Bộ nhớ: lõi từ, băng từ. Kích thước: lớn (bộ phận xử lí và tính toán lớn như những chiếc tủ). Thiết bị vào – ra: máy đọc và in băng đục lỗ, máy đọc và in băng từ. Ví dụ: IBM 7090 (1959), IBM 7094 (1962), UNIVAC 1107 (1960),..."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "Thế hệ thứ ba (1965 – 1974)", "knowledge_content": "Máy tính thế hệ thứ ba là máy tính được chế tạo dựa trên các mạch tích hợp (IC – Integrated Circuit). Công nghệ này làm giảm kích thước và tăng tốc độ tính toán của máy tính so với thế hệ thứ hai. Chẳng hạn, IBM System/360 Model 30 có thể thực hiện khoảng 1 triệu lệnh mỗi giây và quản lí được 8 MB bộ nhớ. Chiếc máy tính thế hệ thứ ba được đưa vào nước ta năm 1967 thuộc họ IBM System/360 (Hình 1.6)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "3. Máy tính thay đổi thế giới như thế nào?", "knowledge_content": "Máy tính đã thay đổi thế giới theo nhiều cách nhờ khả năng tiếp nhận mệnh lệnh bền bỉ, xử lí dữ liệu chính xác, với dung lượng lớn, tốc độ cao. Máy tính còn có thể tự thay đổi, trở nên thông minh hơn.\n- Trong lĩnh vực y tế: Đồng hồ thông minh theo dõi sức khỏe thường xuyên, phát hiện bất thường và tự động thông báo đến người thân, cơ sở y tế.\n- Trong lĩnh vực giáo dục: Internet và máy tính giúp học mọi nơi, mọi lúc, hỗ trợ giáo viên dạy học từ xa, giúp nhà khoa học và chuyên gia phổ biến kiến thức, kĩ năng hiệu quả.\n- Trong lĩnh vực kinh tế: Giao dịch tăng lên nhanh chóng trong môi trường kĩ thuật số, đa dạng hoá hình thức giao dịch, giúp nền kinh tế năng động và phát triển.\n- Trong lĩnh vực quốc phòng: Thiết bị bay thông minh hỗ trợ quan sát vùng trời, vùng biển, lãnh thổ với tính tự động cao, giúp quân đội bảo vệ Tổ quốc.\n- Trong lĩnh vực an toàn xã hội: Camera an ninh thu nhận thông tin ở nơi công cộng có thể phát hiện hành vi vi phạm pháp luật, mất an toàn xã hội, giúp cơ quan chức năng kịp thời xử lí.\nVì máy tính là công cụ hỗ trợ đắc lực trong hoạt động trí óc, con người cũng dần thay đổi hành vi để thích nghi với môi trường mới, góp phần tạo nên những chuyển biến mạnh mẽ trong mọi lĩnh vực."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "Em cần nhớ", "knowledge_content": "Thế giới đang biến đổi nhanh chóng và sâu sắc nhờ sự phát triển của công nghệ máy tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "knowledge_name": "1. Thông tin trong môi trường số - a) Thông tin số", "knowledge_content": "Thông tin được mã hoá thành dãy bit, được chuyển vào máy tính, điện thoại thông minh, máy tính bảng,... để có thể lan truyền, trao đổi trong môi trường kĩ thuật số còn được gọi ngắn gọn là thông tin số. Khác với bức ảnh trên giấy, bức ảnh số được tạo ra không tốn vật liệu và khi gửi cho người khác thì người gửi không bị mất đi bức ảnh đó."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "knowledge_name": "Đặc điểm của thông tin số", "knowledge_content": "Thông tin số có thể được truy cập từ xa thông qua kết nối Internet, dễ dàng nhân bản, chia sẻ và lan truyền tự động do nhiều thiết bị đồng bộ với nhau. Tuy nhiên, thông tin số khó bị xoá bỏ hoàn toàn. Thông tin số trong xã hội được lưu trữ với dung lượng rất lớn bởi nhiều cá nhân, tổ chức; dễ dàng được chỉnh sửa và lại tiếp tục lan truyền trên mạng với độ tin cậy rất khác nhau, phụ thuộc vào nguồn gốc và mục tiêu thông tin."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "knowledge_name": "Phân biệt ý kiến và sự kiện", "knowledge_content": "Ý kiến là quan điểm, không phải sự kiện. Các ý kiến cần được xem xét và có thể cũng thú vị nhưng độ tin cậy của chúng thấp hơn sự kiện vì mang nhiều cảm xúc và định kiến cá nhân. Chẳng hạn phát biểu: 'Tôi tin rằng việc đó đã xảy ra!' không có nghĩa rằng sự kiện được nói tới đã xảy ra trong thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "knowledge_name": "Kiểm tra chứng cứ của kết luận", "knowledge_content": "Những kết luận không có chứng cứ, cũng giống như những ý kiến mang tính chất cá nhân nên có độ tin cậy rất thấp. Chẳng hạn, sau khi xem một bộ phim, một người nhận xét: 'Tôi nghĩ đây là bộ phim hoạt hình hay nhất mọi thời đại'. Phát biểu này rõ ràng là quan điểm cá nhân và vì vậy cần được xử lí một cách thận trọng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "knowledge_name": "Đánh giá tính thời sự của thông tin", "knowledge_content": "Thời điểm công bố thông tin quan trọng vì nó quyết định thông tin đó còn ý nghĩa không hay đã trở nên lỗi thời. Chẳng hạn, nội dung những trang web đã lâu không được cập nhật thường có độ tin cậy thấp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "knowledge_name": "Ghi nhớ", "knowledge_content": "Thông tin đáng tin cậy giúp em đưa ra kết luận đúng, quyết định hành động đúng và giải quyết được các vấn đề được đặt ra. Một số cách xác định thông tin có đáng tin cậy hay không: kiểm tra nguồn thông tin; phân biệt ý kiến với sự kiện; kiểm tra chứng cứ của kết luận; đánh giá tính thời sự của thông tin."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "knowledge_name": "Khởi động và tình huống thực hành", "knowledge_content": "Tình huống tìm hiểu về các nguồn năng lượng thay thế nhiên liệu hoá thạch (như năng lượng tái tạo: điện gió, điện mặt trời, thuỷ điện,...). Tạo một bài trình chiếu với chủ đề Năng lượng tái tạo bằng cách khai thác thông tin số để giải quyết các vấn đề băn khoăn đặt ra."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "knowledge_name": "Đánh giá thông tin", "knowledge_content": "Trước khi sử dụng thông tin để minh hoạ cho lập luận của mình, cần đánh giá lợi ích của thông tin bằng cách trả lời một số câu hỏi như: Thông tin có thực sự phù hợp với nội dung trình bày không? (kiến thức chung có thể không đáp ứng yêu cầu dự báo phát triển); Nguồn tin có đáng tin cậy không? (thông tin từ cơ quan chính phủ đáng tin cậy hơn thông tin trên các diễn đàn hay trang web của doanh nghiệp)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "knowledge_name": "Xác định mức độ, yêu cầu cụ thể với bài trình chiếu", "knowledge_content": "Bài trình chiếu khoảng 10 trang gồm: trang tiêu đề, trang dàn ý, trang giới thiệu vấn đề, một số trang nội dung, trang kết luận và trang tài liệu tham khảo. Mỗi trang nội dung không quá 6 mục; mỗi mục không quá 2 dòng. Bài trình chiếu cần có ít nhất 2 hình ảnh minh hoạ cho nội dung trình bày."}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "knowledge_name": "Hướng dẫn thực hiện Nhiệm vụ 3", "knowledge_content": "Bước 1. Tạo bài trình chiếu: Tạo các trang của bài trình chiếu theo cấu trúc đã định (tham khảo Hình 3.2, Hình 3.3, Hình 3.4). Soạn nội dung từng trang sao cho phù hợp với lập luận của cả bài trình chiếu. Sử dụng thông tin đã được chọn làm tư liệu tham khảo cho các trang nội dung."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "knowledge_name": "Biên tập và chia sẻ bài trình chiếu", "knowledge_content": "Bước 2. Biên tập nội dung: Biên tập nội dung sao cho mỗi trang không quá 6 mục; mỗi mục không quá 2 dòng. Sử dụng phần mềm xử lí hình ảnh để tạo và sửa hình ảnh minh hoạ phù hợp với nội dung.\nBước 3. Chia sẻ bài trình chiếu: Lựa chọn phương tiện kĩ thuật số để chia sẻ bài trình chiếu: thư điện tử, mạng xã hội, không gian lưu trữ dùng chung,... Giải thích phương án lựa chọn của em theo các tiêu chí: dễ sử dụng và an toàn dữ liệu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "knowledge_name": "Lưu ý khi sử dụng công nghệ kĩ thuật số", "knowledge_content": "Ba điều lưu ý để tránh các vi phạm khi sử dụng công nghệ kĩ thuật số: Tìm hiểu thông tin, trang bị cho mình những kiến thức cần thiết; Chỉ sử dụng những sản phẩm số khi có sự cho phép của tác giả hoặc có bản quyền sử dụng; Hầu hết thông tin trên Internet là có bản quyền."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "knowledge_name": "2. Trung thực khi tạo ra sản phẩm số", "knowledge_content": "Có nhiều dạng sản phẩm số mà em có thể tạo ra, đáp ứng sở thích cũng như nhu cầu học tập, kết nối bạn bè."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "knowledge_name": "Yêu cầu về đạo đức, pháp luật và văn hoá trong tạo ra sản phẩm số", "knowledge_content": "Khi tạo ra các sản phẩm số, cần bảo đảm sản phẩm thể hiện được đạo đức, tính văn hoá và không vi phạm pháp luật. Cụ thể:\n- Luôn trung thực trong quá trình tạo ra sản phẩm số: Không sử dụng thông tin giả, thông tin không đáng tin cậy; không sao chép, chỉnh sửa thông tin của người khác rồi coi là của mình (ví dụ: tự ý chỉnh sửa ảnh và viết chú thích làm người xem hiểu nhầm, không ghi chú tác giả là thiếu trung thực).\n- Nên sử dụng thông tin do mình tự tạo (tự quay video, chụp ảnh, viết nội dung,...), không sử dụng các thông tin có bản quyền nếu chưa mua hoặc xin phép.\n- Nội dung và hình thức của sản phẩm tạo ra không được vi phạm các quy định, chuẩn mực về đạo đức, văn hoá trong xã hội nói chung (chỉ dùng ngôn ngữ lịch sự, không dùng hình ảnh giật gân, không tiết lộ thông tin cá nhân của người khác,...)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "knowledge_name": "Khởi động và Tình huống thực tế", "knowledge_content": "Bố của Khoa là giám đốc một công ty sản xuất phần mềm máy tính. Bố giao cho Khoa tính toán doanh thu một số phần mềm của công ty. Khoa đã tạo bảng tính lưu thông tin về các phần mềm để tính toán."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "knowledge_name": "1. Địa chỉ tương đối", "knowledge_content": "Chương trình bảng tính sử dụng ba loại địa chỉ ô là địa chỉ tương đối, địa chỉ tuyệt đối và địa chỉ hỗn hợp. Địa chỉ tương đối là địa chỉ ô cho một công thức được tạo bằng thao tác nháy chuột vào ô thì chương trình bảng tính mặc định lấy địa chỉ ô đó là địa chỉ tương đối. Khi sao chép công thức, địa chỉ tương đối sẽ tự động thay đổi theo dòng hoặc cột tương ứng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài", "knowledge_name": "2. Địa chỉ tuyệt đối", "knowledge_content": "Trong chương trình bảng tính, một địa chỉ ô trong công thức không thay đổi khi sao chép công thức thì địa chỉ đó là địa chỉ tuyệt đối. Phần mềm bảng tính quy định địa chỉ tuyệt đối có dấu $ trước tên cột và tên hàng. Ví dụ, $F$2 là địa chỉ tuyệt đối. Sau khi nhập địa chỉ tương đối, em nhấn phím F4 để chuyển địa chỉ tương đối thành địa chỉ tuyệt đối."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "knowledge_name": "Địa chỉ tuyệt đối trong bảng tính", "knowledge_content": "- Địa chỉ tuyệt đối không thay đổi khi sao chép công thức.\n- Địa chỉ tuyệt đối có dấu $ trước tên cột và tên hàng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "knowledge_name": "Sao chép công thức sử dụng địa chỉ tuyệt đối", "knowledge_content": "Tại ô F4, nhập công thức =E4*$F$2 bằng cách gõ dấu $ từ bàn phím hoặc sau khi nhập F2 thì nhấn phím F4 trên bàn phím. Sau đó sao chép công thức tại ô F4 đến các ô từ F5 đến F9 và lưu tệp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "knowledge_name": "4. Thực hành: Sao chép dữ liệu từ các tệp văn bản, trang trình chiếu sang trang tính", "knowledge_content": "Trong thực tế, có nhiều tình huống bảng dữ liệu được tạo ra trong phần mềm soạn thảo văn bản hoặc phần mềm trình chiếu. Khi cần tính toán trên các bảng dữ liệu này, em có thể sao chép bảng dữ liệu sang phần mềm bảng tính để giúp công việc được giải quyết nhanh chóng và hiệu quả."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "knowledge_name": "1. Khảo sát và xử lý dữ liệu với bảng tính", "knowledge_content": "Mục đích của việc khảo sát là thu thập thông tin để quyết định CLB Tin học sẽ được tổ chức như thế nào. Học sinh cần thực hiện các thao tác xử lý dữ liệu như sắp xếp theo thứ tự bảng chữ cái để dễ tìm kiếm, thống kê số lượng học sinh theo nội dung hoặc theo tổ. Chúng ta có thể sử dụng chức năng sắp xếp và lọc dữ liệu để giải quyết những yêu cầu của bài toán thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "knowledge_name": "b) Sắp xếp dữ liệu theo nhiều tiêu chí", "knowledge_content": "Khi cần sắp xếp dữ liệu theo nhiều tiêu chí (ví dụ: khi có các giá trị trùng nhau ở tiêu chí thứ nhất), ta cần bổ sung thêm tiêu chí thứ hai (ví dụ: sắp xếp theo Họ đệm) bằng cách sử dụng nút lệnh Add level trong hộp thoại Sort để thêm tiêu chí sắp xếp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "3. Thực hành: Lọc dữ liệu", "knowledge_content": "Chức năng lọc dữ liệu của phần mềm bảng tính được sử dụng để chọn và chỉ hiển thị các dòng thoả mãn các điều kiện nào đó. Dữ liệu không đúng với điều kiện lọc sẽ bị ẩn đi. Để lọc dữ liệu theo một tiêu chí (ví dụ lọc danh sách học sinh theo từng nội dung Tin học), ta thực hiện qua các bước: chọn vùng dữ liệu cần lọc, vào thẻ Data, chọn lệnh Filter, sau đó chọn các điều kiện lọc mong muốn và nhấn OK."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "knowledge_name": "Lọc và sắp xếp dữ liệu nâng cao trong bảng tính", "knowledge_content": "Phần mềm bảng tính điện tử hỗ trợ các chức năng sắp xếp dữ liệu theo nhiều tiêu chí và lọc dữ liệu nâng cao thông qua các điều kiện số (Number Filters) hoặc điều kiện kí tự (Text Filters) nhằm phân tích dữ liệu hiệu quả."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "knowledge_name": "1. Trực quan hoá dữ liệu bằng biểu đồ", "knowledge_content": "Biểu đồ được sử dụng để minh hoạ dữ liệu một cách trực quan, giúp em dễ so sánh hoặc dự đoán xu hướng tăng hay giảm của dữ liệu. Có nhiều loại biểu đồ, mỗi loại có một ý nghĩa riêng. Biểu đồ cột thường được sử dụng để so sánh dữ liệu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "knowledge_name": "Biểu đồ đoạn thẳng và Biểu đồ hình quạt tròn", "knowledge_content": "- Biểu đồ đoạn thẳng thường được sử dụng để quan sát xu hướng tăng giảm của dữ liệu theo thời gian hoặc quá trình nào đó (Ví dụ: số lượng ứng dụng được tải về từ các chợ ứng dụng từ năm 2017 đến 2020).\n- Biểu đồ hình quạt tròn rất hữu ích trong trường hợp cần so sánh các phần với tổng thể (Ví dụ: tỉ lệ phần trăm số học sinh muốn tìm hiểu thêm mỗi nội dung Tin học trên tổng số học sinh khảo sát).\n- Biểu đồ là cách minh hoạ dữ liệu trực quan giúp dễ dàng so sánh, nhận định xu hướng thay đổi của dữ liệu và cần sử dụng loại biểu đồ phù hợp với mục đích biểu diễn."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "knowledge_name": "Bổ sung thông tin cho biểu đồ cột", "knowledge_content": "Để bổ sung thông tin cho biểu đồ, nháy chuột chọn biểu đồ, sau đó chọn nút lệnh Chart Elements ở góc trên bên phải của biểu đồ. Nháy chuột chọn các loại thông tin cho biểu đồ như Axes, Axis Titles, Chart Title, Data Labels, Data Table, Error Bars, Gridlines, Legend, Trendline."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "knowledge_name": "Tạo và định dạng biểu đồ hình quạt tròn", "knowledge_content": "Biểu đồ hình quạt tròn dùng để so sánh trực quan tỉ lệ phần trăm số học sinh khảo sát. Các bước tạo: Chọn vùng dữ liệu, vào thẻ Insert, chọn nhóm Charts, chọn Insert Pie or Doughnut Chart, chọn kiểu 2-D Pie. Để hiển thị nhãn dữ liệu là tỉ lệ phần trăm, chọn More Options và đánh dấu chọn Percentage trong khung làm việc bên phải."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "1. Danh sách dạng liệt kê", "knowledge_content": "Tìm hiểu về tác dụng của danh sách dạng liệt kê trong việc trình bày các mục thông tin rõ ràng và khoa học."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "1. Sử dụng danh sách dạng liệt kê trong văn bản", "knowledge_content": "Phần mềm soạn thảo văn bản cung cấp hai kiểu danh sách dạng liệt kê là: danh sách dấu đầu dòng và danh sách có thứ tự. Mỗi đơn vị trong danh sách dạng liệt kê là một đoạn văn bản, phân tách nhau bởi phím Enter. Trong danh sách dấu đầu dòng, mỗi đoạn văn bản bắt đầu bằng một dấu đầu dòng. Các dấu đầu dòng được tự động tạo ra mỗi khi em thêm đoạn văn bản mới. Trong danh sách có thứ tự, mỗi đoạn văn bản bắt đầu bằng một số hoặc chữ cái và dấu phân tách (thường là dấu chấm hoặc dấu ngoặc đơn). Thứ tự trong danh sách có thứ tự được tạo và cập nhật tự động khi em thêm hoặc bớt các đoạn văn bản trong danh sách. Sử dụng danh sách dạng liệt kê giúp cho văn bản trở nên rõ ràng, có tính thẩm mĩ hơn. Nếu được sử dụng đúng cách, các dấu đầu dòng và thứ tự có tác dụng như một điểm truy cập cho người đọc, một hình thức nhấn mạnh hoặc một cách để biểu thị tầm quan trọng của nội dung đoạn văn bản. Danh sách dạng liệt kê chia nhỏ các đoạn văn bản dài, giúp người đọc có khả năng tham khảo thông tin nhanh chóng, dễ dàng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "2. Làm việc với hình ảnh minh họa và vẽ hình đồ hoạ", "knowledge_content": "Bên cạnh các công cụ xử lí văn bản, phần mềm soạn thảo còn cung cấp các công cụ xử lí hình ảnh, giúp em nâng cao hiệu quả sử dụng hình ảnh. Em có thể: chèn thêm, xoá bỏ hình ảnh; thay đổi kích thước, vị trí hình ảnh,... Bên cạnh đó, phần mềm soạn thảo còn cung cấp một thư viện đa dạng các mẫu hình đồ hoạ, các chức năng để vẽ hình đồ hoạ trong văn bản. Với các công cụ mà phần mềm soạn thảo văn bản cung cấp, em có thể tạo được các sản phẩm là văn bản có tính thẩm mĩ phục vụ nhu cầu thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "knowledge_name": "Sử dụng công cụ nâng cao trong soạn thảo văn bản", "knowledge_content": "Phần mềm soạn thảo văn bản cung cấp nhiều công cụ nâng cao để làm việc với hình ảnh và hình đồ hoạ. Sử dụng các chức năng nâng cao, em có thể tạo được các sản phẩm có tính thẩm mĩ phục vụ nhu cầu thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "c) Lưu tệp", "knowledge_content": "Chọn File/Save để lưu tệp văn bản với tên PhieuKhaoSat.docx."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "Nhiệm vụ 2: Tạo tờ rơi quảng cáo và tuyển thành viên", "knowledge_content": "Sử dụng phần mềm soạn thảo tạo tờ rơi quảng cáo và tuyển thành viên cho CLB Tin học của trường. Các đối tượng văn bản, hình đồ hoạ nằm bên trên ảnh nền (tức là ảnh nền nằm ở lớp dưới, văn bản và hình đồ hoạ nằm ở lớp trên)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "a) Khởi động phần mềm và nhập nội dung", "knowledge_content": "Nháy đúp chuột vào biểu tượng phần mềm trên màn hình nền. Nhập nội dung văn bản theo mẫu như Hình 8a.5."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "knowledge_name": "b) Thêm ảnh minh hoạ, thay đổi lớp, thay đổi kích thước ảnh", "knowledge_content": "Nháy chuột vào đầu đoạn văn bản để đặt vị trí chèn ảnh, chọn Insert/Picture, chọn tệp ảnh nền rồi chọn OK để chèn ảnh. Hình ảnh được chèn vào văn bản (ảnh có thể che mất nội dung văn bản hoặc đẩy nội dung văn bản xuống dưới - Hình 8a.9b). Vì ảnh nền cần nằm dưới văn bản, nên em nháy chuột chọn ảnh, chọn Format. Trong nhóm lệnh Arrange, nháy chuột vào mũi tên bên cạnh lệnh Wrap Text rồi chọn Behind Text để ảnh nằm ở lớp dưới, văn bản nằm ở lớp trên. Kết quả là văn bản sẽ được đưa lên trên ảnh nền (Hình 8a.9c). Bước tiếp theo cần thay đổi vị trí và kích thước ảnh để ảnh phủ hết nền của tờ rơi. Em di chuyển chuột vào hình vuông nhỏ màu trắng nằm ở góc dưới bên phải của ảnh rồi kéo thả chuột để thay đổi kích thước sao cho ảnh nền phủ kín tờ rơi (Hình 8a.9d)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "knowledge_name": "c) Thêm, thay đổi màu các đối tượng hình đồ hoạ", "knowledge_content": "Để vẽ hình đồ hoạ (ví dụ hình mũi tên), thực hiện: Chọn Insert -> Nháy chuột vào mũi tên bên dưới lệnh Shapes -> Chọn mẫu trong nhóm Block Arrows rồi kéo thả chuột để tạo hình. Để đổi màu, chọn đối tượng, chọn Format, trong nhóm lệnh Shape Styles, nháy chuột vào mũi tên bên cạnh lệnh Shape Fill và chọn màu vàng. Lưu ý: Muốn thay đổi hình ảnh làm nền hoặc mẫu hình đồ hoạ khác, nháy chọn hình ảnh/hình đồ hoạ rồi nhấn phím Delete, sau đó thực hiện lại các bước để chèn thêm."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "knowledge_name": "d) Chỉnh sửa vị trí và màu sắc các đối tượng", "knowledge_content": "Chỉnh sửa vị trí dòng chữ vào đúng hình cầu trên hình nền, đổi màu chữ đen thành vàng. Chỉnh sửa màu sắc và vị trí các đối tượng văn bản khác. Chèn thêm hình ảnh vào góc trên bên phải, chọn Format/Arrange/Wrap Text rồi chọn Square để đặt hình ảnh vào đúng vị trí."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "knowledge_name": "e) Lưu tệp", "knowledge_content": "Chọn File/Save để lưu tệp văn bản với tên tương ứng (ví dụ: TuyenThanhVien.docx)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "knowledge_name": "1. Đầu trang và chân trang", "knowledge_content": "Đầu trang (Header) và chân trang (Footer) lần lượt là phần trên cùng (phần lề trên) và dưới cùng (phần lề dưới) của văn bản. Chúng là các phần biệt lập với văn bản chính và thường được sử dụng để chứa chú thích, số trang, tên văn bản, tên tác giả,... Đầu trang và chân trang cũng có thể chứa hình ảnh hay hình đồ hoạ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "knowledge_name": "Đầu trang và chân trang", "knowledge_content": "Các thông tin đặt trong phần đầu trang và chân trang sẽ tự động xuất hiện ở tất cả các trang, giúp cố định một số thông tin cần xuyên suốt cả văn bản. Đầu trang và chân trang là phần riêng biệt với văn bản chính; thường chứa thông tin ngắn gọn; được tự động thêm vào tất cả các trang trong văn bản. Chân trang còn giúp trang văn bản chuyên nghiệp và đẹp hơn nhờ cách sắp xếp thông tin hay các hình ảnh trang trí."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "knowledge_name": "2. Đánh số trang", "knowledge_content": "Các tài liệu dạng văn bản, nhất là các văn bản dài thường đánh số trang để người đọc dễ theo dõi. Phần mềm soạn thảo văn bản có chức năng đánh số trang tự động cho văn bản. Số trang thường được đặt ở đầu trang hoặc chân trang. Em có thể lựa chọn đặt số trang ở vị trí bên trái, bên phải hoặc giữa."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "knowledge_name": "Định dạng đầu trang, chân trang và đánh số trang", "knowledge_content": "Sử dụng lệnh Page Number để đánh số trang vào vị trí giữa, bên dưới trang văn bản. Sử dụng lệnh Header và Footer để nhập nội dung đầu trang, chân trang, canh phải và tạo chữ in nghiêng, màu cam. Sử dụng lệnh Close Header and Footer để hoàn thành việc định dạng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "knowledge_name": "1. Văn bản và màu sắc trên trang chiếu", "knowledge_content": "Khác với văn bản trong tài liệu thông thường, văn bản trên trang chiếu có đặc điểm là ngắn gọn, chỉ nêu ý chính, không nêu chi tiết,... Văn bản trên trang chiếu góp phần quan trọng vào việc tạo ấn tượng, thu hút sự quan tâm, giúp người nghe nhanh chóng tiếp nhận được nội dung tóm tắt của trang trình chiếu,... Màu sắc đóng vai trò quan trọng trong việc thiết kế một bài trình chiếu. Một bài trình chiếu đẹp, chuyên nghiệp là sự phối hợp hoàn hảo của nội dung, bố cục và màu sắc. Các màu nóng như đỏ, da cam, vàng,... mang lại cảm giác ấm áp, giúp người xem phấn chấn, hoạt bát, năng nổ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "knowledge_name": "Lựa chọn màu sắc cho trang chiếu", "knowledge_content": "Các màu lạnh như xanh, tím,... mang lại cảm giác lạnh, giúp người xem bình tĩnh, hiền hoà, lắng dịu. Các màu trung tính như trắng, đen, be,... mang lại cảm giác lịch sự, nhẹ nhàng. Màu sắc chủ đạo nên đặt sao cho hài hoà với nội dung. Nên kết hợp các màu cùng nhóm với nhau (màu nóng như đỏ, cam, vàng kết hợp với màu nâu; màu lạnh như xanh dương, xanh lục kết hợp với màu xám). Không sử dụng quá nhiều màu trên một trang (bao gồm cả màu nền, màu chữ,...). Nên chọn màu văn bản có độ tương phản cao với màu nền. Phần mềm trình chiếu cung cấp các công cụ giúp em chọn đặt được màu sắc, cỡ chữ hài hoà, hợp lí với nội dung."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "knowledge_name": "2. Số trang, đầu trang và chân trang", "knowledge_content": "Giống như phần mềm soạn thảo văn bản, phần mềm trình chiếu cũng cho phép em thêm đầu trang, chân trang và đánh số thứ tự cho các trang trong bài trình chiếu. Đó là thông tin xuất hiện ở đầu và cuối tất cả các trang chiếu. Thông tin này thường bao gồm tên người trình chiếu, tên công ti, tiêu đề bài trình chiếu, số trang hay thời gian trình chiếu,... Có thể đánh số trang, thêm đầu trang, chân trang vào các trang chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "1. Nhiệm vụ và nội dung các trang chiếu", "knowledge_content": "Tạo một bài trình chiếu mới gồm 4 trang chiếu với các nội dung: Trang 1 (Chào mừng các bạn đến với CLB Tin học, Mục tiêu hoạt động), Trang 2 (Nguyên tắc hoạt động), Trang 3 (Kế hoạch hoạt động), và các định dạng văn bản, bố cục, đánh số trang, thêm đầu trang và chân trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "2. Hướng dẫn thực hiện với Microsoft PowerPoint 2016", "knowledge_content": "Khởi động phần mềm, chọn mẫu Title Slide cho trang đầu tiên và Title and Content cho các trang tiếp theo. Định dạng phông chữ Arial với các cỡ chữ và màu sắc khác nhau cho tiêu đề và nội dung. Sử dụng lệnh Insert / Header & Footer hoặc Slide Number để đánh số trang và thêm thông tin đầu chân trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "knowledge_name": "Định dạng đầu trang và chân trang", "knowledge_content": "Em có thể định dạng cho số trang và thông tin trong phần đầu trang, chân trang giống như định dạng văn bản trên trang chiếu. Phần mềm trình chiếu còn hỗ trợ em in nội dung bài trình chiếu ra giấy (Handouts) để phát cho người nghe. Em cũng có thể thêm đầu trang, chân trang vào tài liệu in trên giấy để giúp người nghe dễ dàng theo dõi bằng cách nháy chuột chọn Notes and Handouts trong cửa sổ Header and Footer rồi nhập thông tin tương ứng. Ở chế độ Slide, em không thêm được đầu trang. Chỉ ở chế độ Notes and Handouts phần mềm PowerPoint mới có chức năng thêm đầu trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "d) Hoàn thiện bài trình chiếu và lưu tệp", "knowledge_content": "Áp dụng một mẫu định dạng cho bài trình chiếu, tạo danh sách dấu đầu dòng, chọn File/Save để lưu tệp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "knowledge_name": "a) Sử dụng một bản mẫu có sẵn cho bài trình chiếu", "knowledge_content": "Chọn File/New để tạo một bài trình chiếu mới. Phần mềm trình chiếu sẽ đưa ra các bản mẫu có sẵn được sắp xếp theo các chủ đề để em lựa chọn. Em chọn Education và chọn bản mẫu có tên Lab Safety (Hình 11a.3). Nội dung trong bản mẫu viết bằng tiếng Anh. Em có thể sử dụng các công cụ dịch từ tiếng Anh sang tiếng Việt để hỗ trợ trong việc hiểu nội dung. Bản mẫu Lab Safety có nội dung tương tự như Hình 11a.4."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11a", "knowledge_name": "Chỉnh sửa bản mẫu", "knowledge_content": "Có thể thay đổi phông chữ, cỡ chữ, màu nền, thêm hoặc bớt trang chiếu để phù hợp với nội dung trình chiếu dựa trên bản mẫu có sẵn."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "knowledge_name": "c) Đưa vào trang tiêu đề đường dẫn đến một video", "knowledge_content": "Giả sử em muốn giới thiệu một video (có tên NhungSuCoPhongThucHanh.mp4) có nội dung cảnh báo về các tai nạn có thể xảy ra trong phòng thực hành. Em có thể đưa đường dẫn đến tệp video đó vào trang tiêu đề để mở trong khi trình chiếu. Cách làm như sau:\n- Chèn vào trang chiếu một hình ảnh minh họa để đặt liên kết (hoặc chọn luôn hình ảnh chiếc bình màu vàng có sẵn trên trang chiếu).\n- Nháy chuột chọn hình ảnh minh họa, chọn Insert/Links/Link. Trong cửa sổ Insert Hyperlink, chọn đường dẫn đến tệp NhungSuCoPhongThucHanh.mp4.\nd) Lưu tệp\n- Chọn File/Save để lưu tệp với tên AnToanPhongThucHanh.pptx."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "knowledge_name": "1. Phần mềm chỉnh sửa ảnh", "knowledge_content": "Không phải mọi hình ảnh đều đẹp ngay từ khi nó được tạo ra. Mỗi hình ảnh đều cần được chỉnh sửa để mang được thông điệp tích cực đến người xem. Phần mềm chỉnh sửa ảnh là công cụ giúp em tạo ra hoặc thay đổi một hình ảnh để có được hình ảnh mới theo cách mà em mong muốn. Ví dụ: từ bức ảnh phong cảnh trường (Hình 8b.1) mà bạn An chụp bị lỗi (ngón tay che ống kính, ảnh mờ và tối), sau khi chỉnh sửa có thể thu được ảnh kết quả như Hình 8b.2. Phần mềm chỉnh sửa ảnh có thể được cài đặt trên máy tính hoặc chạy trực tuyến trên Internet. Những chức năng chính của phần mềm chỉnh sửa ảnh gồm: tạo mới ảnh, chỉnh sửa ảnh, chuyển đổi ảnh sang các định dạng và độ phân giải khác nhau."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "knowledge_name": "4. Thực hành: Làm quen với phần mềm chỉnh sửa ảnh", "knowledge_content": "Phần mềm GIMP (phiên bản 2.10.32) là phần mềm chỉnh sửa ảnh phổ biến. Giao diện làm việc gồm các thành phần chính: Bảng công cụ, Hộp tuỳ chọn công cụ, Vùng làm việc, và Bảng tuỳ chọn cấu hình, điều khiển lớp. Để mở tệp ảnh, chọn File/Open, chọn ảnh và nháy chuột chọn Open. Để đọc thông tin ảnh, chọn Image/Image Properties để xem các thông tin như kích thước ảnh, độ phân giải, tên tệp ảnh và định dạng tệp ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "knowledge_name": "1. Công cụ cắt, xoay, thay đổi kích thước ảnh", "knowledge_content": "a) Cắt hình ảnh: Khi chụp ảnh, có thể có những đối tượng xuất hiện trong ảnh ngoài ý muốn của người chụp. Trong trường hợp đó, em cần sử dụng công cụ cắt (Crop) để loại bỏ những chi tiết không hợp lí, giúp cho bức ảnh có bố cục chặt hơn, thu hút sự chú ý của người xem vào chủ đề của bức ảnh.\nb) Xoay hình ảnh: Trong thực tế, khi chụp ảnh, máy ảnh có thể bị nghiêng hoặc xoay không đúng hướng. Kết quả là ảnh chụp có thể bị lỗi hoặc không đúng ý định của người chụp. Công cụ xoay (Rotate) có thể giúp em khắc phục vấn đề bằng cách xoay hình ảnh theo góc xoay và tâm xoay tuỳ ý (Hình 9b.1)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "knowledge_name": "1. Công cụ cắt ảnh (Crop)", "knowledge_content": "Công cụ Crop dùng để cắt phần ảnh bị lỗi hoặc không cần thiết, giúp chọn lại khung hình mong muốn cho bức ảnh. Kéo thả chuột để tạo khung hình chữ nhật xác định vùng ảnh được giữ lại, phần ngoài khung sẽ bị tối đi và cắt bỏ. Nhấn phím Enter để hoàn thành hoặc Esc để hủy bỏ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "knowledge_name": "2. Công cụ xoay ảnh (Rotate)", "knowledge_content": "Công cụ Rotate cho phép xoay hình ảnh theo các góc độ khác nhau. Có hai cách thực hiện: Cách 1 dùng hộp thoại Rotate (chọn công cụ Rotate trong bảng công cụ hoặc qua lệnh Tools/Transform Tools/Rotate, nhập giá trị góc xoay vào ô Angle); Cách 2 xoay trực tiếp trên ảnh bằng cách kéo thả chuột khi con trỏ chuột chuyển sang dạng biểu tượng xoay."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "2. Tạo hiệu ứng cho ảnh", "knowledge_content": "Hình ảnh được chụp từ máy ảnh kĩ thuật số không phải lúc nào cũng hoàn hảo. Đôi khi hình ảnh có thể trông quá sáng hoặc quá tối. Em có thể khắc phục vấn đề này bằng cách điều chỉnh độ sáng và độ tương phản của hình ảnh.\na) Độ sáng của ảnh (Brightness): Điều chỉnh độ sáng là thay đổi mức độ sáng và tối tổng thể của ảnh. Nếu ảnh quá tối có thể thử tăng độ sáng. Tuy nhiên, việc tăng độ sáng cho một ảnh quá tối có thể tạo ra nhiều nhiễu cho ảnh.\nb) Độ tương phản (Contrast): Tăng độ tương phản là thao tác làm cho sự khác biệt giữa vùng sáng và vùng tối của hình ảnh dễ nhận thấy hơn. Nói cách khác là làm cho các phần tối tối hơn và các phần sáng sáng hơn. Tuy nhiên, tăng độ tương phản quá nhiều có thể dẫn đến mất chi tiết hình ảnh.\nc) Độ mờ, độ sắc nét (Blur, Sharpen): Phần mềm xử lí ảnh cung cấp công cụ làm mờ, làm sắc nét ảnh. Em có thể sử dụng để làm mờ một vùng quá nổi bật trong ảnh, làm sắc nét riêng một đối tượng hoặc làm mờ nền xung quanh ảnh để làm nổi bật chủ thể bức ảnh. Tuy nhiên, việc thêm quá nhiều độ mờ, độ sắc nét có thể làm cho hình ảnh trông xấu hơn hoặc dẫn đến mất chi tiết của ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "Công cụ xử lý ảnh", "knowledge_content": "Phần mềm xử lí ảnh cung cấp các công cụ để chèn thêm văn bản, điều chỉnh độ sáng, tối, độ tương phản, làm mờ, làm sắc nét,... cho ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "knowledge_name": "1. Chỉnh sửa độ sáng, độ tương phản của ảnh", "knowledge_content": "Sử dụng lệnh Colors/Brightness-Contrast... để mở hộp thoại Brightness-Contrast, sau đó kéo thả chuột để điều chỉnh độ sáng, độ tương phản theo ý muốn và chọn OK để hoàn thành."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "knowledge_name": "2. Làm mờ hoặc làm sắc nét vùng ảnh", "knowledge_content": "Thực hiện các bước: Chọn công cụ Brush, chọn cọ vẽ Brush, chọn kích thước cọ vẽ, chọn Blur để làm mờ hoặc Sharpen để làm sắc nét, chọn tốc độ thay đổi, sau đó nháy chuột vào vùng cần làm mờ hoặc làm sắc nét."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "knowledge_name": "1. Tập hợp nội dung thực hành", "knowledge_content": "Thu thập khoảng 4 đến 6 ảnh đã được chỉnh sửa bố cục, màu sắc, hiệu ứng hợp lí từ các bài thực hành trước (Bài 8b, Bài 9b, Bài 10b) và đưa vào một thư mục."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "knowledge_name": "2. Tạo khung viền cho ảnh", "knowledge_content": "Mở tệp ảnh (ví dụ: Anh_Crop.xcf), tạo một lớp mới bằng cách chọn Layer/New Layer, nhập tên lớp là Khungvien và chọn OK. Trên cửa sổ Layer sẽ xuất hiện thêm lớp Khungvien nằm trên lớp ảnh gốc. Sử dụng biểu tượng con mắt bên cạnh tên lớp để ẩn hoặc hiện nội dung của lớp đó."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "knowledge_name": "Đổ màu Gradient và quản lý lớp ảnh", "knowledge_content": "Sử dụng công cụ Gradient để đổ màu chuyển dần giữa màu nền và màu vẽ. Có thể điều chỉnh các thông số trong cửa sổ Gradient như chế độ đổ màu (mode), mật độ màu (Opacity), chuyển màu lặp lại nhiều lần hay chỉ một lần (Repeat). Sắp xếp thứ tự các lớp trong cửa sổ Layers, thay đổi kích thước lớp bằng công cụ Scale và trộn các lớp ảnh thành một lớp bằng lệnh Layer/Merge Down."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "knowledge_name": "1. Từ thuật toán đến chương trình", "knowledge_content": "Bằng ngôn ngữ lập trình trực quan, bạn Khoa muốn tạo chương trình điều khiển nhân vật di chuyển theo đường đi là các hình như: tam giác đều, vuông,... Tam giác đều là hình có ba cạnh bằng nhau, ba góc bằng nhau và bằng 60 độ. Để di chuyển theo một hình tam giác đều, nhân vật cần lặp lại ba lần việc thực hiện hai hành động sau đây: Di chuyển về phía trước một số bước bằng độ dài cạnh tam giác. Ví dụ, di chuyển 60 bước; Quay trái 120 độ. Thuật toán sử dụng cấu trúc tuần tự và cấu trúc lặp, trong đó số bước lặp bằng 3 (bằng số cạnh của tam giác đều). Khi thực hiện đủ ba lần thì vòng lặp kết thúc. Kịch bản chương trình được mô tả bằng sơ đồ khối của thuật toán như minh hoạ ở Hình 12.3a."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "knowledge_name": "Chuyển đổi thuật toán thành chương trình", "knowledge_content": "Để điều khiển nhân vật trên máy tính thực hiện thuật toán được mô tả bằng sơ đồ khối, chúng ta viết chương trình Scratch trong đó mỗi bước của thuật toán mô tả ở sơ đồ khối đã được thực hiện bằng lệnh tương ứng của ngôn ngữ lập trình Scratch. Chương trình là dãy các lệnh điều khiển máy tính thực hiện một thuật toán."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "knowledge_name": "Kiểu dữ liệu trong Scratch", "knowledge_content": "Mỗi kiểu dữ liệu là một tập hợp các giá trị mà một biến thuộc kiểu đó có thể nhận. Mỗi kiểu dữ liệu được trang bị một số phép toán. Ba kiểu dữ liệu phổ biến trong ngôn ngữ lập trình trực quan là: kiểu số, kiểu sâu kí tự, kiểu lôgic."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "knowledge_name": "2. Hằng, biến, biểu thức", "knowledge_content": "Trong lập trình, biến được dùng để lưu trữ giá trị có thể thay đổi trong khi thực hiện chương trình. Biến được nhận biết qua tên của nó. Hằng là giá trị không đổi trong quá trình thực hiện chương trình. Biểu thức là sự kết hợp của biến, hằng, dấu ngoặc, phép toán và các hàm để trả lại giá trị thuộc một kiểu dữ liệu nhất định."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "knowledge_name": "Lập trình Scratch với biến và biểu thức", "knowledge_content": "Sử dụng các nhóm lệnh 'Cảm biến' (để nhận dữ liệu nhập từ bàn phím), nhóm lệnh 'Các biến số' (để tạo và sử dụng biến lưu trữ giá trị), nhóm lệnh 'Các phép toán' (để tạo các biểu thức số học và logic), và nhóm lệnh 'Hiển thị' để hoàn thành chương trình điều khiển nhân vật."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "1. Cấu trúc điều khiển cơ bản", "knowledge_content": "Ngôn ngữ lập trình trực quan như Scratch có các khối lệnh tương ứng với các cấu trúc điều khiển cơ bản bao gồm cấu trúc tuần tự, cấu trúc rẽ nhánh và cấu trúc lặp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "a) Cấu trúc tuần tự", "knowledge_content": "Cấu trúc tuần tự thể hiện các bước thực hiện lần lượt theo thứ tự từ trên xuống dưới. Trong Scratch, cấu trúc tuần tự được thể hiện bằng cách sắp xếp các khối lệnh theo đúng thứ tự thực hiện."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "c) Cấu trúc lặp", "knowledge_content": "Trong trò chơi, việc đoán số không chỉ được thực hiện một lần mà được người chơi thực hiện lặp lại cho đến khi đoán đúng số bí mật. Mỗi khi người chơi đoán sai, máy tính hỏi lại và câu trả lời mới lại được đem ra so sánh với số bí mật. Lưu ý rằng việc lặp lại chỉ thực hiện khi người chơi đoán sai. Điều đó cũng có nghĩa là người chơi đoán đúng là điều kiện kết thúc vòng lặp. Thuật toán được mô tả bằng cấu trúc lặp như trong Hình 14.4a và được thể hiện trong ngôn ngữ lập trình trực quan bằng khối lệnh \"lặp cho đến khi\" (Hình 14.4d). Trong ngôn ngữ lập trình Scratch, có ba khối lệnh lặp, bao gồm: lặp với số lần định trước (Hình 14.4b), lặp vô hạn (Hình 14.4c), và lặp có điều kiện kết thúc (Hình 14.4d)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "Ghi nhớ: Cấu trúc điều khiển trong ngôn ngữ lập trình trực quan", "knowledge_content": "Cấu trúc điều khiển trong ngôn ngữ lập trình trực quan: Cấu trúc tuần tự được thể hiện bằng cách lắp ghép các khối lệnh theo trình tự của các hoạt động, từ trên xuống dưới. Cấu trúc rẽ nhánh có hai dạng, dạng khuyết và dạng đầy đủ. Cấu trúc lặp có ba dạng: lặp với số lần định trước, lặp vô hạn và lặp có điều kiện kết thúc."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "Xây dựng trò chơi đoán số", "knowledge_content": "Lập trình trò chơi đoán số trên Scratch bao gồm việc tạo biến (số bí mật, trả lời), thiết lập khung chương trình tuần tự, sử dụng biểu thức lấy số ngẫu nhiên, biểu thức logic so sánh và các cấu trúc điều khiển (lặp lại cho đến khi, rẽ nhánh nếu... thì... nếu không thì)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "Hoàn thành chương trình trò chơi đoán số", "knowledge_content": "Bước 4. Tạo khối lệnh rẽ nhánh: Tương tự như bước 2 và bước 3 để tạo khối lệnh rẽ nhánh với điều kiện 'trả lời < số bí mật'. Chọn từ nhóm 'Cảm biến' các khối lệnh 'hỏi' và lắp vào vị trí phù hợp như Hình 14.6b. Bước 5. Hoàn thành chương trình: Lắp khối lệnh rẽ nhánh vào khung chương trình để được chương trình hoàn chỉnh. Đối chiếu thuật toán được mô tả dưới dạng sơ đồ với chương trình hoàn chỉnh ở Hình 14.7."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "knowledge_name": "Vận dụng giải quyết bài toán bằng Scratch", "knowledge_content": "Sử dụng các khối lệnh trong Scratch bao gồm khối sự kiện, khối hiển thị, khối điều khiển (nếu - thì, nếu - không thì, lặp lại cho đến khi), khối các phép toán và biến để xây dựng chương trình giải phương trình ax + b = 0 và tìm ước chung lớn nhất của hai số nguyên không âm dựa trên thuật toán Euclid."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "knowledge_name": "1. Kiểm thử và phân loại lỗi", "knowledge_content": "Việc chạy thử chương trình để kiểm tra (còn gọi là kiểm thử) nhằm phát hiện những tình huống bất thường (được gọi là lỗi) khi thực hiện chương trình. Các lỗi cần được loại bỏ trước khi chương trình được coi là sản phẩm hoàn chỉnh và có thể chia sẻ với người khác."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "b) Phân loại lỗi", "knowledge_content": "Có hai loại lỗi: 1) Lỗi cú pháp xảy ra khi lệnh viết sai so với quy tắc của ngôn ngữ lập trình, làm cho chương trình không hoạt động; 2) Lỗi lôgic (hay lỗi ngữ nghĩa) xảy ra khi các câu lệnh trong chương trình tuy được viết đúng cú pháp nhưng thực hiện không đúng kịch bản như trong chương trình của trò chơi Đoán số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "Em cần nhớ", "knowledge_content": "- Cần phải chạy thử chương trình để phát hiện và loại bỏ lỗi.\n- Có hai loại lỗi: lỗi cú pháp và lỗi lôgic.\n- Lỗi cú pháp là lỗi viết câu lệnh sai quy tắc, làm cho chương trình không hoạt động.\n- Lỗi lôgic là lỗi câu lệnh, tuy được viết đúng quy tắc nhưng thực hiện sai so với kịch bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "knowledge_name": "2. Phát hiện lỗi và sửa lỗi lôgic", "knowledge_content": "Hầu hết các ngôn ngữ lập trình đều có chức năng chỉ rõ lỗi cú pháp. Ngôn ngữ lập trình trực quan, thậm chí còn hạn chế những tình huống xảy ra lỗi cú pháp. Vì vậy lỗi cú pháp dễ dàng được phát hiện và sửa chữa. Tuy nhiên, với lỗi lôgic, việc xác định lệnh nào gây ra lỗi và nó đã hoạt động thế nào để tạo ra lỗi ấy không phải lúc nào cũng đơn giản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "knowledge_name": "a) Phát hiện lỗi lôgic", "knowledge_content": "Có hai cách thường được sử dụng để phát hiện lỗi lôgic. Cách thứ nhất: Dựa vào phân tích lôgic để tìm lỗi. Tập trung vào những khối lệnh liên quan đến lỗi và so sánh với kịch bản xem chúng có được thực hiện đúng yêu cầu hay không. Chẳng hạn, trong chương trình của trò chơi Đoán số, lỗi được thể hiện ở việc chương trình hiển thị sai giá trị của số lần đoán. Các khối lệnh liên quan đến biến này là khởi tạo giá trị (2), thay đổi giá trị (9) và hiển thị giá trị (11). Theo kịch bản, số lần đoán cần phải tăng 1 đơn vị khi người chơi nhập một giá trị số (đoán). Điều này xảy ra ở các câu lệnh (4), (7) và (8). Tuy nhiên, có thể thấy rằng, mặc dù (9) tăng giá trị của số lần đoán sau khi (7) hoặc (8) được thực hiện, nhưng không có lệnh nào như thế sau khối lệnh (4) cả. Theo cách này, việc phát hiện vị trí xuất hiện lỗi trong chương trình được tìm kiếm bằng cách suy luận lôgic, bắt đầu từ những khối lệnh thực hiện không đúng kịch bản. Hạn chế việc tìm lỗi theo cách dò dòng lệnh. Cách thứ hai: Chạy thử với dữ liệu mẫu để dò lỗi. Vì là người lập trình, em có thể cho hiển thị giá trị các biến số bí mật và số lần đoán bằng cách đánh dấu tích vào bên cạnh các biến đó trong nhóm \"Các biến số\" (Hình 15.2a). Chạy chương trình với một số đầu vào dự kiến. Chẳng hạn, em có thể nhập số bí mật ngay trong lần đoán đầu tiên. Khi đó, lẽ ra số lần đoán cần nhận giá trị 1 thì nó vẫn chỉ mang giá trị 0. Từ đó, em nhận thấy lỗi xảy ra do không tăng giá trị của số lần đoán sau lần nhập giá trị đầu tiên của người chơi ở lệnh (4). Lưu ý: Chương trình có thể chạy theo từng bước bằng cách chèn lệnh \"đợi... giây\" (Hình 15.2b) vào những vị trí cần quan sát dữ liệu. Theo cách này, người lập trình có thể kết hợp chạy chương trình từng bước với việc theo dõi giá trị của các biến, so sánh chúng với các giá trị tương ứng được tính theo cách thủ công để phát hiện câu lệnh nào gây ra lỗi và cách nó hoạt động để gây ra lỗi đó."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "knowledge_name": "b) Sửa lỗi", "knowledge_content": "Khi đã biết vị trí câu lệnh xảy ra lỗi trong chương trình và cách thức câu lệnh đó tạo ra lỗi, em có thể đưa ra những cách sửa lỗi phù hợp với yêu cầu. Chẳng hạn, tăng giá trị số lần đoán lên 1 đơn vị sau lần đoán đầu tiên bằng cách bổ sung lệnh (4a) \"thay đổi số lần đoán một lượng 1\" giống như lệnh (9) vào sau lệnh (4)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "knowledge_name": "Ghi nhớ", "knowledge_content": "Hai phương pháp phổ biến để phát hiện lỗi lôgic trong chương trình: Tập trung vào những khối lệnh trực tiếp gây ra lỗi và những khối lệnh liên quan lôgic đến nó theo các cấu trúc điều khiển. Chạy chương trình từng bước, kết hợp theo dõi sự thay đổi của các biến, các giá trị đầu ra và so sánh với các giá trị tính được theo cách thủ công."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "knowledge_name": "Gỡ lỗi chương trình", "knowledge_content": "Gỡ lỗi chương trình là quá trình chạy thử chương trình với các bộ dữ liệu kiểm thử khác nhau để phát hiện lỗi logic hoặc lỗi cú pháp, từ đó phân tích và sửa đổi đoạn mã nguồn để chương trình hoạt động đúng yêu cầu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "knowledge_name": "Phát hiện và sửa lỗi chương trình", "knowledge_content": "Trong quá trình lập trình, việc gặp lỗi logic ở câu lệnh hiển thị, biểu thức điều kiện hoặc vòng lặp là thường xuyên xảy ra. Cần phân tích kỹ các tình huống, sử dụng đúng các phép toán ghép nối chữ (như khối lệnh 'kết hợp...') thay cho dấu '+' và điều chỉnh chính xác giới hạn vòng lặp, biểu thức rẽ nhánh để chương trình hoạt động đúng yêu cầu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "knowledge_name": "Tác động và ứng dụng của tin học trong các ngành nghề", "knowledge_content": "Ứng dụng tin học giúp tăng tốc độ xử lí, tiết kiệm thời gian của người lao động. Ví dụ với nghề kế toán, những yêu cầu mất hàng giờ tính toán thủ công có thể thực hiện trong vài phút nhờ các phần mềm ứng dụng. Các khoản thanh toán, giao dịch, chuyển tiền được thực hiện gần như ngay lập tức qua mạng.\nỨng dụng tin học giúp liên lạc và trao đổi thông tin dễ dàng. Các tài liệu cần trao đổi, tin nhắn công việc được gửi ngay lập tức đến đồng nghiệp hoặc khách hàng trên toàn thế giới.\nỨng dụng tin học hỗ trợ làm việc nhóm và mở rộng phạm vi làm việc. Ví dụ với nghề phát triển phần mềm, nhờ các công cụ giao tiếp trực tuyến, các lập trình viên có thể làm việc xuyên biên giới, trao đổi với đồng nghiệp ở các nước khác nhau. Các nhóm có thể tổ chức hợp tác từ xa và làm việc trên cùng một tài liệu được chia sẻ dựa trên công nghệ đám mây.\nỨng dụng tin học giúp nâng cao tay nghề, bổ sung kiến thức, hỗ trợ thông tin cho người lao động. Ví dụ nghề lái xe taxi, các ứng dụng đặt xe, bản đồ, thông báo tình trạng giao thông giúp lái xe dễ dàng nhận khách, tìm đường, tránh các cung đường bị tắc để tiết kiệm thời gian, nhiên liệu.\nThông qua sự phát triển của tin học, hàng loạt các lĩnh vực nghề nghiệp được hỗ trợ hiệu quả, nâng cao chất lượng công việc. Sự phát triển của tin học cũng đã tạo ra những nghề nghiệp đa dạng của lĩnh vực này như: phát triển phần mềm, lập trình ứng dụng điện thoại, quản trị mạng, phát triển và thiết kế website,...\nBên cạnh đó, một số nghề liên quan đến ứng dụng tin học cũng rất phát triển như: bán online, streamer (phát sóng trực tiếp cho người xem thông qua một nền tảng online), vlogger (tạo dựng nội dung trên nền tảng video và đăng trên các mạng xã hội)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "knowledge_name": "Ghi nhớ", "knowledge_content": "Ứng dụng tin học phù hợp trong các ngành nghề sẽ giúp tăng hiệu quả công việc. Một số nghề thuộc lĩnh vực tin học và liên quan đến ứng dụng tin học ra đời và phát triển để đáp ứng yêu cầu cuộc sống và công việc."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "knowledge_name": "2. Bình đẳng giới trong sử dụng máy tính và ứng dụng tin học", "knowledge_content": "Tin học đang thúc đẩy sự phát triển của mọi ngành nghề và thu hút lượng lớn lao động xã hội. Mặc dù tỉ lệ nữ giới làm việc trong các ngành nghề tin học còn thấp so với nam giới, môi trường và điều kiện công việc hoàn toàn phù hợp để phụ nữ phát huy năng lực. Ngày Quốc tế trẻ em gái với công nghệ thông tin (International Girls in ICT Day - viết tắt là ICU) được tổ chức hằng năm nhằm tuyên truyền, nhấn mạnh sự cần thiết phải thúc đẩy cơ hội nghề nghiệp công nghệ cho phụ nữ và trẻ em gái."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Bình đẳng giới", "knowledge_content": "Nam, nữ có vị trí, vai trò ngang nhau, được tạo điều kiện và cơ hội phát huy năng lực của mình cho sự phát triển của cộng đồng, của gia đình và thụ hưởng như nhau về thành quả của sự phát triển đó."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Bóng bán dẫn", "knowledge_content": "Linh kiện được làm từ vật liệu bán dẫn (có thể vừa dẫn điện vừa cách điện như germani và silicon) được dùng để chuyển đổi và điều chế dòng điện."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Đèn điện tử chân không", "knowledge_content": "Linh kiện sử dụng để tạo ra, khuếch đại và biến đổi tín hiệu điện bằng cách điều khiển chuyển động của các điện tử trong một khoảng không áp suất thấp."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Livestream", "knowledge_content": "Truyền trực tuyến (hay phát sóng trực tiếp) qua Internet những gì đang xảy ra. Nghĩa là, thông tin số được ghi lại và phát đồng thời trong thời gian thực qua Internet cho người xem ở khắp mọi nơi trên thế giới."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Mạch tích hợp rất lớn (VLSI – Very Large Scale Integrated)", "knowledge_content": "Vi mạch với mật độ tích hợp rất cao, từ vài chục nghìn đến vài trăm nghìn linh kiện bán dẫn trên một chip."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Mạch tích hợp cỡ siêu lớn hay quy mô cực lớn (ULSI – Ultra Large Scale Integration)", "knowledge_content": "Vi mạch với mật độ tích hợp cao hơn VLSI, có thể tới hàng chục triệu linh kiện bán dẫn trên một chip."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Sản phẩm số", "knowledge_content": "Sản phẩm hay dịch vụ tồn tại dưới dạng kĩ thuật số như một trang web, một cuốn sách điện tử, một chương trình máy tính,..."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Thông tin đáng tin cậy", "knowledge_content": "Thông tin dựa trên chứng cứ khách quan, không bị tác động bởi ý kiến cá nhân hay thành kiến."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Thông tin số", "knowledge_content": "Thông tin được mã hoá thành dãy bit, được chuyển vào máy tính, điện thoại thông minh, máy tính bảng,... để có thể lan truyền, trao đổi trong môi trường kĩ thuật số."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Tờ rơi", "knowledge_content": "Tờ giấy rời để giới thiệu, quảng cáo, tuyên truyền về một sự kiện, dịch vụ, sản phẩm,... nào đó."}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "knowledge_name": "Trống từ", "knowledge_content": "Thiết bị kim loại hình trụ, có nhiều rãnh, được phủ lớp vật liệu từ tính ở mặt ngoài, được đọc, ghi bằng những đầu chạy dọc theo chiều dài của trống, mỗi đầu một rãnh."}, {"grade_level": "Lớp 8", "lesson_id": "Thông tin chung", "knowledge_name": "Thông tin bản quyền và xuất bản", "knowledge_content": "Sách giáo khoa Tin học 8 thuộc bộ sách Kết nối tri thức với cuộc sống, bản quyền thuộc Nhà xuất bản Giáo dục Việt Nam năm 2022."}, {"grade_level": "Lớp 8", "lesson_id": "Trang bìa sau", "knowledge_name": "Thông tin xuất bản", "knowledge_content": "Bộ sách giáo khoa Lớp 8 - Kết nối tri thức với cuộc sống bao gồm các môn: Ngữ văn 8, Toán 8, Khoa học tự nhiên 8, Công nghệ 8, Lịch sử và Địa lí 8, Mĩ thuật 8, Âm nhạc 8, Giáo dục công dân 8, Tin học 8, Hoạt động trải nghiệm hướng nghiệp 8, Giáo dục thể chất 8, Tiếng Anh 8."}, {"grade_level": "Lớp 9", "lesson_id": "Thông tin xuất bản", "knowledge_name": "Thông tin tác giả và xuất bản", "knowledge_content": "Tác giả: NGUYỄN CHÍ CÔNG (Tổng Chủ biên), HÀ ĐẶNG CAO TÙNG (Chủ biên), PHAN ANH - NGUYỄN HẢI CHÂU - HOÀNG THỊ MAI. Nhà xuất bản Giáo dục Việt Nam. Bộ sách: Kết nối tri thức với cuộc sống."}, {"grade_level": "Lớp 9", "lesson_id": "Bìa sách", "knowledge_name": "Thông tin xuất bản sách", "knowledge_content": "Sách giáo khoa Tin học lớp 9, bộ sách Kết nối tri thức với cuộc sống. Tổng Chủ biên: Nguyễn Chí Công; Chủ biên: Hà Đặng Cao Tùng; Tác giả: Phan Anh, Nguyễn Hải Châu, Hoàng Thị Mai. Nhà xuất bản Giáo dục Việt Nam."}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "knowledge_name": "1. Tổng quan cấu trúc sách", "knowledge_content": "Sách giáo khoa Tin học 9 gồm 6 chủ đề với 22 bài học. Trong đó, chủ đề Ứng dụng tin học có hai chủ đề con để lựa chọn là Sử dụng bảng tính điện tử nâng cao (Bài 9a đến Bài 13a) và Làm quen với phần mềm làm video (Bài 9b đến Bài 13b)."}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "knowledge_name": "2. Cấu trúc thống nhất của các bài học", "knowledge_content": "Mỗi bài học được thiết kế gồm các phần:\n- Mục tiêu: Giúp em biết cần đạt được gì sau bài học.\n- Khởi động: Giúp em nhận biết ý nghĩa của bài học bằng cách kết nối những tình huống xuất hiện trong cuộc sống với nội dung bài học.\n- Nội dung bài học:\n  + Các hoạt động: Giúp lớp học tích cực, bài học dễ tiếp thu, giúp em chủ động hơn trong quá trình nhận thức.\n  + Kiến thức mới: Cung cấp cho em nội dung chính của bài học, giúp em bổ sung kiến thức nhằm đạt được mục tiêu của bài học.\n  + Hộp kiến thức: Ghi ngắn gọn hoặc tóm tắt kiến thức mới. Em có thể dùng hộp kiến thức cùng với bảng giải thích thuật ngữ (ở cuối sách) để ôn tập hoặc tra cứu thuật ngữ mới.\n  + Câu hỏi: Giúp em kiểm tra xem mình đã hiểu bài chưa.\n- Luyện tập: Gồm những câu hỏi, bài tập để củng cố kiến thức, kĩ năng trong bài học.\n- Vận dụng: Gồm những câu hỏi, bài tập yêu cầu em kết hợp kiến thức, kĩ năng đã học để giải quyết tình huống trong thực tiễn cuộc sống."}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "knowledge_name": "3. Công cụ phần mềm và các nhân vật đồng hành", "knowledge_content": "Sách sử dụng các phần mềm: Microsoft Excel, MindMaple Lite, Video Editor và ngôn ngữ lập trình trực quan Scratch để minh hoạ và hướng dẫn thực hành.\nTrong các đoạn hội thoại, có ba nhân vật là ba bạn học sinh lớp 9: An, Minh, Khoa. Mỗi bạn có một sở trường khác nhau, đại diện cho một trong ba mạch kiến thức của môn Tin học là Học vấn số hoá phổ thông (ICT), Công nghệ thông tin và truyền thông (DL), Khoa học máy tính (CS)."}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "knowledge_name": "Giới thiệu môn Tin học 9", "knowledge_content": "Sách giáo khoa Tin học 9 tiếp nối các bài học của những năm học trước, giúp học sinh bước vào thế giới kĩ thuật số với các thiết bị đa dạng, phần mềm mô phỏng. Sách được biên soạn theo Chương trình Giáo dục phổ thông 2018, định hướng giải quyết vấn đề khoa học, sử dụng thông tin hiệu quả và định hướng nghề nghiệp."}, {"grade_level": "Lớp 9", "lesson_id": "Mục lục", "knowledge_name": "Cấu trúc sách giáo khoa Tin học 9", "knowledge_content": "Sách bao gồm các chủ đề: Chủ đề 1 (Máy tính và cộng đồng - Bài 1), Chủ đề 2 (Tổ chức lưu trữ, tìm kiếm và trao đổi thông tin - Bài 2, 3), Chủ đề 3 (Đạo đức, pháp luật và văn hoá trong môi trường số - Bài 4), Chủ đề 4 (Ứng dụng tin học - Bài 5 đến Bài 13b), Chủ đề 5 (Giải quyết vấn đề với sự trợ giúp của máy tính - Bài 14 đến Bài 16), Chủ đề 6 (Hướng nghiệp với tin học - Bài 17)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "knowledge_name": "b) Ứng dụng của máy tính trong khoa học kĩ thuật và đời sống", "knowledge_content": "Máy tính có thể kết nối với nhau, tạo thành mạng máy tính toàn cầu Internet và truy cập các nguồn thông tin, dịch vụ và giải trí phong phú trên môi trường đó. Máy tính hiệu năng cao được sử dụng để tính toán trong khoa học và kĩ thuật như mô phỏng dòng chảy của chất lỏng, chất khí,... Siêu máy tính có thể được sử dụng để thực hiện những tính toán phức tạp trong hoá học, vật lí, công nghệ kết cấu hay dự báo thời tiết. Công nghệ thông tin được ứng dụng trên các vệ tinh nhân tạo để nghiên cứu vũ trụ. Trong y tế, bác sĩ sử dụng máy tính để hiểu cơ thể con người và chẩn đoán những rối loạn về thể chất và tinh thần. Bệnh viện sử dụng máy tính để quản lí dữ liệu người bệnh và bác sĩ. Trong nghiên cứu, các nhà khoa học có thể tìm thấy tài liệu tham khảo từ kho dữ liệu được số hoá và được lưu trữ trên thiết bị lưu trữ hoặc Internet. Trong lĩnh vực giao thông, máy tính được sử dụng để điều khiển xe tự động lái, điều khiển hệ thống đèn tín hiệu,... Trong cuộc sống hằng ngày, hầu như mọi dịch vụ thiết yếu như gửi hàng, di chuyển, mua thực phẩm, đọc báo,... đều có thể tìm được bằng vài lần nháy chuột đơn giản. Máy tính cung cấp nhiều lựa chọn giải trí nên được nhiều người sử dụng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "knowledge_name": "Em cần nhớ", "knowledge_content": "Máy tính có khả năng tính toán nhanh, bền bỉ, chính xác; lưu trữ dữ liệu với dung lượng lớn; kết nối toàn cầu với tốc độ cao. Máy tính được ứng dụng hiệu quả trong nhiều lĩnh vực của khoa học kĩ thuật và đời sống."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "knowledge_name": "3. Tác động của công nghệ thông tin lên giáo dục và xã hội", "knowledge_content": "Công nghệ thông tin tạo ra những thay đổi to lớn trong lĩnh vực giáo dục (như học trực tuyến, tài nguyên số, học liệu mở) và đời sống xã hội."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "knowledge_name": "1. Vai trò của chất lượng thông tin trong giải quyết vấn đề", "knowledge_content": "Chất lượng thông tin đóng vai trò quyết định trong việc giải quyết các vấn đề đặt ra trong cuộc sống. Khi tìm kiếm, tiếp nhận và trao đổi thông tin, cần quan tâm đến chất lượng thông tin để tránh đưa ra những quyết định sai lầm."}, {"grade_level": "Lớp 9", "lesson_id": "Bài", "knowledge_name": "Ý nghĩa của thông tin và chất lượng thông tin", "knowledge_content": "Thông tin là cơ sở để đưa ra các quyết định. Cần phải quan tâm đến chất lượng thông tin khi tìm kiếm, tiếp nhận, trao đổi và sử dụng thông tin để có thể đưa ra các quyết định đúng đắn. Internet là một kho thông tin khổng lồ nhưng không phải thông tin nào cũng có thể sử dụng để giải quyết vấn đề một cách hiệu quả. Không phải số lượng bản tin mà là chất lượng của thông tin mới thực sự làm cho thông tin trở thành hữu ích."}, {"grade_level": "Lớp 9", "lesson_id": "Bài", "knowledge_name": "2. Chất lượng thông tin", "knowledge_content": "Mặc dù thông tin đóng vai trò quan trọng trong việc ra quyết định nhưng không phải thông tin nào cũng hữu ích đối với việc giải quyết vấn đề. Chất lượng thông tin thể hiện ở mức độ đáp ứng của thông tin đối với các yêu cầu cụ thể nhằm giải quyết vấn đề, làm thông tin trở nên hữu ích. Để đánh giá chất lượng thông tin, em cần xem xét các tiêu chí như tính mới, tính chính xác, tính đầy đủ, tính sử dụng được của thông tin.\n- Tính mới (tính cập nhật): Tính mới cho biết thông tin đã bị lỗi thời chưa. Em cần thông tin cập nhật gần nhất vào thời gian nào? Nếu thông tin đã lỗi thời, cũ hoặc chậm trễ, em có thể chọn nhầm trường hoặc bỏ lỡ cơ hội vì không biết những thay đổi của các trường.\n- Tính chính xác, đúng đắn của thông tin: Nội dung có cụ thể không? Có cách để xác minh hay không? Nếu thông tin không chính xác (ví dụ: sai điểm tuyển sinh, sai..."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "knowledge_name": "Các tiêu chí đánh giá chất lượng thông tin", "knowledge_content": "- Tính đầy đủ: Thể hiện sự bao quát nhiều khía cạnh, cho cái nhìn tổng thể về vấn đề cần đặt ra.\n- Tính sử dụng được (tính liên quan, phù hợp): Thông tin phải liên quan và phù hợp với vấn đề hay câu hỏi được đặt ra.\n- Chất lượng thông tin là yếu tố quan trọng, quyết định hiệu quả của việc giải quyết vấn đề.\n- Chất lượng thông tin được đánh giá thông qua tính mới, tính chính xác, tính đầy đủ, tính sử dụng được."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 3", "knowledge_name": "1. Xác định mục đích, yêu cầu tìm kiếm thông tin", "knowledge_content": "Xác định rõ mục đích tìm kiếm (ví dụ: tìm thông tin về các trường THPT tại địa phương để quyết định lựa chọn nguyện vọng đăng kí) và những yêu cầu tìm kiếm cụ thể như: điểm chuẩn, chỉ tiêu tuyển sinh, tỉ lệ tốt nghiệp và trúng tuyển đại học, nhóm môn học thế mạnh, hoạt động ngoại khoá, khoảng cách từ nhà đến trường."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 3", "knowledge_name": "2. Thực hiện tìm kiếm", "knowledge_content": "Sử dụng máy tìm kiếm và các từ khoá tìm kiếm (xác định từ khoá dựa trên yêu cầu tìm kiếm) để tìm thông tin trên Internet. Lưu trữ tóm tắt (nội dung tóm tắt, địa chỉ trang web) của thông tin tìm được vào một tệp để sử dụng trong việc đánh giá ở bước tiếp theo."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "Sử dụng công cụ hội thoại thông minh và đánh giá độ tin cậy của thông tin", "knowledge_content": "Có thể sử dụng công cụ hội thoại thông minh (công cụ tương tác giữa người với máy tính có ứng dụng trí tuệ nhân tạo) để khoanh vùng phạm vi tìm kiếm với những yêu cầu cụ thể. Ví dụ: 'Hãy cho biết tên các trường THPT gần Vĩnh Tường, Vĩnh Phúc để biết các trường có địa điểm ở gần nhà'. Người dùng có thể tìm kiếm thông tin từ nhiều nguồn nhưng cần lưu ý rằng độ tin cậy của thông tin trên Internet rất khác nhau. Vì vậy, với mỗi yêu cầu cụ thể, nguồn thông tin cần được xem xét về thẩm quyền để đảm bảo tính tin cậy. Ví dụ: Thông tin về tuyển sinh vào lớp 10 cần tìm trên website của Sở Giáo dục và Đào tạo (lưu ý: trang web các Sở thường có dạng .edu.vn như vinhphuc.edu.vn); thông tin về các hoạt động giáo dục và ngoại khóa nên tìm trên website của nhà trường. Không phải mọi thông tin đều có thể tìm được trên website của Sở Giáo dục và Đào tạo hoặc của các trường, thông tin cần được đối chiếu, kiểm chứng trước khi sử dụng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "a) Đánh giá thông tin", "knowledge_content": "- Tính mới: Thông tin được cập nhật gần nhất, kiểm tra ngày đăng bài hoặc ngày cuối cùng được đề cập đến trong bài viết.\n- Tính chính xác: Kiểm tra thông tin bằng cách đối chiếu thông tin từ những nguồn khác nhau.\n- Tính đầy đủ: Hình dung về một trường THPT trong một bức tranh tổng thể, gồm nhiều khía cạnh trong yêu cầu tìm kiếm thông tin.\n- Tính sử dụng được: Kiểm tra thông tin tìm được có phù hợp với yêu cầu chọn trường hay không nhờ tiêu đề và nội dung của bài viết, tránh tập trung vào những thông tin chỉ nhằm thu hút sự chú ý."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "b) Lựa chọn và sắp xếp thứ tự", "knowledge_content": "- Dựa trên thông tin tìm được, lựa chọn các trường phù hợp với năng lực và sở thích của mình, lưu ý tính khả thi.\n- Sắp xếp các trường được chọn theo một danh sách ưu tiên giúp xác định danh sách các trường được chọn một cách thuận lợi hơn."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "knowledge_name": "Khởi động", "knowledge_content": "Trong thời đại kĩ thuật số phát triển, hầu hết thông tin ở dạng số. Điều này khiến cho đời sống xã hội thay đổi toàn diện. Công nghệ kĩ thuật số giúp cho mọi việc của con người trong lao động, sản xuất, học tập hay giải trí,... thuận tiện, dễ dàng và nhanh chóng hơn. Bên cạnh những tác động tích cực đó, công nghệ kĩ thuật số cũng có những tác động tiêu cực đến con người."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "knowledge_name": "1. Một số tác động tiêu cực của công nghệ kĩ thuật số", "knowledge_content": "Mặc dù công nghệ kĩ thuật số thúc đẩy sự phát triển của mọi lĩnh vực trong đời sống, xã hội và đem tới cho chúng ta một cuộc sống ngày càng hiện đại hơn, thông minh hơn, tiện lợi hơn,... nhưng không thể phủ nhận những tác động tiêu cực của công nghệ kĩ thuật số đến con người và xã hội. Đối với con người, công nghệ kĩ thuật số tác động tiêu cực đến sức khoẻ thể chất và tinh thần như: gây nghiện Internet, ít giao tiếp, mất ngủ,...; tác động tiêu cực..."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "knowledge_name": "Tác động tiêu cực của công nghệ kĩ thuật số", "knowledge_content": "Bên cạnh các ứng dụng nhằm nâng cao chất lượng đời sống, phát triển xã hội thì vẫn có những ứng dụng hỗ trợ và phổ biến tệ nạn trên mạng như lừa đảo, tổ chức đánh bạc trực tuyến,... Công nghệ phát triển, tự động hoá ứng dụng nhiều dẫn đến nguy cơ thất nghiệp tăng và khiến cho một bộ phận người dân yếu thế như người già, người khuyết tật hoặc người dân ở các vùng khó khăn càng ngày càng tụt hậu. Đó chính là những tác động tiêu cực đối với xã hội của công nghệ kĩ thuật số. Ngoài ra, công nghệ triển khai nhanh khiến những thiết bị số nhanh chóng trở nên lỗi thời. Những thiết bị số bị thải ra nhiều, sẽ tạo ra rác thải điện tử nguy hại cho môi trường. Một số ví dụ cụ thể về tác động tiêu cực của công nghệ kĩ thuật số là:\n- Chơi game quá nhiều, liên tục có thể gây nghiện. Không được chơi sẽ cảm thấy bứt rứt, khó chịu, không kiểm soát được cảm xúc.\n- Quá lệ thuộc vào công nghệ kĩ thuật số để giải quyết những vấn đề nhỏ trong cuộc sống (học sinh nhờ trí tuệ nhân tạo làm bài tập về nhà, làm văn,...).\n- Trò chuyện trực tuyến với đối tượng ẩn danh hay mạo danh dẫn đến nguy cơ mất an toàn do có thể lộ thông tin cá nhân.\n- Thông tin số có thể bị đánh cấp, gây thiệt hại cho người sử dụng. Ví dụ: Việc lộ thông tin tài khoản ngân hàng có thể bị mất tiền trong tài khoản (Hình 4.1).\n- Thông tin về cha mẹ, số điện thoại, địa chỉ nhà của học sinh có thể bị đánh cấp và bị các đối tượng xấu lợi dụng, giả danh liên hệ để lừa cha mẹ học sinh."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "knowledge_name": "1. Các hành vi vi phạm pháp luật và trái đạo đức trên không gian mạng", "knowledge_content": "- Hành vi vi phạm đến việc bảo đảm an toàn thông tin trên không gian mạng: làm phát tán virus máy tính qua truy cập các liên kết lừa đảo nhận thưởng hoặc gây tò mò.\n- Hành vi tuyên truyền, quảng cáo, giới thiệu sản phẩm, dịch vụ không phù hợp quy định của pháp luật, trái với thuần phong, mỹ tục, lối sống văn minh,... Chẳng hạn, quảng cáo vũ khí, buôn bán động vật quý hiếm,...\n- Hành vi xuyên tạc lịch sử, phủ nhận thành tựu cách mạng, phá hoại khối đại đoàn kết toàn dân tộc, xúc phạm hoặc phân biệt đối xử về tôn giáo, về giới, về chủng tộc, về vùng miền,..."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "knowledge_name": "2. Trách nhiệm và ứng xử khi hoạt động trong môi trường số", "knowledge_content": "- Khi hoạt động trong môi trường số, sử dụng các dịch vụ Internet, người sử dụng cần có trách nhiệm, không vi phạm pháp luật và ứng xử lành mạnh, có văn hóa.\n- Khi hoạt động trong môi trường số, em cần cẩn trọng, tránh vi phạm bản quyền khi sử dụng dữ liệu, phần mềm và cảnh giác với các giao tiếp trên mạng. Đồng thời khi giao tiếp cũng luôn thể hiện là người có văn hóa, tôn trọng mọi người."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 5", "knowledge_name": "1. Phần mềm mô phỏng", "knowledge_content": "Phần mềm mô phỏng giúp người dùng tái hiện lại các quá trình, hiện tượng hoặc hoạt động thực tế trên máy tính. Việc sử dụng phần mềm mô phỏng pha màu cho phép chọn màu, tăng giảm tỉ lệ các màu và nhìn thấy màu kết quả được tạo ra trên màn hình, giúp tiết kiệm vật liệu, thời gian, đồng thời tạo hứng thú trong việc tìm hiểu về màu sắc và hệ thống màu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "knowledge_name": "Phần mềm mô phỏng", "knowledge_content": "Phần mềm mô phỏng là phương tiện giúp em quan sát và hình dung ra những hiện tượng khó hoặc không thể trải nghiệm trong thực tế, giúp em giải quyết nhiều vấn đề trong học tập. Ví dụ: Phần mềm Crocodile Physics hay phần mềm trực tuyến PhET mô phỏng thí nghiệm vật lí (Hình 5.2); Crocodile Chemistry hoặc ChemLab mô phỏng thí nghiệm hoá học; GeoGebra, Cabri II plus, Cabri 3D, Geometer's Sketchpad giúp vẽ hình học và giải toán; Flowalgorithm cho phép chạy thử thuật toán dạng sơ đồ khối trước khi cài đặt trong một ngôn ngữ lập trình. Bên cạnh đó, phần mềm mô phỏng còn có thể sử dụng trong nhiều lĩnh vực khác như nghiên cứu chuyển động và tương tác giữa các phân tử, nghiên cứu và xây dựng giải pháp giao thông."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "knowledge_name": "2. Lợi ích của phần mềm mô phỏng", "knowledge_content": "Phần mềm mô phỏng thể hiện trực quan sự vận động của một đối tượng, cho phép người dùng tương tác và tìm hiểu cách thức hoạt động của đối tượng đó. Phần mềm mô phỏng pha màu giúp em học cách tạo ra màu mới từ những màu đã cho mà vẫn tiết kiệm được thời gian và vật liệu. Ngoài ra, bằng cách thay đổi các lựa chọn của phần mềm, em có thể tìm hiểu được những hệ màu cơ bản."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "knowledge_name": "Giới thiệu phần mềm mô phỏng", "knowledge_content": "Phần mềm mô phỏng trình bày các hiện tượng khoa học bằng cách sử dụng hình ảnh động hay ba chiều, giúp em cảm nhận được sự vận động của các đối tượng. Bằng cách tương tác, khám phá nhiều chức năng của phần mềm mô phỏng dạng thí nghiệm ảo, em không chỉ bổ sung kiến thức về khoa học, toán học, học cách giải quyết một số vấn đề đặt ra trong công nghệ mà còn có thể phát hiện được những điều mới mẻ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "knowledge_name": "b) Tương tác với phần mềm", "knowledge_content": "Trong cửa sổ, em có thể quan sát được sự chuyển hoá của các dạng năng lượng thông qua những biểu tượng. Em cũng có thể tương tác với ứng dụng bằng cách chọn nguồn năng lượng, thiết bị chuyển hoá năng lượng và thiết bị tiêu thụ năng lượng (Hình 6.4).\n- Thay đổi nguồn năng lượng: người đạp xe, ánh sáng mặt trời, vòi nước chảy, ấm nước sôi (Hình 6.4).\n- Thay đổi thiết bị chuyển hoá năng lượng thành điện năng: pin mặt trời và máy phát điện.\n- Thay đổi thiết bị tiêu thụ điện: bếp điện, bóng đèn sợi đốt, bóng đèn compact, quạt điện.\nc) Nêu kiến thức thu nhận được\n- Em quan sát được những dạng năng lượng nào?\n- Nêu một tình huống năng lượng được chuyển hoá từ dạng này sang dạng khác."}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "knowledge_name": "NHIỆM VỤ 2. ĐO CƯỜNG ĐỘ DÒNG ĐIỆN", "knowledge_content": "Yêu cầu:\nSử dụng phần mềm thí nghiệm ảo lắp ráp mạch điện một chiều. Giải quyết vấn đề đo cường độ dòng điện đi qua một điện trở, chẳng hạn một bóng đèn.\nHướng dẫn:\na) Truy cập phần mềm mô phỏng\n- Thực hiện tương tự Nhiệm vụ 1, chọn CÁC MÔ PHỎNG. Chọn Vật lý.\n- Chọn Bộ lắp ráp mạch điện: DC–Phòng thí nghiệm ảo để vào phòng thí nghiệm ảo lắp ráp mạch điện.\nb) Vẽ mạch điện\n- Kéo các biểu tượng Pin, Đèn tròn, Ampe kế, Công tắc và Dây nối, thả vào vùng hiển thị.\n- Kết nối các thành phần của mạch điện (Hình 6.5a).\nLưu ý: Ampe kế cần mắc nối tiếp với đoạn mạch điện cần đo cường độ dòng điện và không mắc trực tiếp vào hai cực của nguồn điện (Hình 6.5b)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "knowledge_name": "c) Trình bày giải pháp", "knowledge_content": "Tương tác với phần mềm và nêu giải pháp đo cường độ dòng điện trên một đoạn của mạch điện bằng cách trả lời các câu hỏi: Em cần dùng thiết bị nào để đo cường độ dòng điện trên mạch điện? Thiết bị đó được nối song song hay nối tiếp với mạch điện cần đo?"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "knowledge_name": "NHIỆM VỤ 3. TỈ LỆ VÀNG TRONG NGÔI SAO NĂM CÁNH", "knowledge_content": "Sử dụng công cụ đo và tính toán trong phần mềm mô phỏng hình học Geometer's Sketchpad để khám phá tri thức về tỉ lệ các đoạn thẳng xuất hiện trong một ngôi sao có năm cánh cách đều nhau."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "b) Đo độ dài", "knowledge_content": "- Sử dụng công cụ chọn đối tượng để chọn đoạn thẳng AB (Hình 6.6) và chọn Measure/Length để đo độ dài đoạn AB đã chọn.\n- Tương tự như vậy, em sẽ đo được độ dài các đoạn thẳng BC, AC và AD."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "c) Tính tỉ lệ", "knowledge_content": "- Mở công cụ tính bằng cách gõ tổ hợp phím Alt + = hoặc chọn Number/Calculate... (Measure/Calculate... với Geometer's Sketchpad 4.x).\n- Nhập biểu thức cần tính bằng bàn phím, bàn phím ảo hoặc sử dụng chuột để chọn các giá trị đã được đo hoặc tính trước trên màn hình (Hình 6.7)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "knowledge_name": "d) Khám phá tri thức", "knowledge_content": "- Thay đổi kích thước ngôi sao bằng cách kéo thả điểm P hoặc điểm Q, em sẽ thấy số đo các đoạn thẳng AB, BC, AC và AD cũng thay đổi theo.\n- Điều đáng kinh ngạc là dù độ dài của các đoạn thay đổi nhưng tỉ lệ giữa chúng không thay đổi, luôn bằng nhau và xấp xỉ 1,62. Chính xác hơn, ta có:\nAB / BC = AC / AB = AD / AC = (1 + √5) / 2 ≈ 1,618034\n- Tỉ lệ trên có tính chất đặc biệt, được gọi là tỉ lệ vàng. Nếu một hình chữ nhật có tỉ lệ hai cạnh là tỉ lệ vàng thì sau khi cắt bỏ một hình vuông, phần còn lại là một hình chữ nhật cũng có tỉ lệ hai cạnh là tỉ lệ vàng (Hình 6.8b). Một hình chữ nhật như vậy được gọi là hình chữ nhật tỉ lệ vàng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 7", "knowledge_name": "1. Trình bày thông tin trong trao đổi và hợp tác", "knowledge_content": "Sơ đồ tư duy và bài trình chiếu đều là những công cụ hiệu quả để trình bày thông tin. Để sử dụng sơ đồ tư duy hoặc bài trình chiếu trong trao đổi và hợp tác, có thể sử dụng sơ đồ tư duy hoặc bài trình chiếu để trình bày trực tiếp: Đây là cách dễ dàng nhất để cộng tác vì em có thể diễn giải bức tranh toàn cảnh, làm rõ các nội dung chi tiết và trực tiếp trả lời các câu hỏi mà người nghe đặt ra."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Trang 28)", "knowledge_name": "Các hình thức chia sẻ sơ đồ tư duy và bài trình chiếu", "knowledge_content": "Chia sẻ sơ đồ tư duy hoặc bài trình chiếu để các thành viên khác xem khi không có điều kiện trình bày trực tiếp; chia sẻ để các thành viên khác chủ động cập nhật và chỉnh sửa; chia sẻ để cộng tác theo thời gian thực để tất cả các thành viên cùng làm việc trực tuyến chỉnh sửa sản phẩm, mở kênh hội thoại để trao đổi trong quá trình hoàn thiện sản phẩm."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Trang 28)", "knowledge_name": "Sử dụng công cụ trực quan hợp lí", "knowledge_content": "Sử dụng đúng công cụ trực quan theo nguyên tắc đơn giản và rõ ràng, chọn loại công cụ minh hoạ tốt nhất để truyền tải thông điệp (ví dụ trình bày tiến trình lịch sử thì sử dụng sơ đồ dòng thời gian). Đảm bảo chất lượng dữ liệu: công cụ trực quan có thể xem được từ khoảng cách xa, hình ảnh sắc nét, bố cục hợp lí, có thể sử dụng màu sắc để tăng sự chú ý và cải thiện khả năng hiển thị thông tin."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "knowledge_name": "1. Sử dụng phần mềm tạo sơ đồ tư duy có đính kèm dữ liệu", "knowledge_content": "Sử dụng phần mềm tạo sơ đồ tư duy (như MindMaple Lite) để tạo sơ đồ tư duy với chủ đề chính và các chủ đề nhánh. Có thể đính kèm các tệp dữ liệu đa phương tiện như tệp bảng tính Excel (tính toán chi phí, ví dụ KinhPhi.xlsx), tệp hình ảnh (Pascaline.png), tệp văn bản (CharlesBabbage.docx chứa tiểu sử nhà khoa học), và đường liên kết đến video trên Internet."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "knowledge_name": "2. Cách thức đính kèm tệp trong sơ đồ tư duy", "knowledge_content": "Để đính kèm tệp vào sơ đồ tư duy, chọn nhánh của sơ đồ tư duy cần đính kèm tệp, sau đó chọn lệnh Insert/Attachment/Attachment."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "knowledge_name": "Đính kèm tệp và đường liên kết vào sơ đồ tư duy", "knowledge_content": "- Khi hộp thoại mở tệp xuất hiện, chọn tệp cần chèn như minh hoạ ở Hình 8.3. Nháy chuột chọn Open. Biểu tượng tệp đính kèm xuất hiện ở nhánh của sơ đồ (Hình 7.1).\n- Thực hiện tương tự để hoàn thành việc đính kèm các tệp văn bản, hình ảnh, bảng tính vào sơ đồ tư duy.\nc) Đính kèm đường liên kết\n- Chọn nhánh của sơ đồ tư duy cần đính kèm đường liên kết.\n- Chọn Insert/Hyperlink. Khi hộp thoại Hyperlink xuất hiện, sao chép đường liên kết đến video vào ô Link to: (Hình 8.4).\n- Chọn OK để hoàn thành việc chèn đường liên kết."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "knowledge_name": "Nhiệm vụ 2. Trình bày sơ đồ tư duy", "knowledge_content": "Lựa chọn một cách trong các cách sử dụng sơ đồ tư duy để trình bày thông tin đã học ở Bài 7. Chọn một thành viên đóng vai trò trưởng nhóm trình bày nội dung chuẩn bị về Lược sử công cụ tính toán. Trao đổi, thảo luận để bổ sung thêm nội dung cần chuẩn bị và phân công công việc cho các thành viên tiếp tục hoàn thành."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "knowledge_name": "Nhiệm vụ 3. Tạo bài trình chiếu có sử dụng hình ảnh, sơ đồ, video hợp lí", "knowledge_content": "Tạo bài trình chiếu chủ đề Lược sử công cụ tính toán có sử dụng hình ảnh, sơ đồ, video hợp lí. Các bước thực hiện bao gồm khởi động phần mềm trình chiếu, tạo trang tiêu đề, tạo trang dàn ý với các mục: Mở đầu, Dòng thời gian lược sử công cụ tính toán, Blaise Pascal và máy tính cơ học đầu tiên, Charles Babbage và máy tính đa năng, Các thế hệ máy tính điện tử, và sử dụng mẫu có sẵn để tạo sơ đồ dòng thời gian tương tự Hình 8.6."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "knowledge_name": "1. Công cụ xác thực dữ liệu", "knowledge_content": "Ưu điểm nổi bật của phần mềm bảng tính là xử lí dữ liệu tự động. Sử dụng chương trình bảng tính để quản lí tài chính sẽ giúp kiểm soát được tình hình chi tiêu một cách cụ thể, trực quan, từ đó điều chỉnh chi tiêu sao cho phù hợp với thu nhập gia đình và mục tiêu phát triển. Thông tin lưu trữ trong bảng tính điện tử quản lí tài chính sẽ gồm ít nhất hai loại: Thu và Chi."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "knowledge_name": "b) Công cụ xác thực dữ liệu", "knowledge_content": "Khi dùng bảng tính để quản lí tài chính gia đình, em có thể lưu trữ dữ liệu Thu và Chi trên cùng một trang tính hoặc ở hai trang tính khác nhau. Để hạn chế loại dữ liệu hoặc giá trị của dữ liệu khi nhập vào ô tính, em sử dụng công cụ xác thực dữ liệu (Data Validation)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "knowledge_name": "Sử dụng công cụ xác thực dữ liệu (Data Validation)", "knowledge_content": "Để sử dụng công cụ xác thực dữ liệu, trong nhóm lệnh Data Tools của dải lệnh Data, chọn Data Validation. Hộp thoại Data Validation xuất hiện. Tại ô Allow trong thẻ Settings, học sinh lựa chọn kiểu dữ liệu hoặc giá trị dữ liệu cho phù hợp với yêu cầu của từng bài toán cụ thể. Công cụ xác thực dữ liệu (Data Validation) hạn chế kiểu dữ liệu hoặc giá trị dữ liệu nhập vào ô tính, giúp cho việc nhập dữ liệu được chính xác và thoả mãn những yêu cầu bài toán đặt ra."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "knowledge_name": "1. Xác thực dữ liệu với danh sách (List)", "knowledge_content": "Trong thẻ Settings của hộp thoại Data Validation, chọn giá trị List ở mục Allow để dữ liệu nhập vào cột cần thuộc danh sách cho trước. Tại mục Source, chọn vùng dữ liệu chứa danh sách (ví dụ: =$F$2:$F$10) để đưa địa chỉ vùng vào ô Source."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "knowledge_name": "2. Xác thực dữ liệu với số lớn hơn 0", "knowledge_content": "Để giới hạn dữ liệu nhập vào chỉ chấp nhận kiểu số lớn hơn 0, trong thẻ Settings của hộp thoại Data Validation, chọn Whole number ở mục Allow, chọn greater than ở mục Data và nhập 0 vào ô Minimum."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "knowledge_name": "Sử dụng tính năng Data Validation", "knowledge_content": "- Trong thẻ Input Message, nhập nội dung thông báo hướng dẫn người dùng khi chọn ô (ví dụ: Title: 'Dữ liệu kiểu số', Input message: 'Giá trị lớn hơn 0').\n- Trong thẻ Error Alert, nhập nội dung thông báo lỗi khi nhập dữ liệu không hợp lệ (ví dụ: Style: Stop, Title: 'Dữ liệu nhập sai', Error message: 'Hãy nhập lại dữ liệu kiểu số và lớn hơn 0').\n- Khi nhập dữ liệu không đúng với yêu cầu xác thực của ô, màn hình sẽ xuất hiện hộp thoại thông báo lỗi với các nút lệnh Retry, Cancel, Help.\n- Lưu tệp sau khi hoàn thành."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "knowledge_name": "1. Hàm COUNTIF", "knowledge_content": "Hàm COUNTIF được sử dụng để đếm số lượng các ô thỏa mãn một điều kiện nhất định trong một vùng dữ liệu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "knowledge_name": "1. Hàm COUNTIF trong Excel", "knowledge_content": "Hàm COUNTIF dùng để đếm số ô tính trong vùng dữ liệu (range) thoả mãn điều kiện (criteria).\n- Công thức: =COUNTIF(range, criteria)\n- Trong đó:\n  + range: là địa chỉ vùng dữ liệu cần kiểm tra để đếm.\n  + criteria: là điều kiện kiểm tra các ô tính trong phạm vi range."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "knowledge_name": "1. HÀM SUMIF", "knowledge_content": "Trong bài toán quản lí tài chính gia đình, em cần biết tổng số tiền thu, chi theo từng khoản để cân đối sao cho hợp lí. Để tính tổng số tiền theo từng khoản mục, em sử dụng hàm tính tổng theo điều kiện SUMIF. Công thức chung của hàm SUMIF là: =SUMIF(range, criteria, [sum_range])\nTrong đó, ý nghĩa của các tham số như sau:\n- range: là phạm vi chứa các giá trị cần kiểm tra.\n- criteria: là điều kiện kiểm tra các giá trị trong phạm vi range.\n- sum_range (tuỳ chọn, có thể có hoặc không): là phạm vi chứa các giá trị cần tính tổng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "knowledge_name": "2. Thực hành: Sử dụng hàm SUMIF", "knowledge_content": "Nhiệm vụ: Sử dụng hàm SUMIF để tính tổng số tiền của mỗi khoản chi tiêu và khoản thu. Hàm SUMIF cho phép tính tổng các giá trị trong một dải ô thỏa mãn một điều kiện nhất định. Cú pháp: =SUMIF(range, criteria, [sum_range])."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "knowledge_name": "1. Hàm IF", "knowledge_content": "Hàm IF là hàm điều kiện được sử dụng trong bảng tính điện tử để thực hiện các phép tính hoặc đưa ra kết quả khác nhau tùy thuộc vào điều kiện có thỏa mãn hay không. Trong bài toán quản lí tài chính, hàm IF giúp so sánh số tiền chi tiêu thực tế với quy tắc tài chính (ví dụ quy tắc 50-30-20) để đưa ra đánh giá chi tiêu là 'Nhiều hơn' hay 'Ít hơn'."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12", "knowledge_name": "1. Sử dụng hàm điều kiện IF và hàm IF lồng nhau", "knowledge_content": "Dựa trên quy tắc quản lí tài chính 50-30-20, có thể đưa ra nhận xét về tình trạng chi tiêu của mỗi mục. Để điền nhận xét như minh hoạ ở các ô từ O3 đến O5 trong Hình 12a.3, sử dụng hàm điều kiện IF. Công thức chung của hàm IF là: =IF(logical_test, [value_if_true], [value_if_false]). Trong đó, ý nghĩa của các tham số như sau: logical_test: điều kiện kiểm tra; value_if_true: giá trị trả về nếu điều kiện là đúng; value_if_false: giá trị trả về nếu điều kiện là sai. Trong trường hợp tiêu chí kiểm tra cần thoả mãn nhiều mức hơn, sử dụng các hàm IF lồng nhau. Ví dụ sử dụng hai hàm IF lồng nhau cho nhận xét trên như minh hoạ trong Hình 12a.4 là =IF(N3>80%, \"Nhiều quá\", IF(N3>50%, \"Nhiều hơn\", \"Ít hơn\"))."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "knowledge_name": "Sử dụng hàm SUMIF trong bảng tính điện tử", "knowledge_content": "Hàm SUMIF dùng để tính tổng các giá trị trong một vùng thỏa mãn một điều kiện nhất định. Cú pháp cơ bản bao gồm vùng chứa điều kiện, điều kiện và vùng cần tính tổng. Trong bài học này, hàm SUMIF được áp dụng để tổng hợp số tiền chi theo từng mục như Nhu cầu thiết yếu, Mong muốn cá nhân, và Tiết kiệm."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "knowledge_name": "1. Trang tính tổng hợp dữ liệu tài chính gia đình", "knowledge_content": "Dự án sử dụng bảng tính điện tử quản lí tài chính gia đình gồm các trang tính 'Thu nhập', 'Chi tiêu' và trang tính 'Tổng hợp' để cân đối thu chi, giúp kiểm soát chi tiêu gia đình hiệu quả bằng cách tổng hợp thông tin thu chi từ các trang tính thành phần."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "knowledge_name": "Khái niệm và vai trò của video", "knowledge_content": "Video là dạng thông tin đặc biệt (kết hợp của văn bản, âm thanh, hình ảnh). Video tác động đến nhiều giác quan của người xem cùng lúc nên mang đến hiệu quả cao. Trong dự án Triển lãm tin học, nếu các em làm được những video minh hoạ cho các nội dung triển lãm thì sẽ mang đến ấn tượng mạnh cho người xem."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "knowledge_name": "1. Phần mềm làm video và các chức năng chính", "knowledge_content": "Để tạo mới, chỉnh sửa, kết hợp các loại thông tin thành một video theo ý muốn của mình, em cần sử dụng phần mềm làm video. Phần mềm làm video là phần mềm ứng dụng, được thiết kế với các chức năng chính: tạo mới video, chỉnh sửa video, thêm hiệu ứng, tạo các video kết hợp từ nhiều loại thông tin (chèn thêm âm thanh, phụ đề,...), tạo các đoạn hoạt hình từ ảnh, ghi lại và chuyển đổi video sang các định dạng và độ phân giải khác nhau."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "knowledge_name": "Chức năng của phần mềm làm video", "knowledge_content": "Chức năng chính của phần mềm làm video: tạo mới, chỉnh sửa, thêm hiệu ứng, tạo các video kết hợp từ nhiều loại thông tin, tạo các đoạn hoạt hình từ ảnh, ghi lại và chuyển đổi video sang các định dạng và độ phân giải khác nhau."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "knowledge_name": "2. Phần mềm Video Editor", "knowledge_content": "Có nhiều phần mềm làm video, trong đó có loại miễn phí, trả phí, có loại chuyên nghiệp, không chuyên nghiệp. Video Editor (Hình 9b.5) là một phần mềm làm video (được tích hợp sẵn trong hệ điều hành Windows 10, Windows 11) giúp người sử dụng làm video, chỉnh sửa video với các thao tác cơ bản. Video Editor hỗ trợ nhiều định dạng tệp như mp3, wma, wav, mp4, avi, mpg, jpg, bmp, png,... Đây là phần mềm được rất nhiều người sử dụng vì những ưu điểm sau: Giao diện thân thiện, dễ sử dụng. Có đầy đủ những chức năng cơ bản và nâng cao để làm ra video từ dữ liệu hình ảnh, video; thêm hiệu ứng, âm thanh, phụ đề; tự động tạo hoạt hình từ ảnh;... Dễ dàng chia sẻ video. Em có thể sử dụng Video Editor để làm ra các video đáp ứng nhu cầu cuộc sống của cá nhân, gia đình, trường học,... và có thể chia sẻ trên các mạng xã hội như YouTube, Facebook,..."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "knowledge_name": "1. Các bước để làm một video", "knowledge_content": "Để làm video giới thiệu nhanh chóng, hiệu quả, theo đúng mục tiêu đặt ra, cần thực hiện các bước sau:\n- Bước 1. Đưa ra ý tưởng, xây dựng kịch bản: Xuất phát từ mục tiêu ban đầu, phác thảo ra một bản sắp xếp các dữ liệu theo một tiến trình và thời lượng cụ thể.\n- Bước 2. Chuẩn bị dữ liệu: Thu thập tất cả các dữ liệu cần thiết theo kịch bản đã xây dựng. Quay video, chụp ảnh, thu âm thanh bằng máy quay, điện thoại thông minh, webcam; viết phụ đề; tập hợp các tệp dữ liệu vào một thư mục trong máy tính.\n- Bước 3. Nhập dữ liệu, dựng video: Đưa dữ liệu vào phần mềm làm video. Sắp xếp dữ liệu, chỉnh sửa, thêm hiệu ứng, thêm phụ đề,... theo kịch bản đã xây dựng bằng phần mềm làm video.\n- Bước 4. Biên tập video: Xem lại video; Kiểm tra âm thanh, hình ảnh, phụ đề đã đúng theo kịch bản chưa? Có cần thêm hiệu ứng không? Có cần cắt bỏ hay điều chỉnh lại nội dung không?\n- Bước 5. Xuất video: Xuất video đã dựng sang định dạng có thể chia sẻ với người khác."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "knowledge_name": "Các bước làm video nhanh chóng và hiệu quả", "knowledge_content": "Để làm được một video nhanh chóng và hiệu quả theo đúng ý tưởng ban đầu, em nên thực hiện theo các bước: lên ý tưởng, xây dựng kịch bản; chuẩn bị dữ liệu; nhập dữ liệu, dựng video; biên tập video; xuất video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "knowledge_name": "Nội dung Nhiệm vụ 1: Đưa ra ý tưởng, xây dựng kịch bản và chuẩn bị dữ liệu", "knowledge_content": "a) Lên ý tưởng, xây dựng kịch bản: Video giới thiệu về những sản phẩm, kết quả của những dự án học tập môn Tin học như cuốn sổ lưu niệm, hàng cây xanh, hoa ở cổng trường, sân trường, vườn trường, tờ rơi, tài liệu, kết quả hoạt động của CLB Tin học,... Kịch bản chi tiết bao gồm tiêu đề video, đoạn video quay cuốn sổ lưu niệm, đoạn hoạt hình từ ảnh chụp cây hoa, đoạn hoạt hình tờ rơi tài liệu, hiệu ứng chuyển động, hiệu ứng ba chiều, bộ lọc, nhạc nền nhẹ nhàng, thêm phụ đề và lời thuyết minh.\nb) Chuẩn bị dữ liệu: Tạo thư mục 'SanPhamTinHoc' chứa các thư mục con 'DuLieu-AmThanh', 'DuLieu-Anh', 'DuLieu-Video' để lưu trữ các tệp đã thu thập."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "knowledge_name": "Nhiệm vụ 2: Nhập dữ liệu và dựng video", "knowledge_content": "Phần mềm Video Editor cho phép người dùng nhập dữ liệu video và hình ảnh vào thư viện dự án (Project library). Quá trình dựng video theo kịch bản bắt đầu bằng việc tạo tiêu đề cho video, nhập nội dung tiêu đề, chọn kiểu hiển thị, chọn vị trí hiển thị và sử dụng các nút điều khiển để xem trước kết quả."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "knowledge_name": "Cắt ngắn đoạn video và thay đổi thời gian hiển thị ảnh", "knowledge_content": "Bước 2: Cắt ngắn đoạn video quay cuốn sổ lưu niệm bằng cách kéo thả đoạn video vào bàn dựng, nháy chuột chọn nút Trim để cắt đoạn video theo độ dài yêu cầu (ví dụ từ 9.05 giây rút ngắn còn 7 giây). Bước 3: Tạo đoạn hoạt hình từ hình ảnh bằng cách kéo thả các ảnh chụp vào bàn dựng (mặc định mỗi ảnh hiển thị trong 3 giây), sau đó có thể thay đổi thời gian hiển thị của mỗi ảnh thành 2 giây bằng cách chọn công cụ Duration."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "knowledge_name": "Bước 4. Thêm hiệu ứng chuyển động", "knowledge_content": "- Nháy chuột vào ảnh ở ngay sau đoạn video để chọn. Nháy chuột vào nút Motion để thêm hiệu ứng chuyển động vào ảnh đang chọn. Một cửa sổ mới mở ra cho phép em thực hiện một số thao tác để thêm hiệu ứng chuyển động. Em thực hiện theo các hướng dẫn ở Hình 10b.10: 1. Chọn kiểu hiệu ứng Zoom in center; 2. Nháy vào đây để hoàn thành việc tạo hiệu ứng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "knowledge_name": "Thêm hiệu ứng ba chiều vào video", "knowledge_content": "Phần mềm Video Editor cung cấp một số hiệu ứng ba chiều (3D effects) để thêm vào video, làm cho video thêm ấn tượng và thú vị. Hiệu ứng được mặc định hiển thị trong khoảng thời gian hiển thị của ảnh, có thể kéo thả hai con chạy hình chữ nhật để đặt khoảng thời gian cho hiệu ứng theo ý muốn."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "knowledge_name": "1. Chỉnh sửa âm lượng hiệu ứng âm thanh", "knowledge_content": "Hiệu ứng ba chiều bao gồm cả hiệu ứng hình ảnh và âm thanh. Người dùng có thể nháy chuột chọn nút Edit để mở giao diện chỉnh sửa và điều chỉnh âm lượng cho hiệu ứng âm thanh trong phần mềm biên tập video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "knowledge_name": "2. Thêm bộ lọc (Filters) vào video và hình ảnh", "knowledge_content": "Bộ lọc (trong lĩnh vực quay phim, chụp ảnh) là những thiết bị hoặc hiệu ứng phần mềm giúp thu được các hiệu ứng cụ thể cho ảnh như giảm độ loá, tạo tông màu ấm/lạnh hơn, tăng cường màu sắc. Phần mềm Video Editor cung cấp một số bộ lọc (Filters) để người dùng thêm vào ảnh hoặc video trong bàn dựng, giúp thay đổi gam màu theo ý thích."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "knowledge_name": "1. Thêm nhạc nền cho video", "knowledge_content": "Nhạc nền giúp tăng tính sinh động cho video. Phần mềm cho phép chọn các bản nhạc có sẵn, tự động điều chỉnh độ dài khớp với đoạn video, đồng bộ video với nhịp âm thanh và điều chỉnh âm lượng nhạc nền."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "knowledge_name": "2. Thêm phụ đề vào video", "knowledge_content": "Phụ đề (như tên dự án, tiêu đề) giúp người xem nắm bắt nội dung chính của video. Sử dụng công cụ Text để thêm và định dạng phụ đề vào đầu đoạn video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "knowledge_name": "1. Một số việc cần thực hiện để hoàn thiện việc dựng video", "knowledge_content": "Không thể nhập dữ liệu âm thanh vào thư viện dữ liệu theo cách đã nhập dữ liệu ảnh và video. Muốn đưa âm thanh vào video, em cần sử dụng chức năng Custom audio của phần mềm làm video. Ngoài các chức năng cơ bản, phần mềm làm video còn cung cấp các chức năng nâng cao để xử lý các vấn đề có thể gặp phải trong quá trình dựng video như: xoay hướng video, hình ảnh (Rotate) khi bị lệch 90 độ do quay bằng điện thoại nằm ngang; phân chia (Split) để tách video thành hai đoạn khi cần chèn thêm hình ảnh vào giữa; cung cấp các mẫu định dạng video (Themes) để tạo các đoạn video nhanh chóng và chuyên nghiệp."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "knowledge_name": "Thêm âm thanh vào dự án làm video", "knowledge_content": "Để đưa tệp âm thanh vào đoạn video, thực hiện chọn khung hình của đoạn video trong bàn dựng, chọn Custom audio ở góc trên, bên phải màn hình. Nháy chuột chọn Add audio file để mở tệp âm thanh từ thư mục. Có thể điều chỉnh âm lượng bằng thanh trượt hoặc sử dụng tính năng Fade in, Fade out."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "knowledge_name": "Phân chia video (Split) và xử lý âm thanh", "knowledge_content": "Để phân chia một đoạn video thành các phần nhỏ, ta di chuyển con chạy đến vị trí muốn phân chia và chọn công cụ Split. Sau khi phân chia, ta có thể chèn hình ảnh hoặc các thành phần khác vào giữa các đoạn video. Ngoài ra, phần mềm hỗ trợ thêm tệp âm thanh tùy chỉnh (Custom audio), điều chỉnh âm lượng và tạo hiệu ứng âm thanh như Fade in (tăng dần), Fade out (giảm dần)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13", "knowledge_name": "Khái niệm biên tập video", "knowledge_content": "Biên tập video là việc tìm ra các vấn đề chưa đúng, chưa tốt còn tồn tại để chỉnh sửa sao cho sản phẩm video được hoàn chỉnh về cả mặt hình thức lẫn nội dung trước khi trình chiếu hay chia sẻ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "knowledge_name": "1. Nhiệm vụ 1: Thiết lập thời lượng hiển thị cho tiêu đề", "knowledge_content": "Cho phép tuỳ chỉnh thời gian hiển thị của dòng tiêu đề trên video thông qua việc điều chỉnh thanh thời lượng (Text duration) trên giao diện phần mềm biên tập video, ví dụ hiển thị từ giây thứ 1 đến giây thứ 3 hoặc giây thứ 5."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "knowledge_name": "2. Nhiệm vụ 2: Xuất video", "knowledge_content": "Sử dụng lệnh Finish video ở góc trên bên phải giao diện phần mềm để xuất video thành tệp có định dạng mp4. Cửa sổ Finish your video cho phép chọn chất lượng tệp video (High, Medium, hoặc Low), sau đó nháy chuột chọn Export để mở cửa sổ Save As, nhập tên video và lưu lại."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "knowledge_name": "1. Giải quyết vấn đề", "knowledge_content": "Quá trình giải quyết vấn đề bao gồm: Tìm hiểu vấn đề (xác định yếu tố đã cho và kết quả cần đạt), Phân tích vấn đề (phân chia vấn đề thành những vấn đề nhỏ hơn, dễ giải quyết hơn), và Lựa chọn giải pháp (lựa chọn cách giải quyết vấn đề theo quy tắc ưu tiên)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "knowledge_name": "Quá trình giải quyết vấn đề", "knowledge_content": "Quá trình giải quyết vấn đề bao gồm các bước sau:\n1) Tìm hiểu vấn đề: xác định những yếu tố đã cho và kết quả cần đạt.\n2) Phân tích vấn đề: xem xét từng khía cạnh của vấn đề, đưa ra nhận định để tìm cách giải quyết.\n3) Lựa chọn giải pháp: dựa trên nhận định ở bước trên, tìm kiếm và lựa chọn cách giải quyết vấn đề.\n4) Trình bày giải pháp: mô tả giải pháp một cách rõ ràng để không gây ra nhầm lẫn khi thực hiện. Trong trò chơi, cách di chuyển phải được mô tả như một thuật toán, sao cho tại mỗi vị trí, robot phải xác định được đúng một hướng (rẽ phải, đi thẳng hay rẽ trái) để di chuyển, không gây ra nhầm lẫn.\n5) Thực hiện giải pháp và đánh giá kết quả: triển khai giải pháp đã chọn và xem xét hiệu quả đạt được để cải thiện hoặc phát hiện những giải pháp mới. Chẳng hạn, thuật toán bám tường có thể được thực hiện với nhiều mê cung có đặc điểm khác nhau để có thể cải thiện với những tình huống đặc biệt."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "knowledge_name": "Ghi nhớ", "knowledge_content": "Giải quyết vấn đề là quá trình, thường được thực hiện qua các bước: 1) Tìm hiểu vấn đề; 2) Phân tích vấn đề; 3) Lựa chọn giải pháp; 4) Trình bày giải pháp; 5) Thực hiện giải pháp và đánh giá kết quả."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "knowledge_name": "2. Trình bày giải pháp - Thuật toán bám tường", "knowledge_content": "Thuật toán bám tường là một trong những giải pháp thoát khỏi mê cung. Trong thuật toán, robot di chuyển sao cho bức tường luôn ở một phía của nó (chẳng hạn phía bên phải). Các tình huống lựa chọn của robot gồm:\n- a) Nếu phía phải không có tường (nghĩa là có đường đi phía bên phải) thì rẽ phải.\n- b) Nếu phía phải có tường mà phía trước không có (đi thẳng được) thì đi thẳng.\n- c) Nếu cả phía phải và phía trước đều có tường thì quay sang trái để chọn hướng lại."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "knowledge_name": "Thuật toán bám tường", "knowledge_content": "Robot là một máy tính. Giải pháp thoát khỏi mê cung cần phải được mô tả một cách rõ ràng sao cho tại mỗi bước đi của nó, robot biết được phải đi theo hướng nào mà không bị nhầm lẫn. Trong thuật toán bám tường (bên phải), robot sẽ ưu tiên đi con đường phía tay phải, nếu không có đường nó mới lần lượt chọn lối đi thẳng hoặc quay sang trái như được mô tả trong Hình 14.2. Thuật toán bám tường có thể được mô tả theo cách liệt kê các bước (Hình 14.3a) hoặc bằng sơ đồ khối (Hình 14.3b).\n\nPhương pháp giải quyết vấn đề (hay giải pháp) có thể được mô tả dưới dạng thuật toán bằng phương pháp liệt kê các bước hoặc bằng sơ đồ khối."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "knowledge_name": "Khái niệm bài toán tin học", "knowledge_content": "Bài toán trong tin học là một nhiệm vụ có thể giao cho máy tính thực hiện. Bài toán đó được xác định bởi dữ liệu đã biết (đầu vào), dữ liệu cần tìm (đầu ra). Đầu vào là những giá trị cho trước, đầu ra là giá trị phải tìm hoặc kết quả của hành động. Máy tính không chỉ tính toán với những giá trị số mà còn có thể xử lí cả những dữ liệu khác như văn bản, hình ảnh, âm thanh,..."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "knowledge_name": "2. Giải bài toán tin học", "knowledge_content": "Việc giải một bài toán tin học cũng trải qua những bước tương tự quá trình giải quyết vấn đề. Các bước bao gồm:\n1) Xác định bài toán: Xác định đầu vào, đầu ra.\n2) Xây dựng thuật toán: Chia bài toán thành những bài toán nhỏ bằng cách trả lời các câu hỏi."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "knowledge_name": "1. Mô tả và cài đặt thuật toán tính lương", "knowledge_content": "Thuật toán tính lương được chia thành các bước: (1) Nhập dữ liệu (đầu vào) gồm muc_luong và tgian_laodong; (2) Xử lý dữ liệu với các cấu trúc rẽ nhánh để tính tgian_dmuc, tgian_vuot và tính tiền lương (tien_luong); (3) Xuất giá trị đầu ra tien_luong. Việc cài đặt thuật toán thành chương trình máy tính là bước thực hiện giải pháp, có thể bổ sung các biến trung gian (như luong_dmuc, luong_vuot) để lưu trữ giá trị trung gian trong quá trình tính toán."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "knowledge_name": "2. Gỡ lỗi và hiệu chỉnh chương trình", "knowledge_content": "Sau khi chương trình được cài đặt, em cần chạy chương trình với những dữ liệu khác nhau, gỡ lỗi và hiệu chỉnh để có một chương trình chạy tốt. Gỡ lỗi là một trong những bước cần thiết của việc lập trình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "knowledge_name": "3. Bài toán tìm giá trị lớn nhất của dãy số", "knowledge_content": "Ví dụ tìm và hiển thị giá trị lớn nhất của những số nguyên dương được nhập vào từ bàn phím, kết thúc bởi số 0. Xác định bài toán: Đầu vào là x (số nguyên dương nhập nhiều lần, kết thúc bởi 0), đầu ra là max (số lớn nhất trong các giá trị đã nhập). Thuật toán có thể mô tả bằng ba bước: (1) Gán cho max giá trị bằng 0; (2) Lặp nhiều lần thao tác nhập x và gán lại max theo giá trị x nhận được (vòng lặp kết thúc khi x = 0); (3) In kết quả. Giá trị khởi đầu vòng lặp: max = 0 để có thể thay đổi khi số nguyên dương đầu tiên được nhập, và các số x nhập vào là số nguyên dương nên số lớn nhất max tìm được cũng là một số nguyên dương."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "knowledge_name": "Thuật toán tìm số lớn nhất", "knowledge_content": "Trường hợp không có số nguyên dương nào được nhập, max không có dữ liệu để so sánh nên không thay đổi. Vì vậy, sau vòng lặp max = 0 thì hiển thị \"Không có dữ liệu!\". Trường hợp các số âm được nhập vào sẽ không được tính nhưng dù có đem so sánh thì cũng không làm sai kết quả. Quy trình giải một bài toán tin học gồm các bước: 1) Xác định bài toán; 2) Xây dựng thuật toán; 3) Cài đặt thuật toán; 4) Gỡ lỗi và hiệu chỉnh chương trình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "knowledge_name": "Nhiệm vụ 1. Tính lương", "knowledge_content": "Lập chương trình tính và hiển thị tiền lương của một nhân viên bằng ngôn ngữ lập trình Scratch dựa trên mức lương (tiền lương trong một giờ làm việc) và số giờ làm việc trong tuần. Các bước cài đặt thuật toán gồm tạo các biến nhớ (biến đầu vào: muc_luong, tgian_laodong; biến đầu ra: tien_luong; biến trung gian: tgian_dmuc, tgian_vuot, luong_dmuc, luong_vuot) và mô tả thuật toán theo ngôn ngữ lập trình, trong đó việc nhập dữ liệu tgian_laodong sử dụng cấu trúc lặp với điều kiện sau cần phải chuyển thành những câu lệnh sử dụng vòng lặp với điều kiện trước cho phù hợp với cấu trúc lặp có sẵn trong ngôn ngữ lập trình trực quan Scratch."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "knowledge_name": "Nhiệm vụ 2. Tìm giá trị lớn nhất - Cài đặt thuật toán", "knowledge_content": "Cài đặt thuật toán tìm giá trị lớn nhất của dãy số nguyên dương không biết trước số lượng, kết thúc khi nhập số 0. Bước 1: Tạo các biến gồm biến đầu vào x và biến đầu ra max. Bước 2: Tạo chương trình bằng cách lắp ghép các khối lệnh Scratch theo cấu trúc vòng lặp điều kiện, kiểm tra điều kiện và cập nhật giá trị max."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "knowledge_name": "Gỡ lỗi chương trình", "knowledge_content": "Khi chạy chương trình, lần lượt nhập các số trong bộ dữ liệu kiểm thử, cần nhập từng số và nhấn phím Enter trước khi nhập số tiếp theo cho đến khi kết thúc bằng số 0."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "knowledge_name": "1. Nghề nghiệp trong tin học", "knowledge_content": "Nghề nghiệp trong lĩnh vực tin học rất đa dạng, bao gồm các nhóm nghề liên quan đến phát triển phần mềm, ứng dụng tin học, quản trị hệ thống, và hỗ trợ kỹ thuật, phục vụ cho nhu cầu chuyển đổi số của các doanh nghiệp và xã hội."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "knowledge_name": "1. Các nhóm nghề nghiệp trong lĩnh vực Tin học", "knowledge_content": "Lĩnh vực tin học chia thành các nhóm nghề nghiệp chính: Nhóm thuộc hướng Khoa học máy tính (như nhà chuyên môn phân tích và phát triển phần mềm, nghiên cứu hệ thống, thuật toán, cơ sở dữ liệu và mạng máy tính) và Nhóm thuộc hướng Tin học ứng dụng (như nhà thiết kế đồ họa và truyền thông đa phương tiện, sử dụng công nghệ thông tin để giải quyết các vấn đề thực tế trong y tế, giáo dục, thương mại, truyền thông...)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "knowledge_name": "1. Bình đẳng giới trong lĩnh vực tin học", "knowledge_content": "Nữ giới có vai trò quan trọng trong phát triển công nghệ nhờ khả năng ghi nhớ tốt, cẩn thận, chu đáo, giao tiếp tốt và chịu được áp lực lớn. Nữ giới làm việc trong lĩnh vực tin học có cơ hội phát triển bản thân nhanh chóng, mức lương cao và được tôn trọng. Các công việc phù hợp với nữ giới gồm thiết kế đồ hoạ, truyền thông đa phương tiện, quản trị web, kiểm thử phần mềm, phân tích dữ liệu,... Không chỉ doanh nghiệp tin học mà nhiều doanh nghiệp khác cũng cần lao động tin học, theo cả hai hướng Khoa học máy tính và Tin học ứng dụng. Mọi người đều có cơ hội tiếp cận các nghề nghiệp trong lĩnh vực tin học theo sở thích, năng lực."}, {"grade_level": "Lớp 9", "lesson_id": "Trang thông tin xuất bản", "knowledge_name": "Thông tin xuất bản và bản quyền", "knowledge_content": "Trang cung cấp thông tin về nhà xuất bản (Nhà xuất bản Giáo dục Việt Nam), ban biên tập, chịu trách nhiệm xuất bản (Tổng Giám đốc Hoàng Lê Bách), tổng biên tập (Phạm Vĩnh Thái), cùng các biên tập viên, họa sĩ thiết kế, đơn vị chế bản và thông tin bản quyền (2024) thuộc Nhà xuất bản Giáo dục Việt Nam."}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "knowledge_name": "Danh mục sách giáo khoa Lớp 9", "knowledge_content": "Bộ sách giáo khoa Lớp 9 - Kết nối tri thức với cuộc sống bao gồm các môn học: Ngữ văn 9 (tập một, tập hai), Toán 9 (tập một, tập hai), Khoa học tự nhiên 9, Công nghệ 9, Lịch sử và Địa lí 9, Mĩ thuật 9, Âm nhạc 9, Giáo dục công dân 9, Tin học 9, Hoạt động trải nghiệm, hướng nghiệp 9, Giáo dục thể chất 9, và Tiếng Anh 9 - Global Success."}] AS row
MATCH (l:Lesson {id: toString(row.grade_level) + '_' + toString(row.lesson_id)})
MERGE (k:Knowledge {id: toString(row.grade_level) + '_' + toString(row.lesson_id) + '_' + toString(row.knowledge_name)})
ON CREATE SET k.name = toString(row.knowledge_name),
              k.content = toString(row.knowledge_content)
MERGE (l)-[:TEACHES_KNOWLEDGE]->(k);

// --- 5. NẠP HÌNH ẢNH, SƠ ĐỒ VÀ GIAO DIỆN (391 VISUAL ASSETS) ---
UNWIND [{"grade_level": "Lớp 6", "lesson_id": "Bai_6_1", "visual_asset_code": "Hình minh họa trang mở đầu Chủ đề 1", "visual_caption": "Tranh minh họa chủ đề Máy tính và cộng đồng", "visual_description": "Tranh vẽ khung cảnh trường học với các học sinh đang vui chơi dưới sân trường trước dãy nhà lớp học có treo cờ đỏ sao vàng. Phía trước là một chiếc kính mắt màu xanh lam cỡ lớn, trên hai tròng kính hiển thị dày đặc các dãy số nhị phân (0 và 1). Hình ảnh mang ý nghĩa sư phạm ẩn dụ: thế giới thực qua lăng kính công nghệ/máy tính được mã hóa và nhìn nhận dưới dạng thông tin và dữ liệu số.", "page_num": "6"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "visual_asset_code": "Hình minh họa đèn giao thông", "visual_caption": "Đèn tín hiệu giao thông", "visual_description": "Hình ảnh mô tả cột đèn giao thông với ba màu đèn đỏ, vàng, xanh. Hình ảnh minh họa cho hoạt động thực tế trên đường, giúp học sinh nhận diện tín hiệu thị giác làm cơ sở để xử lý tình huống qua đường an toàn.", "page_num": "7"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "visual_asset_code": "Hình minh họa dự báo thời tiết", "visual_caption": "Bản tin dự báo thời tiết trên ti vi", "visual_description": "Hình ảnh màn hình tivi hiển thị thông tin dự báo thời tiết hôm nay với biểu tượng ít mây, trời nắng cùng bảng số liệu nhiệt độ thấp nhất (24 độ C) và nhiệt độ cao nhất (31 độ C). Hình ảnh minh họa cho dạng dữ liệu xuất hiện dưới dạng con số, văn bản, hình ảnh.", "page_num": "7"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "visual_asset_code": "Hình minh họa 1", "visual_caption": "Tấm bảng ghi thông tin dịch vụ du lịch", "visual_description": "Ảnh chụp một mảnh giấy viết tay gắn trên bảng với nội dung: 'Đảo Cô Tô. Xuống máy 40.000đ, 35 phút'. Hình ảnh minh họa cho ví dụ về vật mang tin (tấm bảng) và dữ liệu (các số và chữ viết trên bảng).", "page_num": "8"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "visual_asset_code": "Hoạt động 2", "visual_caption": "Thảo luận nhóm tìm thông tin chuẩn bị cho buổi dã ngoại", "visual_description": "Hình vẽ minh họa một nhóm gồm 5 bạn học sinh đang ngồi quanh bàn thảo luận với máy tính xách tay. Các bóng thoại thể hiện ý kiến của từng bạn về việc thu thập các thông tin khác nhau phục vụ chuyến dã ngoại: phong cảnh chụp ảnh, trò chơi, thời tiết, di tích lịch sử và món ăn nhẹ.", "page_num": "9"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "visual_asset_code": "Bảng 1.1", "visual_caption": "Bảng 1.1. Lượng mưa trung bình hàng tháng", "visual_description": "Bảng số liệu thống kê lượng mưa trung bình hàng tháng (theo đơn vị mm) từ tháng 1 đến tháng 12 của 4 thành phố: Hà Nội, Huế, Đà Nẵng, Vũng Tàu (theo Tổng cục Thống kê).", "page_num": "9"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "visual_asset_code": "Hình minh họa cầu thủ sút phạt đền", "visual_caption": "Cầu thủ bóng đá thực hiện quả phạt đền", "visual_description": "Hình vẽ minh họa một cầu thủ mặc áo vàng đang thực hiện cú sút bóng vào góc trên bên trái khung thành, với quả bóng bay về phía khung thành và điểm va chạm tạo hiệu ứng lóe sáng. Hình ảnh trực quan giúp học sinh hình dung quá trình thu nhận thông tin (mắt nhìn thủ môn), xử lí thông tin (não phân tích, đánh giá) và ra quyết định hành động (chân sút bóng) trong tình huống thực tế.", "page_num": "10"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "visual_asset_code": "Hình 1.1", "visual_caption": "Các bước xử lí thông tin của con người", "visual_description": "Sơ đồ minh họa quá trình xử lí thông tin của con người gồm bốn mũi tên chỉ các hoạt động: Thu nhận (từ các giác quan Nghe, Nhìn, Chạm, Nếm, Ngửi qua mũi tên chỉ vào bộ não), Lưu trữ (mũi tên hai chiều dọc ở bộ não kết hợp biểu tượng vật mang tin), Biến đổi (mũi tên hướng lên trên từ bộ não) và Truyền thông tin (mũi tên hướng sang phải từ bộ não đến hình ảnh hai bạn học sinh đang giao tiếp, trao đổi thông tin). Sơ đồ giúp học sinh hình dung trực quan chu trình tiếp nhận, lưu trữ, xử lý và truyền đạt thông tin của con người.", "page_num": "11"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "visual_asset_code": "Hình 1.2", "visual_caption": "Các bước xử lí thông tin của máy tính", "visual_description": "Sơ đồ khối mô tả quá trình xử lí thông tin của máy tính gồm 4 thành phần liên kết với nhau: Thiết bị vào thực hiện thu nhận thông tin gửi tới Bộ xử lí (CPU), từ đó truyền thông tin tới Thiết bị ra, đồng thời tương tác với Bộ nhớ để lưu trữ thông tin. Hình ảnh giúp học sinh trực quan hóa cách thức hoạt động và trao đổi dữ liệu giữa các thành phần phần cứng bên trong hệ thống máy tính.", "page_num": "12"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "visual_asset_code": "Hình 1.3", "visual_caption": "Cách mã hoá số 3", "visual_description": "Sơ đồ minh hoạ cách mã hoá số 3 thông qua phương pháp chia đôi dãy số từ 0 đến 7 qua 3 lần (lần 1, lần 2, lần 3). Bảng trực quan thể hiện quá trình thu hẹp phạm vi tìm kiếm số 3 từ nửa trái sang nửa phải, kết quả ghi nhận các hướng rẽ trái (0) và phải (1) tạo thành dãy bít '011'.", "page_num": "14"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "visual_asset_code": "Bảng biểu diễn số", "visual_caption": "Bảng chuyển đổi các số từ 0 đến 7 sang dãy kí hiệu 0 và 1", "visual_description": "Bảng dữ liệu gồm 2 hàng: hàng trên chứa các số từ 0 đến 7, hàng dưới chứa dãy 3 bit tương ứng biểu diễn các số đó (ví dụ số 0 là 000, số 3 là 011, số 7 là 111), giúp học sinh hiểu cách mã hóa số nguyên thành dãy bit trong máy tính.", "page_num": "14"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "visual_asset_code": "Hình 1.6", "visual_caption": "Hình trái tim", "visual_description": "Hình ảnh hiển thị một hình vuông lưới 8x8 ô, trong đó các ô được tô màu đen và trắng tạo thành hình trái tim. Hình minh họa cho hoạt động chuyển đổi hình ảnh thành dãy bit trong máy tính.", "page_num": "16"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "visual_asset_code": "Bảng 1.3", "visual_caption": "Một số đơn vị cơ bản đo dung lượng thông tin", "visual_description": "Bảng thống kê các đơn vị đo dung lượng thông tin gồm: byte (B, 1 B), kilobyte (KB, 1024 B), megabyte (MB, 1024 KB), gigabyte (GB, 1024 MB), terabyte (TB, 1024 GB) kèm cách đọc và giá trị tương đương trong thực tế.", "page_num": "16"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "visual_asset_code": "Hình 1.7", "visual_caption": "Giao diện hiển thị dung lượng của các ổ đĩa trên máy tính", "visual_description": "Ảnh chụp giao diện Quản lý ổ đĩa (Hard Disk Drives) trên hệ điều hành Windows, hiển thị hai phân vùng ổ đĩa: New Volume (C:) với dung lượng đã dùng và tổng dung lượng 99,9 GB (còn trống 55,0 GB), và Local Disk (D:) với dung lượng tổng 431 GB (còn trống 337 GB). Hình ảnh minh họa thực tế về cách máy tính hiển thị dung lượng bộ nhớ ngoài.", "page_num": "17"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "visual_asset_code": "Hình 1.8", "visual_caption": "Danh sách các tệp tin hình ảnh và dung lượng chi tiết", "visual_description": "Ảnh chụp màn hình danh sách các tệp tin định dạng JPG File (như IMG_0013.jpg, IMG_0014.jpg...) kèm theo cột thông tin Loại (Type) và Kích thước (Size) tính bằng KB (ví dụ: 372 KB, 408 KB, 1,095 KB...). Hình ảnh giúp học sinh quan sát và nhận biết dung lượng cụ thể của các tệp tin trong máy tính.", "page_num": "17"}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "visual_asset_code": "Hình minh họa chủ đề 2", "visual_caption": "Mạng máy tính và Internet", "visual_description": "Tranh minh họa sinh động thể hiện quả địa cầu ở trung tâm với hình mặt cười thân thiện, xung quanh là các học sinh đang sử dụng máy tính để bàn được kết nối với nhau qua các đường cong biểu diễn mạng lưới toàn cầu (Internet). Hình ảnh thể hiện sự kết nối thông tin toàn cầu giữa con người với nhau thông qua mạng máy tính và Internet.", "page_num": "18"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "visual_asset_code": "Hình minh họa bài học", "visual_caption": "Hai bạn học sinh An và Khoa đang ngồi trò chuyện dưới tán cây xanh trước sân trường", "visual_description": "Tranh minh họa đầy màu sắc vẽ hai học sinh (bạn nữ tóc buộc hai bên và bạn nam) đang ngồi trên ghế đá sân trường, xung quanh có cây cối, nhà cửa và con đường. Bức tranh tạo bối cảnh trực quan cho phần khởi động của bài học, nơi hai bạn thảo luận về các mạng lưới trong thực tế như mạng giao thông.", "page_num": "19"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "visual_asset_code": "Hình minh họa 2", "visual_caption": "Minh họa chia sẻ thiết bị máy in chung trong mạng", "visual_description": "Sơ đồ minh họa hệ thống gồm ba máy tính bàn kết nối chung tới một thiết bị máy in đặt ở trung tâm, thể hiện đặc tính chia sẻ và dùng chung thiết bị trên mạng máy tính.", "page_num": "20"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "visual_asset_code": "Hình 2.2", "visual_caption": "Các thiết bị được nối vào mạng", "visual_description": "Sơ đồ minh họa hệ thống mạng kết hợp giữa thiết bị có dây và không dây, bao gồm: Máy tính để bàn, điện thoại di động và máy tính xách tay kết nối qua bộ định tuyến không dây (có biểu tượng sóng wifi), bộ chuyển mạch và bộ định tuyến kết nối với mạng Internet toàn cầu. Hình ảnh giúp học sinh phân biệt rõ ràng giữa phương thức kết nối có dây truyền thống và kết nối không dây hiện đại.", "page_num": "22"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "visual_asset_code": "Hình 2.3", "visual_caption": "Ví dụ cách kết nối 5 máy tính thành một mạng", "visual_description": "Sơ đồ cấu trúc mạng dạng hình sao đơn giản gồm 5 máy tính (được vẽ bằng các khối hình chữ nhật màu xanh lá cây) được kết nối về một thiết bị trung tâm ở phía trên. Sơ đồ minh họa trực quan cách thức bố trí và kết nối nhiều máy tính trong một không gian thực tế như phòng thư viện trường học.", "page_num": "22"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "visual_asset_code": "Hoạt động 3", "visual_caption": "Lợi ích của Internet", "visual_description": "Tranh minh họa một nhóm học sinh đang ngồi quanh bàn học có sử dụng máy tính xách tay và thảo luận sôi nổi về lợi ích của Internet. Các bong bóng hội thoại biểu thị các hoạt động cụ thể: học tiếng Anh trực tuyến, xem phim và chơi trò chơi, tìm tư liệu học tập nhóm, gửi thư điện tử và quảng cáo bán sản phẩm tự làm. Hình ảnh giúp học sinh trực quan hóa các ứng dụng thực tế đa dạng của Internet trong đời sống hằng ngày.", "page_num": "25"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "visual_asset_code": "Hình ghim vàng", "visual_caption": "Không nên truy cập Internet liên tục trong nhiều giờ", "visual_description": "Mẩu giấy ghi chú màu vàng có đinh ghim, nhắc nhở học sinh về việc không nên lạm dụng hoặc ngồi máy tính, truy cập Internet liên tục trong nhiều giờ để bảo vệ sức khỏe thị lực và thể chất.", "page_num": "26"}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "visual_asset_code": "Hình minh họa chủ đề", "visual_caption": "Tổ chức lưu trữ, tìm kiếm và trao đổi thông tin", "visual_description": "Hình vẽ minh họa quả địa cầu được bao quanh bởi một dải băng có dòng chữ 'http://www...', kết hợp với hình ảnh bàn tay đang trỏ vào. Bức tranh thể hiện trực quan khái niệm về mạng thông tin toàn cầu (Internet) kết nối toàn cầu và việc truy cập trang web.", "page_num": "27"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "visual_asset_code": "Hình 3.2", "visual_caption": "Trang Bách khoa toàn thư mở tiếng Việt", "visual_description": "Ảnh chụp giao diện trình duyệt hiển thị trang web Wikipedia tiếng Việt (vi.wikipedia.org). Hình ảnh minh họa các thành phần quan trọng: tên và biểu tượng của trang, ô địa chỉ nhập vi.wikipedia.com rồi nhấn phím Enter, ô nhập từ hoặc cụm từ cần tra cứu, khung chứa các mục chính của trang, khu vực nháy chuột để xem danh sách bài viết chọn lọc, thông tin giới thiệu chung của trang và vị trí nháy chuột để xem bài viết mới. Ý nghĩa sư phạm giúp học sinh nhận diện trực quan giao diện trình duyệt và cách thức tương tác khi tra cứu thông tin trên một trang web cụ thể.", "page_num": "30"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình 3.3", "visual_caption": "Trang thông tin thời tiết của Trung tâm Dự báo Khí tượng Thuỷ văn Quốc gia", "visual_description": "Ảnh chụp giao diện trình duyệt web hiển thị trang web của Trung tâm Dự báo Khí tượng Thuỷ văn Quốc gia. Hình ảnh minh họa các bước thao tác: (1) Nhập địa chỉ khituongvietnam.gov.vn vào ô địa chỉ và nhấn Enter; (2) Nháy chuột vào các liên kết để xem tin; xem tóm tắt thời tiết trong ngày; các nút điều hướng (quay về trang trước, đến trang tiếp theo, quay về trang chủ) và tính năng Bookmark để lưu địa chỉ trang web.", "page_num": "31"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình 3.4", "visual_caption": "Trang thông tin của Đài Truyền hình Việt Nam", "visual_description": "Ảnh chụp giao diện trang web vtvgo.vn hiển thị bản tin Thời sự và lịch phát sóng trực tuyến. Minh họa thao tác (1) Nhập vtvgo.vn vào ô địa chỉ, nhấn Enter; (2) Nháy chuột để xem bản tin thời sự, kết hợp các thành phần giao diện như thanh địa chỉ, các kênh VTV, lịch phát sóng theo ngày và các nút điều khiển phát video.", "page_num": "31"}, {"grade_level": "Lớp 6", "lesson_id": "Bài (tiếp theo)", "visual_asset_code": "Bảng 1", "visual_caption": "Bảng ghép nối nội dung cột A và cột B", "visual_description": "Bảng dạng 2 cột gồm cột A và cột B dùng để kiểm tra mức độ hiểu biết của học sinh về các khái niệm liên quan đến website, trình duyệt web và WWW trên Internet.", "page_num": "32"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình 3.6", "visual_caption": "Tìm kiếm với từ khoá vai trò của tầng ozon", "visual_description": "Ảnh chụp giao diện trang chủ máy tìm kiếm Google minh hoạ hai bước thực hiện: (1) Nhập địa chỉ website www.google.com vào thanh địa chỉ rồi nhấn phím Enter, (2) Nhập từ khoá 'vai trò của tầng ozon' vào ô tìm kiếm rồi nhấn phím Enter.", "page_num": "35"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình 3.7", "visual_caption": "Lọc kết quả tìm kiếm", "visual_description": "Ảnh chụp giao diện trang kết quả tìm kiếm của Google minh hoạ các tuỳ chọn lọc kết quả: nháy vào thẻ 'Hình ảnh' để lọc kết quả dạng hình ảnh, thẻ 'Tin tức' để lọc kết quả là tin tức, thẻ 'Video' để lọc kết quả dạng video, cùng với phần hiển thị chi tiết kết quả tìm kiếm bên dưới.", "page_num": "35"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "visual_asset_code": "Hình 3.12", "visual_caption": "Xem nội dung thư, đăng xuất", "visual_description": "Ảnh chụp giao diện Gmail minh họa cách xem nội dung thư và đăng xuất tài khoản. Giao diện hiển thị danh sách thư đến với các mục được khoanh đỏ như 'Hộp thư đến', tên người gửi 'Thanh Nam Phạm', 'Phiếu học tập', cùng với khung tài khoản cá nhân của Hà Hoàng Hải và nút 'Đăng xuất'. Có các chú thích hướng dẫn: 'Nháy chuột vào đây để mở thư' và 'Nháy chuột vào nút này để hiển thị nút Đăng xuất'.", "page_num": "40"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "visual_asset_code": "Hình 3.13", "visual_caption": "Soạn thư mới và gửi", "visual_description": "Ảnh chụp giao diện cửa sổ 'Thư mới' trong Gmail minh họa các bước soạn và gửi thư. Giao diện hiển thị các trường: Người nhận (thuyk39@yahoo.com), Chủ đề (Thư hỏi thăm bạn), vùng soạn thảo nội dung thư với bức thư mẫu gửi cho bạn Thùy, và nút 'Gửi' ở góc dưới. Các bước thực hiện được đánh số từ (1) đến (5) với các chỉ dẫn trực quan: (1) Nháy chuột vào đây để soạn thư mới, (2) Nhập địa chỉ hộp thư người nhận, (3) Nhập tiêu đề thư, (4) Nhập nội dung thư, (5) Nháy chuột vào nút này để gửi thư, kèm theo biểu tượng Gửi kèm tệp.", "page_num": "40"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Trò chơi: Giải ô chữ", "visual_caption": "Trò chơi giải ô chữ củng cố kiến thức về thư điện tử", "visual_description": "Hình ảnh sơ đồ trò chơi ô chữ gồm các hàng ngang đánh số từ 1 đến 9 và cột dọc màu xanh lá cây chứa từ khóa ẩn. Sơ đồ minh họa trực quan các thuật ngữ liên quan đến thư điện tử giúp học sinh ôn tập các khái niệm về đăng kí tài khoản, mật khẩu, địa chỉ người nhận, tệp đính kèm, nút gửi, nút đăng xuất, hộp thư và nút chuyển thư.", "page_num": "41"}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "visual_asset_code": "Hình mở đầu Chủ đề 4", "visual_caption": "An toàn thông tin trên Internet", "visual_description": "Biểu tượng chiếc khóa lớn màu trắng nằm ở trung tâm vòng tròn bảo mật, xung quanh là các biểu tượng minh họa cho các thiết bị số, ứng dụng, tài liệu, thư điện tử, kết nối mạng và các hoạt động trên Internet. Hình ảnh thể hiện ý nghĩa bảo vệ thông tin, dữ liệu và an toàn cho người dùng trong môi trường số.", "page_num": "42"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình minh họa tác hại", "visual_caption": "Tác hại, nguy cơ khi dùng Internet", "visual_description": "Hình vẽ minh họa một người mặc áo trùm đầu màu xanh đang sử dụng máy tính xách tay trong không gian tối, tượng trưng cho kẻ xấu hoặc nguy cơ tiềm ẩn trên không gian mạng như lừa đảo, đánh cắp thông tin, phát tán mã độc.", "page_num": "44"}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 5", "visual_asset_code": "Trang 47", "visual_caption": "Sổ lưu niệm lớp 6A và danh mục các bài học trong Chủ đề 5", "visual_description": "Hình ảnh minh họa một cuốn sổ lưu niệm mở trang bìa ghi 'SỔ LƯU NIỆM LỚP 6A' bên cạnh trang chứa các hình ảnh chân dung học sinh nhỏ được sắp xếp dạng lưới. Phía trên là tiêu đề Chủ đề 5: Ứng dụng tin học cùng danh sách các bài học: Sơ đồ tư duy, Định dạng văn bản, Trình bày thông tin ở dạng bảng, Tìm kiếm và thay thế, Thực hành tổng hợp: Hoàn thiện sổ lưu niệm. Hình ảnh trực quan khơi gợi hứng thú học tập và định hướng sản phẩm thực hành cuối chủ đề cho học sinh.", "page_num": "48"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "visual_asset_code": "Hình 5.2", "visual_caption": "Sơ đồ tư duy", "visual_description": "Sơ đồ tư duy mẫu minh họa về chính khái niệm 'Sơ đồ tư duy'. Ở trung tâm là chủ đề chính 'Sơ đồ tư duy'. Tỏa ra là các nhánh chính gồm: 'Người sáng tạo' (Tony Buzan, Quốc tịch Anh, Sinh năm 1942), 'Lợi ích' (Nhìn thấy bức tranh tổng thể, Dễ dàng ghi nhớ, Thúc đẩy tư duy, Tăng khả năng sáng tạo, Đơn giản, dễ hiểu, Tiết kiệm thời gian), 'Thành phần' (Từ khóa, Hình ảnh, Đường nối), và 'Làm gì?' (Ghi nhớ thông tin, Tổ chức thông tin gồm Chủ đề chính và Chủ đề nhánh). Sơ đồ sử dụng màu sắc phân biệt trực quan giúp học sinh dễ dàng nắm bắt cấu trúc.", "page_num": "50"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Giao diện MindMaple Lite v1.63", "visual_caption": "Giao diện phần mềm MindMaple Lite v1.63 sau khi khởi động", "visual_description": "Ảnh chụp giao diện phần mềm MindMaple Lite v1.63 hiển thị thanh Ribbon ở trên cùng chứa các thẻ lệnh (File, Home, Insert, View, Review, Share (Web), Tools, Design Tools), khu vực làm việc chính với chủ đề trung tâm (MindMaple Lite v1.63), các nút chức năng mẫu, bảng công cụ bên trái (System Requirements, Contact Us, Extract Main Ideas, Explain the Main Ideas) và bảng Marker - Icon Marker ở bên phải dùng để quản lý độ ưu tiên công việc, biểu tượng cảm xúc.", "page_num": "52"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình giao diện phần mềm MindMap", "visual_caption": "Tạo sơ đồ tư duy", "visual_description": "Ảnh chụp giao diện phần mềm tạo sơ đồ tư duy (MindMaple) minh họa 4 bước thực hiện để tạo mới một sơ đồ tư duy: (1) Nháy chuột vào thẻ File ở góc trên bên trái, (2) Chọn New trên menu dọc bên trái, (3) Chọn một mẫu thiết kế (MindMap, Black Board, Neon Sign), và (4) Nháy chuột vào nút Create ở bên phải để bắt đầu tạo sơ đồ.", "page_num": "53"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình sơ đồ tư duy Sổ lưu niệm lớp 6A", "visual_caption": "Sơ đồ tư duy hoàn chỉnh với các chủ đề nhánh", "visual_description": "Sơ đồ tư duy mẫu với chủ đề trung tâm 'SỔ LƯU NIỆM LỚP 6A' và các chủ đề nhánh xung quanh như 'Các bài viết cảm nghĩ', 'Giới thiệu thành viên' (với các nhánh con 'Họ tên', 'Ngày sinh', 'Địa chỉ liên lạc', 'Ảnh', 'Sở thích'), 'Giáo viên' (với nhánh 'Giáo viên chủ nhiệm'), và 'Hoạt động, sự kiện'. Sơ đồ sử dụng màu sắc sinh động để phân cấp thông tin rõ ràng.", "page_num": "53"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "visual_asset_code": "Sơ đồ tư duy Vận dụng", "visual_caption": "Sơ đồ tư duy tóm tắt nội dung Bài 9. An toàn thông tin trên Internet", "visual_description": "Sơ đồ tư duy dạng phân nhánh trực quan với nút gốc ở trung tâm là 'An toàn thông tin trên Internet'. Nhánh chính màu đỏ thể hiện 'Tác hại, nguy cơ' bao gồm các nhánh con như 'Thông tin cá nhân bị lộ hoặc bị đánh cắp', 'Máy tính bị nhiễm virus hay mã độc', 'Bị lừa đảo, dụ dỗ, đe doạ, bắt nạt trên mạng' và các ô có dấu hỏi chấm (?) chờ học sinh bổ sung. Các nhánh phụ màu xanh lá cây thể hiện giải pháp hoặc nội dung an toàn với các mục 'Giữ an toàn', 'Không gặp gỡ', 'Bảo mật thông tin cá nhân' cùng nhiều ô trống dấu hỏi chấm (?) để học sinh điền tiếp.", "page_num": "54"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "visual_asset_code": "Hình 5.4", "visual_caption": "Các lệnh định dạng đoạn văn bản", "visual_description": "Ảnh chụp giao diện nhóm lệnh Paragraph trong thẻ Home của phần mềm soạn thảo văn bản, hiển thị các nút chức năng như căn thẳng lề trái, căn giữa, căn thẳng lề phải, căn thẳng hai lề, giãn dòng, tăng/giảm mức thụt lề trái, và các tùy chọn khoảng cách giữa các dòng, giữa các đoạn. Hình ảnh giúp học sinh nhận diện trực quan vị trí và biểu tượng của các công cụ định dạng đoạn.", "page_num": "56"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "visual_asset_code": "Hình 5.5", "visual_caption": "Đoạn văn bản sau khi được định dạng", "visual_description": "Ảnh chụp minh họa một trang văn bản đã áp dụng các định dạng như căn giữa tiêu đề, căn thẳng hai lề cho nội dung đoạn văn, thiết lập khoảng cách dòng và khoảng cách giữa các đoạn hợp lý, giúp học sinh thấy rõ hiệu quả trực quan của việc định dạng đoạn văn bản.", "page_num": "56"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "visual_asset_code": "Hình 5.6", "visual_caption": "Trình bày trang văn bản", "visual_description": "Sơ đồ minh họa giao diện trang văn bản trên phần mềm soạn thảo với các chú thích chi tiết về lề trên, lề dưới, lề trái, lề phải và hướng trang đứng khổ giấy A4. Giúp học sinh hình dung trực quan bố cục một trang văn bản chuẩn.", "page_num": "57"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "visual_asset_code": "Hình 5.7", "visual_caption": "Các lệnh để in văn bản", "visual_description": "Ảnh chụp màn hình giao diện cửa sổ Print trong thẻ File của phần mềm soạn thảo Microsoft Word. Giao diện hiển thị các thành phần: nút lệnh Print (In văn bản), danh sách chọn máy in (Chọn máy in), khu vực xem trước trang in (Xem trước khi in), và ô nhập số trang cần in (Nhập trang cần in). Hướng dẫn học sinh các bước cấu hình thông số trước khi xuất tài liệu ra máy in.", "page_num": "57"}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "visual_asset_code": "Hình 5.8", "visual_caption": "Bài viết của bạn An", "visual_description": "Ảnh chụp một trang sổ lưu niệm được đóng khung viền trang trí nét đứt màu xanh lá, bên trong chứa đoạn văn bản 'Cảm nghĩ về nhóm bạn thân lớp 6A' do bạn An viết cùng với hình vẽ minh họa một học sinh nữ đeo khăn quàng đỏ tên là An. Hình ảnh minh họa một sản phẩm văn bản hoàn chỉnh được soạn thảo và trình bày trên máy tính.", "page_num": "58"}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "visual_asset_code": "Hình minh họa căn lề", "visual_caption": "Minh họa kết quả căn lề đoạn văn bản và hình ảnh", "visual_description": "Hai hình chữ nhật mô tả sự thay đổi vị trí của tiêu đề 'CẢM NGHĨ VỀ NHÓM BẠN THÂN LỚP 6A' và hình ảnh sau khi thực hiện thao tác căn lề giữa trong phần mềm soạn thảo văn bản Microsoft Word, giúp học sinh quan sát trực quan sự khác biệt trước và sau khi căn lề.", "page_num": "58"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "visual_asset_code": "Hình 5.9", "visual_caption": "Cách thay đổi hướng trang", "visual_description": "Ảnh chụp màn hình minh họa các bước thực hiện thay đổi hướng trang trong phần mềm soạn thảo văn bản: (1) Nháy chuột chọn thẻ Page Layout, (2) Tìm nhóm Page Setup, (3) Nháy chuột chọn Orientation và chọn hướng trang đứng Portrait.", "page_num": "59"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "visual_asset_code": "Hình 5.10", "visual_caption": "Cách thay đổi lề trang", "visual_description": "Ảnh chụp màn hình minh họa các bước thực hiện thay đổi lề trang trong phần mềm soạn thảo văn bản: (1) Nháy chuột chọn thẻ Page Layout, (2) Tìm nhóm Page Setup, (3) Nháy chuột chọn Margins và chọn mẫu đặt lề trang là Normal.", "page_num": "59"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "visual_asset_code": "Hình 5.11", "visual_caption": "Danh sách lớp", "visual_description": "Hình vẽ minh họa cuốn sổ lưu niệm mở ra, thể hiện hai cách trình bày danh sách học sinh: trang bên trái sử dụng bảng để sắp xếp ảnh và thông tin gọn gàng, khoa học; trang bên phải liệt kê lần lượt danh sách các thành viên theo dòng thông thường. Hình ảnh giúp học sinh trực quan nhận biết ưu điểm của việc trình bày thông tin dưới dạng bảng.", "page_num": "60"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "visual_asset_code": "Bảng thống kê phiếu khảo sát", "visual_caption": "Phiếu khảo sát về sở thích trò chơi tập thể", "visual_description": "Ảnh minh họa một phiếu khảo sát dạng giấy bên cạnh bảng thống kê kết quả gồm các cột: STT, Tên trò chơi, Số bạn nam thích, Số bạn nữ thích. Bên cạnh là phiếu khảo sát cá nhân của học sinh Nguyễn Thu An với các lựa chọn trò chơi yêu thích được đánh dấu.", "page_num": "61"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "visual_asset_code": "Hình 5.12", "visual_caption": "Tạo bảng", "visual_description": "Ảnh chụp giao diện thanh công cụ Ribbon trong phần mềm soạn thảo văn bản, hướng dẫn chi tiết 2 bước để tạo bảng: Bước 1 nháy chọn thẻ Insert, Bước 2 chọn nút tam giác nhỏ dưới nhóm lệnh Table để mở bảng chọn lưới ô vuông.", "page_num": "61"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "visual_asset_code": "Hình 5.13", "visual_caption": "Chọn số cột, hàng của bảng", "visual_description": "Ảnh chụp phóng to lưới chọn kích thước bảng (ví dụ 4x8 Table), minh họa cách kéo chuột để xác định 'Số cột (columns)' theo chiều ngang và 'Số hàng (rows)' theo chiều dọc trước khi chèn bảng vào văn bản.", "page_num": "61"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.17", "visual_caption": "Kết quả sau khi tạo bảng", "visual_description": "Ảnh chụp minh họa bảng được tạo gồm 4 cột và 4 hàng với các đường viền nét liền, hiển thị kết quả sau khi thực hiện lệnh tạo bảng.", "page_num": "63"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.18", "visual_caption": "Chọn ô", "visual_description": "Ảnh minh họa thao tác kéo thả chuột để chọn bôi đen bốn ô ở góc trên bên trái của bảng (gồm 2 cột, 2 hàng được tô màu xanh) nhằm chuẩn bị cho thao tác gộp ô.", "page_num": "63"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Visual Asset", "visual_caption": "Nhóm lệnh Merge", "visual_description": "Ảnh chụp giao diện thanh công cụ Table Tools > Layout, hiển thị nhóm lệnh Merge với các nút: Merge Cells, Split Cells, và Split Table.", "page_num": "63"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.19", "visual_caption": "Chọn lệnh gộp ô", "visual_description": "Sơ đồ chú thích trực quan từ nút 'Chọn Merge Cells' chỉ dẫn đến lệnh Merge Cells trên thanh công cụ Layout trong nhóm thẻ Table Tools.", "page_num": "63"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.20", "visual_caption": "Kết quả gộp ô", "visual_description": "Ảnh minh họa bảng sau khi đã gộp 4 ô ở góc trên bên trái thành một ô lớn chứa thông tin giáo viên chủ nhiệm.", "page_num": "63"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.21", "visual_caption": "Thay đổi kích thước cột và hàng", "visual_description": "Ảnh minh họa hai trường hợp thay đổi kích thước: hình bên trái thể hiện con trỏ chuột thay đổi dạng mũi tên hai chiều trên đường biên dọc để chỉnh độ rộng cột; hình bên phải thể hiện con trỏ chuột trên đường biên ngang để chỉnh độ cao hàng.", "page_num": "63"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "visual_asset_code": "Hình 5.23", "visual_caption": "Tìm kiếm", "visual_description": "Ảnh chụp giao diện phần mềm Microsoft Word minh họa các bước thực hiện tìm kiếm từ 'dưa hấu' trong văn bản công thức làm kem sữa chua dưa hấu. Sơ đồ gồm 3 bước: Bước 1 khoanh vùng thẻ Home trên thanh ribbon; Bước 2 chỉ định nhóm lệnh Editing và chọn Find; Bước 3 hiển thị khung Navigation bên trái liệt kê các kết quả tìm thấy và đánh dấu vàng các từ 'dưa hấu' trong văn bản bên phải.", "page_num": "66"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "visual_asset_code": "Hình 5.24", "visual_caption": "Tìm kiếm và thay thế", "visual_description": "Ảnh chụp giao diện hộp thoại 'Find and Replace' trong phần mềm soạn thảo văn bản Microsoft Word và menu lệnh 'Editing'. Hộp thoại minh họa cụ thể việc điền từ cần tìm 'dưa hấu' vào ô 'Find what' và từ thay thế 'xoài' vào ô 'Replace with'. Các chú thích số từ 1 đến 4 (4a, 4b) hướng dẫn trực quan từng bước thao tác nháy chọn lệnh Editing -> Replace, nhập từ khóa và bấm các nút 'Replace' hoặc 'Replace All' giúp học sinh nắm vững kỹ năng thay thế từ trong văn bản.", "page_num": "67"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "visual_asset_code": "Hình 5.25", "visual_caption": "Tập hợp nội dung vào một tệp", "visual_description": "Ảnh chụp giao diện thanh công cụ (Ribbon) của phần mềm soạn thảo văn bản Microsoft Word, minh họa chi tiết 3 bước để chèn nội dung từ tệp khác: (1) Nháy chuột vào thẻ Insert trên thanh dải lệnh; (2) Trong nhóm lệnh Text, chọn biểu tượng Object; (3) Chọn lệnh Text from File từ menu thả xuống để mở hộp thoại chọn tệp cần chèn vào tệp hiện tại.", "page_num": "68"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.26", "visual_caption": "Tạo trang bìa", "visual_description": "Ảnh chụp giao diện phần mềm soạn thảo văn bản Microsoft Word (thẻ Insert > Cover Page) minh họa các bước tạo trang bìa. Các chú thích đánh số từ (1) đến (4) hướng dẫn chi tiết cách chọn thẻ Insert, mở nhóm lệnh Pages chọn Cover Page, chọn một mẫu trang bìa có sẵn (như mẫu Motion) và sửa lại nội dung, hình ảnh trên trang bìa.", "page_num": "69"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.27", "visual_caption": "Cuốn sổ lưu niệm", "visual_description": "Hình minh họa một cuốn sổ lưu niệm mở ra, trang trái có tiêu đề 'SỔ LƯU NIỆM LỚP 6A' với chữ màu cam nổi bật, trang phải chứa lưới các ô ảnh chân dung của học sinh trong lớp. Hình ảnh thể hiện sản phẩm hoàn thiện của học sinh sau khi thực hành tạo và trang trí sổ lưu niệm.", "page_num": "69"}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 6", "visual_asset_code": "Hình trang 69", "visual_caption": "Học sinh đang thực hành trên máy tính với phần mềm lập trình Scratch", "visual_description": "Tranh vẽ minh họa một học sinh đang ngồi trước máy tính để bàn, sử dụng bàn phím và chuột để lập trình. Màn hình máy tính hiển thị giao diện phần mềm lập trình trực quan Scratch với các khối lệnh nhiều màu sắc và nhân vật chú mèo quen thuộc. Hình ảnh thể hiện hoạt động thực hành giải quyết vấn đề và viết chương trình máy tính.", "page_num": "70"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "visual_asset_code": "Hình 6.2", "visual_caption": "Sơ đồ khối mô tả cách gấp hình trò chơi Đông-Tây-Nam-Bắc", "visual_description": "Sơ đồ khối thể hiện chi tiết thuật toán gấp hình trò chơi Đông-Tây-Nam-Bắc bằng các hình khối quy ước: Bắt đầu (hình bầu dục hồng), Tờ giấy hình vuông (hình bình hành xanh lá), các bước gấp giấy (hình chữ nhật vàng), sản phẩm Hình trò chơi Đông-Tây-Nam-Bắc (hình bình hành xanh lá) và Kết thúc (hình bầu dục hồng). Các mũi tên chỉ rõ trình tự thực hiện từ trên xuống dưới.", "page_num": "73"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.3", "visual_caption": "Sơ đồ khối", "visual_description": "Sơ đồ khối dạng thẳng đứng mô tả thuật toán tính trung bình cộng của hai số a và b. Gồm các khối: Bắt đầu (hình bầu dục), Nhập giá trị a, giá trị b (hình bình hành), Tính Tổng = a + b (hình chữ nhật), Tính giá trị tổng (hình bình hành), và Kết thúc (hình bầu dục).", "page_num": "74"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.4", "visual_caption": "Các hình trong sơ đồ khối biểu diễn thuật toán tính trung bình cộng của hai số", "visual_description": "Sơ đồ khối bị xáo trộn thứ tự các bước được đánh số từ 1 đến 6, yêu cầu học sinh sắp xếp lại để tạo thành sơ đồ khối hoàn chỉnh của thuật toán tính trung bình cộng hai số a và b.", "page_num": "74"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.5", "visual_caption": "Công thức làm kem sữa chua xoài", "visual_description": "Khung nội dung trình bày công thức nấu ăn thực tế bao gồm ba phần: Nguyên liệu (Xoài: 250g, Sữa chua: 100g, Mật ong: 1 thìa cà phê), Dụng cụ (1 tô to, 4 khuôn làm kem), và Hướng dẫn gồm 7 bước được đánh số từ 1 đến 7 minh họa cho việc mô tả thuật toán bằng phương pháp liệt kê trong đời sống.", "page_num": "74"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.7", "visual_caption": "Sơ đồ khối mô tả cấu trúc rẽ nhánh dạng thiếu", "visual_description": "Sơ đồ khối minh họa cấu trúc rẽ nhánh dạng thiếu với khối điều kiện hình thoi 'Trả lời đúng?'. Nếu điều kiện là 'Đúng', luồng đi tới khối hành động 'Cộng 1 điểm'; nếu 'Sai', luồng bỏ qua và đi thẳng xuống dưới.", "page_num": "76"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.8", "visual_caption": "Sơ đồ khối mô tả cấu trúc rẽ nhánh dạng đủ", "visual_description": "Sơ đồ khối minh họa cấu trúc rẽ nhánh dạng đủ với điều kiện 'Câu khẳng định đúng hay sai?'. Nhánh 'Đúng' dẫn đến hành động 'Gật đầu', trong khi nhánh 'Sai' dẫn đến hành động 'Lắc đầu'.", "page_num": "76"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Bảng tổng kết cấu trúc", "visual_caption": "Tóm tắt ba cấu trúc cơ bản: Cấu trúc tuần tự, Cấu trúc rẽ nhánh dạng thiếu, Cấu trúc rẽ nhánh dạng đủ", "visual_description": "Khung tóm tắt trực quan ba dạng cấu trúc điều khiển trong thuật toán gồm sơ đồ khối của cấu trúc tuần tự (Lệnh 1, Lệnh 2, Lệnh 3), cấu trúc rẽ nhánh dạng thiếu và cấu trúc rẽ nhánh dạng đủ kèm giải thích ngắn gọn.", "page_num": "76"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "visual_asset_code": "Hình 6.9", "visual_caption": "Sơ đồ khối mô tả cấu trúc lặp", "visual_description": "Sơ đồ khối minh họa cấu trúc lặp với khối điều kiện hình thoi 'Còn thời gian?' (với hai nhánh 'Đúng' dẫn đến khối hành động 'Đọc phiếu và trả lời' rồi quay vòng lại kiểm tra, và nhánh 'Sai' thoát khỏi vòng lặp). Sơ đồ giúp học sinh trực quan hóa cách thức hoạt động của vòng lặp có điều kiện.", "page_num": "77"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "visual_asset_code": "Hình 6.10", "visual_caption": "Sơ đồ khối chưa hoàn thành", "visual_description": "Sơ đồ khối mô tả thuật toán chú cá di chuyển trong Scratch chưa được điền đầy đủ các bước tương ứng với danh sách: 1. Di chuyển 10 bước, 2. Chạm biên?, 3. Đúng, 4. Sai, 5. Dừng lại. Học sinh có nhiệm vụ quan sát và điền các nhãn vào vị trí thích hợp trong sơ đồ khối.", "page_num": "77"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.11a", "visual_caption": "Sơ đồ khối cấu trúc lặp", "visual_description": "Sơ đồ khối thể hiện cấu trúc lặp (kiểm tra điều kiện trước): luồng thực hiện đi vào từ trên, kiểm tra điều kiện 'Chưa trúng đích?'. Nếu đúng, thực hiện hành động 'Ném bóng vào đích' rồi quay lại kiểm tra điều kiện. Nếu sai, thoát khỏi vòng lặp. Hình vẽ minh họa dạng lặp với điều kiện nằm ở đầu vòng lặp.", "page_num": "78"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.11b", "visual_caption": "Sơ đồ khối cấu trúc lặp", "visual_description": "Sơ đồ khối thể hiện cấu trúc lặp tương tự Hình 6.11a nhưng có sự khác biệt về đường đi của mũi tên điều hướng rẽ nhánh khi kiểm tra điều kiện 'Chưa trúng đích?'. Đây là dạng biểu diễn sơ đồ khối cấu trúc lặp trong thuật toán.", "page_num": "78"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.12a", "visual_caption": "Sơ đồ khối mô tả cấu trúc lặp việc đọc lại sách và làm bài tập", "visual_description": "Sơ đồ khối gồm điều kiện 'Chưa hiểu bài?'. Nếu đúng, thực hiện 'Đọc lại sách' sau đó 'Làm bài tập' rồi quay lại kiểm tra điều kiện. Nếu sai, kết thúc vòng lặp. Minh họa cho cấu trúc lặp với nhiều thao tác bên trong thân vòng lặp.", "page_num": "78"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.12b", "visual_caption": "Sơ đồ khối mô tả cấu trúc lặp việc đọc lại sách và làm bài tập", "visual_description": "Sơ đồ khối tương tự Hình 6.12a nhưng có cấu trúc đường đi mũi tên khác, thể hiện một cách sắp xếp khác của vòng lặp kiểm tra điều kiện trước hoặc sau trong thuật toán.", "page_num": "78"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.13", "visual_caption": "Chương trình Scratch tính tổng số a và b", "visual_description": "Ảnh chụp màn hình các khối lệnh Scratch (từ số 1 đến 8) mô tả chương trình tính tổng hai số a và b: khi nhấn cờ xanh, nhân vật nói 'Cùng làm toán nhé!', hỏi người dùng nhập số a và gán giá trị vào biến a, tiếp tục hỏi số b và gán vào biến b, sau đó đặt biến tong bằng a + b và hiển thị kết quả tổng.", "page_num": "80"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình 6.15", "visual_caption": "Chương trình Scratch", "visual_description": "Đoạn mã chương trình Scratch gồm các khối lệnh: Khi bấm vào lá cờ xanh, chương trình hỏi nhập điểm toán, điểm văn, điểm tiếng anh, lưu vào các biến a, b, c, tính điểm trung bình (DTB) bằng tổng chia 3. Dùng cấu trúc rẽ nhánh 'nếu DTB > 8.0 thì nói 'Bạn được thưởng ngôi sao' còn không thì nói 'Bạn cố gắng lên nhé'.", "page_num": "82"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "visual_asset_code": "Hình 6.16", "visual_caption": "Chương trình Scratch", "visual_description": "Đoạn mã chương trình Scratch thể hiện cấu trúc lặp: Khi bấm vào lá cờ xanh, nhân vật nói 'Xin chào!' trong 2 giây, sau đó lặp lại 10 lần các hành động di chuyển 10 bước, chơi trống, chỉnh kiểu quay và nếu chạm biên thì bật lại.", "page_num": "82"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.2", "visual_caption": "Thiết bị vào - ra", "visual_description": "Sơ đồ khối mô tả tương tác giữa Bộ xử lý với các nhóm thiết bị: Thiết bị lưu trữ, Thiết bị vào (bàn phím, chuột, máy quét, micro) và Thiết bị ra (màn hình, máy in, loa, máy ảnh, tai nghe). Sơ đồ thể hiện luồng trao đổi dữ liệu giữa bộ xử lý trung tâm và hệ thống thiết bị ngoại vi.", "page_num": "7"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.3", "visual_caption": "Sự đa dạng của thiết bị vào - ra", "visual_description": "Ảnh chụp minh họa ba thiết bị chuyên dụng gồm: a) Bộ điều khiển game cầm tay màu đen có các nút bấm và cần điều khiển; b) Màn hình cảm ứng trên thiết bị di động/máy tính bảng hiển thị giao diện màu cam; c) Tấm cảm ứng (touchpad) trên bàn phím laptop được khoanh viền đỏ. Hình ảnh giúp học sinh nhận diện các thiết bị thay thế hoặc kết hợp cả tính năng vào và ra.", "page_num": "7"}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "visual_asset_code": "Hình 1.5", "visual_caption": "Cổng kết nối của máy tính và các đầu nối thiết bị", "visual_description": "Hình ảnh minh họa mặt sau của thân máy tính để bàn với các cổng kết nối được đánh số từ 1 đến 8 (gồm cổng nguồn, cổng PS/2, cổng VGA/HDMI hiển thị màn hình, các cổng audio/tai nghe/micro, cổng mạng RJ45, cổng USB) kèm theo các đầu nối thiết bị ngoại vi tương ứng được gán chữ cái từ a đến f: a) Bàn phím; b) Dây mạng; c) Chuột; d) Dây màn hình; e) Tai nghe; f) Dây nguồn. Giúp học sinh nhận diện trực quan vị trí cắm chính xác các thiết bị vào thân máy tính.", "page_num": "9"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "visual_asset_code": "Bảng 1.1", "visual_caption": "Một số việc nên và không nên làm khi sử dụng máy tính", "visual_description": "Bảng so sánh hai cột 'Nên làm' và 'Không nên làm' khi sử dụng máy tính. Cột 'Nên làm' bao gồm các thao tác đúng cách như đọc kĩ hướng dẫn, giữ tay khô sạch, gõ phím dứt khoát nhẹ nhàng, tắt máy bằng nút lệnh Shut down, rút điện trước khi lau dọn, đóng tài liệu trước khi tắt máy. Cột 'Không nên làm' liệt kê các hành vi nguy hiểm như thao tác tùy tiện, để đồ uống gần thiết bị, tác động vật sắc nhọn lên màn hình, ngắt điện đột ngột, chạm vào phần kim loại của máy, hoặc nối máy in khi một trong hai máy đang bật nguồn.", "page_num": "10"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "visual_asset_code": "Hoạt động 2", "visual_caption": "Loại tệp và phần mở rộng", "visual_description": "Bảng hoạt động gồm 2 cột: Cột 'Loại tệp' liệt kê các mục (1) Tài liệu Word, (2) Chương trình viết bằng Scratch, (3) Hình ảnh, (4) Ứng dụng, (5) Trang web, (6) Bài trình bày PowerPoint; Cột 'Phần mở rộng' liệt kê các định dạng a) .jpg, .png, .bmp, b) .exe, .com, .bat, .msi, c) .sb, .sb2, .sb3, d) .ppt, .pptx, e) .htm, .html, f) .doc, .docx. Hoạt động giúp học sinh ghép đúng loại tệp với phần mở rộng tương ứng.", "page_num": "12"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "visual_asset_code": "Bảng 2.1", "visual_caption": "Phân biệt hệ điều hành và phần mềm ứng dụng", "visual_description": "Bảng so sánh chi tiết giữa hệ điều hành và phần mềm ứng dụng theo 4 tiêu chí: Tương tác với phần cứng (Hệ điều hành trực tiếp quản lí và vận hành phần cứng; phần mềm ứng dụng tương tác qua hệ điều hành), Sự cần thiết (Hệ điều hành phải cài đặt đầu tiên; phần mềm ứng dụng có thể có hoặc không), Phụ thuộc (Hệ điều hành tạo môi trường chạy phần mềm ứng dụng; phần mềm ứng dụng chạy trong môi trường hệ điều hành), và Ví dụ (Hệ điều hành gồm Windows, Linux, MacOS, Android, iOS; phần mềm ứng dụng gồm Mind Maple, MS Word, MS Paint, Photoshop).", "page_num": "13"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "visual_asset_code": "Bảng 3.1", "visual_caption": "Ưu và nhược điểm của một số thiết bị lưu trữ", "visual_description": "Bảng hệ thống hóa chi tiết gồm 4 cột: Thiết bị lưu trữ, Hình ảnh minh họa, Ưu điểm và Nhược điểm của các thiết bị: Thẻ nhớ/USB, Đĩa quang (CD, DVD), Ổ cứng ngoài, và Lưu trữ nhờ công nghệ đám mây. Hình ảnh minh họa trực quan giúp học sinh nhận diện hình dáng thực tế của từng thiết bị.", "page_num": "16"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "visual_asset_code": "Hình 3.2", "visual_caption": "Biểu tượng của một số phần mềm diệt virus", "visual_description": "Hình ảnh hiển thị logo và biểu tượng nhận diện của các phần mềm diệt virus phổ biến trên thị trường gồm Kaspersky, AVG, Avira, Bkav và Avast. Giúp học sinh nhận biết trực quan các ứng dụng bảo mật thường được cài đặt trên máy tính.", "page_num": "16"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 3.3", "visual_caption": "Sơ đồ cây thư mục", "visual_description": "Sơ đồ cấu trúc cây thư mục trực quan bắt đầu từ ổ đĩa C:\\ phân nhánh thành các thư mục con 'DuLich' và 'HocTap'. Thư mục 'DuLich' chứa các thư mục con 'GiaDinh', 'DiemDen'. Thư mục 'GiaDinh' chứa 'BinhMinh' và 'BanNgay'. Thư mục 'BinhMinh' chứa thư mục 'HoangHon' và các tệp hình ảnh 'PhaoHoa01.jpg', 'PhaoHoa02.jpg'. Hình ảnh minh họa trực quan cách tổ chức phân cấp tệp và thư mục trong hệ thống tệp của máy tính.", "page_num": "17"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 3.4", "visual_caption": "Đặt tên mới cho thư mục", "visual_description": "Ảnh chụp màn hình minh họa thao tác đổi tên thư mục từ 'New Folder' thành 'DuLich' bằng cách gõ tên trực tiếp trên giao diện hệ điều hành Windows.", "page_num": "18"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 3.5", "visual_caption": "Các thư mục được tạo", "visual_description": "Ảnh chụp màn hình hiển thị kết quả sau khi tạo và sắp xếp các thư mục con 'GiaDinh' và 'DiemDen' bên trong thư mục gốc 'DuLich'.", "page_num": "18"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 3.6", "visual_caption": "Các lệnh đổi tên, di chuyển, sao chép, xoá,... thư mục", "visual_description": "Sơ đồ chỉ dẫn chi tiết menu ngữ cảnh (Context menu) khi nháy chuột phải vào thư mục/tệp với các lệnh Cut (Chuyển thư mục vào bộ nhớ), Copy (Sao chép thư mục vào bộ nhớ), Paste (Dán thư mục từ bộ nhớ ra), Delete (Xoá thư mục) và Rename (Đổi tên thư mục).", "page_num": "18"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Bảng 4.1", "visual_caption": "Một số mạng xã hội và mục đích sử dụng", "visual_description": "Bảng gồm 2 cột ('Mục đích và ví dụ' và 'Mô tả') liệt kê 4 nhóm mục đích sử dụng mạng xã hội kèm theo biểu tượng và tên minh họa: (1) Giao lưu với bạn bè với logo Facebook và Zalo; (2) Chia sẻ video với logo YouTube; (3) Chia sẻ ảnh với logo Instagram; (4) Diễn đàn học tập, thảo luận với logo minh họa giao diện Scratch. Bảng giúp học sinh nhận diện trực quan các nền tảng mạng xã hội phổ biến và công dụng chính của chúng.", "page_num": "20"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.1", "visual_caption": "Tạo tài khoản", "visual_description": "Ảnh chụp giao diện màn hình đăng ký tài khoản Facebook với các trường thông tin bao gồm Họ, Tên, Số di động hoặc email, Mật khẩu mới, Ngày sinh, Giới tính và nút Đăng ký màu xanh lá cây ở dưới cùng. Hình ảnh minh họa trực quan các bước điền thông tin để khởi tạo tài khoản mạng xã hội cho học sinh.", "page_num": "21"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.2", "visual_caption": "Trang Facebook cá nhân", "visual_description": "Ảnh chụp giao diện trang Facebook cá nhân hiển thị khung đăng trạng thái ('Học ơi, bạn đang nghĩ gì thế?'), các tùy chọn Video trực tiếp, Ảnh/Video, Cảm xúc/Hoạt động và thông báo về tính năng 'Phòng họp mặt trên Messenger'. Hình ảnh minh họa trực quan giao diện trang cá nhân và các tính năng tương tác của mạng xã hội Facebook.", "page_num": "22"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.3", "visual_caption": "Nhập nội dung chia sẻ", "visual_description": "Ảnh chụp phóng to một phần giao diện hộp trạng thái trên Facebook với mũi tên chỉ dẫn: 'Nháy chuột vào hộp trạng thái để nhập nội dung chia sẻ'. Giúp học sinh nắm rõ thao tác tương tác cơ bản khi muốn đăng bài viết mới.", "page_num": "22"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.4", "visual_caption": "Tìm bạn trên Facebook", "visual_description": "Ảnh chụp giao diện thanh tìm kiếm phía trên cùng của mạng xã hội Facebook với khung khoanh đỏ và chú thích 'Nhập tên trên Facebook của bạn vào đây'. Hướng dẫn học sinh cách tìm kiếm và kết nối với bạn bè trên mạng xã hội.", "page_num": "22"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 4.5", "visual_caption": "Kết quả tìm kiếm", "visual_description": "Ảnh chụp giao diện trang mạng xã hội Facebook hiển thị kết quả tìm kiếm với từ khóa 'wikihow'. Có các chú thích hướng dẫn bằng khung màu đỏ chỉ rõ vị trí ảnh đại diện của trang tìm kiếm và dòng chữ 'Nháy chuột vào đây để mở trang Facebook'.", "page_num": "23"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 4.6", "visual_caption": "Gửi yêu cầu kết bạn", "visual_description": "Ảnh chụp giao diện trang cá nhân trên Facebook hiển thị nút 'Thêm bạn bè' màu xanh dương có biểu tượng hình người và dấu cộng. Có chú thích vòng tròn và khung đỏ hướng dẫn 'Nháy chuột vào đây để gửi yêu cầu kết bạn'.", "page_num": "23"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình minh họa 1", "visual_caption": "Biểu tượng bóng đèn (Em cần nhớ)", "visual_description": "Khung ghi nhớ với biểu tượng bóng đèn mang thông điệp sư phạm: 'Luôn sử dụng ngôn ngữ lịch sự và ứng xử có văn hóa khi tham gia giao tiếp qua mạng.'", "page_num": "25"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình minh họa 2", "visual_caption": "Khung lưu ý về ứng xử khi gặp thông tin không phù hợp", "visual_description": "Khung văn bản nền xanh nhạt với biểu tượng mặt cười chú thích: 'Không nên có lời nói, cách ứng xử nào qua mạng mà em không thực hiện như vậy khi gặp trực tiếp!'", "page_num": "25"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.1", "visual_caption": "Cần tránh xa những trang thông tin có nội dung không phù hợp", "visual_description": "Ảnh minh họa một học sinh đang ngồi trước máy tính với thông báo 'CẢNH BÁO: Bạn không được phép truy cập trang web này' hiển thị trên màn hình. Hình ảnh nhắc nhở học sinh cần có ý thức tự bảo vệ bản thân, tránh xa các trang web độc hại và nhờ người lớn hoặc cài phần mềm chặn nội dung không phù hợp.", "page_num": "26"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Sơ đồ 1", "visual_caption": "Lời khuyên phòng tránh nghiện Internet", "visual_description": "Sơ đồ dạng bảng gồm 4 cột chính tương ứng với 4 lời khuyên: 'Chia sẻ', 'Rời xa', 'Giới hạn' và 'Theo đuổi'. Mỗi cột chứa nội dung chi tiết các hành động thiết thực giúp học sinh kiểm soát thời gian dùng Internet và mạng xã hội.", "page_num": "28"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.1", "visual_caption": "Giao diện phần mềm bảng tính", "visual_description": "Ảnh chụp giao diện phần mềm bảng tính (Microsoft Excel hoặc tương tự) với các chú thích chỉ rõ các thành phần: Ô hiện thời (B5), Hộp địa chỉ, Vùng nhập dữ liệu, Hàng ghi tên các cột (A, B, C,...), Cột ghi tên các hàng (1, 2, 3,...), Các trang tính có tên Sheet1, Sheet2 và Khu vực hiển thị dữ liệu.", "page_num": "30"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.2", "visual_caption": "Ô và địa chỉ ô", "visual_description": "Ảnh chụp màn hình giao diện một bảng tính Excel có tiêu đề 'BẢNG ĐIỂM LỚP 7A, NĂM HỌC: 2020-2021'. Hình minh họa cách xác định địa chỉ ô B6 giao giữa Cột B và Hàng 6, đồng thời ô Hộp tên (Name Box) hiển thị giá trị B6 và thanh công thức hiển thị nội dung ô 'Bùi Lê Đình Anh'.", "page_num": "31"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.3", "visual_caption": "Vùng dữ liệu", "visual_description": "Ảnh chụp màn hình bảng tính Excel 'Kết quả thi Tin học trẻ, bảng A, vòng sơ khảo' minh họa cách chọn một khối ô hình chữ nhật được bao quanh bởi đường viền đậm. Chú thích chỉ rõ vùng dữ liệu được đánh dấu có địa chỉ B4:E11, gồm ô góc trên bên trái là B4 và ô góc dưới bên phải là E11.", "page_num": "31"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.4", "visual_caption": "Cách nhập dữ liệu", "visual_description": "Giao diện thanh công thức và lưới ô tính trong phần mềm bảng tính: Hộp tên (Name Box) hiển thị ô hiện thời 'B2', bên cạnh là các nút hủy, chấp nhận và nút fx cùng thanh công thức (Formula Bar) được chú thích là 'Vùng nhập dữ liệu'. Lưới bảng tính minh họa ô B2 đang được chọn thông qua viền đậm, kèm các chú thích chỉ rõ: 'Địa chỉ ô hiện thời', 'Vùng nhập dữ liệu' và 'Nháy chuột vào ô muốn nhập'.", "page_num": "32"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.5", "visual_caption": "Hiển thị dữ liệu", "visual_description": "Bảng tính chứa dữ liệu mẫu minh họa quy tắc căn lề tự động theo kiểu dữ liệu: Cột B chứa văn bản nhãn ('Họ và tên', 'Ngày sinh', 'Tổ', 'Điểm Toán', 'Điểm Ngữ văn', 'Địa chỉ') tự động căn lề trái. Cột C chứa dữ liệu tương ứng: văn bản 'Nguyễn Việt Hương', 'Hoàn Kiếm' tự động căn lề trái; dữ liệu ngày tháng '9/23/2010' và dữ liệu số '3', '8.5', '7' tự động căn lề phải.", "page_num": "32"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 6.6", "visual_caption": "Các lệnh định dạng dữ liệu", "visual_description": "Ảnh chụp màn hình các nhóm lệnh Font và Alignment trên thẻ Home của Microsoft Excel, minh họa các nút chức năng: Phông chữ, Cỡ chữ, Kiểu chữ (đậm, nghiêng, gạch chân), Màu nền ô, Màu chữ, Căn dữ liệu theo chiều dọc (trên, giữa, dưới) và Căn dữ liệu theo chiều ngang (trái, giữa, phải). Giúp học sinh nắm vững các công cụ định dạng trực quan.", "page_num": "33"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 6.7", "visual_caption": "Bảng dữ liệu khảo sát cho dự án Trường học xanh", "visual_description": "Ảnh chụp giao diện bảng tính Excel hiển thị nội dung mẫu của dự án Trường học xanh từ ô A1 đến C8. Tiêu đề chính ở ô A1, tiêu đề bảng ở ô A2, và bảng dữ liệu gồm 3 cột: STT, Địa điểm, Loại cây cùng các dòng nội dung khảo sát thực tế.", "page_num": "33"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "visual_asset_code": "Hình 6.8", "visual_caption": "Bảng dữ liệu sau khi hoàn thành", "visual_description": "Ảnh chụp giao diện bảng tính Excel minh họa 'Dự án trường học xanh' với bảng 'Bảng 1. Khảo sát địa điểm trồng cây'. Bảng gồm các cột STT (căn giữa), Địa điểm và Loại cây (được định dạng nền vàng và chữ in đậm ở tiêu đề bảng). Hình ảnh minh họa kết quả sau khi thực hiện các bước chỉnh sửa, định dạng dữ liệu và đổi tên trang tính.", "page_num": "34"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "visual_asset_code": "Bảng 7.1", "visual_caption": "Một số kí hiệu phép toán dùng trong phần mềm bảng tính", "visual_description": "Bảng liệt kê chi tiết các phép toán gồm Phép cộng (+), Phép trừ (-), Phép nhân (*), Phép chia (/) và Phép lũy thừa (a^x) tương ứng với ký hiệu toán học, ký hiệu trong bảng tính và ví dụ cụ thể giúp học sinh dễ dàng chuyển đổi biểu thức toán học sang công thức trên phần mềm bảng tính Excel.", "page_num": "36"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.3", "visual_caption": "Công thức (cách 1)", "visual_description": "Ảnh chụp minh họa giao diện phần mềm bảng tính với 'Bảng 2. Dự kiến số lượng cây cần trồng'. Ô E4 hiển thị công thức nhập giá trị trực tiếp '=25*10' với kết quả là 250, thể hiện cách tính không tự động cập nhật khi dữ liệu ở ô C4 hoặc D4 thay đổi.", "page_num": "36"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.4", "visual_caption": "Công thức (cách 2)", "visual_description": "Ảnh chụp minh họa giao diện phần mềm bảng tính với 'Bảng 2. Dự kiến số lượng cây cần trồng'. Ô E4 hiển thị công thức sử dụng địa chỉ ô '=C4*D4' với kết quả là 250, thể hiện ưu điểm vượt trội là tự động cập nhật kết quả khi các ô dữ liệu thành phần thay đổi.", "page_num": "36"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 7.5", "visual_caption": "Nhập công thức tính nửa chu vi tam giác ABC vào ô C6", "visual_description": "Ảnh chụp giao diện bảng tính Excel minh họa bài toán tính nửa chu vi tam giác ABC với các cạnh AB, BC, CA lần lượt ở các ô C3, C4, C5 và ô C6 chứa công thức tính nửa chu vi.", "page_num": "37"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 7.6", "visual_caption": "Nhập công thức tính chu vi và diện tích hình tròn vào các ô C5, C6", "visual_description": "Ảnh chụp giao diện bảng tính Excel hiển thị bảng tính hình tròn với bán kính R ở ô C3, số Pi ở ô C4, chu vi ở ô C5 và diện tích ở ô C6.", "page_num": "37"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 7.7", "visual_caption": "Nhập công thức tại ô E4", "visual_description": "Ảnh chụp giao diện phần mềm bảng tính hiển thị Bảng 2. Dự kiến số lượng cây cần trồng, trong đó ô E4 chứa công thức =C4*D4 để tính tổng số cho loại Cây hoa.", "page_num": "37"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình 7.8", "visual_caption": "Sao chép công thức xuống các ô E5, E6", "visual_description": "Ảnh chụp giao diện bảng tính minh họa thao tác đánh dấu vùng E5:E6 để chuẩn bị sao chép công thức từ ô E4 xuống nhằm tính tổng số cây cho Cây ăn quả và Cây bóng mát.", "page_num": "37"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "visual_asset_code": "Hình 7.10", "visual_caption": "Trang tính 3. Tìm hiểu giống cây", "visual_description": "Ảnh chụp giao diện phần mềm bảng tính hiển thị trang tính có tên '3. Tìm hiểu giống cây'. Bảng dữ liệu bao gồm các cột: STT, Loại cây, Tên cây, Đơn giá, Số lượng, Thành tiền. Dòng tiêu đề được định dạng chữ đậm và nền màu vàng. Dữ liệu bao gồm các loại cây hoa, cây ăn quả và cây bóng mát cùng các con số chi tiết về đơn giá và số lượng.", "page_num": "39"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "visual_asset_code": "Hình 7.11", "visual_caption": "Dữ liệu diện tích rừng", "visual_description": "Ảnh chụp giao diện bảng tính hiển thị bảng 'DIỆN TÍCH PHỦ RỪNG CÁC TỈNH VÙNG ĐÔNG BẮC' với đơn vị tính là ha. Bảng gồm các cột: Tỉnh, Rừng tự nhiên, Rừng trồng, Tổng diện tích. Dữ liệu chứa thông tin về diện tích rừng của các tỉnh Hà Giang, Tuyên Quang, Cao Bằng, Lạng Sơn và Bắc Giang. Dòng tiêu đề có nền màu vàng, chữ đậm.", "page_num": "39"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.3", "visual_caption": "Chuẩn bị nhập hàm", "visual_description": "Ảnh chụp giao diện bảng tính Excel hướng dẫn Bước 1: Nháy chuột vào ô C9 hoặc vùng nhập dữ liệu để nhập hàm tính tổng số lượng cây phân bổ cho lớp 7A dựa trên bảng dữ liệu dự kiến phân bổ cây hoa cho các lớp.", "page_num": "41"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.4", "visual_caption": "Vị trí nhập hàm", "visual_description": "Ảnh chụp giao diện bảng tính Excel minh họa Bước 2: Nhập =SUM(, sau đó dùng chuột đánh dấu vùng dữ liệu cần tính tổng (C4:C8), gõ dấu đóng ngoặc ')' để đóng hàm và nhấn Enter để kết thúc, hiển thị kết quả tại ô C9.", "page_num": "41"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.5", "visual_caption": "Các yêu cầu cần tính toán", "visual_description": "Ảnh chụp màn hình phần mềm bảng tính hiển thị trang tính 'Dự kiến phân bổ cây hoa cho các lớp' (từ cột A đến cột K, dòng 1 đến dòng 8). Bên phải là các câu hỏi yêu cầu tính toán tại cột J từ ô K4 đến K8, minh họa trực quan việc áp dụng hàm vào thực tế dự án 'Trường học xanh'.", "page_num": "42"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "visual_asset_code": "Bảng 8.1", "visual_caption": "Các công thức cần nhập", "visual_description": "Bảng biểu diễn 3 cột gồm: Yêu cầu tính toán, Công thức tính (sử dụng các hàm AVERAGE, MAX, MIN, COUNT với các tham số vùng dữ liệu cụ thể như C4:I8, C6:I6, C4:I4, C8:I8, D4:D8) và Kết quả tương ứng.", "page_num": "42"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "visual_asset_code": "Bảng 8.2", "visual_caption": "Cú pháp một số hàm", "visual_description": "Bảng tổng hợp cú pháp, ý nghĩa và ví dụ minh họa của 5 hàm thông dụng trong phần mềm bảng tính gồm: SUM, AVERAGE, MIN, MAX và COUNT. Bảng giúp học sinh nắm vững cách viết hàm và ứng dụng tính toán các hàm số trong bảng dữ liệu.", "page_num": "43"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "visual_asset_code": "Hình 8.6", "visual_caption": "Trang tính 4", "visual_description": "Ảnh chụp giao diện phần mềm bảng tính điện tử hiển thị trang tính 4 với bảng dữ liệu 'Bảng 4. Dự kiến phân bổ cây cho các lớp'. Bảng gồm các cột STT, Loại cây, Tên cây và các cột lớp từ 7A đến 7H, chứa các số liệu phân bổ cây hoa, cây ăn quả và cây bóng mát cho từng lớp khối 7.", "page_num": "44"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "visual_asset_code": "Hình 8.7", "visual_caption": "Kết quả trang tính 4", "visual_description": "Ảnh chụp màn hình giao diện phần mềm bảng tính hiển thị Bảng 4 'Dự kiến phân bổ cây cho các lớp'. Bảng biểu diễn dữ liệu chi tiết gồm các cột: STT, Loại cây, Tên cây, các cột lớp từ 7A đến 7H, Tổng số cây (cột K) và Trung bình (cột L). Hàng tiêu đề có nền màu vàng và chữ in đậm. Các dòng tổng kết được định dạng in đậm để làm nổi bật dữ liệu tổng hợp.", "page_num": "45"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.1", "visual_caption": "Một bảng dữ liệu của dự án Trường học xanh", "visual_description": "Ảnh chụp bảng tính Excel thể hiện dữ liệu của dự án 'Trường học xanh' bao gồm các cột STT, Loại cây, Tên cây, Đơn giá, số lượng cây theo các lớp (7A, 7B, 7C, 7D, 7E, 7G, 7H), Tổng số cây, Trung bình và Chi phí. Hình ảnh trực quan hóa một bảng dữ liệu thô chưa được định dạng tối ưu để học sinh nhận xét về khả năng hiển thị.", "page_num": "46"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.2", "visual_caption": "Cửa sổ Format Cells", "visual_description": "Ảnh chụp cửa sổ Format Cells trong phần mềm bảng tính, tab Number đang được chọn. Có các mũi tên chú thích đánh số từ 1 đến 3 hướng dẫn các bước: (1) Chọn số chữ số thập phân tại ô Decimal places; (2) Nháy chuột vào ô Use 1000 Separator để chọn dùng dấu ',' ngăn cách hàng nghìn, hàng triệu; (3) Nháy nút OK để thiết lập cách thể hiện.", "page_num": "47"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.3", "visual_caption": "Cột E được tính theo công thức = Số cây đã trồng/Số cây dự kiến", "visual_description": "Ảnh chụp một bảng tính Excel có tiêu đề 'DỰ ÁN TRƯỜNG HỌC XANH'. Bảng hiển thị danh sách các loài hoa với các cột STT, Tên cây, Số cây dự kiến, Số cây đã trồng, và cột E chứa kết quả phép chia dạng số thập phân chưa được định dạng phần trăm.", "page_num": "47"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.4", "visual_caption": "Sau khi định dạng kiểu dữ liệu phần trăm (percentage)", "visual_description": "Ảnh chụp bảng tính 'DỰ ÁN TRƯỜNG HỌC XANH' sau khi đã áp dụng định dạng Percentage cho cột E, chuyển đổi các giá trị số thập phân thành dạng hiển thị phần trăm kèm ký hiệu % (ví dụ: 0.982142857 thành 98.21%).", "page_num": "47"}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "visual_asset_code": "Hình 9.5", "visual_caption": "Cách thiết lập hiển thị ngày tháng của Việt Nam", "visual_description": "Ảnh chụp hộp thoại Format Cells trong phần mềm bảng tính với các bước hướng dẫn chi tiết: 1. Chọn Number, 2. Chọn Date, 3. Nháy chuột vào mũi tên trỏ xuống và chọn Vietnamese trong danh sách Locale (location), 4. Chọn kiểu ngày/tháng/năm, 5. Nháy chuột chọn OK. Giúp học sinh nắm vững thao tác định dạng chuẩn ngày tháng Việt Nam.", "page_num": "48"}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "visual_asset_code": "Hình 9.6", "visual_caption": "Dữ liệu ngày tháng với các phép toán cộng, trừ", "visual_description": "Ảnh chụp bảng tính minh họa kết quả phép toán ngày tháng: Ô C2 chứa công thức =A2+B2 thực hiện phép cộng ngày 3/1/2020 + 30 ngày cho kết quả ngày 2/2/2020; ô C3 chứa dữ liệu trừ hai khoảng thời gian ngày 31/3/2021 - 15/3/2021 cho kết quả 16 ngày.", "page_num": "48"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.7", "visual_caption": "Ẩn hàng và cột", "visual_description": "Ảnh chụp một phần bảng tính Excel mang tên 'DỰ ÁN TRƯỜNG HỌC XANH', minh họa vị trí ẩn các cột D giữa cột C và cột E (chỉ số cột nhảy từ C sang E), đồng thời có các chú thích hướng dẫn quan sát tên các cột và hàng để nhận biết vị trí ẩn.", "page_num": "49"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.8", "visual_caption": "Trước khi gộp ô", "visual_description": "Ảnh chụp bảng dữ liệu 'Bảng 4. Kết quả dự án Trường học xanh' trước khi thực hiện thao tác gộp ô. Vùng từ ô C4 đến D4 chứa dữ liệu cây hoa Mười giờ, chuẩn bị được gộp lại.", "page_num": "49"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.9", "visual_caption": "Sau khi gộp ô", "visual_description": "Ảnh chụp bảng dữ liệu sau khi thực hiện lệnh gộp ô, hiển thị các ô trong vùng đã chọn được gộp lại thành một ô chung và căn giữa nội dung.", "page_num": "49"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.10", "visual_caption": "Chọn các ô của vùng dữ liệu A2:B3", "visual_description": "Ảnh chụp giao diện bảng tính minh họa thao tác chọn vùng dữ liệu từ ô A2 đến B3 trước khi thực hiện gộp ô.", "page_num": "49"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.11", "visual_caption": "Sau khi gộp, ô đã gộp có địa chỉ là A2", "visual_description": "Ảnh chụp bảng tính sau khi gộp vùng A2:B3, kết quả cho thấy ô đã gộp nằm ở góc trên bên trái và nhận địa chỉ mới là A2.", "page_num": "49"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.12", "visual_caption": "Dữ liệu và tiến độ thực tế", "visual_description": "Ảnh chụp bảng tính Excel có tiêu đề 'DỰ ÁN TRƯỜNG HỌC XANH' theo dõi tiến độ trồng cây của các lớp từ 7A đến 7H. Bảng chứa dữ liệu số kết hợp với các giá trị văn bản như 'Không', 'Đang làm', và '???' (chưa biết thông tin). Có các khung chú thích minh họa công thức tính toán tại ô J5 (=SUM(C5:I5)) và ô H9 (=COUNT(H4:H8)), giúp học sinh thấy rõ cách các hàm xử lý dữ liệu hỗn hợp (số và văn bản).", "page_num": "50"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9.13", "visual_caption": "Trang tính 5. Tổng kết", "visual_description": "Ảnh chụp màn hình phần mềm bảng tính điện tử thể hiện dữ liệu của 'Bảng 5. Dự kiến phân bổ cây dự án Trường học xanh'. Bảng bao gồm các cột từ STT đến Chi phí (A đến N), liệt kê chi tiết các loại cây hoa, cây ăn quả, cây bóng mát cùng số lượng phân bổ cho từng lớp khối 7 (từ 7A đến 7H), cột tổng số cây, trung bình và chi phí tương ứng. Hàng cuối cùng hiển thị tổng số cây dự kiến theo lớp.", "page_num": "51"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.1a", "visual_caption": "Dữ liệu trong phần mềm bảng tính", "visual_description": "Ảnh chụp một bảng dữ liệu mẫu 'Bảng 2. Dự kiến số lượng cây cần trồng' hiển thị trên màn hình phần mềm bảng tính, có các đường kẻ ô lưới rõ ràng gồm các cột STT, Loại cây, Vị trí, Số lượng và 3 hàng dữ liệu cây hoa, cây ăn quả, cây bóng mát.", "page_num": "52"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.1b", "visual_caption": "Dữ liệu khi in ra", "visual_description": "Ảnh chụp kết quả của bảng dữ liệu Bảng 2 khi in ra giấy nhưng không hiển thị các đường kẻ ô (Gridlines), làm cho các hàng và cột không có khung phân cách rõ ràng như trên màn hình.", "page_num": "52"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.2", "visual_caption": "Tạo trang tính mới", "visual_description": "Ảnh minh họa giao diện thanh tên các trang tính ở phía dưới góc trái của phần mềm bảng tính, gồm các trang tính 'Dữ liệu 1', 'Sheet2' và biểu tượng nút dấu cộng (+) màu trắng trong vòng tròn có chú thích mũi tên 'Nháy chuột vào đây để tạo trang tính mới'.", "page_num": "52"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.3", "visual_caption": "Cửa sổ Move or Copy", "visual_description": "Ảnh chụp giao diện cửa sổ 'Move or Copy' trong phần mềm bảng tính Excel. Cửa sổ có các tùy chọn gồm danh sách 'To book', danh sách 'Before sheet' để chọn vị trí sắp xếp (như Bảng 4a, Bảng 4b, ..., (move to end)) và hộp kiểm 'Create a copy'. Các chú thích bằng khung màu đỏ hướng dẫn chi tiết 3 bước: (1) Chọn vị trí muốn sao chép đến, (2) Nháy chuột vào đây để sao chép trang tính (tích vào Create a copy), (3) Chọn OK.", "page_num": "53"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.4", "visual_caption": "Cửa sổ Format Cells", "visual_description": "Ảnh chụp giao diện thẻ 'Border' trong cửa sổ 'Format Cells' của phần mềm bảng tính. Giao diện bao gồm các mục chọn kiểu đường kẻ (Line Style), chọn màu sắc cho đường kẻ (Color), các nút thiết lập nhanh (None, Outline, Inside) và sơ đồ xem trước mẫu kẻ viền cho các ô dữ liệu (Text). Các chú thích bằng khung màu đỏ chỉ rõ các thao tác chọn kiểu đường kẻ, chọn màu sắc, các nút None/Outline/Inside, vùng nháy chuột chọn từng đường viền và nút OK để thực hiện lệnh.", "page_num": "53"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.5", "visual_caption": "Nhập các thông số để in và xem kết quả trước khi in", "visual_description": "Ảnh chụp giao diện hộp thoại Print trong phần mềm bảng tính điện tử, thể hiện các thiết lập in ấn như chọn số bản in, chọn máy in kết nối, chọn vùng in (vùng được chọn, trang tính hiện thời, toàn bộ bảng tính), chọn số lượng trang in từ trang đến trang, chọn hướng giấy (nằm ngang hay thẳng đứng), và chọn kích thước giấy in. Hình ảnh giúp học sinh nắm rõ cách cấu hình thông số trước khi in trang tính.", "page_num": "54"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.6", "visual_caption": "Hoàn thiện dữ liệu dự án Trường học xanh", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh họa dự án 'Dự án trường học xanh', hiển thị dữ liệu chi tiết từ hàng 1 đến hàng 25, các cột từ A đến N bao gồm STT, Loại cây, Tên cây, Đơn giá, các lớp từ 7A đến 7H, Tổng số cây, Trung bình và Chi phí. Bảng tính đã được định dạng màu sắc cho từng nhóm cây (cây hoa, cây ăn quả, cây bóng mát), kẻ viền khung rõ ràng và căn chỉnh số liệu chuẩn xác.", "page_num": "55"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.1", "visual_caption": "Trang tiêu đề", "visual_description": "Ảnh chụp giao diện phần mềm Microsoft PowerPoint 2016 minh họa khu vực soạn thảo trang tiêu đề. Giao diện hiển thị khung chứa dòng chữ 'Click to add title' (chỗ nhập tiêu đề, tên bài trình chiếu được đánh dấu số 1) và khung 'Click to add subtitle' (chỗ nhập phụ đề, tên người thực hiện, thời gian... được đánh dấu số 2 bằng các mũi dẫn hướng màu đỏ).", "page_num": "59"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.2", "visual_caption": "Trang nội dung", "visual_description": "Ảnh chụp giao diện thanh công cụ Ribbon thẻ HOME và vùng làm việc của Microsoft PowerPoint 2016 khi tạo trang nội dung. Hình ảnh đánh số các bước hướng dẫn thao tác: (1) Nháy chuột vào nút New Slide để tạo trang mới, (2) Nháy chuột vào Layout để chọn mẫu bố trí, (3) Nhập tiêu đề của trang vào khung 'Click to add title', (4) Nhập nội dung vào khung văn bản bên dưới. Các thành phần được chỉ dẫn bằng đường kẻ và hộp đỏ rõ ràng giúp học sinh dễ dàng thực hành theo.", "page_num": "59"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.3", "visual_caption": "Ví dụ trang tiêu đề", "visual_description": "Ảnh chụp mẫu trang tiêu đề của một bài trình bày với chủ đề 'Dự án Trường học xanh', bao gồm tên chi đội 7A, tên trường THCS và ngày tháng. Minh họa cách trình bày trang tiêu đề trong phần mềm trình chiếu.", "page_num": "60"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.4", "visual_caption": "Ví dụ trang nội dung", "visual_description": "Ảnh chụp mẫu trang nội dung trình bày với tiêu đề 'Nội dung trình bày' và danh sách các mục như Ý tưởng, Vai trò của cây xanh, Đề xuất dự án, Kế hoạch,... giúp học sinh hình dung bố cục trang nội dung chuẩn.", "page_num": "60"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.5", "visual_caption": "Chọn các dòng cần tăng cấp", "visual_description": "Ảnh chụp giao diện phần mềm trình chiếu cho thấy người dùng đang bôi đen hoặc chọn một nhóm dòng văn bản trong khung nội dung để chuẩn bị thực hiện thao tác tăng bậc phân cấp.", "page_num": "60"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.6", "visual_caption": "Kết quả nhận được sau khi nhấn phím Tab", "visual_description": "Ảnh chụp giao diện sau khi nhấn phím Tab, các dòng được chọn đã dịch chuyển lùi vào trong (thụt lề sang phải) và được thu nhỏ cỡ chữ để thể hiện rõ cấu trúc phân cấp nội dung.", "page_num": "60"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.7", "visual_caption": "Trang chiếu khi chưa phân cấp", "visual_description": "Ảnh chụp trang chiếu mẫu với danh sách các mục nội dung nằm thẳng hàng ở cùng một cấp độ (chưa có sự phân cấp lớn nhỏ giữa các mục chính và mục con).", "page_num": "60"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.8", "visual_caption": "Trang chiếu sau khi phân cấp", "visual_description": "Ảnh chụp trang chiếu mẫu sau khi đã áp dụng cấu trúc phân cấp, các mục con được thụt lề và giảm cỡ chữ rõ ràng, giúp bố cục bài trình bày khoa học và dễ theo dõi hơn.", "page_num": "60"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11.9", "visual_caption": "Trang chiếu sau khi thay đổi hình dạng và màu sắc của các kí hiệu đầu dòng", "visual_description": "Ảnh chụp một trang chiếu mẫu có tiêu đề 'Nội dung trình bày', thể hiện cấu trúc phân cấp gồm các mục 'Ý tưởng', 'Kế hoạch', 'Kết luận' với các kí hiệu đầu dòng được tuỳ chỉnh hình mũi tên màu đỏ và các cấp con được đánh dấu hoa thị. Hình ảnh minh hoạ trực quan kết quả sau khi định dạng lại kí hiệu đầu dòng trong phần mềm trình chiếu.", "page_num": "61"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Hình minh họa", "visual_caption": "Màu nền và định dạng văn bản cần thống nhất", "visual_description": "Ảnh minh họa khung chú thích màu xanh nhạt với các mẫu ô màu nền và chữ, thể hiện nguyên tắc màu nền và định dạng văn bản cần thống nhất, không nên dùng nhiều màu, nhiều chữ trên một trang.", "page_num": "63"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.1", "visual_caption": "Lệnh Copy và Paste trong thẻ Home", "visual_description": "Ảnh chụp màn hình dải lệnh (Ribbon) trong phần mềm soạn thảo hoặc trình chiếu, tập trung vào nhóm Clipboard trong thẻ Home. Hiển thị rõ hai nút lệnh Cut (cắt), Copy (sao chép có biểu tượng hai tờ giấy chồng lên nhau) và Paste (dán). Hình ảnh hỗ trợ học sinh nhận biết trực quan vị trí và biểu tượng của các lệnh sao chép, dán văn bản cơ bản.", "page_num": "64"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.2", "visual_caption": "Chọn phần dữ liệu cần sao chép trong tệp văn bản", "visual_description": "Ảnh chụp một đoạn văn bản mẫu (khung '1. Ý TƯỞNG') với nội dung về xây dựng ngôi trường xanh - sạch - đẹp, trong đó một đoạn văn đã được bôi đen (được chọn) để chuẩn bị thực hiện thao tác sao chép. Minh họa cụ thể vùng dữ liệu nguồn trong tệp Word trước khi đưa vào bài trình chiếu PowerPoint.", "page_num": "64"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.3", "visual_caption": "Dữ liệu được sao chép vào trang chiếu", "visual_description": "Ảnh chụp một trang chiếu hiển thị nội dung phần '1. Ý tưởng' với tiêu đề 'Xây dựng ngôi trường xanh - sạch - đẹp' và đoạn văn bản mô tả về ý nghĩa của cây xanh cũng như đề xuất của chi đội 7A. Trang chiếu minh họa việc đưa dữ liệu thô vào phần mềm trình chiếu.", "page_num": "65"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.4", "visual_caption": "Các lệnh định dạng văn bản trên thẻ Home", "visual_description": "Ảnh chụp giao diện thanh ribbon của phần mềm trình chiếu tại thẻ Home, làm nổi bật các nhóm công cụ Clipboard, Slides, Font, Paragraph, Drawing. Các mũi tên chú thích chỉ rõ nhóm 'Thay đổi phông, cỡ, kiểu, màu sắc cho chữ' và nhóm 'Căn lề, giãn dòng'.", "page_num": "65"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.5", "visual_caption": "Trang chiếu sau khi định dạng, biên tập", "visual_description": "Ảnh chụp trang chiếu sau khi đã được biên tập lại nội dung ngắn gọn thành các ý chính sử dụng kí hiệu đầu dòng (bullet points) thay vì đoạn văn dài, chữ được định dạng rõ ràng, trang trọng, giúp truyền tải thông điệp dự án 'Trường học xanh' một cách hiệu quả.", "page_num": "65"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.6", "visual_caption": "Cách áp dụng mẫu định dạng", "visual_description": "Ảnh chụp màn hình phần mềm trình chiếu minh họa giao diện thẻ DESIGN với các nhóm lệnh Themes và Variants. Sơ đồ trực quan hướng dẫn 3 bước thực hiện: Bước 1 chọn các trang cần áp dụng mẫu ở khung bên trái; Bước 2 nháy chuột chọn Design; Bước 3 nháy chuột vào mẫu muốn áp dụng trên thanh Ribbon, bên cạnh là vị trí của nút More. Phía bên phải hiển thị kết quả minh họa trang chiếu '1. Ý TƯỞNG - XÂY DỰNG NGÔI TRƯỜNG XANH - SẠCH - ĐẸP' áp dụng mẫu định dạng chuyên nghiệp.", "page_num": "66"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.7", "visual_caption": "Hình ảnh che nội dung văn bản", "visual_description": "Ảnh chụp màn hình phần mềm trình chiếu hiển thị một trang chiếu có tiêu đề 'DỰ ÁN TRƯỜNG HỌC XANH' và hình ảnh minh họa đang che khuất một phần văn bản ở phía dưới.", "page_num": "67"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.8", "visual_caption": "Kết quả sau khi thay đổi lớp của hình ảnh", "visual_description": "Ảnh chụp màn hình phần mềm trình chiếu sau khi thực hiện thao tác đổi lớp (Send Backward) cho hình ảnh, giúp hình ảnh nằm phía dưới lớp văn bản, không còn che khuất các dòng chữ 'Chi đội 7A', 'Trường THCS...' và 'Ngày...'.", "page_num": "67"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.9", "visual_caption": "Cách thay đổi kích thước hình ảnh", "visual_description": "Ảnh chụp màn hình hướng dẫn các thao tác thay đổi kích thước hình ảnh bằng chuột: kéo thả nút ở cạnh trái hoặc phải để thay đổi kích thước chiều ngang, kéo thả nút ở trên hoặc dưới để thay đổi chiều dọc, và kéo thả nút ở góc theo đường chéo để thay đổi kích thước đồng thời giữ nguyên tỉ lệ của hình ảnh.", "page_num": "67"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.10", "visual_caption": "Trang chiếu kết quả", "visual_description": "Ảnh chụp màn hình trang chiếu minh họa kết quả của dự án 'Trường học xanh' với nền màu xanh, tiêu đề 'DỰ ÁN TRƯỜNG HỌC XANH' được định dạng nổi bật cùng các thông tin chi tiết của Chi đội 7A, Trường THCS..., Ngày... Hình ảnh giúp học sinh hình dung rõ giao diện trang chiếu sau khi được định dạng màu nền và trang trí đường viền hình ảnh.", "page_num": "68"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "visual_asset_code": "Hình 13.1", "visual_caption": "Tạo hiệu ứng cho đối tượng", "visual_description": "Ảnh chụp giao diện phần mềm trình chiếu (PowerPoint) minh họa các bước thực hiện tạo hiệu ứng động cho đối tượng trên trang chiếu: 1. Chọn đối tượng; 2. Chọn thẻ Animations; 3. Chọn hiệu ứng; 4. Chọn cách đối tượng xuất hiện, thời lượng,...; 5. Thay đổi thứ tự đối tượng xuất hiện; 6. Xem trước. Kèm theo nút More để mở rộng danh sách hiệu ứng và hình ảnh minh họa slide 'DỰ ÁN TRƯỜNG HỌC XANH'.", "page_num": "70"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "visual_asset_code": "Hình 13.2", "visual_caption": "Tạo hiệu ứng chuyển trang chiếu", "visual_description": "Ảnh chụp giao diện phần mềm Microsoft PowerPoint minh hoạ chi tiết 5 bước tạo hiệu ứng chuyển trang chiếu. Trên dải lệnh, thẻ 'Transitions' được chọn, hiển thị các nhóm tuỳ chọn hiệu ứng chuyển tiếp (Transition to This Slide) như Fade, Push, Wipe, Split... và khu vực thiết lập âm thanh (Sound), thời lượng (Duration) cũng như nút lệnh xem trước (Preview) ở góc trái.", "page_num": "71"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.1", "visual_caption": "Sơ đồ khối mô tả thuật toán tìm kiếm tuần tự địa chỉ khách hàng", "visual_description": "Sơ đồ khối bắt đầu từ việc lấy danh sách khách hàng và họ tên khách hàng yêu cầu, xem họ tên khách hàng đầu tiên, sau đó thực hiện vòng lặp kiểm tra: nếu đúng họ tên cần tìm thì ghi ra địa chỉ khách hàng và kết thúc; nếu sai thì kiểm tra xem đã hết danh sách chưa, nếu đúng là hết danh sách thì báo không tìm thấy khách hàng và kết thúc, nếu chưa thì xem họ tên khách hàng tiếp theo và lặp lại quá trình.", "page_num": "73"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "visual_asset_code": "Bảng 14.1", "visual_caption": "Danh sách khách hàng", "visual_description": "Bảng dữ liệu gồm 5 hàng chứa thông tin khách hàng: TT, Họ tên, Địa chỉ tương ứng của các khách hàng Nguyễn An, Trần Bình, Hoàng Mai, Thanh Trúc, Nguyễn Hoà.", "page_num": "73"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "visual_asset_code": "Bảng 14.2", "visual_caption": "Các bước tìm địa chỉ khách hàng", "visual_description": "Bảng mẫu gồm các cột: Lần lặp, Tên khách hàng, Có đúng khách hàng cần tìm không?, Có đúng là đã hết danh sách không? dùng để học sinh thực hành theo dõi các bước thực hiện của thuật toán tìm kiếm tuần tự.", "page_num": "73"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "visual_asset_code": "Bảng 14.3", "visual_caption": "Các bước tìm kiếm tuần tự", "visual_description": "Bảng biểu diễn quá trình thực hiện thuật toán tìm kiếm tuần tự trên danh sách tên các nước, gồm các cột: Lần lặp, Tên nước, Có đúng tên nước cần tìm không?, Có đúng là đã hết danh sách không?, Đầu ra. Bảng giúp học sinh trực quan hóa từng bước lặp kiểm tra điều kiện của thuật toán.", "page_num": "74"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.1", "visual_caption": "Danh sách khách hàng", "visual_description": "Bảng dữ liệu mẫu gồm 9 dòng hiển thị danh sách khách hàng với các cột TT (Thứ tự), Họ đệm, Tên và Địa chỉ. Bảng được sắp xếp theo tên khách hàng theo thứ tự chữ cái (từ An, Bình, Hoà, Liên, Mai, Phương, Trang, Trúc đến Tước), minh họa bộ dữ liệu đầu vào đã được sắp xếp để áp dụng thuật toán tìm kiếm nhị phân.", "page_num": "75"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.2", "visual_caption": "Vùng tìm kiếm", "visual_description": "Sơ đồ minh họa cấu trúc vùng tìm kiếm trong thuật toán tìm kiếm nhị phân gồm hai trường hợp: a) Vùng tìm kiếm có lẻ phần tử với ô 'Vị trí giữa' nằm chính giữa; b) Vùng tìm kiếm có chẵn phần tử với 'Vị trí giữa' nằm ở ranh giới phía trước phần nửa sau. Hình ảnh giúp học sinh trực quan hóa cách chia đôi danh sách và xác định nửa trước, nửa sau trong quá trình tìm kiếm.", "page_num": "77"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "visual_asset_code": "Hình 16.1", "visual_caption": "Hoán đổi", "visual_description": "Hình ảnh minh họa thao tác hoán đổi chất lỏng giữa hai cốc A (màu xanh) và B (màu đỏ) thông qua một cốc trung gian C không đựng gì (a, b, c, d). Cốc C được dùng làm chỗ chứa tạm thời để thực hiện việc trao đổi chất lỏng mà không bị lẫn lộn, mô phỏng trực quan cho thuật toán hoán đổi giá trị của hai biến trong lập trình.", "page_num": "79"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "visual_asset_code": "Hoạt động 1", "visual_caption": "Mô phỏng thuật toán sắp xếp nổi bọt", "visual_description": "Sơ đồ hiển thị các ô chứa dãy số gồm 5 phần tử lần lượt là 3, 5, 4, 1, 2 nhằm yêu cầu học sinh thực hiện và mô phỏng các bước lặp sắp xếp nổi bọt để sắp xếp dãy số theo thứ tự tăng dần.", "page_num": "81"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "visual_asset_code": "Hình 16.5", "visual_caption": "Mô phỏng thuật toán sắp xếp chọn", "visual_description": "Sơ đồ trực quan mô phỏng từng bước thuật toán sắp xếp chọn để sắp xếp dãy số [3, 4, 1, 5, 2] thành dãy tăng dần [1, 2, 3, 4, 5].\n- Đầu vào: Dãy các phần tử chưa được sắp xếp gồm [3, 4, 1, 5, 2].\n- Vòng lặp thứ nhất: Xét vị trí đầu tiên (giá trị 3). So sánh 3 với 4 (không hoán đổi). So sánh 3 với 1 (vì 1 < 3 nên hoán đổi, dãy trở thành [1, 4, 3, 5, 2]). So sánh 1 với 5 (không hoán đổi), so sánh 1 với 2 (không hoán đổi). Kết quả vòng lặp thứ nhất đưa phần tử nhỏ nhất (1) về vị trí đầu tiên: [1, 4, 3, 5, 2].\n- Vòng lặp thứ hai: Thực hiện tương tự với vị trí thứ hai, kết quả thu được [1, 2, 4, 5, 3].\n- Vòng lặp thứ ba: Thực hiện tương tự với vị trí thứ ba, kết quả thu được [1, 2, 3, 5, 4].\n- Vòng lặp thứ tư: Thực hiện tương tự với vị trí thứ tư, kết quả thu được [1, 2, 3, 4, 5].\n- Đầu ra: Dãy các phần tử đã được sắp xếp [1, 2, 3, 4, 5].\nÝ nghĩa sư phạm: Giúp học sinh nắm bắt trực quan cơ chế hoạt động, từng bước hoán đổi và tính dừng của thuật toán sắp xếp chọn (Selection Sort).", "page_num": "82"}, {"grade_level": "Lớp 8", "lesson_id": "Bìa sách", "visual_asset_code": "Bìa sách", "visual_caption": "Bìa sách Tin học 8 - Kết nối tri thức với cuộc sống", "visual_description": "Ảnh chụp trang bìa sách giáo khoa Tin học lớp 8, bộ sách Kết nối tri thức với cuộc sống. Trên bìa có logo Nhà xuất bản Giáo dục Việt Nam, tên sách 'TIN HỌC 8' nổi bật với màu vàng và số 8 lớn màu xanh lá mạ trên nền hình cầu Trái Đất và các biểu đồ số liệu mạng máy tính, thể hiện chủ đề công nghệ thông tin và tri thức thời đại số.", "page_num": "1"}, {"grade_level": "Lớp 8", "lesson_id": "Bìa sách", "visual_asset_code": "Hình Bìa SGK", "visual_caption": "Bìa sách giáo khoa Tin học 8", "visual_description": "Ảnh bìa sách giáo khoa Tin học lớp 8 thuộc bộ sách Kết nối tri thức với cuộc sống do Nhà xuất bản Giáo dục Việt Nam phát hành. Các tác giả biên soạn gồm: Nguyễn Chí Công (Tổng Chủ biên), Hà Đặng Cao Tùng (Chủ biên), Phan Anh, Nguyễn Hải Châu, Hoàng Thị Mai, Nguyễn Thị Hoài Nam. Bìa sách có màu hồng nhạt làm chủ đạo, nổi bật dòng chữ 'TIN HỌC 8' và logo 'Bản mẫu' của Nhà xuất bản Giáo dục Việt Nam.", "page_num": "2"}, {"grade_level": "Lớp 8", "lesson_id": "HD01", "visual_asset_code": "HA01", "visual_caption": "Sơ đồ các thành phần cấu trúc bài học và hình ảnh ba nhân vật An, Minh, Khoa", "visual_description": "Hình ảnh bao gồm các biểu tượng minh họa cho từng phần trong bài học như ngọn lửa (Khởi động), sách vở (Các hoạt động), bóng đèn (Kiến thức mới/Hộp kiến thức), dấu hỏi (Câu hỏi), bút viết (Luyện tập), màn hình máy tính (Vận dụng). Bên cạnh đó là hình ảnh ba nhân vật học sinh An, Minh và Khoa mặc đồng phục đeo khăn quàng đỏ đang đứng tạo dáng, minh họa cho các đoạn hội thoại xuyên suốt trong sách giáo khoa.", "page_num": "3"}, {"grade_level": "Lớp 8", "lesson_id": "MỤC LỤC", "visual_asset_code": "Trang 4", "visual_caption": "Mục lục sách giáo khoa Tin học lớp 9 (bộ sách Kết nối tri thức hoặc Chân trời sáng tạo)", "visual_description": "Ảnh chụp bảng mục lục liệt kê các chủ đề từ Chủ đề 1 đến Chủ đề 6, chi tiết tên từng bài học cùng số trang tương ứng. Bảng có định dạng rõ ràng, màu xanh chủ đạo, giúp học sinh và giáo viên tra cứu nhanh chóng nội dung học tập trong năm học.", "page_num": "5"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.3", "visual_caption": "Sơ đồ cấu trúc máy tính", "visual_description": "Sơ đồ khối thể hiện kiến trúc máy tính Von Neumann gồm: khối 'Thiết bị vào' có mũi tên chỉ tới khối trung tâm, khối 'Bộ xử lí' và 'Bộ nhớ' trao đổi thông tin hai chiều với nhau, và mũi tên từ khối trung tâm trỏ ra khối 'Thiết bị ra'. Sơ đồ minh họa trực quan sự luân chuyển dữ liệu và mối liên kết cơ bản giữa các bộ phận trong máy tính.", "page_num": "8"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.4", "visual_caption": "Máy tính tích hợp điện tử số (ENIAC)", "visual_description": "Ảnh tư liệu đen trắng chụp toàn cảnh cỗ máy tính ENIAC đồ sộ chiếm trọn không gian của một căn phòng lớn, với các tủ điều khiển, bảng dây dẫn chằng chịt và các khối đèn điện tử chân không, minh họa trực quan kích thước khổng lồ của thế hệ máy tính thứ nhất.", "page_num": "8"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.5", "visual_caption": "Máy tính Minsk 22", "visual_description": "Ảnh chụp máy tính Minsk 22 của thế hệ thứ hai với một chuyên viên đang ngồi vận hành tại bàn điều khiển có nhiều công tắc, đèn báo, phía sau là hệ thống các tủ xử lý và ổ băng từ to lớn.", "page_num": "8"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.6", "visual_caption": "Máy tính IBM System/360", "visual_description": "Ảnh màu chụp hệ thống máy tính IBM System/360 với thiết kế hiện đại hơn, gồm bàn điều khiển gắn thiết bị ngoại vi và các khối tủ vi mạch tích hợp (IC) xếp gọn gàng trong phòng máy.", "page_num": "8"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "visual_asset_code": "Hình 2.1", "visual_caption": "Bức ảnh được chụp lại và gửi qua mạng", "visual_description": "Minh hoạ quá trình số hoá và truyền tải thông tin: Một bức ảnh in truyền thống về phong cảnh ruộng bậc thang được chụp lại bằng điện thoại thông minh tạo thành ảnh số, sau đó truyền tải qua môi trường mạng (biểu tượng đám mây mạng Internet) đến điện thoại thông minh của người nhận. Hình ảnh thể hiện tính tiện lợi của thông tin số khi dễ dàng sao chép, truyền gửi từ xa mà không làm mất bản gốc.", "page_num": "11"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "visual_asset_code": "Hình 2.2", "visual_caption": "Bức ảnh được sử dụng làm nền", "visual_description": "Sơ đồ minh họa quá trình gửi nhận bức ảnh ruộng bậc thang qua thư điện tử giữa Khoa và An, sau đó An chỉnh sửa bức ảnh trên điện thoại di động và đưa lên mạng xã hội hiển thị trên máy tính bảng. Hình ảnh giúp học sinh trực quan hóa khả năng lan truyền, chia sẻ, chỉnh sửa và tái sử dụng thông tin số trên các thiết bị khác nhau qua môi trường Internet.", "page_num": "12"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "visual_asset_code": "Bảng 3.1", "visual_caption": "Bảng 3.1. Kết quả tìm kiếm", "visual_description": "Bảng tổng hợp kết quả tìm kiếm gồm 5 cột: STT, Nội dung, Địa chỉ trang web, Nguồn gốc, Thời gian. Bảng có 3 dòng dữ liệu: Dòng 1 ghi nhận nội dung 'Khái niệm chung về các nguồn năng lượng' từ địa chỉ 'https://hvacr.vn/diendan/' thuộc 'Cộng đồng Cơ Điện Lạnh Việt Nam' năm 2008; Dòng 2 ghi 'Năng lượng tái tạo sẽ thống trị công suất điện toàn thế giới' từ 'https://www.evn.com.vn/' thuộc 'Tập đoàn Điện lực Việt Nam' năm 2022; Dòng 3 ghi 'Quy hoạch điện VIII: Ưu tiên phát triển năng lượng tái tạo' từ 'http://www.erea.gov.vn/vi-VN' thuộc 'Bộ Công Thương' năm 2021. Bảng hướng dẫn học sinh cách ghi chép có hệ thống để phục vụ việc đánh giá độ tin cậy và tính thời sự của nguồn tin.", "page_num": "16"}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "visual_asset_code": "Hình 3.1", "visual_caption": "Trang web có địa chỉ ...gov.vn là trang thông tin của cơ quan chính phủ", "visual_description": "Ảnh chụp màn hình kết quả tìm kiếm hoặc phần đầu của trang web từ tên miền .gov.vn chứa thông tin về 'Quy hoạch điện VIII: Ưu tiên phát triển năng lượng tái tạo', thể hiện việc khai thác thông tin chính thống từ trang web cơ quan chính phủ làm tư liệu tham khảo.", "page_num": "17"}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "visual_asset_code": "Hình 3.2", "visual_caption": "Trang dàn ý", "visual_description": "Khung nội dung thể hiện dàn ý của bài trình chiếu gồm các mục: (1) Giới thiệu chủ đề, (2) Năng lượng tái tạo là gì?, (3) Nguồn năng lượng sản xuất điện tại tỉnh..., (4) Nhà máy điện tương lai, (5) Kết luận, (6) Tài liệu tham khảo. Hình ảnh hướng dẫn học sinh cách bố cục cấu trúc logic cho bài thuyết trình.", "page_num": "17"}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "visual_asset_code": "Hình 3.3", "visual_caption": "Trang nội dung", "visual_description": "Bảng dữ liệu có tiêu đề 'QUY HOẠCH CƠ CẤU NGUỒN ĐIỆN' với các cột: TT, Cơ cấu nguồn điện, Năm 2030, Năm 2045. Liệt kê tỉ lệ các nguồn điện như Nhiệt điện than, Nhiệt điện khí, Thuỷ điện, Điện gió, Điện Mặt Trời, Điện sinh khối và NLTT khác, Thuỷ điện tích năng, Nhập khẩu điện. Hình ảnh minh họa cách trình bày dữ liệu dạng bảng trong trang nội dung bài trình chiếu.", "page_num": "17"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "visual_asset_code": "Hình 3.4", "visual_caption": "Trang tài liệu tham khảo", "visual_description": "Ảnh chụp khung giao diện tài liệu tham khảo liệt kê các nguồn trích dẫn từ Bộ Công Thương (http://www.erea.gov.vn/vi-VN), Công ty cổ phần tư vấn xây dựng điện 1 và Cộng đồng Cơ điện lạnh Việt Nam (https://hvacr.vn/diendan/). Hình ảnh minh họa cách trình bày danh mục tài liệu tham khảo chuẩn xác trong bài trình chiếu.", "page_num": "18"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.1", "visual_caption": "Biển cấm quay phim, chụp ảnh", "visual_description": "Biển báo gồm hai biểu tượng nằm trong hình tròn đỏ có gạch chéo: bên trái là máy quay phim bị gạch chéo, bên phải là máy ảnh kỹ thuật số bị gạch chéo. Hình ảnh minh họa cho quy định cấm ghi hình hoặc chụp ảnh tại một số khu vực nhất định nhằm bảo vệ bản quyền hoặc an ninh.", "page_num": "20"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.2", "visual_caption": "Một chương trình cung cấp kiến thức mà học sinh cần tìm hiểu", "visual_description": "Ảnh chụp màn hình chương trình truyền hình với dòng chữ nổi bật 'VI PHẠM BẢN QUYỀN BIẾT MÀ VẪN XEM?' ở phía trên cùng logo kênh 24 giờ. Hình ảnh mang tính cảnh tỉnh và giáo dục học sinh về ý thức tôn trọng bản quyền khi xem các chương trình trên không gian mạng.", "page_num": "20"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.3", "visual_caption": "Các sản phẩm số được tạo bởi học sinh", "visual_description": "Sơ đồ tư duy dạng phân nhánh trực quan với tâm sơ đồ là khối màu vàng 'Sản phẩm số'. Các nhánh bên trái bao gồm: Poster, tài liệu quảng cáo; Những bức ảnh (chụp, chỉnh sửa); Truyện tự sáng tác; Bài đăng trên mạng xã hội, diễn đàn; Bài giới thiệu, đánh giá một cuốn sách, một bộ phim, một nhà hàng,... Các nhánh bên phải bao gồm: Blog (nhật kí trên web); Tệp ghi âm giọng hát; Vlog (video blog); Video âm nhạc; Trò chơi điện tử tự thiết kế. Sơ đồ giúp học sinh hình dung phong phú các loại sản phẩm số có thể tự sáng tạo.", "page_num": "20"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.1", "visual_caption": "Danh sách phần mềm của công ty", "visual_description": "Ảnh chụp màn hình bảng tính Excel hiển thị bảng 'DANH SÁCH PHẦN MỀM ỨNG DỤNG' gồm các cột: A (số thứ tự hàng), B (Sản phẩm), C (Đơn giá (đồng)), D (Số lượt mua), E (Doanh thu). Bảng liệt kê 6 sản phẩm phần mềm với các mức giá và số lượt mua khác nhau, cột Doanh thu (E) đang để trống để học sinh thực hiện tính toán.", "page_num": "22"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.2", "visual_caption": "Địa chỉ trong công thức tại ô E4 là địa chỉ tương đối", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh họa Danh sách phần mềm ứng dụng từ hàng 1 đến hàng 9, cột từ A đến E. Cột A là TT, cột B là Sản phẩm, cột C là Đơn giá (đồng), cột D là Số lượt mua, cột E là Doanh thu. Tại ô E4 hiển thị công thức =C4*D4 với các ô tham chiếu được đánh dấu màu xanh và đỏ tương ứng. Hình ảnh trực quan hóa cách lập công thức tính doanh thu bằng tích của đơn giá và số lượt mua, đồng thời minh họa rõ ràng vị trí ô dữ liệu trong bảng tính điện tử.", "page_num": "23"}, {"grade_level": "Lớp 8", "lesson_id": "Bài", "visual_asset_code": "Hình 5.3", "visual_caption": "Tỉ lệ doanh thu của công ti được lưu ở ô F2", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh họa danh sách phần mềm ứng dụng với các cột: TT, Sản phẩm, Đơn giá (đồng), Số lượt mua, Doanh thu và Doanh thu của công ti. Ô F2 chứa giá trị tỉ lệ doanh thu của công ti là 70%.", "page_num": "24"}, {"grade_level": "Lớp 8", "lesson_id": "Bài", "visual_asset_code": "Hình 5.4", "visual_caption": "Công thức tại ô F4 và F5", "visual_description": "Sơ đồ minh họa sự thay đổi của địa chỉ ô trong công thức khi sao chép từ ô F4 sang ô F5. Tại ô F4, công thức là =E4*$F$2, trong đó E4 là địa chỉ thay đổi còn $F$2 là địa chỉ tuyệt đối không thay đổi. Khi sao chép xuống ô F5, công thức trở thành =E5*$F$2.", "page_num": "24"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.5", "visual_caption": "Công thức tính Doanh thu của công ti cho phần mềm Quản lí thời gian", "visual_description": "Giao diện bảng tính Excel chứa bảng 'DANH SÁCH PHẦN MỀM ỨNG DỤNG'. Ô F2 chứa giá trị tỉ lệ doanh thu là 70%. Cột E hiển thị Doanh thu và cột F hiển thị Doanh thu của công ti. Ô F4 đang được nhập công thức tính '=E4*$F$2', minh họa việc sử dụng địa chỉ tuyệt đối của ô F2 để khi sao chép công thức xuống các ô F5:F9 giá trị tham chiếu tới ô F2 không bị thay đổi.", "page_num": "26"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "visual_asset_code": "Bảng 5.1", "visual_caption": "Số liệu thống kê lựa chọn nghề nghiệp của học sinh", "visual_description": "Bảng dữ liệu gồm 4 cột: TT, Nhóm nghề, Nghề, Số lượng HS; thống kê 4 nhóm nghề: Lĩnh vực phát triển phần mềm (46 HS), Lĩnh vực mạng máy tính và an toàn thông tin (25 HS), Lĩnh vực đa phương tiện (78 HS), Lĩnh vực khác của Công nghệ thông tin (42 HS).", "page_num": "26"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.2", "visual_caption": "Bảng kết quả khảo sát", "visual_description": "Ảnh chụp màn hình bảng tính điện tử gồm 5 cột (A: TT, B: Họ đệm, C: Tên, D: Tổ, E: Nội dung) chứa danh sách 10 học sinh lớp 8A tham gia khảo sát CLB Tin học. Bảng dữ liệu minh họa các thông tin chi tiết về họ tên, tổ và nội dung Tin học mà học sinh muốn tìm hiểu.", "page_num": "29"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.3", "visual_caption": "Sắp xếp bảng dữ liệu theo một tiêu chí", "visual_description": "Ảnh chụp hộp thoại Sort trong phần mềm bảng tính điện tử Excel với các chú thích chi tiết các bước: chọn ô để không sắp xếp dòng tiêu đề (My data has headers), chọn thứ tự sắp xếp (Order: A to Z), và chọn cột tiêu chí sắp xếp (Column: Sort by Tên). Hình ảnh giúp học sinh nắm rõ các bước cấu hình để sắp xếp dữ liệu theo một cột cụ thể.", "page_num": "29"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.4", "visual_caption": "Kết quả sắp xếp tên học sinh theo thứ tự bảng chữ cái", "visual_description": "Bảng tính Excel 'Bảng kết quả khảo sát lớp 8A' gồm các cột TT, Họ đệm, Tên, Tổ, Nội dung, hiển thị danh sách học sinh đã được sắp xếp theo thứ tự bảng chữ cái ở cột Tên.", "page_num": "30"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.5", "visual_caption": "Sắp xếp dữ liệu theo nhiều tiêu chí", "visual_description": "Ảnh chụp hộp thoại Sort trong Excel với các chú thích chi tiết cho các bước thực hiện: 1. Chọn ô 'My data has headers' để không sắp xếp dòng tiêu đề; 2. Chọn 'Add level' để thêm tiêu chí sắp xếp; 3. Chọn cột 'Tên' là tiêu chí sắp xếp thứ nhất; 4. Chọn cột 'Họ đệm' là tiêu chí sắp xếp thứ hai.", "page_num": "30"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 6.6", "visual_caption": "Kết quả sắp xếp theo hai tiêu chí", "visual_description": "Ảnh chụp bảng dữ liệu 'Bảng kết quả khảo sát lớp 8A' từ cột A đến cột E, hiển thị kết quả sau khi sắp xếp theo Tên và sau đó đến Họ đệm. Các cột gồm TT, Họ đệm, Tên, Tổ và Nội dung. Hình ảnh minh họa cách tổ chức lại dữ liệu trực quan theo nhiều tiêu chí.", "page_num": "31"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 6.7", "visual_caption": "Các bước lọc danh sách học sinh theo từng nội dung", "visual_description": "Ảnh chụp màn hình giao diện phần mềm bảng tính hiển thị menu thả xuống (dropdown menu) của bộ lọc (Filter) tại cột E (Nội dung). Giao diện thể hiện các tùy chọn sắp xếp (Sort A to Z, Sort Z to Z), thanh tìm kiếm Search và danh sách hộp kiểm (checkbox) để chọn các mục nội dung như 'Bảng tính điện tử', 'Đồ hoạ máy tính', 'Mạng máy tính', 'Ngôn ngữ lập trình',... Trong hình có các chú thích bằng số từ 1 đến 3 hướng dẫn thao tác nháy chuột để thực hiện bộ lọc.", "page_num": "31"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 6.8", "visual_caption": "Kết quả lọc dữ liệu", "visual_description": "Ảnh chụp bảng dữ liệu 'Bảng kết quả khảo sát lớp 8A' sau khi đã áp dụng bộ lọc. Bảng chỉ hiển thị các dòng có nội dung là 'Ngôn ngữ lập trình' (các dòng khác chứa nội dung khác đã bị ẩn đi), giúp người dùng dễ dàng quan sát và phân tích tập dữ liệu con.", "page_num": "31"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "visual_asset_code": "Hình 6.9", "visual_caption": "Bảng dữ liệu khảo sát thời gian học sinh sử dụng thiết bị số mỗi ngày", "visual_description": "Ảnh chụp giao diện bảng tính Excel hiển thị bảng dữ liệu khảo sát thời gian sử dụng thiết bị số của học sinh khối 8 từ cột A đến cột G, với các tiêu đề cột gồm: TT, Lớp, Không sử dụng, Dưới 1 giờ, 1-2 giờ, 3-4 giờ, Từ 5 giờ trở lên. Bảng chứa dữ liệu thống kê số lượng học sinh của từng lớp (từ 8A1 đến 8A10) theo các mức thời gian khác nhau, giúp học sinh thực hành các thao tác lọc và sắp xếp dữ liệu.", "page_num": "32"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.1", "visual_caption": "Trình bày dữ liệu bằng bảng", "visual_description": "Ảnh chụp màn hình bảng tính Excel thể hiện bảng tổng hợp kết quả khảo sát lớp 8A với các cột: TT, Nội dung Tin học, Số học sinh quan tâm. Bảng liệt kê 6 nội dung Tin học gồm Ngôn ngữ lập trình (8), Mạng máy tính (7), Đồ hoạ máy tính (15), Bảng tính điện tử (4), Soạn thảo văn bản (2), Phần mềm trình chiếu (5).", "page_num": "33"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.2", "visual_caption": "Trình bày dữ liệu bằng biểu đồ", "visual_description": "Ảnh chụp màn hình biểu đồ cột thể hiện số học sinh quan tâm đến các nội dung Tin học dựa trên dữ liệu từ Hình 7.1. Biểu đồ trực quan hóa số liệu giúp dễ dàng nhận thấy 'Đồ hoạ máy tính' thu hút sự quan tâm nhiều nhất.", "page_num": "33"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.3", "visual_caption": "Biểu đồ đoạn thẳng", "visual_description": "Biểu đồ đoạn thẳng minh họa 'Số ứng dụng trên điện thoại được tải về từ các chợ ứng dụng' từ năm 2017 đến 2020 có xu hướng tăng dần từ dưới 150 lên trên 200.", "page_num": "34"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.4", "visual_caption": "Biểu đồ hình quạt tròn", "visual_description": "Biểu đồ hình quạt tròn thể hiện 'Số học sinh quan tâm' với các tỷ lệ phần trăm cho các nội dung như Ngôn ngữ lập trình (19%), Đồ hoạ máy tính (17%), Bảng tính điện tử (10%), Phần mềm trình chiếu (5%), v.v.", "page_num": "34"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.5", "visual_caption": "Nhóm lệnh Charts", "visual_description": "Ảnh chụp giao diện thanh công cụ trong phần mềm bảng tính (Excel) tại thẻ Insert, nhóm lệnh Charts bao gồm các tùy chọn Recommended Charts, các loại biểu đồ cột, đường, hình quạt, Maps và PivotChart.", "page_num": "34"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.6", "visual_caption": "Bổ sung thông tin cho biểu đồ", "visual_description": "Ảnh chụp màn hình giao diện phần mềm Microsoft Excel minh họa thao tác chọn nút lệnh Chart Elements ở góc trên bên phải của biểu đồ cột 'Số học sinh quan tâm', mở ra danh sách các tuỳ chọn bổ sung thông tin cho biểu đồ như Axis Titles, Chart Title, Data Labels, Data Table, Gridlines, Legend, Trendline.", "page_num": "35"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.7", "visual_caption": "Bổ sung thông tin cho biểu đồ hình quạt tròn", "visual_description": "Ảnh chụp màn hình giao diện phần mềm Microsoft Excel hiển thị biểu đồ hình quạt tròn 'Số học sinh quan tâm' kèm theo hộp thoại tuỳ chọn Chart Elements và khung làm việc định dạng nhãn dữ liệu (Label Option) với tuỳ chọn Percentage để hiển thị tỉ lệ phần trăm.", "page_num": "35"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.8", "visual_caption": "Tổng số học sinh sử dụng thiết bị số trong mỗi khoảng thời gian", "visual_description": "Bảng dữ liệu trong phần mềm bảng tính gồm 2 cột: 'Thời gian' (các khoảng: Không sử dụng, Dưới 1 giờ, 1-2 giờ, 3-4 giờ, Từ 5 giờ trở lên) và 'Số học sinh' (lần lượt là 68, 131, 146, 72, 12). Bảng cung cấp dữ liệu thống kê để học sinh thực hành vẽ biểu đồ cột và biểu đồ hình quạt tròn.", "page_num": "36"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "visual_asset_code": "Hình 7.9", "visual_caption": "Doanh thu công nghiệp phần mềm giai đoạn 2016 – 2020", "visual_description": "Biểu đồ cột thể hiện doanh thu công nghiệp phần mềm qua các năm từ 2016 đến 2020 (đơn vị: Triệu USD). Các giá trị doanh thu tương ứng: 2016 (3.038), 2017 (3.779), 2018 (4.447), 2019 (4.932), 2020 (5.439). Biểu đồ giúp học sinh quan sát xu hướng tăng trưởng và thực hành tạo bảng dữ liệu ngược lại từ biểu đồ.", "page_num": "36"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.1", "visual_caption": "Phiếu khảo sát", "visual_description": "Ảnh chụp mẫu phiếu khảo sát 'Họ và tên', 'Lớp', và nội dung câu hỏi 'Bạn mong muốn tìm hiểu thêm nội dung nào của môn Tin học?' kèm theo 6 mục lựa chọn có hộp kiểm (checkbox) từ số 1 đến số 6: Ngôn ngữ lập trình, Mạng máy tính, Đồ hoạ máy tính, Bảng tính điện tử, Soạn thảo văn bản, Phần mềm trình chiếu. Hình ảnh minh họa cho bài toán thực tế cần sử dụng danh sách dạng liệt kê trong soạn thảo văn bản.", "page_num": "37"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.2", "visual_caption": "Văn bản không sử dụng danh sách dạng liệt kê", "visual_description": "Đoạn văn bản mô tả các công việc cần làm cho dự án Thành lập CLB Tin học được trình bày dạng văn bản thuần túy liên tục, không có các ký hiệu đánh dấu hay phân cấp ý, làm cho người đọc khó nắm bắt các bước công việc.", "page_num": "38"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.3", "visual_caption": "Văn bản sử dụng danh sách dạng liệt kê", "visual_description": "Đoạn văn bản mô tả các công việc cần làm cho dự án Thành lập CLB Tin học được trình bày lại bằng danh sách có thứ tự kết hợp danh sách dấu đầu dòng (bulleted and numbered lists), giúp cấu trúc các công việc khảo sát, xử lí dữ liệu, quảng cáo và tổ chức sự kiện trở nên rõ ràng, khoa học và dễ theo dõi.", "page_num": "38"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.4", "visual_caption": "Danh sách có thứ tự", "visual_description": "Minh họa kết quả khi thêm đoạn văn bản mới bằng cách nhấn phím Enter tại cuối dòng thứ hai trong danh sách có thứ tự. Gồm ba ô kết quả a, b, c thể hiện các tình huống sắp xếp lại các mục trong danh sách số từ 1 đến 4 hoặc 5.", "page_num": "39"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.5", "visual_caption": "Tờ rơi không có hình minh họa", "visual_description": "Mẫu tờ rơi thông báo tuyển thành viên cho Câu lạc bộ Tin học chỉ chứa văn bản đơn thuần, bố cục đơn giản với tiêu đề 'TUYỂN THÀNH VIÊN' và thông tin thời gian, địa điểm tại Nhà A.", "page_num": "39"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.6", "visual_caption": "Tờ rơi có hình minh họa", "visual_description": "Mẫu tờ rơi thông báo tuyển thành viên cho Câu lạc bộ Tin học được bổ sung hình ảnh minh họa sinh động ở phần đầu tờ rơi (hình quả địa cầu công nghệ số kết hợp các khối mã nhị phân), giúp tờ rơi trực quan và thu hút hơn.", "page_num": "39"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8a.7", "visual_caption": "Các bước tạo danh sách có thứ tự", "visual_description": "Ảnh chụp giao diện thanh Ribbon của phần mềm Microsoft Word 2016, hướng dẫn 3 bước tạo danh sách có thứ tự (Numbered list) trong thẻ Home: Bước 1 chọn thẻ Home, bước 2 nháy chuột vào hình tam giác nhỏ bên cạnh lệnh Numbering, bước 3 chọn kiểu danh sách có thứ tự mong muốn trong hộp thoại Numbering Library.", "page_num": "40"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.8", "visual_caption": "Kết quả các bước tạo danh sách có thứ tự", "visual_description": "Ảnh chụp 3 giai đoạn tiến hành trên một phiếu khảo sát dạng form điền thông tin, minh họa qua các mũi tên chuyển đổi từ danh sách chưa có số thứ tự sang danh sách được đánh số tự động từ 1 đến 6 cho các mục nội dung tin học.", "page_num": "41"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "visual_asset_code": "Hình 8a.9", "visual_caption": "Các bước chèn, thay đổi lớp và kích thước ảnh", "visual_description": "Ảnh chụp 4 trạng thái từ a đến d minh họa quá trình tạo tờ rơi CLB Tin học: (a) văn bản thô chưa chèn ảnh, (b) chèn ảnh nền che khuất văn bản, (c) chỉnh sửa thuộc tính Wrap Text thành Behind Text để đưa văn bản lên trên ảnh nền, và (d) kéo dãn kích thước ảnh phủ kín trang giấy.", "page_num": "41"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.10", "visual_caption": "Các bước vẽ hình đồ hoạ", "visual_description": "Ảnh chụp màn hình giao diện phần mềm soạn thảo văn bản (Microsoft Word), minh họa các bước trên Ribbon: Bước 1 chọn thẻ Insert, Bước 2 nháy chuột vào mũi tên dưới lệnh Shapes trong nhóm Illustrations, Bước 3 chọn mẫu trong nhóm Block Arrows.", "page_num": "42"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.11", "visual_caption": "Nhóm Block Arrows", "visual_description": "Ảnh chụp màn hình danh sách các mẫu hình mũi tên (Block Arrows) trong menu Shapes của phần mềm soạn thảo văn bản, bao gồm cả mũi tên cong (Arrow: Curved Right) được đánh dấu chọn để phục vụ vẽ hình trên tờ rơi.", "page_num": "42"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.1", "visual_caption": "Trang văn bản", "visual_description": "Ảnh chụp trang văn bản tiêu đề 'DỰ ÁN THÀNH LẬP CLB TIN HỌC' không có đầu trang và chân trang, thể hiện bố cục trang tài liệu thông thường trước khi bổ sung thông tin định danh.", "page_num": "43"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.2", "visual_caption": "Trang văn bản", "visual_description": "Ảnh chụp trang văn bản 'DỰ ÁN THÀNH LẬP CLB TIN HỌC' sau khi đã được bổ sung phần đầu trang bằng chữ màu cam 'Tài liệu dự án' ở góc trên bên phải và phần chân trang gồm số trang '1' cùng dòng chữ 'CLB Tin học' ở góc dưới bên phải.", "page_num": "43"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.3", "visual_caption": "Vị trí của đầu trang và chân trang", "visual_description": "Sơ đồ khối minh họa vị trí tương đối trên một trang giấy: phần trên cùng là 'ĐẤU TRang' (Đầu trang), ở giữa là 'NỘI DUNG VĂN BẢN', và phần dưới cùng là 'CHÂN TRANG'. Sơ đồ giúp học sinh hình dung rõ không gian phân bổ của Header và Footer trong trang văn bản.", "page_num": "43"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.4", "visual_caption": "Ví dụ cách đặt số trang", "visual_description": "Hình ảnh sơ đồ minh họa 4 vị trí đặt số trang trên trang văn bản: (1) Số trang ở vị trí đầu trang, giữa; (2) Số trang ở vị trí đầu trang, bên trái; (3) Số trang ở vị trí đầu trang, bên phải; (4) Số trang ở vị trí chân trang, giữa. Hình ảnh giúp học sinh trực quan hóa các tùy chọn bố trí số trang trong phần mềm soạn thảo văn bản.", "page_num": "44"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.5", "visual_caption": "Văn bản sau khi bổ sung nội dung, đánh số trang, thêm đầu trang và chân trang", "visual_description": "Ảnh minh họa hai trang tài liệu dự án Thành lập CLB Tin học và Phiếu khảo sát. Trên các trang có phần đầu trang (Header) hiển thị 'Tài liệu dự án' hoặc 'C. Tài liệu dự án' và phần chân trang (Footer) hiển thị số trang ('1', '2') kết hợp dòng chữ đỏ 'CLB Tin học'. Hình ảnh minh họa trực quan kết quả định dạng bố cục trang văn bản chuyên nghiệp.", "page_num": "45"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.6", "visual_caption": "Nhóm lệnh Header & Footer", "visual_description": "Sơ đồ chỉ dẫn giao diện nhóm lệnh 'Header & Footer' trên thẻ 'Insert' của phần mềm soạn thảo văn bản Microsoft Word. Sơ đồ làm nổi bật 3 nút lệnh chính gồm: 'Header' (chèn đầu trang), 'Footer' (chèn chân trang) và 'Page Number' (đánh số trang), với các mũi tên chỉ dẫn thao tác rõ ràng giúp học sinh dễ dàng nhận diện trên thanh công cụ.", "page_num": "45"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "visual_asset_code": "Close Header and Footer", "visual_caption": "Nút lệnh Close Header and Footer", "visual_description": "Biểu tượng hình chữ X màu đỏ kèm dòng chữ Close Header and Footer dùng để đóng chế độ chỉnh sửa đầu trang và chân trang.", "page_num": "46"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9a.7", "visual_caption": "Mẫu bổ sung đường thẳng vào đầu trang, chân trang", "visual_description": "Hai trang văn bản minh họa kết quả sau khi bổ sung đầu trang ('Nhóm 1', 'Tài liệu dự án') và chân trang ('1', '2', 'CLB Tin học') cùng đường kẻ ngang phân cách, giúp học sinh quan sát trực quan bố cục trang văn bản chuyên nghiệp.", "page_num": "46"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "visual_asset_code": "Hình 10a.1", "visual_caption": "Văn bản trong tệp văn bản", "visual_description": "Ảnh chụp khung 'MỤC TIÊU HOẠT ĐỘNG CỦA CLB TIN HỌC' hiển thị dưới dạng văn bản chi tiết trong tệp văn bản gồm 5 ý được đánh số từ 1) đến 5), trình bày đầy đủ và dài dòng hơn.", "page_num": "47"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "visual_asset_code": "Hình 10a.2", "visual_caption": "Văn bản trên trang chiếu", "visual_description": "Ảnh chụp khung 'MỤC TIÊU HOẠT ĐỘNG' hiển thị dưới dạng các gạch đầu dòng ngắn gọn gồm 4 ý chính: Truyền cảm hứng, chia sẻ niềm đam mê Tin học; Tạo môi trường giao lưu, hợp tác; Củng cố ý thức tự giác, nâng cao khả năng tự học, rèn luyện, nâng cao kĩ năng sống; Kích thích tính chủ động, sáng tạo.", "page_num": "47"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10a.3", "visual_caption": "Nội dung các trang chiếu", "visual_description": "Sơ đồ hoặc ảnh chụp bố cục gồm 4 ô nội dung đại diện cho 4 trang chiếu của bài thuyết trình CLB Tin học: (1) Chào mừng các bạn đến với CLB Tin học và Mục tiêu hoạt động; (2) Nguyên tắc hoạt động; (3) Kế hoạch hoạt động. Hình ảnh giúp học sinh định hình cấu trúc và nội dung chi tiết cần nhập liệu cho bài trình chiếu.", "page_num": "49"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "visual_asset_code": "Hình 10a.4", "visual_caption": "Nhóm lệnh Text", "visual_description": "Ảnh chụp giao diện thanh công cụ (Ribbon) trong phần mềm Microsoft PowerPoint, cụ thể là nhóm lệnh Text thuộc thẻ Insert. Nhóm lệnh bao gồm các nút chức năng: Text Box, Header & Footer, WordArt, Date & Time, Slide Number, và Object. Hình ảnh giúp học sinh định vị chính xác vị trí của nút lệnh Header & Footer để thực hiện chèn đầu trang và chân trang.", "page_num": "50"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "visual_asset_code": "Hình 10a.5", "visual_caption": "Các bước đánh số trang và thêm đầu trang, chân trang", "visual_description": "Ảnh chụp cửa sổ hộp thoại 'Header and Footer' trong PowerPoint với các chú thích chi tiết bằng khung màu và mũi tên chỉ dẫn: tùy chọn 'Date and time' để thêm thông tin ngày trình chiếu, tùy chọn 'Update automatically' để tự động cập nhật ngày, tùy chọn 'Slide number' để chèn số trang, tùy chọn 'Footer' để nhập thông tin chân trang (ví dụ: 'CLB Tin học - Trường THCS...'), hộp kiểm 'Don't show on title slide' để không hiển thị ở trang tiêu đề, cùng với các nút lệnh 'Apply', 'Apply to All' và 'Cancel'.", "page_num": "50"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10a.6", "visual_caption": "Các trang chiếu kết quả", "visual_description": "Ảnh chụp gồm 4 trang chiếu (slides) kết quả của bài trình chiếu giới thiệu CLB Tin học: Trang 1 là tiêu đề 'CHÀO MỪNG CÁC BẠN ĐẾN VỚI CLB TIN HỌC' với tên tác giả; Trang 2 hiển thị 'MỤC TIÊU HOẠT ĐỘNG' với danh sách các mục tiêu bằng dấu đầu dòng; Trang 3 nêu 'NGUYÊN TẮC HOẠT ĐỘNG'; Trang 4 trình bày 'KẾ HOẠCH HOẠT ĐỘNG'. Các trang đều sử dụng chung một mẫu định dạng (template) với nền xanh lá cây và bố cục trực quan.", "page_num": "51"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11a.3", "visual_caption": "Các bước sử dụng một bản mẫu", "visual_description": "Ảnh chụp màn hình giao diện phần mềm trình chiếu minh họa 3 bước thao tác để chọn bản mẫu: Bước 1 chọn New, Bước 2 chọn Education, Bước 3 chọn Lab Safety thông qua ô tìm kiếm và các thẻ phân loại chủ đề.", "page_num": "54"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11a.4", "visual_caption": "Bản mẫu An toàn phòng thực hành", "visual_description": "Ảnh chụp tổng quan các trang chiếu (slides) trong bản mẫu 'Lab Safety' (An toàn phòng thực hành) với thiết kế màu xanh dương và cam, bao gồm các tiêu đề như 'An toàn phòng thực hành', 'Trang phục khi đến phòng thực hành', 'Thực hành an toàn', và 'Hãy nhớ... An toàn là trên hết!', cung cấp bố cục trực quan để học sinh điền nội dung.", "page_num": "54"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11a", "visual_asset_code": "Hình 11a.5", "visual_caption": "Bài trình chiếu kết quả", "visual_description": "Ảnh chụp gồm 8 trang chiếu (slide) minh họa kết quả hoàn thiện của bài trình chiếu về chủ đề 'An toàn phòng thực hành' do học sinh thực hiện. Các trang chiếu bao gồm: Tiêu đề 'An toàn phòng thực hành' (Nguyễn Thu An - 8A5), 'Trước khi vào phòng thực hành', 'Trang phục khi đến phòng thực hành', 'Thực hành an toàn', 'Khi xảy ra sự cố trong phòng thực hành', 'Những việc cần làm trước khi rời phòng thực hành' và trang kết luận 'Hãy nhớ... An toàn là trên hết!'. Giao diện sử dụng tông màu xanh dương và cam chủ đạo, kết hợp các biểu tượng khoa học, khung nội dung và sơ đồ khối mạch lạc, thể hiện tính trực quan và sư phạm cao trong việc giáo dục an toàn thực hành.", "page_num": "55"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11a.6", "visual_caption": "Chèn đường dẫn đến tệp video", "visual_description": "Ảnh chụp cửa sổ giao diện hộp thoại Insert Hyperlink trong phần mềm trình chiếu Microsoft PowerPoint. Hộp thoại hiển thị các tùy chọn liên kết bên trái như Existing File or Web Page, Place in This Document, Create New Document, E-mail Address. Vùng trung tâm hiển thị thư mục 'AnToan' và tệp video 'NhungSuCoPhongThucHanh.mp4' được chọn, cùng ô Address hiển thị đường dẫn tương đối tới tệp video. Hình ảnh minh họa trực quan các bước thiết lập siêu liên kết (hyperlink) từ một đối tượng trên trang chiếu tới một tệp đa phương tiện bên ngoài.", "page_num": "56"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "visual_asset_code": "Hình 8b.7", "visual_caption": "Màn hình làm việc của phần mềm GIMP", "visual_description": "Ảnh chụp giao diện phần mềm GIMP với các thành phần chính được chú thích bằng khung màu xám và mũi tên chỉ dẫn chi tiết: Bảng công cụ (chứa các công cụ chọn, cắt, tô màu, vẽ), Hộp tuỳ chọn công cụ (hiển thị thông số chi tiết của công cụ đang chọn như Crop, kích thước, vị trí), Vùng làm việc (khu vực hiển thị hình ảnh đang chỉnh sửa), và Bảng tuỳ chọn cấu hình, điều khiển lớp (quản lý các lớp Layers, Channels, Paths). Hình ảnh giúp học sinh nắm vững tổng quan không gian làm việc của phần mềm xử lý ảnh.", "page_num": "61"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "visual_asset_code": "Hình 8b.8", "visual_caption": "Một phần cửa sổ Image Properties", "visual_description": "Ảnh chụp hộp thoại Image Properties hiển thị các thông số chi tiết của tệp ảnh được chú thích bằng các mũi tên hồng: Kích thước ảnh (Size in pixels), Độ phân giải (Resolution), Không gian màu (Color space), Tên tệp ảnh (File Name), Kích thước tệp (File Size), và Định dạng tệp (File Type). Hình ảnh giúp học sinh minh họa rõ cách đọc thông tin kỹ thuật của một bức ảnh số.", "page_num": "61"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.1", "visual_caption": "Một ví dụ về xoay ảnh kết hợp cắt ảnh", "visual_description": "Ảnh minh họa gồm hai phần: bên trái là bức ảnh chụp kiến trúc trường học bị nghiêng nhẹ, bên phải là bức ảnh sau khi đã được xoay chỉnh lại đường chân trời thẳng hàng và cắt bớt các chi tiết thừa xung quanh để có bố cục cân đối, đẹp mắt hơn. Ở giữa có mũi tên màu xanh chỉ hướng chuyển đổi từ ảnh gốc sang ảnh đã xử lý.", "page_num": "63"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.7", "visual_caption": "Các bước cắt ảnh bằng công cụ Crop", "visual_description": "Ảnh chụp giao diện phần mềm chỉnh sửa ảnh GIMP minh họa chi tiết thao tác cắt ảnh bằng công cụ Crop. Giao diện hiển thị thanh công cụ bên trái với biểu tượng Crop được chọn, vùng làm việc chính hiển thị bức ảnh phong cảnh có lồng khung hình chữ nhật nét đứt xác định vùng ảnh cần giữ lại, phần bên ngoài được làm tối. Sơ đồ ở phía trên chỉ rõ 2 bước: 1. Chọn công cụ Crop, 2. Chọn vùng cần giữ lại. Hình ảnh giúp học sinh hình dung trực quan cách định khung và cắt bỏ chi tiết thừa trên ảnh.", "page_num": "65"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.3", "visual_caption": "Điều chỉnh độ sáng cho ảnh", "visual_description": "Hình ảnh gồm hai phần: a) Ảnh gốc chụp sân trường với khung cảnh hơi tối và b) Ảnh sau khi tăng độ sáng, giúp khung cảnh trở nên sáng sủa hơn, rõ ràng các chi tiết cây cối và ghế đá.", "page_num": "68"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10.4", "visual_caption": "Điều chỉnh độ tương phản cho ảnh", "visual_description": "Hình ảnh minh họa kết quả điều chỉnh độ tương phản gồm: a) Ảnh gốc chụp vòm cây xanh và b) Ảnh sau khi tăng độ tương phản, làm cho các vùng tối sậm hơn và vùng sáng nổi bật hơn, giúp sự khác biệt giữa các chi tiết rõ nét hơn.", "page_num": "68"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10b.5", "visual_caption": "Điều chỉnh độ mờ của ảnh", "visual_description": "Ảnh gồm hai phần: a) Ảnh gốc chụp đóa hồng đỏ tươi với phần nền xung quanh sắc nét; b) Ảnh đã làm mờ phần nền, giúp đối tượng chính là đóa hoa hồng nổi bật hơn. Hình ảnh minh họa tác dụng của việc xử lý làm mờ hậu cảnh trong chỉnh sửa ảnh.", "page_num": "69"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10b.6", "visual_caption": "Các bước chèn văn bản", "visual_description": "Sơ đồ minh họa 3 bước thực hiện chèn văn bản trên phần mềm xử lý ảnh: Bước 1 - Chọn công cụ chèn văn bản; Bước 2 - Nháy chuột vào vị trí cần chèn và nhập nội dung; Bước 3 - Định dạng văn bản. Bên dưới là ảnh chụp màn hình giao diện phần mềm chỉnh sửa ảnh với các hộp công cụ và ô nhập văn bản chữ 'Vườn hồng' trên ảnh.", "page_num": "69"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.7", "visual_caption": "Hộp thoại Brightness-Contrast", "visual_description": "Ảnh chụp giao diện hộp thoại Brightness-Contrast trong phần mềm GIMP, bao gồm các thanh trượt điều chỉnh Brightness (Độ sáng) và Contrast (Độ tương phản) cùng các nút lệnh Reset, OK, Cancel, giúp học sinh trực quan hóa cách tinh chỉnh thông số ánh sáng của bức ảnh.", "page_num": "70"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.8", "visual_caption": "Các bước làm mờ ảnh", "visual_description": "Sơ đồ chỉ dẫn chi tiết trên giao diện phần mềm GIMP với các bước: 1. Chọn công cụ, 2. Chọn Blur để làm mờ hoặc Sharpen để làm sắc nét, 3. Chọn cọ vẽ Brush, 4. Chọn kích thước cọ vẽ, 5. Chọn tốc độ thay đổi, 6. Nháy chuột vào vùng cần làm mờ hoặc làm sắc nét. Hình ảnh minh họa thao tác trực tiếp trên bức ảnh bông hoa đỏ với nền xung quanh.", "page_num": "70"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "visual_asset_code": "Hình 11b.1", "visual_caption": "Đặt tên cho lớp mới", "visual_description": "Ảnh chụp giao diện hộp thoại 'Create a New Layer' trong phần mềm GIMP, cho phép người dùng cấu hình tên lớp ('Layer name' là Khungvien), chế độ hòa trộn (Mode), độ mờ (Opacity), kích thước chiều rộng, chiều cao và màu tô nền (Fill with: Transparency), kèm theo các nút lệnh Help, OK, Cancel.", "page_num": "71"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "visual_asset_code": "Hình 11b.2", "visual_caption": "Cửa sổ Layer", "visual_description": "Ảnh chụp giao diện cửa sổ 'Layers' hiển thị danh sách các lớp sau khi tạo mới, trong đó lớp 'Khungvien' nằm phía trên lớp 'Anh_Crop', giúp học sinh quản lý các lớp ảnh theo thứ tự trên dưới.", "page_num": "71"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "visual_asset_code": "Hình 11b.3", "visual_caption": "Ẩn lớp Anh_Crop", "visual_description": "Ảnh chụp giao diện thu nhỏ của cửa sổ 'Layers' minh họa thao tác nháy chuột vào biểu tượng con mắt bên cạnh lớp 'Anh_Crop' để ẩn nội dung của lớp đó trên vùng làm việc.", "page_num": "71"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11b.4", "visual_caption": "Các bước đổ màu cho lớp Khungvien", "visual_description": "Ảnh chụp giao diện phần mềm chỉnh sửa ảnh GIMP, minh họa 3 bước sử dụng công cụ Gradient: (1) Chọn công cụ Gradient trên hộp công cụ, (2) Nháy chuột vào hai ô vuông để chọn màu nền và màu vẽ, (3) Kéo thả chuột để điều chỉnh vị trí và hướng chuyển giữa hai màu trên vùng làm việc. Bên trái hiển thị cửa sổ tùy chỉnh Gradient với các thông số Mode, Opacity, Blend Color Space, Shape...", "page_num": "72"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11b.5", "visual_caption": "Trộn các lớp ảnh", "visual_description": "Ảnh chụp giao diện phần mềm GIMP minh họa thao tác chọn menu Layer và chọn lệnh Merge Down để trộn lớp ảnh trên cùng với lớp bên dưới. Giao diện hiển thị cửa sổ Layers ở góc phải và vùng làm việc chính giữa với các lớp ảnh Khungvien và Anh_Crop.", "page_num": "72"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "visual_asset_code": "Hình 11b.6", "visual_caption": "Hình 11b.6. Tờ rơi giới thiệu về trường", "visual_description": "Hình ảnh minh họa sản phẩm tờ rơi hoàn chỉnh được thiết kế bằng phần mềm chỉnh sửa ảnh GIMP với chủ đề 'SCHOOL TOUR'. Tờ rơi có phông nền màu xanh da trời kết hợp các họa tiết mùa hè (dù bảy màu, bóng bãi biển, sao biển, hoa sứ). Trên nền có ghép các bức ảnh chụp hoạt động trường học đã được tạo khung viền, kèm dòng chữ thời gian '10:30 – 11:00 thứ 7 hàng tuần' và tiêu đề lớn 'SCHOOL TOUR' trên nền bảng gỗ. Hình ảnh đóng vai trò là sản phẩm mẫu trực quan giúp học sinh hình dung kết quả thực hành sau khi hoàn thiện.", "page_num": "73"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.1", "visual_caption": "Nhân vật di chuyển", "visual_description": "Ảnh chụp màn hình phần mềm lập trình trực quan (như Scratch) thể hiện nhân vật chú bọ rùa đang di chuyển trên sân khấu theo đường viền của một hình tam giác đều màu hồng, minh họa cho việc điều khiển nhân vật theo kịch bản.", "page_num": "74"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.2", "visual_caption": "Đường đi của nhân vật", "visual_description": "Sơ đồ minh họa góc quay của nhân vật khi di chuyển cạnh tam giác đều. Hình vẽ cho thấy góc quay bên ngoài là 120 độ khi nhân vật đổi hướng để tiếp tục đi theo cạnh tiếp theo của hình tam giác đều.", "page_num": "74"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.3", "visual_caption": "Sơ đồ khối và chương trình thực hiện thuật toán", "visual_description": "Hình ảnh gồm hai phần a và b minh họa mối tương quan giữa sơ đồ khối (a) và đoạn mã lệnh Scratch (b). Sơ đồ khối (a) thể hiện cấu trúc lặp với các khối: Bắt đầu, Lần lặp <- 1, điều kiện lặp (Lần lặp <= 3), khối lệnh thực hiện (Di chuyển 60 bước, Quay trái 120 độ, Tăng Lần lặp lên 1 đơn vị) và Kết thúc. Phần (b) là tập hợp các khối lệnh Scratch tương ứng: 'Khi bấm vào cờ xanh', 'lặp lại 3', 'di chuyển 60 bước', 'xoay 120 độ'. Các mũi tên đứt nét thể hiện sự ánh xạ trực tiếp từ từng bước trong sơ đồ khối sang các khối lệnh trong ngôn ngữ lập trình Scratch.", "page_num": "75"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.4", "visual_caption": "Chương trình vẽ hình tam giác đều", "visual_description": "Khối lệnh chương trình Scratch hoàn chỉnh để vẽ hình tam giác đều. Bao gồm: khối sự kiện 'Khi bấm vào [lá cờ xanh]'; các khối lệnh từ nhóm Bút vẽ: 'Xóa tất cả', 'đặt bút', 'chọn bút màu [hồng tím]'; khối lặp 'lặp lại 3' lần chứa: 'di chuyển 60 bước', 'xoay ngược chiều kim đồng hồ 120 độ', 'đợi 1 giây'; cuối cùng là lệnh 'nhấc bút'. Giúp học sinh hiểu cách kết hợp cấu trúc lặp với các lệnh bút vẽ để tạo hình học.", "page_num": "76"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.5", "visual_caption": "Xe dừng lại khi cách hòn đá nhỏ hơn 120 bước", "visual_description": "Hình ảnh minh họa sân khấu Scratch gồm hai nhân vật: chiếc xe buýt màu hồng tím (Scratch Tours) đang chạy trên đường hướng tới một hòn đá màu xám. Minh họa cho kịch bản điều kiện dừng của xe dựa trên khoảng cách giữa hai đối tượng.", "page_num": "76"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12.6", "visual_caption": "Sơ đồ khối mô tả kịch bản", "visual_description": "Sơ đồ khối thuật toán lặp có điều kiện: bắt đầu từ khối Elip 'Bắt đầu', mũi tên đi vào khối hình thoi điều kiện (1). Nếu Sai (False), rẽ nhánh sang khối chữ nhật thao tác (2) rồi quay lại trước điều kiện (1). Nếu Đúng (True), rẽ nhánh đi tới khối Elip 'Kết thúc'. Minh họa trực quan cấu trúc lặp với điều kiện dừng.", "page_num": "76"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "visual_asset_code": "Bảng 13.1", "visual_caption": "Tập hợp giá trị của các kiểu dữ liệu trong ngôn ngữ lập trình Scratch", "visual_description": "Bảng liệt kê 3 kiểu dữ liệu gồm: Số (tập hợp giá trị là số nguyên và số thập phân, ví dụ: 15, 3.141592), Xâu kí tự (tập hợp giá trị là kí tự hoặc xâu kí tự, ví dụ: @, Computer), Lôgic (tập hợp giá trị gồm hai giá trị true và false, ví dụ: false, true).", "page_num": "78"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "visual_asset_code": "Bảng 13.2", "visual_caption": "Các phép toán cơ bản trong ngôn ngữ lập trình Scratch", "visual_description": "Bảng mô tả chi tiết các phép toán cơ bản theo từng kiểu dữ liệu trong Scratch: Kiểu Số (các phép toán cộng, trừ, nhân, chia, chia lấy dư, làm tròn số...), Kiểu Xâu kí tự (phép toán kết hợp/join nối các xâu kí tự), Kiểu Lôgic (các phép toán so sánh bằng, nhỏ hơn, lớn hơn, và các phép toán lôgic và/and, hoặc/or, không phải/not với các khối lệnh minh họa cụ thể của Scratch).", "page_num": "78"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "visual_asset_code": "Biểu thức minh họa", "visual_caption": "Biểu thức tính chu vi đường tròn", "visual_description": "Khối lệnh biểu thức số trong Scratch kết hợp phép nhân và hằng số/biến số để tính gần đúng chu vi đường tròn bán kính r: 2 * 3.14 * r.", "page_num": "79"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "visual_asset_code": "Hình 13.4", "visual_caption": "Giao diện chương trình Scratch trong phần thực hành", "visual_description": "Ảnh minh họa các khối lệnh tạo biến trong Scratch như 'Các biến số', các biến cụ thể gồm n, số bước, góc quay.", "page_num": "79"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.1", "visual_caption": "Thuật toán sử dụng cấu trúc tuần tự", "visual_description": "Hình ảnh gồm hai phần: phần a) mô tả thuật toán đọc và hiển thị dữ liệu dạng liệt kê văn bản (gồm 6 bước từ Bắt đầu, Gán giá trị ngẫu nhiên, Hỏi và nhận giá trị, Hiển thị số bí mật, Hiển thị trả lời, đến Kết thúc); phần b) thể hiện chương trình viết bằng ngôn ngữ lập trình Scratch sử dụng các khối lệnh 'Khi bấm vào', 'đặt [số bí mật v] thành (lấy ngẫu nhiên từ (1) đến (100))', 'hỏi (Hãy cho biết bạn đoán số nào?) và đợi', 'nói (số bí mật) trong (2) giây', 'nói (trả lời) trong (2) giây', và 'dừng lại [tất cả v]'. Hình ảnh giúp học sinh minh họa mối quan hệ giữa mô tả thuật toán tự nhiên và mã lệnh Scratch trong cấu trúc tuần tự.", "page_num": "81"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.4", "visual_caption": "Cấu trúc lặp", "visual_description": "Hình ảnh gồm 4 phần minh họa cho cấu trúc lặp và các khối lệnh lặp trong Scratch: a) Sơ đồ cấu trúc lặp có điều kiện với các khối kiểm tra điều kiện \"trả lời = số bí mật\", nhánh sai thực hiện so sánh nhận xét và máy hỏi lại, nhánh đúng xuất hiện thông báo \"HOAN HÔ!\"; b) Khối lệnh lặp 10 lần (lặp với số lần định trước); c) Khối lệnh lặp liên tục (lặp vô hạn); d) Khối lệnh lặp cho đến khi (lặp có điều kiện kết thúc) chứa điều kiện \"trả lời = số bí mật\" bên trong. Hình ảnh giúp học sinh hình dung trực quan về thuật toán lặp và các dạng khối lệnh lặp tương ứng trong Scratch.", "page_num": "83"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.5", "visual_caption": "Khung chương trình", "visual_description": "Ảnh chụp màn hình các khối lệnh Scratch sắp xếp theo cấu trúc tuần tự từ trên xuống dưới bao gồm các khối: sự kiện khi bấm vào cờ xanh, đặt biến số bí mật thành 0, hỏi 'Hãy cho biết bạn đoán số nào?' và đợi, lặp lại cho đến khi, nói 'HOAN HÔ!', dừng lại tất cả. Hình ảnh hướng dẫn học sinh tạo khung kịch bản cơ bản cho trò chơi đoán số.", "page_num": "84"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.6", "visual_caption": "Tạo các biểu thức trong khối lệnh", "visual_description": "Ảnh chụp gồm 2 phần minh họa chi tiết cho việc tạo biểu thức trong Scratch: Phần a ('Biểu thức trong khối lệnh') hiển thị khung chương trình đã được lắp thêm khối lấy ngẫu nhiên từ 1 đến 100 vào biến số bí mật và điều kiện lặp lại cho đến khi trả lời = số bí mật; Phần b ('Khối lệnh rẽ nhánh') minh họa cấu trúc điều kiện nếu 'trả lời < số bí mật' thì hỏi 'Quá thấp!' và đợi, nếu không thì hỏi 'Quá cao!' và đợi. Hình ảnh thể hiện rõ cấu trúc điều khiển rẽ nhánh và vòng lặp trong lập trình trò chơi.", "page_num": "84"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.7", "visual_caption": "Chương trình hoàn chỉnh", "visual_description": "Hình ảnh gồm hai phần đặt cạnh nhau: bên trái là sơ đồ khối của thuật toán đoán số từ 1 đến 100 với các điều kiện rẽ nhánh (trả lời = số bí mật, trả lời < số bí mật), bên phải là đoạn chương trình Scratch hoàn chỉnh tương ứng với sơ đồ khối sử dụng các khối lệnh sự kiện, biến số, cảm biến, điều khiển (lặp lại cho đến khi, nếu... thì... nếu không thì) và hiển thị.", "page_num": "85"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Bảng 14.1", "visual_caption": "Các đoạn lệnh và kết quả thực hiện", "visual_description": "Bảng gồm 2 hàng: Hàng trên chứa 4 đoạn lệnh Scratch (a, b, c, d) sử dụng vòng lặp 'lặp lại' với số lần lặp lần lượt là 4, 5, 6, 3 kết hợp lệnh 'di chuyển 100 bước' và 'xoay 90 độ', '72 độ', '60 độ', '120 độ'. Hàng dưới chứa kết quả tương ứng: 1) Hình ba cạnh, 2) Hình bốn cạnh, 3) Hình năm cạnh, 4) Hình sáu cạnh.", "page_num": "85"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.8", "visual_caption": "Các khối lệnh", "visual_description": "Ảnh chụp giao diện các khối lệnh lập trình Scratch gồm khung chương trình chính có các vị trí trống 1, 2, 3, 4 và các nhóm khối lệnh a, b, c, d dùng để ghép nối tạo thành chương trình giải phương trình bậc nhất ax + b = 0. Hình ảnh minh họa trực quan cách tổ chức cấu trúc rẽ nhánh và nhập xuất dữ liệu trong Scratch.", "page_num": "86"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.9", "visual_caption": "Sơ đồ khối", "visual_description": "Sơ đồ khối thể hiện thuật toán tìm ước chung lớn nhất (ƯCLN) của hai số a và b bằng cách sử dụng phép chia lấy dư (thuật toán Euclid). Sơ đồ gồm các khối: Bắt đầu, Nhập hai số a và b, kiểm tra điều kiện a * b = 0, kiểm tra điều kiện a > b để thực hiện phép trừ/chia lấy dư cho đến khi tích bằng 0, và Xuất a + b.", "page_num": "86"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.10", "visual_caption": "Các khối lệnh", "visual_description": "Ảnh chụp giao diện các khối lệnh Scratch được đánh số từ 1 đến 9 bao gồm các câu lệnh gán giá trị, vòng lặp điều kiện, câu lệnh điều kiện rẽ nhánh và các sự kiện để học sinh sắp xếp thành chương trình hoàn chỉnh tính ước chung lớn nhất của hai số nguyên không âm.", "page_num": "86"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.1", "visual_caption": "Chương trình mới được tạo", "visual_description": "Ảnh chụp giao diện các khối lệnh Scratch (được đánh số dòng từ (1) đến (12)) minh họa cho chương trình trò chơi đoán số có bổ sung biến 'số lần đoán' và 'số bí mật'. Các khối lệnh bao gồm sự kiện khi bấm vào lá cờ xanh, các lệnh gán giá trị khởi tạo, vòng lặp, câu lệnh điều kiện rẽ nhánh (nếu - nếu không thì), các lệnh hỏi và trả lời, thay đổi biến, và nói kết quả. Hình ảnh giúp học sinh quan sát cấu trúc lập trình Scratch để thực hiện hoạt động kiểm thử.", "page_num": "87"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.2", "visual_caption": "Công cụ phát hiện lỗi lôgic", "visual_description": "Ảnh chụp giao diện phần mềm Scratch minh họa hai công cụ hỗ trợ gỡ lỗi và kiểm tra giá trị biến: (a) Hộp kiểm tra (checkbox) bên cạnh các khối lệnh hiển thị giá trị của biến số 'số bí mật' và 'số bí mật' (67) trên màn hình sân khấu nhằm theo dõi trạng thái dữ liệu; (b) Khối lệnh 'đợi 5 giây' dùng làm công cụ tạm dừng thực thi chương trình để quan sát các bước chạy.", "page_num": "89"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.3", "visual_caption": "Chương trình xác định một số là chẵn hay lẻ", "visual_description": "Đoạn mã lệnh Scratch sử dụng sự kiện khi bấm vào lá cờ xanh, dùng khối lệnh hỏi 'n = ' và đợi, kiểm tra điều kiện nếu phần dư của phép chia n cho 2 bằng 0 thì thông báo 'là số CHẴN', ngược lại thông báo 'là số LẺ'.", "page_num": "90"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.4", "visual_caption": "Chương trình cần được gỡ lỗi", "visual_description": "Đoạn mã lệnh Scratch gồm 15 dòng lệnh mô phỏng trò chơi Đoán số. Chương trình thiết lập số lần đoán bằng 0, chọn ngẫu nhiên số bí mật từ 1 đến 100, sử dụng vòng lặp 'lặp lại cho đến khi trả lời = số bí mật hoặc số lần đoán > 7', kiểm tra các điều kiện để đưa ra thông báo 'Quá thấp!', 'Quá cao!', xử lý số lần đoán và kiểm tra điều kiện thua cuộc.", "page_num": "90"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.5", "visual_caption": "Các lệnh (11) đến (14) sau khi sửa", "visual_description": "Ảnh chụp đoạn mã khối lệnh Scratch minh họa cấu trúc điều kiện 'nếu... thì... nếu không thì' sau khi đã sửa lỗi. Khối lệnh kiểm tra điều kiện 'trả lời = số bí mật', kết hợp các khối lệnh 'nói' để hiển thị thông báo 'HOAN HÔ!' hoặc kết quả số lần đoán và thông báo 'Bạn đã thua!' khi hết số lần đoán. Hình ảnh giúp học sinh trực quan hóa cách sửa lỗi cấu trúc rẽ nhánh và hiển thị trong lập trình kéo thả.", "page_num": "91"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "visual_asset_code": "Hình 16.1", "visual_caption": "Ví dụ về ứng dụng tin học trong một số nghề nghiệp", "visual_description": "Sơ đồ tư duy dạng mạng nhện minh họa các ứng dụng tin học trong 6 ngành nghề cụ thể: Bác sĩ (hồ sơ sức khoẻ điện tử, khám bệnh từ xa), Quản lí du lịch (quảng cáo sản phẩm du lịch, đặt chỗ khách sạn trên website), Kiến trúc sư (phần mềm thiết kế bản vẽ, in 3D tạo mẫu), Nhà báo (đăng bài nhanh chóng trên báo điện tử, chỉnh sửa ảnh, video dễ dàng), Nhân viên văn phòng (phần mềm soạn thảo văn bản, phần mềm lưu trữ hồ sơ), Kĩ sư nông nghiệp (tự động điều tiết nước tưới, nghiên cứu tiến bộ nông nghiệp: Ví dụ Internet vạn vật - IoT). Hình ảnh giúp học sinh trực quan hóa vai trò của tin học trong các lĩnh vực nghề nghiệp đa dạng.", "page_num": "93"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "visual_asset_code": "Hình 16.2", "visual_caption": "Chủ đề Ngày Quốc tế trẻ em gái với công nghệ thông tin năm 2021 là “Internet tốt hơn cho trẻ em”", "visual_description": "Ảnh poster với tông màu xanh và vàng cam, nổi bật dòng chữ 'Happy International Girls in ICT Day! 22 April 2021 - 10th Anniversary' cùng hashtag '#GirlsInICT'. Hình ảnh minh họa hai nhân vật nữ đang tương tác với thiết bị công nghệ (máy tính, máy tính bảng), thể hiện sự khích lệ phụ nữ và trẻ em gái tham gia vào lĩnh vực công nghệ thông tin.", "page_num": "94"}, {"grade_level": "Lớp 8", "lesson_id": "Glossary", "visual_asset_code": "Bảng 95", "visual_caption": "BẢNG GIẢI THÍCH THUẬT NGỮ", "visual_description": "Bảng tra cứu thuật ngữ chuyên môn trong sách giáo khoa Tin học 9 (bộ sách Kết nối tri thức với cuộc sống), trang 95. Bảng gồm 3 cột: Thư mục chữ cái (B, Đ, L, M, S, T), Thuật ngữ và phần Giải thích chi tiết, kèm theo số trang tham chiếu giúp học sinh dễ dàng tra cứu lại các khái niệm trọng tâm đã học.", "page_num": "96"}, {"grade_level": "Lớp 8", "lesson_id": "Trang bìa sau", "visual_asset_code": "Hình bìa sau", "visual_caption": "Danh mục sách giáo khoa lớp 8 bộ Kết nối tri thức với cuộc sống", "visual_description": "Hình ảnh hiển thị danh sách bìa các cuốn sách giáo khoa lớp 8 thuộc bộ Kết nối tri thức với cuộc sống, bao gồm cả SGK Tin học 8, cùng với danh sách các đơn vị đầu mối phát hành sách và website sách điện tử http://hanhtrangso.nxbgd.vn.", "page_num": "98"}, {"grade_level": "Lớp 9", "lesson_id": "Thông tin xuất bản", "visual_asset_code": "Ảnh bìa", "visual_caption": "Bìa sách giáo khoa Tin học 9", "visual_description": "Trang bìa gồm biểu trưng bộ sách Kết nối tri thức với cuộc sống ở góc trên bên trái, tên các tác giả ở phía trên bên phải. Tiêu đề lớn màu vàng nổi bật 'TIN HỌC' kết hợp số '9' màu trắng trong hình tròn màu cam viền xanh. Nửa dưới là hình ảnh bàn tay đang nâng đỡ một quả cầu Trái Đất dạng lưới kỹ thuật số phát sáng, bao quanh bởi các mạng lưới liên kết dữ liệu đa chiều màu tím và trắng, thể hiện tinh thần công nghệ thông tin và kết nối số toàn cầu. Phía dưới cùng có logo và tên 'NHÀ XUẤT BẢN GIÁO DỤC VIỆT NAM' cùng tem hình tròn 'BẢN MẪU - Tháng 10 - 2023'.", "page_num": "1"}, {"grade_level": "Lớp 9", "lesson_id": "Bìa sách", "visual_asset_code": "Bìa sách", "visual_caption": "Trang bìa SGK Tin học 9 - Kết nối tri thức với cuộc sống", "visual_description": "Trang bìa sách giáo khoa Tin học lớp 9, bộ sách 'Kết nối tri thức với cuộc sống', do Nhà xuất bản Giáo dục Việt Nam ấn hành. Bìa có màu hồng nhạt làm chủ đạo, nổi bật dòng chữ 'TIN HỌC 9' với số 9 nằm trong vòng tròn đỏ, và logo 'Bản mẫu' của NXB Giáo dục Việt Nam.", "page_num": "3"}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "visual_asset_code": "Hình 1", "visual_caption": "Hệ thống các biểu tượng định hướng hoạt động học tập", "visual_description": "Tập hợp các biểu tượng đồ họa (icon) tròn nhiều màu sắc đại diện cho các phần trong bài học: Biểu tượng ngọn lửa màu cam (Khởi động), biểu tượng cuốn sách mở màu đỏ (Kiến thức mới), biểu tượng bóng đèn phát sáng màu vàng (Hộp kiến thức), biểu tượng dấu chấm hỏi màu hồng (Câu hỏi kiểm tra), biểu tượng trang vở và cây bút màu xanh lục (Luyện tập), biểu tượng quả địa cầu kết nối mạng lưới màu xanh dương (Vận dụng). Các icon giúp học sinh dễ dàng nhận diện cấu trúc học tập trực quan.", "page_num": "4"}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "visual_asset_code": "Hình 2", "visual_caption": "Ba nhân vật đồng hành: An, Minh, Khoa", "visual_description": "Tranh vẽ minh họa ba bạn học sinh lớp 9 trong trang phục học sinh:\n- Bạn An (bạn nữ đeo kính, tóc ngắn, áo trắng váy xanh, đi tất đỏ).\n- Bạn Minh (bạn nam áo sơ mi trắng có viền cam, quần xanh dài, đi giày thể thao cam).\n- Bạn Khoa (bạn nam đeo kính, quàng khăn đỏ, áo sơ mi ngắn tay, quần xanh, mang giày nâu).\nBa nhân vật này đại diện cho ba mạch tri thức lớn của chương trình Giáo dục phổ thông môn Tin học 2018: Học vấn số hoá phổ thông, Công nghệ thông tin và truyền thông, và Khoa học máy tính.", "page_num": "4"}, {"grade_level": "Lớp 9", "lesson_id": "Mục lục", "visual_asset_code": "Trang 4", "visual_caption": "Mục lục Sách giáo khoa Tin học lớp 9", "visual_description": "Ảnh chụp trang mục lục của sách giáo khoa Tin học lớp 9, trình bày danh sách các chủ đề, tên bài học cụ thể cùng số trang tương ứng từ trang 5 đến trang 91, giúp học sinh và giáo viên nắm bắt tổng quan cấu trúc nội dung môn học.", "page_num": "6"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.3", "visual_caption": "Kính viễn vọng Hubble", "visual_description": "Ảnh chụp kính viễn vọng không gian Hubble bay ngoài quỹ đạo Trái Đất, minh họa cho việc ứng dụng công nghệ thông tin và máy tính hiệu năng cao trên các vệ tinh nhân tạo để nghiên cứu vũ trụ.", "page_num": "9"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "visual_asset_code": "Hình 1.4", "visual_caption": "Ô tô tự động lái do máy tính điều khiển", "visual_description": "Ảnh chụp góc nhìn cận cảnh vô lăng và bảng điều khiển của một chiếc ô tô tự động lái, minh họa cho ứng dụng của máy tính và trí tuệ nhân tạo trong lĩnh vực giao thông thông minh.", "page_num": "9"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "visual_asset_code": "Hình 2.1", "visual_caption": "Thông tin giới thiệu về một trường THPT", "visual_description": "Ảnh chụp màn hình trang web giới thiệu về trường THPT với dòng chữ 'Năm học 2001-2002' và các tiêu chí nổi bật như: Tự do sáng tạo, Nhiều câu lạc bộ, Phát triển kĩ năng, Ngoại khoá phong phú, Gặp gỡ người nổi tiếng, kèm theo hình ảnh hoạt động của học sinh. Hình ảnh minh họa cho trường hợp thông tin có thể lỗi thời hoặc chưa đầy đủ khi học sinh tìm kiếm thông tin chọn trường.", "page_num": "11"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "visual_asset_code": "Hình 2.2", "visual_caption": "Chất lượng thông tin", "visual_description": "Sơ đồ tư duy dạng cây hiển thị 4 tiêu chí cốt lõi để đánh giá chất lượng thông tin gồm: Tính mới, Tính chính xác, Tính đầy đủ, và Tính sử dụng được xuất phát từ nút trung tâm 'Chất lượng thông tin'. Sơ đồ giúp học sinh dễ dàng ghi nhớ các khía cạnh đánh giá thông tin khi tìm kiếm và xử lý dữ liệu.", "page_num": "13"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 3.1", "visual_caption": "Kết quả tìm kiếm với từ khoá Olympic Tin học 2023 tỉnh Vĩnh Phúc", "visual_description": "Ảnh chụp màn hình kết quả tìm kiếm trên trình duyệt web với từ khóa 'Olympic Tin học 2023 tỉnh Vĩnh Phúc', hiển thị đường dẫn trang web vinhphuc.edu.vn và tiêu đề bài viết về kết quả học sinh giỏi quốc gia và các kỳ thi học sinh giỏi của tỉnh Vĩnh Phúc.", "page_num": "15"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 3.2", "visual_caption": "Kết quả nhận được khi sử dụng công cụ hội thoại thông minh với yêu cầu Hãy cho biết tên các trường THPT gần Vĩnh Tường, Vĩnh Phúc", "visual_description": "Ảnh chụp giao diện trả lời của công cụ hội thoại thông minh, liệt kê danh sách các trường THPT tại huyện Vĩnh Tường như THPT Lê Xoay, THPT Nguyễn Viết Xuân, THPT Đội Cấn, THPT Vĩnh Tường, THPT Nguyễn Thị Giang và THPT Hồ Xuân Hương kèm theo địa chỉ xã/thị trấn tương ứng.", "page_num": "15"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 3.3", "visual_caption": "Địa chỉ trang web của Sở Giáo dục và Đào tạo Vĩnh Phúc", "visual_description": "Ảnh chụp màn hình trang kết quả tìm kiếm Google hiển thị liên kết chính thức đến trang web của Sở Giáo dục và Đào tạo Vĩnh Phúc (vinhphuc.edu.vn) với chuyên mục 'Những điều cần biết về tuyển sinh lớp 10 THPT tại Vĩnh Phúc'.", "page_num": "15"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "visual_asset_code": "Hình 4.1", "visual_caption": "Thông tin số có thể bị đánh cấp", "visual_description": "Ảnh minh họa đồ họa cho thấy thông tin số cá nhân, tài khoản ngân hàng và thẻ tín dụng đang đứng trước nguy cơ bị đánh cắp bởi kẻ xấu trực tuyến, bên cạnh máy tính hiển thị biểu tượng cảnh báo bảo mật và ổ khóa. Hình ảnh giúp học sinh nhận thức rõ nguy cơ mất an toàn thông tin trên mạng.", "page_num": "18"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 5", "visual_asset_code": "Hình 5.1", "visual_caption": "Phần mềm mô phỏng pha màu trên trang https://trycolour.com", "visual_description": "Ảnh chụp giao diện phần mềm mô phỏng pha màu trực tuyến trên trang trycolour.com. Giao diện hiển thị các ô nhập mã màu (như #FF80D5), các nút điều khiển lệnh (ADD, BASIC), khu vực hiển thị bảng màu và các vòng tròn chọn màu sắc thành phần với các tỉ lệ khác nhau. Hình ảnh minh họa cách người dùng tương tác trực quan để pha trộn màu sắc trên máy tính trước khi thực hiện trên thực tế.", "page_num": "22"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "visual_asset_code": "Hình 5.2", "visual_caption": "Thí nghiệm ảo lắp ráp mạch điện đơn giản trên trang https://phet.colorado.edu", "visual_description": "Ảnh chụp giao diện phần mềm mô phỏng mạch điện trực tuyến PhET gồm 3 phần: a) Linh kiện để lắp mạch (hiển thị nguồn điện 9.0V, bóng đèn 10.0Ω, công tắc, dây dẫn); b) Mạch điện đơn giản được kết nối hoàn chỉnh; c) Công tắc được bật và bóng đèn phát sáng vàng thể hiện dòng điện chạy qua. Hình ảnh giúp học sinh trực quan hóa hiện tượng vật lý mà không cần dùng thiết bị thật.", "page_num": "23"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.1", "visual_caption": "Chọn ngôn ngữ hiển thị là tiếng Việt", "visual_description": "Ảnh chụp màn hình menu thả xuống của trình duyệt web hiển thị danh sách các ngôn ngữ, trong đó có 'Tiếng Việt' và 'English', minh họa thao tác chuyển đổi ngôn ngữ hiển thị trên trang web sang tiếng Việt.", "page_num": "25"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.2", "visual_caption": "Chọn lĩnh vực hoá học", "visual_description": "Ảnh chụp màn hình giao diện trang web PhET với menu danh mục các lĩnh vực khoa học như 'Tất cả các Sim', 'Vật lý', 'Hoá học', 'Toán', 'Khoa học Trái đất', 'Sinh học', minh họa thao tác chọn lĩnh vực 'Hoá học'.", "page_num": "25"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.3", "visual_caption": "Chọn nội dung mô phỏng", "visual_description": "Ảnh chụp màn hình trang hiển thị biểu tượng và tên chủ đề 'Các dạng và sự chuyển hoá năng lượng', kèm theo hình ảnh thu nhỏ giao diện thí nghiệm và nút play để mở cửa sổ tương tác.", "page_num": "25"}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "visual_asset_code": "Hình 6.4", "visual_caption": "Mô phỏng một số dạng năng lượng và sự chuyển hoá năng lượng", "visual_description": "Ảnh chụp giao diện phần mềm mô phỏng thí nghiệm vật lý hiển thị mô hình người đang đạp xe nối với máy phát điện (Generator) cung cấp năng lượng thắp sáng bóng đèn và đun nóng nước trong bình chứa. Phía bên phải là bảng chọn biểu tượng năng lượng (Cơ, Điện, Nhiệt, Quang, Hóa). Giao diện trực quan giúp học sinh quan sát sinh động sự chuyển hóa giữa các dạng năng lượng.", "page_num": "26"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.5", "visual_caption": "Lắp Ampe kế đúng cách, không để xảy ra sự cố", "visual_description": "Ảnh chụp minh họa hai trường hợp lắp mạch điện với Ampe kế: a) Lắp Ampe kế đúng cách nối tiếp trong mạch điện hiển thị số đo dòng điện; b) Sự cố có thể xảy ra khi lắp Ampe kế không đúng cách (đoản mạch/chập mạch gây cháy hoặc hư hỏng thiết bị).", "page_num": "27"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "visual_asset_code": "Hình 6.6", "visual_caption": "Đo độ dài các đoạn thẳng của ngôi sao năm cánh", "visual_description": "Ảnh chụp màn hình phần mềm mô phỏng hình học Geometer's Sketchpad hiển thị hình ảnh một ngôi sao năm cánh có các đỉnh A, B, C, D... và bảng thông số độ dài các đoạn thẳng như m(AB) = 2.52 cm, m(BC) = 1.56 cm, m(AC) = 4.07 cm, m(DA) = 6.59 cm cùng điểm P, Q điều chỉnh độ dài. Giúp học sinh thực hành đo đạc và phân tích tỉ lệ vàng trong hình học.", "page_num": "27"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 6.7", "visual_caption": "Tính tỉ lệ các đoạn thẳng", "visual_description": "Ảnh chụp giao diện hộp thoại tính toán 'New Calculation' trong phần mềm Geometer's Sketchpad, hiển thị danh sách các giá trị đo đạc (mAB, mBC, mAC, mDA) và bàn phím ảo với các phím số, phép toán cơ bản. Hình ảnh hướng dẫn học sinh cách thực hiện thao tác tính toán biểu thức toán học dựa trên số liệu hình học.", "page_num": "28"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "visual_asset_code": "Hình 6.8", "visual_caption": "Ngôi sao năm cánh và hình chữ nhật tỉ lệ vàng", "visual_description": "Sơ đồ gồm hai phần: a) Ngôi sao năm cánh nội tiếp đường tròn với các đỉnh A, B, C, D minh họa các đoạn thẳng tỉ lệ vàng; b) Hình chữ nhật tỉ lệ vàng được chia thành hình vuông và hình chữ nhật nhỏ hơn cũng có tỉ lệ vàng. Hình ảnh trực quan hóa khái niệm toán học về tỉ lệ vàng áp dụng trong hình học.", "page_num": "28"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.1", "visual_caption": "Bảng tính chi phí cho phần nội dung Lược sử công cụ tính toán", "visual_description": "Ảnh chụp màn hình bảng tính Excel hiển thị chi phí triển lãm với các cột TT (Thứ tự), Nội dung (In ảnh màu, In nội dung chú thích, Văn phòng phẩm), Số lượng, Đơn giá (VND) và Thành tiền. Bảng tính tính toán tổng chi phí là 122,000 VND, dùng để đính kèm vào sơ đồ tư duy trong phần thực hành.", "page_num": "32"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.2", "visual_caption": "Đính kèm tệp vào sơ đồ tư duy", "visual_description": "Ảnh chụp giao diện thanh công cụ của phần mềm tạo sơ đồ tư duy, hiển thị nhóm công cụ 'Attachments' với các nút lệnh để quản lý và đính kèm tệp, giúp học sinh biết cách bổ sung tài nguyên phụ trợ vào các nhánh của sơ đồ.", "page_num": "33"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.3", "visual_caption": "Chọn tệp từ thư mục lưu trữ để chèn vào sơ đồ tư duy", "visual_description": "Ảnh chụp hộp thoại 'Open' của hệ điều hành Windows dùng để duyệt và chọn các tệp tin như tài liệu Word, bảng tính Excel, tệp sơ đồ tư duy hoặc hình ảnh (ví dụ: Pascalise.png) để đính kèm vào nhánh của sơ đồ.", "page_num": "33"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.4", "visual_caption": "Chèn đường liên kết đến video trên Internet", "visual_description": "Ảnh chụp hộp thoại 'Hyperlink' trong phần mềm sơ đồ tư duy, cho phép người dùng nhập hoặc dán địa chỉ URL (đường dẫn YouTube) vào ô 'Link to:' để kết nối trực tiếp nhánh của sơ đồ tư duy với tài nguyên trực tuyến.", "page_num": "33"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "visual_asset_code": "Hình 8.5", "visual_caption": "Nội dung trang dàn ý", "visual_description": "Ảnh chụp khung nội dung dàn ý đặt trong hộp màu vàng với tiêu đề 'Nội dung' bên trái và danh sách 5 mục chính ở bên phải bao gồm: 1. Mở đầu, 2. Dòng thời gian lược sử công cụ tính toán, 3. Blaise Pascal và máy tính cơ học đầu tiên, 4. Charles Babbage và máy tính đa năng, 5. Các thế hệ máy tính điện tử. Hình ảnh minh họa cấu trúc cấu thành nội dung các trang chiếu cho bài thuyết trình nhóm.", "page_num": "34"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.1", "visual_caption": "Khoản mục thu, chi gia đình", "visual_description": "Ảnh chụp bảng hiển thị danh sách các 'Khoản thu' (Lương, Thưởng, Làm thêm, Được cho/tặng, Khác) và 'Khoản chi' (Ở, Ăn, Di chuyển, Học tập, Sức khoẻ, Giải trí, Quà tặng/Từ thiện, Tiết kiệm, Khác). Giúp học sinh nắm rõ cấu trúc phân loại thu chi trong quản lý tài chính.", "page_num": "37"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.2", "visual_caption": "Trang tính ghi thông tin chi tiêu của gia đình, dữ liệu mỗi ô ở cột B được lấy từ danh sách các khoản chi ở cột F", "visual_description": "Ảnh chụp giao diện phần mềm bảng tính Excel minh họa trang tính 'Chi tiêu' với các cột Ngày, Khoản chi, Nội dung, Số tiền (nghìn đồng). Tại ô B6, danh sách thả xuống (Drop-down list) hiển thị các lựa chọn 'Ở', 'Ăn', 'Di chuyển', 'Học tập',... lấy từ cột F 'Khoản chi'. Hình ảnh minh họa việc sử dụng Data Validation để tạo danh sách chọn nhanh.", "page_num": "37"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.3", "visual_caption": "Dữ liệu khi nhập vào ô tính của cột Số tiền (nghìn đồng) phải là dữ liệu kiểu số và có giá trị lớn hơn 0", "visual_description": "Ảnh chụp giao diện trang tính minh họa tính năng cảnh báo lỗi (Error Alert) của Data Validation khi người dùng nhập dữ liệu không hợp lệ vào cột 'Số tiền (nghìn đồng)'. Hộp thoại chú thích màu xanh lá hiển thị dòng chữ 'Dữ liệu kiểu số / Giá trị lớn hơn 0', giúp học sinh hiểu cách thiết lập điều kiện ràng buộc kiểu số dương.", "page_num": "37"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.4", "visual_caption": "Nút lệnh Data Validation trong nhóm lệnh Data Tools", "visual_description": "Ảnh chụp giao diện dải lệnh Data trên Excel, làm nổi bật nhóm lệnh Data Tools với nút lệnh Data Validation được khoanh đỏ. Hình ảnh minh họa trực quan vị trí truy cập công cụ xác thực dữ liệu cho học sinh.", "page_num": "38"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.5", "visual_caption": "Lựa chọn kiểu dữ liệu hoặc giá trị dữ liệu", "visual_description": "Ảnh chụp hộp thoại Data Validation ở thẻ Settings, cho thấy danh sách thả xuống (dropdown list) của mục Allow gồm các tùy chọn: Any value, Whole number, Decimal, List, Date, Time, Text length, Custom.", "page_num": "38"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Bảng 9a.1", "visual_caption": "Các kiểu dữ liệu hoặc giá trị dữ liệu cho phép", "visual_description": "Bảng hệ thống hóa chi tiết ý nghĩa của các kiểu dữ liệu trong công cụ Data Validation: Any value (Bất kì giá trị nào), Whole number (Số nguyên), Decimal (Số thập phân), List (Danh sách - chọn dữ liệu từ danh sách thả xuống), Date (Ngày tháng), Time (Thời gian), Text length (Độ dài văn bản), Custom (Tuỳ chỉnh - cho công thức tuỳ chỉnh).", "page_num": "38"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.6", "visual_caption": "Trang tính lưu các khoản thu của gia đình", "visual_description": "Ảnh chụp giao diện phần mềm Microsoft Excel hiển thị trang tính 'Thu nhập' với các cột A (Ngày), B (Khoản thu), C (Nội dung), D (Số tiền (nghìn đồng)) và bảng danh sách phụ cột F (Khoản thu gồm: Lương, Thưởng, Làm thêm, Được cho/tặng, Khác). Ô A3 hiển thị giá trị '13/8/23', ô B3 hiển thị 'Lương', ô C3 hiển thị 'Lương tháng 8', ô D3 hiển thị '7,000'. Hình ảnh minh họa việc thiết lập và lưu trữ dữ liệu thu nhập gia đình.", "page_num": "39"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.7", "visual_caption": "Trang tính lưu các khoản chi", "visual_description": "Ảnh chụp giao diện phần mềm Microsoft Excel hiển thị trang tính 'Chi tiều' (hoặc Chi tiêu) với các cột A (Ngày), B (Khoản chi), C (Nội dung), D (Số tiền (nghìn đồng)) và cột phụ F (Khoản chi gồm: Ở, Ăn, Di chuyển, Học tập, Sức khoẻ, Giải trí, Quà tặng/Từ thiện, Tiết kiệm, Khác). Hình ảnh minh họa cấu trúc bảng dữ liệu để thực hành quản lý chi tiêu gia đình.", "page_num": "39"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.8", "visual_caption": "Chọn vùng dữ liệu chứa danh sách các khoản chi", "visual_description": "Ảnh chụp hộp thoại Data Validation (Data Validation) hiển thị thẻ Settings. Tại ô Allow chọn 'List', ô Source chứa biểu thức vùng dữ liệu '=$F$2:$F$10'. Hình ảnh minh họa thao tác cấu hình xác thực dữ liệu dạng danh sách thả xuống trong Excel.", "page_num": "40"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.9", "visual_caption": "Nhập các yêu cầu xác thực dữ liệu của cột Số tiền", "visual_description": "Ảnh chụp hộp thoại Data Validation hiển thị thẻ Settings với các thiết lập: mục Allow chọn 'Whole number', mục Data chọn 'greater than', và mục Minimum nhập giá trị '0'. Hình ảnh minh họa cách thiết lập giới hạn dữ liệu số nguyên lớn hơn 0 cho cột 'Số tiền'.", "page_num": "40"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.10", "visual_caption": "Nhập nội dung thông báo sẽ hiển thị khi nhập dữ liệu", "visual_description": "Ảnh chụp hộp thoại Data Validation trong phần mềm bảng tính Excel, đang ở tab 'Input Message'. Hộp thoại cho phép cấu hình hiển thị tin nhắn khi ô được chọn với các trường 'Title' ('Dữ liệu kiểu số') và 'Input message' ('Giá trị lớn hơn 0'). Hình ảnh minh họa cách thiết lập hướng dẫn nhập liệu cho người dùng.", "page_num": "41"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.11", "visual_caption": "Nhập nội dung thông báo lỗi", "visual_description": "Ảnh chụp hộp thoại Data Validation trong Excel, đang ở tab 'Error Alert'. Giao diện hiển thị các trường cấu hình kiểu thông báo lỗi (Style: Stop), tiêu đề ('Dữ liệu nhập sai') và nội dung thông báo ('Hãy nhập lại dữ liệu kiểu số và lớn hơn 0').", "page_num": "41"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "visual_asset_code": "Hình 9a.12", "visual_caption": "Thông báo xuất hiện khi dữ liệu nhập vào ô tính không đúng kiểu hoặc không đúng giá trị cho phép", "visual_description": "Ảnh chụp hộp thoại thông báo lỗi thực tế trong Excel khi người dùng nhập dữ liệu vi phạm quy tắc Data Validation. Hộp thoại có biểu tượng dấu X màu đỏ, tiêu đề 'Dữ liệu nhập sai', nội dung thông báo 'Hãy nhập lại dữ liệu kiểu số và lớn hơn 0' kèm ba nút lệnh 'Retry', 'Cancel', 'Help'.", "page_num": "41"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "visual_asset_code": "Hình 10a.1", "visual_caption": "Bảng dữ liệu về các khoản chi", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh họa dữ liệu quản lí tài chính gia đình từ ô A3 đến D10 bao gồm các cột Ngày, Khoản chi, Nội dung, Số tiền (nghìn đồng), cùng với bảng tổng hợp Khoản chi (Ở, Ăn, Di chuyển, Học tập, Sức khoẻ, Giải trí, Quà tặng/Từ thiện, Tiết kiệm, Khác) và cột Số lần chi chứa các dấu hỏi chấm cần điền công thức.", "page_num": "43"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "visual_asset_code": "Bảng 10a.1", "visual_caption": "Một số ví dụ sử dụng hàm COUNTIF", "visual_description": "Bảng biểu diễn 4 ví dụ cụ thể về cách sử dụng hàm COUNTIF với các dạng điều kiện khác nhau: đếm số ô lớn hơn 100 (=COUNTIF(A1:A4,\">100\")), đếm số ô chứa chuỗi 'Yes' (=COUNTIF(A1:A4,\"Yes\")), đếm số ô bắt đầu bằng ký tự 'Y' (=COUNTIF(A1:A4,\"Y*\")), và đếm số ô chứa giá trị giống ô D2 (=COUNTIF(A1:A4,D2)).", "page_num": "44"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "visual_asset_code": "Hình 10a.2", "visual_caption": "Công thức tính số lần chi của mỗi khoản chi", "visual_description": "Ảnh chụp giao diện bảng tính Excel minh họa việc ứng dụng hàm COUNTIF để thống kê số lần xuất hiện của từng khoản chi (Ăn, Di chuyển, Học tập, Sức khoẻ, Giải trí, Quà tặng/Từ thiện, Tiết kiệm, Khác) từ vùng dữ liệu gốc (từ ô B3 đến B10). Công thức cụ thể tại ô G2 là =COUNTIF($B$3:$B$10,\"Ở\") được sao chép xuống các ô bên dưới để tự động tính toán cho toàn bộ danh mục.", "page_num": "44"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10a.5", "visual_caption": "Sao chép công thức trong ô G2 sang các ô từ G3 đến G6", "visual_description": "Ảnh chụp màn hình phần mềm bảng tính hiển thị bảng 'Thu nhập' với các cột Ngày, Khoản thu, Nội dung, Số tiền (nghìn đồng) và bảng tổng hợp 'Khoản thu', 'Số lần thu'. Hình minh họa thao tác sao chép công thức từ ô G2 xuống các ô G3 đến G6 để tính tự động số lần xuất hiện của từng khoản thu.", "page_num": "46"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10a.6", "visual_caption": "Kết quả khảo sát về việc chọn trường THPT", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh họa kết quả khảo sát lựa chọn trường THPT của học sinh (Mã số học sinh, Tên trường) kết hợp với bảng thống kê số lượng học sinh đăng ký vào từng trường (A, B, C, D). Hình minh họa trực quan cho bài toán thực tế sử dụng hàm COUNTIF trong bảng tính.", "page_num": "46"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "visual_asset_code": "Hình 11a.1", "visual_caption": "Trang tính Chi tiêu đã bổ sung thêm cột Tổng tiền", "visual_description": "Ảnh chụp màn hình trang tính Excel minh họa bài toán tổng hợp chi tiêu theo từng khoản (Ăn, Di chuyển, Học tập, Sức khoẻ,...). Bảng tính gồm hai phần: bảng chi tiết từ hàng 2 đến hàng 10 chứa các cột Ngày, Khoản chi, Nội dung, Số tiền (nghìn đồng); và bảng tổng hợp bên phải chứa các cột Khoản chi, Số lần chi, Tổng tiền (nghìn đồng). Hình ảnh trực quan giúp học sinh hiểu cách áp dụng hàm SUMIF để tính tổng chi phí theo từng điều kiện cụ thể.", "page_num": "47"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "visual_asset_code": "Hình 11a.3", "visual_caption": "Trang tính Thu nhập", "visual_description": "Ảnh chụp màn hình giao diện chương trình bảng tính Excel hiển thị trang tính 'Thu nhập'. Bảng gồm các cột từ A đến H: Ngày, Khoản thu, Nội dung, Số tiền (nghìn đồng), Khoản thu (danh mục thu), Số lần thu, Tổng tiền (nghìn đồng). Hàng 2 hiển thị ô H2 chứa dấu hỏi chấm (?) cần tính tổng tiền cho khoản thu 'Lương'. Hình ảnh minh họa trực quan cấu trúc bảng dữ liệu tài chính gia đình để học sinh áp dụng hàm SUMIF.", "page_num": "49"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "visual_asset_code": "Hình 12a.1", "visual_caption": "Quy tắc 50-30-20", "visual_description": "Biểu đồ hình tròn (pie chart) phân chia tỷ lệ tài chính theo quy tắc 50-30-20: 50% dành cho 'Nhu cầu thiết yếu', 30% dành cho 'Mong muốn cá nhân' và 20% dành cho 'Tiết kiệm'. Hình ảnh minh họa trực quan cách phân bổ ngân sách cá nhân.", "page_num": "50"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "visual_asset_code": "Hình 12a.2", "visual_caption": "Bảng tổng hợp các khoản chi đã thêm cột Mục chi", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh họa danh sách các khoản chi tiêu (Ở, Ăn, Di chuyển, Học tập, Sức khoẻ, Giải trí, Quà tặng/Từ thiện, Tiết kiệm, Khác) cùng số lần chi, tổng tiền (nghìn đồng) và cột 'Mục chi' được phân loại thành các nhóm A, B, C.", "page_num": "50"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "visual_asset_code": "Hình 12a.3", "visual_caption": "Bảng tổng hợp mục chi", "visual_description": "Ảnh chụp màn hình bảng tính Excel tổng hợp theo từng mục chi (A, B, C), bao gồm nội dung, tổng tiền, tỷ lệ (%) và trạng thái đánh giá dựa trên quy tắc quản lý tài chính.", "page_num": "50"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12", "visual_asset_code": "Hình 12a.4", "visual_caption": "Sử dụng hàm IF lồng nhau", "visual_description": "Ảnh chụp màn hình bảng tính Excel minh hoạ bảng tổng hợp mục chi gồm các cột: Mục chi, Nội dung, Tổng tiền (nghìn đồng), Tỉ lệ, Trạng thái. Ô O3 hiển thị công thức hàm IF lồng nhau: =IF(N3>80%, \"Nhiều quá\", IF(N3>50%, \"Nhiều hơn\", \"Ít hơn\")) và kết quả tương ứng là \"Nhiều quá\" đối với ô N3 có giá trị 90.5%. Hình ảnh giúp học sinh quan sát rõ cấu trúc và kết quả thực tế khi áp dụng hàm IF lồng nhau trong bảng tính.", "page_num": "51"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "visual_asset_code": "Hình 12a.5", "visual_caption": "Bảng dữ liệu tổng hợp mục chi", "visual_description": "Ảnh chụp một phần bảng tính Excel thể hiện vùng dữ liệu từ ô K1 đến O5 với tiêu đề 'Tổng hợp mục chi'. Bảng gồm các cột: Mục chi (A, B, C), Nội dung (Nhu cầu thiết yếu, Mong muốn cá nhân, Tiết kiệm), Tổng chi (nghìn đồng), Tỉ lệ, và Trạng thái. Hình ảnh minh họa cấu trúc bảng dữ liệu dùng để tổng hợp thông tin chi tiêu.", "page_num": "52"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "visual_asset_code": "Hình 12a.6", "visual_caption": "Nhập công thức tính tổng chi của mục Nhu cầu thiết yếu", "visual_description": "Ảnh chụp màn hình giao diện phần mềm bảng tính Excel minh họa thao tác nhập công thức tại ô M3. Công thức được sử dụng là =SUMIF($I$2:$I$10,K3,$H$2:$H$10) nhằm tính tổng số tiền chi cho mục 'Nhu cầu thiết yếu' dựa trên bảng dữ liệu chi tiết bên cạnh (từ cột F đến cột I). Hình ảnh giúp học sinh trực quan hóa cách tham chiếu địa chỉ tuyệt đối và tương đối khi viết hàm SUMIF.", "page_num": "52"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "visual_asset_code": "Hình 13a.1", "visual_caption": "Trang tính Thu nhập", "visual_description": "Ảnh chụp giao diện phần mềm bảng tính hiển thị trang tính 'Thu nhập' với các cột Ngày, Khoản thu, Nội dung, Số tiền (nghìn đồng) cùng với bảng tổng hợp khoản thu, số lần thu và tổng tiền ở các cột bên phải (tại ô H7).", "page_num": "54"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "visual_asset_code": "Hình 13a.2", "visual_caption": "Trang tính Chi tiêu", "visual_description": "Ảnh chụp giao diện trang tính 'Chi tiêu' với danh sách các khoản chi gồm Ngày, Khoản chi, Nội dung, Số tiền cùng bảng tổng hợp khoản chi, số lần chi và tổng số tiền chi tiêu (tại ô H11).", "page_num": "54"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "visual_asset_code": "Hình 13a.3", "visual_caption": "Trang tính Tổng hợp", "visual_description": "Ảnh chụp giao diện trang tính 'Tổng hợp' cân đối thu chi, bao gồm bảng dữ liệu tổng kết thu nhập, chi tiêu, gia trị NET và biểu đồ cột trực quan minh họa thu nhập, chi tiêu và số dư.", "page_num": "54"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.1", "visual_caption": "Đoạn video quay sản phẩm của dự án Sổ lưu niệm", "visual_description": "Ảnh chụp giao diện màn hình phát video hiển thị trang bìa cuốn sổ lưu niệm lớp 6A kèm theo các biểu tượng điều khiển phát/tạm dừng video. Hình ảnh minh họa cho dạng thông tin video kết hợp hình ảnh đồ họa và văn bản.", "page_num": "57"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.2", "visual_caption": "Hình ảnh chụp kết quả dự án Trường học xanh", "visual_description": "Ảnh chụp màn hình hiển thị hoạt động trong dự án Trường học xanh với hình ảnh cây xanh ở vườn trường, sân trường nhằm minh họa cho nguồn tư liệu hình ảnh đầu vào khi làm video.", "page_num": "57"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.3", "visual_caption": "Hình ảnh tờ rơi quảng cáo của dự án Thành lập CLB Tin học", "visual_description": "Ảnh chụp tờ rơi thông báo tuyển thành viên Câu lạc bộ Tin học, thể hiện tài liệu dạng văn bản và hình ảnh được sử dụng làm tư liệu để biên tập video.", "page_num": "57"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.4", "visual_caption": "Đoạn âm thanh nền", "visual_description": "Biểu tượng nốt nhạc đại diện cho tệp âm thanh nền (audio), minh họa cho thành phần âm thanh được kết hợp vào video trong quá trình dựng phim.", "page_num": "57"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.5", "visual_caption": "Biểu tượng của phần mềm Video Editor", "visual_description": "Ảnh chụp biểu tượng (icon) của phần mềm Video Editor trên hệ điều hành Windows với hình nền màu xanh dương đậm có các ô vuông lưới trắng và biểu tượng cuộn phim, phía dưới là dòng chữ 'Video Editor'. Biểu tượng giúp học sinh nhận diện nhanh ứng dụng trên máy tính.", "page_num": "58"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9b.6", "visual_caption": "Cửa sổ chào mừng của phần mềm Video Editor", "visual_description": "Ảnh chụp giao diện cửa sổ chào mừng của phần mềm Video Editor trên hệ điều hành Windows với nền mờ logo Kết nối tri thức với cuộc sống. Hiển thị khu vực quản lý các dự án video đã tạo (My Video Projects) cùng các tùy chọn tạo dự án mới, thanh tìm kiếm và các biểu tượng điều khiển ở góc trên bên phải cửa sổ.", "page_num": "59"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9", "visual_asset_code": "Hình 9b.7", "visual_caption": "Nhập tên dự án", "visual_description": "Sơ đồ minh họa gồm hai bước nhỏ thể hiện qua mũi tên xanh chỉ hướng: bên trái là hộp thoại 'Name your video' với tên mặc định 'New video' và các nút 'OK', 'Skip'; bên phải là hộp thoại sau khi người dùng đã thay đổi tên thành 'SanPhamTinHoc' và chuẩn bị nhấn nút 'OK'.", "page_num": "59"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "visual_asset_code": "Hình 9b.10", "visual_caption": "Giao diện phần mềm Video Editor khi bàn dựng có dữ liệu", "visual_description": "Ảnh chụp màn hình giao diện phần mềm Video Editor hiển thị các thành phần chính khi bàn dựng có chứa dữ liệu dự án 'SanPhamTinHoc'. Các chú thích chi tiết chỉ rõ: Nút phóng to toàn màn hình ở góc trên bên phải, Thanh điều khiển thời gian đặt ngay phía dưới khung xem trước video, nút Next Frame, nút Play/Pause và nút Previous Frame. Giao diện giúp học sinh nhận diện trực quan các công cụ điều khiển phát lại và quản lý khung hình trong quá trình biên tập video.", "page_num": "61"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.1", "visual_caption": "Đoàn làm phim", "visual_description": "Hình vẽ minh họa ba thành viên trong đoàn làm phim với các vai trò cụ thể: Đạo diễn (cầm kịch bản và loa phóng thanh chỉ đạo), Quay phim (đứng sau máy quay chuyên nghiệp trên chân máy), Trợ lí (sổ tay ghi chép). Hình ảnh giúp học sinh liên hệ giữa việc làm một bộ phim chuyên nghiệp của đoàn làm phim với việc làm một video giới thiệu sản phẩm tin học cá nhân hoặc nhóm.", "page_num": "62"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.2", "visual_caption": "Thư mục SanPhamTinHoc", "visual_description": "Ảnh chụp màn hình cấu trúc cây thư mục trên máy tính. Thư mục chính có tên 'SanPhamTinHoc', bên trong chứa 3 thư mục con gồm 'DuLieu-AmThanh', 'DuLieu-Anh', và 'DuLieu-Video'. Hình ảnh minh họa cách tổ chức, sắp xếp dữ liệu khoa học trước khi tiến hành dựng video.", "page_num": "63"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.3", "visual_caption": "Thư viện dữ liệu sau khi nhập video và ảnh", "visual_description": "Ảnh chụp giao diện phần mềm Video Editor hiển thị cửa sổ 'Project library' với nút '+ Add' và danh sách các tệp video, hình ảnh đã được nhập vào thư viện theo thư mục SanPhamTinhoc/Dulieu-Anh.", "page_num": "64"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.4", "visual_caption": "Khung hình của tiêu đề trên bàn dựng", "visual_description": "Ảnh chụp giao diện Storyboard trên phần mềm Video Editor hiển thị một đoạn video dài 3 giây xuất hiện ở vị trí đầu tiên với nhãn '3.0' biểu thị độ dài tính theo giây của đoạn video tiêu đề.", "page_num": "64"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.5", "visual_caption": "Định dạng cho đoạn video tiêu đề", "visual_description": "Ảnh chụp giao diện chi tiết của phần mềm Video Editor kèm theo các chú thích hướng dẫn: (1) Nhập nội dung tiêu đề vào đây, (2) Chọn kiểu hiển thị Adventure, (3) Chọn vị trí hiển thị ở giữa khung hình, (4) Nháy vào nút hoàn thành để kết thúc việc tạo tiêu đề, cùng với màn hình xem trước hiển thị dòng chữ 'Sản phẩm, kết quả của các dự án Tin học' và thanh điều khiển phía dưới.", "page_num": "64"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10b.6", "visual_caption": "Đoạn video dài 9.05 giây", "visual_description": "Ảnh chụp màn hình giao diện phần mềm biên tập video hiển thị một đoạn video quay cuốn sổ lưu niệm lớp 6A có độ dài là 9.05 giây.", "page_num": "65"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10b.7", "visual_caption": "Các thao tác cắt ngắn đoạn video", "visual_description": "Ảnh chụp màn hình hướng dẫn chi tiết các bước cắt ngắn đoạn video trong phần mềm biên tập video, bao gồm các thành phần: sử dụng nút điều khiển để xem trước, kéo thả hai con chạy để chọn đoạn video cần giữ lại, nút Trim và nút hoàn thành việc cắt video.", "page_num": "65"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "visual_asset_code": "Hình 10b.8", "visual_caption": "Mỗi ảnh thêm vào bàn dựng được mặc định hiển thị trong 3 giây", "visual_description": "Ảnh chụp màn hình minh họa 4 ảnh chụp cây xanh và hoa được đưa vào bàn dựng, mỗi ảnh có biểu tượng đồng hồ và nhãn '3.0' thể hiện thời gian hiển thị mặc định là 3 giây.", "page_num": "65"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.9", "visual_caption": "Thời gian hiển thị của mỗi ảnh đã thay đổi", "visual_description": "Ảnh chụp giao diện phần mềm làm phim hiển thị chuỗi các hình ảnh/video nhỏ trên thanh timeline, mỗi đối tượng đều có biểu tượng đồng hồ kèm thông số '2.0' thể hiện thời gian hiển thị đã được thay đổi. Hình ảnh minh họa trực quan kết quả sau khi điều chỉnh thời gian cho từng thành phần trong đoạn hoạt hình.", "page_num": "66"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "visual_asset_code": "Hình 10b.10", "visual_caption": "Các thao tác để thêm hiệu ứng chuyển động", "visual_description": "Ảnh chụp giao diện cửa sổ chỉnh sửa của phần mềm làm phim, bên trái là khung xem trước (preview) đoạn video với dòng chữ mờ 'VUI CUỘC SỐNG', bên phải là bảng chọn các hiệu ứng 'Motion' bao gồm các kiểu như None, Zoom in center, Zoom out center, Zoom in left, Zoom out right, Pan left, Pan right, Tilt up... Có các mũi tên chú thích chi tiết bước 1 (chọn kiểu hiệu ứng Zoom in center) và bước 2 (nháy nút Done ở góc dưới để hoàn thành).", "page_num": "66"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "visual_asset_code": "Hình 11b.1", "visual_caption": "Các thao tác để thêm và chỉnh sửa hiệu ứng ba chiều", "visual_description": "Ảnh chụp giao diện phần mềm Video Editor minh họa các bước thêm hiệu ứng 3D effects. Giao diện hiển thị khung xem trước video bên trái với hình ảnh vườn hồng và khung chọn hiệu ứng bên phải bao gồm nút '3D effects', thư viện hiệu ứng với mục 'Butterflies' và các nút điều khiển thời gian, hoàn thành tạo hiệu ứng. Sơ đồ minh họa chi tiết các thao tác nháy chuột để mở thư viện hiệu ứng ba chiều, chọn kiểu hiệu ứng và xác nhận hoàn thành.", "page_num": "67"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11b.2", "visual_caption": "Chỉnh âm lượng cho âm thanh", "visual_description": "Ảnh chụp giao diện cửa sổ chỉnh sửa âm thanh (Volume) với thanh trượt điều chỉnh mức âm lượng và các tuỳ chọn Edit, Effects, 3D library ở góc trên, giúp học sinh biết cách tinh chỉnh âm lượng hiệu ứng trong video.", "page_num": "68"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11b.3", "visual_caption": "Các thao tác để thêm và chỉnh sửa bộ lọc", "visual_description": "Ảnh chụp giao diện phần mềm Video Editor hiển thị hộp thoại Filters với các mẫu bộ lọc như Original, Classic, Adventure, Pearl, Denim, Iceberg, Brassy, Sepia, Inky, Energy. Có sơ đồ hướng dẫn các bước thực hiện: Bước 1 - Chọn bộ lọc Iceberg; Bước 2 - Nháy vào nút Done để hoàn thành việc thêm bộ lọc cho ảnh chụp bông hoa hồng.", "page_num": "68"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "visual_asset_code": "Hình 11b.4", "visual_caption": "Kết quả sau khi sử dụng một số bộ lọc cho ảnh chụp hoa hồng", "visual_description": "Bốn bức ảnh minh họa kết quả sau khi áp dụng các bộ lọc khác nhau gồm: Bộ lọc Inky, Bộ lọc Arcade, Bộ lọc Sepia, và Bộ lọc Loved, thể hiện sự thay đổi về màu sắc và sắc thái của bức ảnh hoa hồng.", "page_num": "68"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "visual_asset_code": "Hình 11b.5", "visual_caption": "Các thao tác chọn nhạc nền", "visual_description": "Ảnh chụp giao diện cửa sổ 'Select background music' trong phần mềm biên tập video, hiển thị danh sách các bản nhạc nền mẫu (A Magical Season, Amplified, Anodized, Arcade Party, Block Party, Blossoming), tùy chọn 'Sync your video to the music's beat', thanh trượt điều chỉnh 'Music volume' và các nút 'Done', 'Cancel'. Sơ đồ chỉ dẫn trực quan 3 bước: 1. Chọn nhạc nền trong danh sách, 2. Kéo thả con chạy để điều chỉnh âm lượng, 3. Nháy vào nút Done để hoàn thành.", "page_num": "69"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "visual_asset_code": "Hình 12b.1", "visual_caption": "Các tệp âm thanh An đã tạo", "visual_description": "Ảnh chụp cửa sổ thư mục 'DuLieu-AmThanh' hiển thị danh sách các tệp âm thanh ghi âm lời thuyết minh (.wav) gồm: ThuyetMinh-DuAnSoLuuNiem.wav, ThuyetMinh-DuAnThanhLapCLBTinhoc.wav và ThuyetMinh-DuAnTruongHocXanh.wav. Hình ảnh giúp học sinh nhận diện đúng định dạng và tên tệp âm thanh cần sử dụng cho dự án.", "page_num": "72"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "visual_asset_code": "Hình 12b.2", "visual_caption": "Tệp âm thanh xuất hiện trong cửa sổ làm việc", "visual_description": "Ảnh chụp giao diện phần mềm biên tập video hiển thị sóng âm thanh của tệp 'ThuyetMinh-DuAn...' đã được thêm vào dự án, nằm ở cửa sổ làm việc với các nút điều khiển phát/tạm dừng và âm lượng.", "page_num": "73"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "visual_asset_code": "Hình 12b.3", "visual_caption": "Thay đổi âm lượng; đặt âm lượng tăng dần, giảm dần", "visual_description": "Ảnh chụp giao diện tùy chỉnh âm thanh (Custom audio) với các tùy chọn hộp kiểm 'Fade in' và 'Fade out', cùng ô nhập giá trị số để điều chỉnh mức âm lượng cho đoạn âm thanh.", "page_num": "73"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "visual_asset_code": "Hình 12b.4", "visual_caption": "Tách đoạn video thành hai đoạn nhỏ", "visual_description": "Ảnh minh họa chi tiết các bước thực hiện chia video: (1) Di chuyển con chạy đến vị trí muốn phân chia trên thanh thời gian; (2) Nháy chuột vào biểu tượng nút lệnh Split để cắt video thành hai phần; giao diện hiển thị video cuốn sổ lưu niệm đang được chia đôi.", "page_num": "73"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "visual_asset_code": "Hình 12b.5", "visual_caption": "Kết quả sau khi phân chia", "visual_description": "Ảnh chụp kết quả màn hình sau khi đoạn video dài 7 giây được tách thành hai đoạn nhỏ hơn: một đoạn dài 4 giây và một đoạn dài 3 giây, sẵn sàng để chèn hình ảnh vào giữa.", "page_num": "73"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13", "visual_asset_code": "Hình 13b.2", "visual_caption": "Chỉnh sửa dòng tiêu đề", "visual_description": "Ảnh chụp giao diện phần mềm biên tập video hiển thị menu ngữ cảnh (với các lệnh Add title card, Duration, Edit, Text, Background, Cut title card, Copy title card, Remove this title card, Remove everything) khi nháy nút phải chuột vào khung hình tiêu đề trong bàn dựng, kèm theo khung hình thu nhỏ có biểu tượng thời lượng 5.0 giây.", "page_num": "76"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "visual_asset_code": "Hình 13b.3", "visual_caption": "Dòng tiêu đề hiển thị từ giây thứ 1 đến giây thứ 3", "visual_description": "Ảnh chụp giao diện thanh thời lượng (Text duration) trên phần mềm biên tập video, minh họa thanh trượt thiết lập thời gian hiển thị văn bản bắt đầu từ mốc 0:03 đến 0:05 với tiêu đề 'Sản phẩm, kết quả của các dự án Tin học', thể hiện đoạn thời gian ngắn từ giây thứ 1 đến giây thứ 3.", "page_num": "77"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "visual_asset_code": "Hình 13b.4", "visual_caption": "Dòng tiêu đề hiển thị từ giây thứ 1 đến giây thứ 5", "visual_description": "Ảnh chụp giao diện thanh thời lượng của phần mềm biên tập video, hiển thị mốc thời gian kéo dài toàn bộ từ đầu đến cuối đoạn video (từ 0:03 đến 0:05 với nhãn 'End of text'), minh họa việc kéo dài thời gian hiển thị tiêu đề.", "page_num": "77"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "visual_asset_code": "Hình 13b.5", "visual_caption": "Cửa sổ Finish your video", "visual_description": "Ảnh chụp giao diện cửa sổ hộp thoại 'Finish your video' trong phần mềm biên tập video. Hộp thoại có các mục chọn Video quality (chất lượng video) với tùy chọn 'High 1080p (recommended)', nút 'More options' và nút 'Export' màu đỏ ở bên dưới để tiến hành xuất tệp video.", "page_num": "77"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.1", "visual_caption": "Robot thoát khỏi mê cung", "visual_description": "Sơ đồ mê cung đơn giản với điểm xuất phát 'Lối vào' và đích đến 'Lối ra', thể hiện hành trình di chuyển của robot trong không gian nhiều hành lang và tường ngăn.", "page_num": "78"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.2", "visual_caption": "Ba tình huống lựa chọn của robot", "visual_description": "Ảnh minh họa ba trường hợp di chuyển của robot trong mê cung theo thuật toán bám tường: Trường hợp a) Phía bên phải không có tường, robot thực hiện rẽ phải; Trường hợp b) Phía bên phải có tường nhưng phía trước thông thoáng, robot đi thẳng; Trường hợp c) Cả phía phải và phía trước đều bị tường chắn, robot quay sang trái. Hình ảnh giúp học sinh hình dung trực quan logic điều khiển hướng đi của robot trong bài toán giải mê cung.", "page_num": "79"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "visual_asset_code": "Hình 14.3", "visual_caption": "Thuật toán bám tường", "visual_description": "Hình ảnh gồm hai phần minh họa thuật toán bám tường: Phần a) Liệt kê các bước gồm 3 hành động (1. Phát hiện xung quanh có tường hay không, 2. Quay trái hoặc quay phải một góc 90 độ, 3. Tiến một bước về phía trước) cùng hộp liệt kê chi tiết các điều kiện lặp lại động tác 'lặp lại động tác sau cho đến khi tìm thấy lối đi ra'. Phần b) Sơ đồ khối chi tiết bắt đầu từ 'Bắt đầu', kiểm tra điều kiện 'Đến đích?', rẽ nhánh 'sai/đúng', kiểm tra 'Có tường bên phải?', 'Có tường phía trước?', thực hiện các hành động 'Quay phải 90 độ', 'Tiến một bước', 'Quay trái 90 độ' cho đến 'Kết thúc'.", "page_num": "80"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.2", "visual_caption": "Đầu vào và đầu ra của bài toán tính lương", "visual_description": "Sơ đồ khối minh họa quá trình xử lý bài toán tính lương. Đầu vào gồm 'muc_luong' và 'tgian_laodong' đi vào hộp xử lý 'Tính lương', cho kết quả đầu ra là 'tien_luong'. Sơ đồ trực quan giúp học sinh hiểu rõ mối quan hệ giữa dữ liệu đầu vào và đầu ra trong một bài toán tin học cụ thể.", "page_num": "82"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.3", "visual_caption": "Thuật toán tính lương", "visual_description": "Sơ đồ khối (Flowchart) mô tả chi tiết thuật toán tính lương. Sơ đồ bắt đầu từ khối 'Bắt đầu', tiến hành nhập 'muc_luong' và 'tgian_laodong', sau đó sử dụng các khối điều kiện rẽ nhánh kiểm tra '1 <= tgian_laodong <= 60' và 'tgian_laodong > 40' để phân chia thời gian làm việc trong định mức và vượt định mức. Tiếp theo là các khối xử lý tính toán 'luong_dmuc', 'luong_vuot', 'tien_luong', sau đó xuất giá trị 'tien_luong' và kết thúc sơ đồ. Sơ đồ giúp học sinh hình dung trực quan cách kết hợp cấu trúc tuần tự và rẽ nhánh trong thiết kế thuật toán.", "page_num": "83"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "visual_asset_code": "Hình 15.4", "visual_caption": "Thuật toán tìm số lớn nhất", "visual_description": "Hình 15.4 gồm hai phần: 15.4a là liệt kê các bước của thuật toán tìm số lớn nhất (từ bước 1 đến bước 6) trong đó có sử dụng vòng lặp và điều kiện rẽ nhánh để cập nhật biến max; 15.4b là sơ đồ khối tương ứng thể hiện rõ các khối hình elip (Bắt đầu, Kết thúc), khối hình bình hành (Nhập x, Xuất max, Xuất Không có dữ liệu), khối hình chữ nhật (max ← 0, max ← x) và khối hình thoi kiểm tra điều kiện (x = 0, x > max, max = 0).", "page_num": "84"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "visual_asset_code": "Hình 16.1", "visual_caption": "Nhập số giờ lao động bằng vòng lặp với điều kiện trước", "visual_description": "Hình ảnh minh họa gồm 3 phần: a) Sơ đồ khối Lặp với điều kiện sau (nhập tgian_laodong, kiểm tra điều kiện tgian_laodong < 60); b) Sơ đồ khối Lặp với điều kiện trước (kiểm tra điều kiện tgian_laodong < 60 trước khi nhập); c) Khối lệnh tương ứng trong ngôn ngữ lập trình Scratch sử dụng vòng lặp 'lặp lại cho đến khi' kết hợp với câu lệnh hỏi và trả lời để nhập số giờ lao động hợp lệ.", "page_num": "85"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "visual_asset_code": "Hình 16.3", "visual_caption": "Các khối lệnh thành phần của chương trình tìm giá trị lớn nhất", "visual_description": "Ảnh chụp màn hình các khối lệnh Scratch mô phỏng chương trình tìm giá trị lớn nhất. Gồm khối sự kiện khi bấm vào lá cờ xanh, khởi tạo biến max bằng 0, vòng lặp 'lặp lại cho đến khi x = 0', câu lệnh hỏi và chờ nhập giá trị x, khối điều kiện 'nếu x > max thì đặt max thành x', và các khối kiểm tra 'nếu max = 0 thì nói Không có dữ liệu, nếu không thì nói kết hợp Số lớn nhất là max'. Hình ảnh giúp học sinh trực quan hóa cách dịch sơ đồ khối thuật toán thành mã lệnh Scratch.", "page_num": "87"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "visual_asset_code": "Hình 17.1", "visual_caption": "Một số nhóm nghề và nghề nghiệp trong lĩnh vực tin học", "visual_description": "Sơ đồ khối phân cấp biểu diễn cấu trúc các nhóm nghề nghiệp trong Tin học, chia làm hai nhánh lớn: Khoa học máy tính và Tin học ứng dụng. Nhánh Khoa học máy tính bao gồm các nghề như nhà lập trình ứng dụng, nhà phát triển web và truyền thông đa phương tiện, nhà phân tích và thiết kế hệ thống, nhà phát triển phần mềm, nhà thiết kế cơ sở dữ liệu, nhà quản trị cơ sở dữ liệu, nhà khoa học dữ liệu, nhà bảo mật, nhà quản trị hệ thống và chuyên gia cơ sở dữ liệu và mạng máy tính. Nhánh Tin học ứng dụng bao gồm các nghề như nhà thiết kế trò chơi máy tính, nghệ sĩ kĩ thuật số, nhà thiết kế đồ họa, nhà thiết kế đa phương tiện, nhà thiết kế trang web, nhà thiết kế đồ họa và truyền thông đa phương tiện. Sơ đồ giúp học sinh có cái nhìn tổng quan về hệ sinh thái nghề nghiệp ngành CNTT.", "page_num": "90"}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "visual_asset_code": "Hình 0.1", "visual_caption": "Trang bìa các môn học trong bộ sách giáo khoa Lớp 9 - Kết nối tri thức với cuộc sống", "visual_description": "Ảnh chụp tổng quan các bìa sách giáo khoa lớp 9 thuộc bộ Kết nối tri thức với cuộc sống, bao gồm cả sách Tin học 9, đặt trên nền xanh lá cây đặc trưng của bộ sách, phía trên có biểu tượng Huân chương Hồ Chí Minh.", "page_num": "95"}] AS row
MATCH (l:Lesson {id: toString(row.grade_level) + '_' + toString(row.lesson_id)})
MERGE (v:VisualAsset {id: toString(row.grade_level) + '_' + toString(row.lesson_id) + '_' + toString(row.visual_asset_code)})
ON CREATE SET v.code = toString(row.visual_asset_code),
              v.caption = toString(row.visual_caption),
              v.description = toString(row.visual_description),
              v.page = toString(row.page_num)
MERGE (l)-[:HAS_VISUAL_ASSET]->(v);

// --- 6. NẠP KỸ NĂNG THỰC HÀNH (341 KỸ NĂNG) ---
UNWIND [{"grade_level": "Lớp 6", "lesson_id": "Bài 1", "skill_name": "Nhận diện thông tin và dữ liệu trong đời sống", "skill_description": "Quan sát các sự vật, hiện tượng xung quanh để phân biệt đâu là dữ liệu tiếp nhận và đâu là thông tin (hiểu biết) thu nhận được."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "skill_name": "Phân biệt thông tin và dữ liệu", "skill_description": "Nhận diện được các dạng dữ liệu (số, văn bản, hình ảnh, âm thanh) và thông tin thu nhận được trong các tình huống thực tế đời sống."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "skill_name": "Phân biệt thông tin và dữ liệu từ bảng số liệu", "skill_description": "Đọc hiểu dữ liệu từ bảng số liệu thống kê và rút ra các thông tin có ý nghĩa phục vụ việc ra quyết định."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "skill_name": "Phân tích quá trình xử lí thông tin trong tình huống thực tế", "skill_description": "Quan sát tình huống thực tế, nhận diện các yếu tố thông tin đầu vào, quá trình phân tích của bộ não và hành động đầu ra tương ứng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "skill_name": "Phân tích hoạt động xử lí thông tin thực tế", "skill_description": "Nhận diện và phân chia các hành động trong đời sống hằng ngày thành các bước xử lí thông tin cơ bản: thu nhận, lưu trữ, biến đổi và truyền thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "skill_name": "Phân tích chức năng thiết bị máy tính", "skill_description": "Nhận diện và phân loại các thiết bị ngoại vi và thành phần phần cứng của máy tính vào các nhóm: thiết bị vào, thiết bị ra, bộ xử lí và bộ nhớ."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "skill_name": "Mã hóa số nguyên thành dãy bit", "skill_description": "Thực hiện quy tắc chia đôi (nhị phân) để chuyển đổi một số nguyên thành dãy các kí hiệu 0 và 1."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "skill_name": "Chuyển đổi hình ảnh đơn giản thành dãy bit", "skill_description": "Thực hiện chuyển đổi từng dòng trong hình vẽ thành dãy bit và nối các dãy bit của các dòng lại với nhau từ trên xuống dưới."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "skill_name": "Quan sát và đọc thông tin dung lượng ổ đĩa, tệp tin", "skill_description": "Thực hiện quan sát giao diện máy tính để xác định dung lượng trống và dung lượng tổng của các ổ đĩa, cũng như kích thước của từng tệp tin cụ thể."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "skill_name": "Nhận biết kết nối mạng", "skill_description": "Quan sát và nhận diện các thiết bị kết nối mạng trong đời sống hàng ngày."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "skill_name": "Nhận diện mạng lưới trong thực tế", "skill_description": "Quan sát và liên hệ các hệ thống giao thông, liên lạc trong đời sống để tìm ra các điểm chung của một mạng lưới."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "skill_name": "Thảo luận về lợi ích mạng máy tính", "skill_description": "Thực hiện trao đổi, thảo luận nhóm để nhận biết và phân tích các ví dụ thực tế về lợi ích của mạng máy tính trong đời sống và học tập."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "skill_name": "Phân tích và lựa chọn phương thức kết nối mạng", "skill_description": "Nhận diện được các thiết bị đầu cuối và thiết bị kết nối trong mạng; so sánh và lựa chọn phương án kết nối mạng phù hợp với điều kiện thực tế (có dây hoặc không dây)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "skill_name": "Nhận diện lợi ích Internet", "skill_description": "Kể tên và liên hệ được các ứng dụng thực tế của Internet vào đời sống, học tập và giải trí của bản thân."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "skill_name": "Kỹ năng xác định ứng dụng của Internet", "skill_description": "Phân biệt được các hoạt động thực tế có thể thực hiện thông qua kết nối Internet như học ngoại ngữ trực tuyến, xem phim, tìm kiếm tài liệu học tập."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "skill_name": "Nhận biết khái niệm về Internet và các dịch vụ cơ bản", "skill_description": "Hiểu được vai trò của mạng thông tin toàn cầu, cách thức tìm kiếm thông tin và trao đổi thông tin qua thư điện tử."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "skill_name": "Khai thác thông tin trên trang web", "skill_description": "Thực hiện mở trình duyệt, nhập địa chỉ trang web như vi.wikipedia.org vào ô địa chỉ, nhấn Enter và tìm kiếm, khai thác thông tin trên trang."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Nhập địa chỉ trang web", "skill_description": "Thao tác gõ chính xác địa chỉ URL của trang web vào thanh địa chỉ của trình duyệt và nhấn phím Enter để truy cập."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Sử dụng nút điều hướng và Bookmark", "skill_description": "Sử dụng thành thạo các nút Quay về trang trước (Back), Đến trang tiếp theo (Forward), Trang chủ (Home) và lưu trang web vào danh sách Bookmark để thuận tiện truy cập lần sau."}, {"grade_level": "Lớp 6", "lesson_id": "Bài (tiếp theo)", "skill_name": "Sử dụng thanh Bookmark trên trình duyệt web", "skill_description": "Thực hiện lưu địa chỉ trang web vào thanh Bookmark để truy cập lại khi cần và nháy chuột vào tên trang web trên thanh Bookmark để mở lại."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Sử dụng máy tìm kiếm Google", "skill_description": "Thực hiện nhập địa chỉ máy tìm kiếm, nhập từ khoá tìm kiếm chính xác và lọc kết quả tìm kiếm theo các dạng hình ảnh, tin tức, video."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "skill_name": "Xem nội dung thư điện tử", "skill_description": "Thực hiện thao tác nháy chuột vào tên người gửi hoặc tiêu đề thư để mở và đọc nội dung thư."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "skill_name": "Soạn và gửi thư điện tử", "skill_description": "Thực hiện tạo thư mới, điền địa chỉ người nhận, tiêu đề, nội dung và gửi thư đi an toàn."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "skill_name": "Đăng xuất tài khoản", "skill_description": "Thực hiện đăng xuất khỏi hộp thư điện tử sau khi sử dụng để bảo mật thông tin cá nhân."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Giải ô chữ củng cố kiến thức thư điện tử", "skill_description": "Vận dụng kiến thức về thư điện tử để điền các từ khóa còn thiếu vào câu hỏi và tìm từ khóa ẩn trong ô chữ."}, {"grade_level": "Lớp 6", "lesson_id": "Mở đầu chủ đề", "skill_name": "Nhận thức an toàn thông tin", "skill_description": "Nhận diện các nguy cơ tiềm ẩn và tầm quan trọng của việc bảo vệ dữ liệu cá nhân trên môi trường mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Nhận diện rủi ro trên Internet", "skill_description": "Phân biệt được các hành vi lừa đảo, thông tin độc hại, không chính xác và các biểu hiện nghiện Internet để phòng tránh."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "skill_name": "Kỹ năng xử lý tình huống giao tiếp trên mạng", "skill_description": "Biết cách từ chối cung cấp thông tin cá nhân, số điện thoại, địa chỉ cho người lạ trên mạng và biết báo cáo cho người lớn khi gặp thông tin xấu, tin nhắn lừa đảo."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Kỹ năng bảo vệ thông tin cá nhân và tài khoản", "skill_description": "Thực hiện các biện pháp an toàn khi sử dụng Internet như đặt mật khẩu mạnh, đăng xuất tài khoản sau khi sử dụng và nhận diện các nguy cơ rủi ro trên không gian mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 5", "skill_name": "Tư duy và tổ chức thông tin trực quan", "skill_description": "Lập kế hoạch và tổ chức nội dung cho sản phẩm thực hành tổng hợp là sổ lưu niệm của lớp."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "skill_name": "Phân tích và đọc sơ đồ tư duy", "skill_description": "Quan sát sơ đồ tư duy để xác định chủ đề chính, các chủ đề nhánh, từ khóa, hình ảnh và mối liên hệ giữa các thông tin."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Khởi động và sử dụng phần mềm MindMaple Lite", "skill_description": "Thực hiện khởi động phần mềm, quan sát và nhận biết các thành phần chính trên giao diện như thanh công cụ, vùng làm việc và bảng chọn biểu tượng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Tạo mới sơ đồ tư duy trên phần mềm", "skill_description": "Thực hiện các bước chọn File -> New -> Chọn mẫu -> Create trên phần mềm tạo sơ đồ tư duy."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Thêm chủ đề nhánh (Subtopic)", "skill_description": "Chọn chủ đề chính hoặc chủ đề hiện tại, sử dụng lệnh Insert/Subtopic để thêm chủ đề nhánh và nhập nội dung."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "skill_name": "Tạo và chỉnh sửa sơ đồ tư duy", "skill_description": "Thực hiện bổ sung các nhánh nội dung, chỉnh sửa màu sắc, kiểu đường nối, bổ sung hình ảnh và biểu tượng; lưu tệp với tên SoLuuniem.emm và chia sẻ qua mạng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 11", "skill_name": "Lựa chọn phần mềm soạn thảo văn bản", "skill_description": "Xác định và lựa chọn phần mềm soạn thảo văn bản phù hợp để tạo nội dung cho cuốn sổ lưu niệm trên máy tính dựa trên sơ đồ tư duy đã lập ở Bài 10."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "skill_name": "Định dạng đoạn văn bản", "skill_description": "Thực hiện các thao tác căn chỉnh lề (trái, phải, giữa, đều hai bên), thay đổi khoảng cách dòng và khoảng cách giữa các đoạn bằng cách sử dụng các nút lệnh trong nhóm Paragraph trên thẻ Home."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học từ trang SGK", "skill_name": "Định dạng trang văn bản", "skill_description": "Thực hiện chọn hướng trang, thiết lập thông số lề trang và lựa chọn khổ giấy A4 sử dụng các lệnh trong thẻ Page Layout, nhóm Page Setup."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "skill_name": "Trình bày trang văn bản", "skill_description": "Thực hiện thiết đặt lề trang, hướng trang phù hợp với nội dung văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "skill_name": "In văn bản", "skill_description": "Thao tác chọn lệnh Print trong thẻ File, chọn máy in, chọn số bản in và các trang cần in rồi nhấn nút Print để in."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "skill_name": "Nhập nội dung và chèn hình ảnh", "skill_description": "Thực hiện mở phần mềm soạn thảo văn bản Microsoft Word, gõ nội dung văn bản và sử dụng lệnh Insert/Picture để chèn hình ảnh minh họa."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "skill_name": "Căn lề đoạn văn bản", "skill_description": "Thao tác trên thẻ Home của Microsoft Word để chọn kiểu căn lề (căn giữa, căn đều hai bên) cho tiêu đề và các đoạn văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài thực hành", "skill_name": "Thiết lập hướng và lề trang văn bản", "skill_description": "Thực hiện chọn hướng trang (Portrait - hướng đứng) và chọn mẫu lề trang (Normal) cho tài liệu soạn thảo."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "skill_name": "Thay đổi hướng trang và lề trang", "skill_description": "Thực hiện thành thạo các thao tác chọn thẻ Page Layout trên thanh công cụ, sử dụng tính năng Orientation để đổi hướng trang và Margins để căn chỉnh lề trang phù hợp với nội dung văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "skill_name": "Soạn thảo và trình bày sổ lưu niệm, đơn xin nghỉ học", "skill_description": "Thực hiện soạn thảo nội dung, chèn hình ảnh minh họa, căn lề, định dạng trang và lưu tệp với tên chỉ định (ví dụ: CamNghiVeBan.docx)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "skill_name": "Nhận xét và lựa chọn cách trình bày thông tin", "skill_description": "Quan sát, so sánh và đưa ra lựa chọn tối ưu giữa cách trình bày thông tin bằng bảng và liệt kê thông thường trong việc làm sổ lưu niệm."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "skill_name": "Tạo bảng trong phần mềm soạn thảo văn bản", "skill_description": "Thao tác trên thẻ Insert, chọn Table và kéo chuột chọn chính xác số hàng, số cột mong muốn để chèn bảng vào trang văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "skill_name": "Nhập và di chuyển dữ liệu trong bảng", "skill_description": "Sử dụng phím mũi tên hoặc chuột để di chuyển giữa các ô trong bảng, nhập văn bản hoặc dữ liệu vào ô, thực hiện căn chỉnh lề dữ liệu trong ô."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "skill_name": "Tạo bảng trong văn bản", "skill_description": "Xác định số cột, số hàng và tạo bảng có kích thước theo yêu cầu."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "skill_name": "Gộp ô trong bảng", "skill_description": "Chọn các ô cần gộp, sử dụng thẻ Layout và lệnh Merge Cells để gộp nhiều ô thành một ô."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "skill_name": "Thay đổi kích thước cột và hàng", "skill_description": "Di chuyển con trỏ chuột vào đường biên của cột hoặc hàng và kéo thả chuột để điều chỉnh kích thước."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "skill_name": "Thực hiện tìm kiếm từ hoặc cụm từ trong Microsoft Word", "skill_description": "Mở thẻ Home, chọn Find trong nhóm Editing, nhập từ khóa cần tìm vào ô Navigation và quan sát các kết quả được đánh dấu trong văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "skill_name": "Thực hiện thay thế từ hoặc cụm từ trong văn bản", "skill_description": "Sử dụng hộp thoại Find and Replace để tìm kiếm và thay thế nhanh chóng một từ hoặc cụm từ bằng từ, cụm từ mới trong toàn bộ văn bản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "skill_name": "Chèn tệp văn bản bằng tính năng Text from File", "skill_description": "Thực hiện các bước trên thanh Ribbon: chọn thẻ Insert -> chọn Object trong nhóm Text -> chọn Text from File để gộp nhiều tệp văn bản lại với nhau."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "skill_name": "Định dạng và hoàn thiện tài liệu", "skill_description": "Thực hiện định dạng chữ (màu sắc, cỡ chữ,...), căn chỉnh lề đoạn văn bản, định dạng hướng trang, lề trang, bổ sung hình ảnh, chèn bảng và sử dụng chức năng Tìm kiếm và Thay thế."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "skill_name": "Tạo trang bìa tài liệu", "skill_description": "Sử dụng tính năng Cover Page trong phần mềm soạn thảo văn bản để chọn và tùy chỉnh trang bìa cho tài liệu."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 5", "skill_name": "Kiểm tra và hoàn thiện tài liệu", "skill_description": "Xem lại tổng thể văn bản, hình ảnh, bố cục để hoàn thiện sản phẩm nhóm."}, {"grade_level": "Lớp 6", "lesson_id": "Chủ đề 6", "skill_name": "Làm quen với môi trường lập trình trực quan", "skill_description": "Quan sát và nhận biết giao diện phần mềm lập trình, thao tác cơ bản với bàn phím và chuột máy tính."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "skill_name": "Xác định đầu vào và đầu ra của bài toán", "skill_description": "Phân tích một bài toán thực tế hoặc quá trình đơn giản (như gấp giấy, chế biến món ăn) để xác định rõ thông tin đầu vào (Input) và đầu ra (Output)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "skill_name": "Mô tả thuật toán bằng ngôn ngữ tự nhiên", "skill_description": "Liệt kê các bước thực hiện tuần tự để giải quyết một nhiệm vụ đơn giản."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "skill_name": "Đọc và hiểu sơ đồ khối", "skill_description": "Nhận diện các hình khối quy ước trong sơ đồ khối và thực hiện tuần tự các bước của thuật toán theo chiều mũi tên."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "skill_name": "Xác định đầu vào và đầu ra của thuật toán", "skill_description": "Phân tích bài toán để nhận diện chính xác dữ liệu cho trước (đầu vào) và kết quả cần thu được (đầu ra)."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "skill_name": "Sắp xếp và thiết kế sơ đồ khối", "skill_description": "Sắp xếp các khối lệnh theo đúng logic thuật toán hoặc sử dụng sơ đồ khối để biểu diễn quá trình giải quyết bài toán."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "skill_name": "Mô tả thuật toán rẽ nhánh", "skill_description": "Vẽ và đọc được sơ đồ khối sử dụng cấu trúc rẽ nhánh dạng thiếu và dạng đủ để giải quyết các bài toán thực tế."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "skill_name": "Xây dựng sơ đồ khối cấu trúc lặp", "skill_description": "Vẽ và điền thông tin vào sơ đồ khối mô tả thuật toán có sử dụng cấu trúc lặp."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "skill_name": "Biểu diễn thuật toán bằng sơ đồ khối", "skill_description": "Thực hiện phân tích bài toán thực tế, nhận diện cấu trúc rẽ nhánh và cấu trúc lặp để vẽ và đọc sơ đồ khối chính xác."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "skill_name": "Mô tả thuật toán và chương trình máy tính", "skill_description": "Thực hiện bổ sung nội dung vào bảng phân tích công việc, mô tả thuật toán bằng ngôn ngữ tự nhiên và xác định số thứ tự câu lệnh Scratch tương ứng với các bước nhập dữ liệu đầu vào, xử lí và thông báo đầu ra."}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6 - Thực hành", "skill_name": "Lập sơ đồ khối và viết chương trình Scratch", "skill_description": "Mô tả thuật toán giải quyết yêu cầu bài toán tính tiền lãi/lỗ bằng sơ đồ khối và xây dựng chương trình Scratch tương ứng."}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "skill_name": "Phân tích và viết chương trình Scratch", "skill_description": "Đọc hiểu sơ đồ khối, phân tích cấu trúc điều khiển và tự lập trình giải quyết bài toán tính điểm trung bình, tìm số lớn hơn hoặc lập trình mô phỏng trong Scratch."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "skill_name": "Phân loại thiết bị", "skill_description": "Quan sát hình ảnh thực tế hoặc thiết bị phần cứng để nhận biết chính xác đâu là thiết bị vào, thiết bị ra hay thiết bị có cả hai chức năng vào và ra."}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "skill_name": "Kết nối thiết bị vào - ra với thân máy", "skill_description": "Thực hiện ghép nối chính xác các đầu cắm của bàn phím, chuột, màn hình, tai nghe, dây mạng và dây nguồn vào đúng các cổng kết nối tương ứng phía sau thùng máy tính theo đúng trình tự an toàn điện."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "skill_name": "Thao tác bật, tắt và sử dụng máy tính an toàn", "skill_description": "Thực hiện đúng quy trình đóng các ứng dụng, chọn lệnh Shut down để tắt máy tính và ngắt kết nối thiết bị ngoại vi an toàn."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 2", "skill_name": "Nhận diện và phân loại phần mềm", "skill_description": "Phân biệt được phần mềm hệ thống (hệ điều hành) và phần mềm ứng dụng trên thiết bị số."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "skill_name": "Nhận diện phần mở rộng của tệp", "skill_description": "Xác định phần mở rộng của tên tệp để biết loại dữ liệu và phần mềm ứng dụng tương thích dùng để mở tệp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "skill_name": "Nhận diện phần mềm ứng dụng và loại tệp", "skill_description": "Xác định chính xác tên phần mềm ứng dụng, phần mở rộng của tệp và khả năng tương thích giữa tệp dữ liệu với phần mềm ứng dụng trên hệ điều hành."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Sao lưu dữ liệu", "skill_description": "Thực hiện tạo bản sao lưu cục bộ và sao lưu từ xa lên đám mây để phòng ngừa rủi ro mất mát dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "skill_name": "Nhận diện và đặt mật khẩu mạnh", "skill_description": "Thực hiện tạo lập mật khẩu bảo vệ tài khoản cá nhân đáp ứng đủ độ dài, ký tự hoa, thường, số và ký tự đặc biệt."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "skill_name": "Sử dụng và cập nhật phần mềm diệt virus", "skill_description": "Kiểm tra trạng thái hoạt động của phần mềm diệt virus trên máy tính và đảm bảo phần mềm được cập nhật thường xuyên."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Quản lí tệp và thư mục trong hệ điều hành", "skill_description": "Thực hiện tạo cây thư mục, đổi tên thư mục, di chuyển các tệp và thư mục con, xoá thư mục trên hệ điều hành bằng File Explorer hoặc Windows Explorer."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Quản lý và thao tác với tệp, thư mục", "skill_description": "Sử dụng thành thạo các lệnh chuột phải (Cut, Copy, Paste, Delete, Rename) để tổ chức, sắp xếp, di chuyển, đổi tên và xoá tệp, thư mục trên hệ điều hành."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Sử dụng kênh trao đổi thông tin trên Internet", "skill_description": "Nhận biết và sử dụng các kênh trao đổi thông tin thông dụng trên Internet như thư điện tử, diễn đàn và mạng xã hội."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Nhận diện và phân loại mạng xã hội", "skill_description": "Kỹ năng phân biệt các website mạng xã hội theo mục đích sử dụng (giao lưu, chia sẻ video, chia sẻ ảnh, học tập) và nhận biết các kênh trao đổi thông tin phù hợp trên Internet."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Sử dụng mạng xã hội an toàn", "skill_description": "Kỹ năng đánh giá tính xác thực của thông tin, tuân thủ độ tuổi tham gia (từ 13 tuổi trở lên) và phòng tránh các nguy cơ tiêu cực, thông tin sai trái, bắt nạt trên mạng xã hội."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Tạo tài khoản và sử dụng mạng xã hội", "skill_description": "Thực hiện truy cập trang web mạng xã hội, tiến hành tạo tài khoản mới, cập nhật thông tin cá nhân, ảnh đại diện và sử dụng các chức năng xem, chia sẻ thông tin dạng văn bản, hình ảnh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Chia sẻ nội dung trên trang Facebook cá nhân", "skill_description": "Thực hiện các bước nhập nội dung văn bản, đính kèm ảnh hoặc video và nhấn nút Đăng/Post để chia sẻ thông tin lên trang cá nhân."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "skill_name": "Tìm kiếm và kết nối bạn bè trên Facebook", "skill_description": "Sử dụng thanh tìm kiếm để nhập tên tài khoản của bạn bè, tìm trang Facebook của bạn và thực hiện kết nối."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Tìm kiếm và gửi yêu cầu kết bạn trên mạng xã hội", "skill_description": "Thực hiện tìm kiếm tài khoản người dùng trên mạng xã hội Facebook và thao tác gửi yêu cầu kết bạn đúng cách."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "skill_name": "Nhận diện phương thức giao tiếp qua mạng", "skill_description": "Phân biệt được các hình thức giao tiếp trực tuyến (thư điện tử, tin nhắn, mạng xã hội, diễn đàn) và giao tiếp trực tiếp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Kỹ năng ứng xử và xử lý tình huống trên mạng", "skill_description": "Thực hành phân loại các hành vi giao tiếp qua mạng thành nhóm nên làm và không nên làm; biết cách xử lý khi gặp tình huống bị bắt nạt hoặc gặp trang web có nội dung xấu không lành mạnh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "skill_name": "Nhận biết và phòng tránh tác hại của Internet", "skill_description": "Kỹ năng tự quản lý thời gian sử dụng thiết bị điện tử, biết cách từ chối các trang web không phù hợp và nhận diện các biểu hiện của bệnh nghiện Internet để phòng tránh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Kỹ năng quản lý thời gian và ứng xử trên mạng", "skill_description": "Thực hiện các biện pháp giới hạn thời gian sử dụng thiết bị số, chia sẻ với người lớn khi gặp vấn đề trên mạng và tham gia các hoạt động ngoại khóa lành mạnh."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "skill_name": "Nhận biết giao diện phần mềm bảng tính", "skill_description": "Quan sát và nhận biết các vùng chính và chức năng của chúng trên giao diện làm việc của phần mềm bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "skill_name": "Nhận diện các thành phần trên giao diện bảng tính", "skill_description": "Xác định vị trí hàng, cột, ô tính, hộp địa chỉ và vùng nhập dữ liệu trên giao diện phần mềm bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "skill_name": "Xác định địa chỉ ô và vùng dữ liệu", "skill_description": "Nhìn vào trang tính, xác định được tên cột và tên hàng để đọc đúng địa chỉ của ô hoặc vùng dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "skill_name": "Thao tác chọn ô, hàng, cột và vùng trên trang tính", "skill_description": "Sử dụng chuột để nháy chọn một ô, tên hàng, tên cột hoặc kéo thả chuột để chọn một vùng dữ liệu trên phần mềm bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "skill_name": "Nhập dữ liệu vào ô tính", "skill_description": "Chọn ô cần nhập, gõ dữ liệu trực tiếp hoặc thông qua thanh công thức (vùng nhập dữ liệu), sau đó nhấn Enter."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "skill_name": "Chỉnh sửa dữ liệu trong ô tính", "skill_description": "Nháy đúp chuột vào ô tính hoặc nháy chuột vào ô rồi nháy chuột lên thanh công thức để làm xuất hiện con trỏ soạn thảo, thực hiện sửa nội dung và nhấn Enter."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Định dạng dữ liệu trang tính", "skill_description": "Thực hiện chọn vùng dữ liệu và áp dụng các lệnh thay đổi phông chữ, cỡ chữ, kiểu chữ, màu sắc và căn lề trong nhóm lệnh Font và Alignment của thẻ Home."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Nhập dữ liệu bảng khảo sát trong Excel", "skill_description": "Thực hiện tạo bảng tính mới (Blank workbook) và nhập chính xác các tiêu đề, dữ liệu dạng văn bản và số vào các ô tính cụ thể theo yêu cầu bài toán thực tế."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "skill_name": "Điều chỉnh độ rộng cột và độ cao hàng", "skill_description": "Thực hiện kéo thả chuột tại vạch giữa các tên cột hoặc tên hàng để hiển thị toàn bộ nội dung dữ liệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "skill_name": "Định dạng dữ liệu trang tính", "skill_description": "Định dạng chữ in đậm, màu sắc, cỡ chữ và căn lề dữ liệu (căn giữa cột STT, định dạng nền hàng tiêu đề màu vàng)."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "skill_name": "Đổi tên trang tính và lưu tệp", "skill_description": "Nháy đúp chuột vào tên trang tính để đổi tên thành 'Khảo sát' và sử dụng lệnh File/Save hoặc tổ hợp phím Ctrl+S để lưu tệp với tên THXanh.xlsx."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "skill_name": "Nhập công thức vào bảng tính", "skill_description": "Thực hiện nhập dấu '=' và xây dựng biểu thức toán học sử dụng địa chỉ ô tính thay vì các con số cụ thể để đảm bảo tính toán tự động khi dữ liệu thay đổi."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Sao chép ô tính chứa công thức trong Excel", "skill_description": "Thực hiện chọn ô chứa công thức cần sao chép, nhấn tổ hợp phím Ctrl+C, đánh dấu vùng muốn sao chép đến và nhấn tổ hợp phím Ctrl+V để dán dữ liệu, đảm bảo công thức tự động cập nhật địa chỉ ô tương ứng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "skill_name": "Tạo trang tính mới và nhập dữ liệu", "skill_description": "Thực hiện tạo trang tính mới trong bảng tính, đặt tên, nhập dữ liệu danh sách các loại cây và đơn giá."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "skill_name": "Sử dụng công thức tính toán và sao chép công thức", "skill_description": "Nhập công thức nhân đơn giá với số lượng (D4 * E4) vào ô F4 và sao chép công thức xuống các ô từ F5 đến F19 để tính giá trị của cột Thành tiền, cũng như tính tổng cho ba loại cây."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "skill_name": "Định dạng trang tính", "skill_description": "Thực hiện định dạng chữ đậm, màu nền vàng cho tiêu đề, căn giữa cột STT và điều chỉnh độ rộng cột."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "skill_name": "Nhập hàm và sao chép công thức", "skill_description": "Thực hiện nhập hàm SUM vào bảng tính để tính tổng dữ liệu theo cột và sao chép công thức từ ô C9 sang các ô từ D9 đến I9."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "skill_name": "Sử dụng hàm tính toán cơ bản trong Excel", "skill_description": "Thực hiện nhập và sử dụng thành thạo các hàm SUM, AVERAGE, MIN, MAX, COUNT vào bảng tính để giải quyết các bài toán thực tế."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "skill_name": "Sử dụng các hàm tính toán trong bảng tính", "skill_description": "Thực hiện nhập cú pháp và sử dụng các hàm SUM, AVERAGE, MIN, MAX, COUNT để tính toán dữ liệu trong dự án trồng cây thực tế."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "skill_name": "Tạo trang tính mới trong phần mềm bảng tính", "skill_description": "Thực hiện mở tệp bảng tính, tạo thêm trang tính mới và đặt tên cho trang tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "skill_name": "Nhập và sao chép dữ liệu trang tính", "skill_description": "Thực hiện nhập tiêu đề, sao chép vùng dữ liệu A3:C19 từ trang tính 3 sang trang tính 4 tại địa chỉ A3."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "skill_name": "Chèn thêm hàng và sử dụng hàm SUM, AVERAGE", "skill_description": "Thực hiện chọn hàng, nháy nút phải chuột chọn lệnh Insert để chèn hàng trống; nhập công thức hàm SUM(D4:D8), SUM(D4:J4) và AVERAGE(D4:J4) để tính tổng số cây và trung bình số cây mỗi loại."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "skill_name": "Định dạng trang tính nâng cao", "skill_description": "Thực hiện định dạng in đậm chữ, tô màu nền cho hàng tiêu đề và các ô tổng hợp trên bảng tính điện tử."}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "skill_name": "Sử dụng công thức và hàm tính toán", "skill_description": "Vận dụng hàm SUM và các công thức cộng trừ số học để tính tổng số cây, tìm giá trị lớn nhất và tính trung bình số cây trồng của các lớp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Định dạng dữ liệu số trong bảng tính", "skill_description": "Thực hiện chọn vùng dữ liệu số, mở cửa sổ Format Cells từ nhóm lệnh Number trên thẻ Home để thiết lập cách hiển thị số thập phân hoặc dấu phân cách hàng nghìn, hàng triệu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Định dạng dữ liệu kiểu phần trăm trong Excel", "skill_description": "Thực hiện chọn vùng dữ liệu, mở hộp thoại Format Cells, chọn danh mục Number hoặc Percentage để hiển thị giá trị dưới dạng tỉ lệ phần trăm."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Định dạng dữ liệu kiểu ngày tháng trong Excel", "skill_description": "Thực hiện thay đổi cách hiển thị ngày tháng trong hộp thoại Format Cells bằng cách chọn các định dạng kiểu ngày tháng khác nhau mà không làm thay đổi giá trị thực tế bên trong ô."}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "skill_name": "Thiết lập định dạng ngày tháng kiểu Việt Nam", "skill_description": "Thực hiện mở hộp thoại Format Cells, chọn thẻ Number, chọn danh mục Date, thiết lập Locale là Vietnamese và chọn kiểu hiển thị ngày tháng phù hợp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "skill_name": "Thực hiện phép tính cộng trừ ngày tháng trên bảng tính", "skill_description": "Nhập công thức cộng ngày tháng với số nguyên hoặc trừ hai giá trị ngày tháng trong các ô tính Excel."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Thao tác chèn, xoá, ẩn, hiện hàng và cột trong Excel", "skill_description": "Sử dụng menu chuột phải để chèn thêm hàng/cột mới, xóa hàng/cột thừa, ẩn bớt hàng/cột không cần thiết hoặc hiển thị lại các hàng/cột đã ẩn để tối ưu hiển thị bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Thao tác gộp các ô trong Excel", "skill_description": "Chọn vùng dữ liệu cần gộp và sử dụng công cụ Merge & Center trên thẻ Home để gộp các ô thành một ô chung và căn giữa nội dung."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Tạo trang tính mới và sao chép dữ liệu", "skill_description": "Mở tệp bảng tính, tạo thêm một trang tính mới đặt tên, sao chép toàn bộ dữ liệu từ trang tính này sang trang tính khác và chỉnh sửa tên bảng."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Chèn thêm cột trong bảng tính", "skill_description": "Nháy chuột chọn cột D, nháy nút phải chuột và chọn Insert để chèn thêm cột Đơn giá."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "skill_name": "Tính toán và sao chép công thức", "skill_description": "Nhập công thức tính Chi phí bằng tích của Đơn giá với Tổng số cây và sao chép công thức cho các hàng dữ liệu còn lại."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "Thao tác với trang tính trong bảng tính điện tử", "skill_description": "Thực hiện thành thạo các kỹ năng: tạo trang tính mới bằng dấu cộng, xóa trang tính bằng chuột phải và chọn Delete, chèn trang tính mới bằng Insert/Worksheet, và đổi tên trang tính bằng cách nháy đúp chuột."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "Sao chép trang tính", "skill_description": "Thực hiện nháy chuột phải vào tên trang tính, chọn Move or Copy, chọn vị trí đích, tích chọn Create a copy và nhấn OK."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "Kẻ đường viền ô và khung dữ liệu", "skill_description": "Chọn vùng dữ liệu cần kẻ viền, mở cửa sổ Format Cells, chọn thẻ Border, chọn kiểu đường kẻ, màu sắc, áp dụng định dạng khung (Outline, Inside) và nhấn OK."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "In trang tính", "skill_description": "Thao tác chọn vùng dữ liệu, mở hộp thoại Print, thiết lập các thông số in (máy in, số bản, vùng in, hướng giấy) và thực hiện lệnh in."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "Trình bày hoàn chỉnh dữ liệu dự án", "skill_description": "Tạo trang tính mới, mở tệp bảng tính, sao chép nội dung, định dạng dữ liệu, kẻ đường viền, kẻ khung để hoàn thành dự án 'Trường học xanh'."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "Định dạng số và căn chỉnh trang tính", "skill_description": "Thực hiện thiết lập số chữ số thập phân, bật chế độ phân tách hàng nghìn, gộp ô, căn chỉnh lề, tô màu nền và kẻ đường viền trong phần mềm bảng tính."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "skill_name": "In trang tính và trình bày dữ liệu", "skill_description": "Thực hiện thao tác in trang tính, ẩn/hiện cột dữ liệu và sao chép bảng tính sang phần mềm trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "skill_name": "Khởi động và tạo trang tiêu đề trong PowerPoint", "skill_description": "Mở phần mềm Microsoft PowerPoint, nhận biết trang tiêu đề mặc định và nhập tiêu đề, phụ đề cho bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "skill_name": "Tạo trang nội dung mới và chọn bố cục", "skill_description": "Sử dụng lệnh New Slide để thêm trang nội dung, chọn Layout phù hợp và nhập tiêu đề cùng nội dung chi tiết cho trang trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "skill_name": "Tạo cấu trúc phân cấp cho văn bản trên trang chiếu", "skill_description": "Sử dụng lệnh Increase List Level, Decrease List Level hoặc phím Tab, tổ hợp phím Shift + Tab để thay đổi mức độ phân cấp các dòng văn bản trong phần mềm trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "skill_name": "Thay đổi kí hiệu đầu dòng và màu sắc trong phần mềm trình chiếu", "skill_description": "Thực hiện chọn đoạn văn bản, sử dụng lệnh Bullets and Numbering trong thẻ Home để thay đổi hình dạng và màu sắc của kí hiệu đầu dòng hoặc chuyển sang dạng đánh số thứ tự."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "skill_name": "Lưu tệp trình chiếu", "skill_description": "Thực hiện thao tác lưu tệp bài trình chiếu với tên theo yêu cầu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Lựa chọn ảnh minh hoạ cho bài trình chiếu", "skill_description": "Thực hiện lựa chọn hình ảnh phù hợp với nội dung bài trình chiếu, đảm bảo tính thẩm mĩ, kích thước và vị trí đặt trên trang chiếu hợp lí."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Định dạng văn bản trong bài trình chiếu", "skill_description": "Thực hiện lựa chọn phông chữ, cỡ chữ, kiểu chữ và màu sắc phù hợp cho tiêu đề và nội dung trên trang chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Sao chép dữ liệu từ Word sang PowerPoint", "skill_description": "Thực hiện bôi đen chọn văn bản trong tệp Word, sử dụng lệnh Copy (Ctrl + C), sau đó chuyển sang tệp PowerPoint và dùng lệnh Paste (Ctrl + V) để dán nội dung vào trang chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Định dạng văn bản và hình ảnh trong trang chiếu", "skill_description": "Thực hiện định dạng văn bản (phông chữ, cỡ chữ, kiểu chữ, định dạng làm nổi bật) và định dạng hình ảnh minh họa trên trang chiếu để báo cáo dự án."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Định dạng và biên tập văn bản trong phần mềm trình chiếu", "skill_description": "Thực hiện chọn các công cụ trên thẻ Home để thay đổi phông chữ, cỡ chữ, kiểu chữ, màu sắc, căn lề, giãn dòng và thêm kí hiệu đầu dòng nhằm làm nổi bật nội dung trình bày."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Áp dụng mẫu định dạng (Theme) cho trang chiếu", "skill_description": "Thao tác chọn thẻ Design, mở nhóm Themes và Variants, chọn và áp dụng mẫu định dạng cho một hoặc nhiều trang chiếu trong phần mềm trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Chèn hình ảnh vào trang chiếu", "skill_description": "Thực hiện chọn trang chiếu, sử dụng lệnh Insert/Pictures hoặc lệnh Copy và Paste để đưa hình ảnh minh họa vào bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Định dạng hình ảnh trên trang chiếu", "skill_description": "Thực hiện thành thạo các thao tác thay đổi vị trí, thay đổi kích thước, thay đổi lớp (hiển thị phía trên hoặc dưới văn bản) cho hình ảnh trong phần mềm trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Định dạng hình ảnh và văn bản trên trang chiếu", "skill_description": "Thực hiện chọn hình ảnh, áp dụng đường viền qua Picture Border, đặt màu nền trang chiếu và thay đổi màu sắc văn bản để nâng cao tính thẩm mỹ cho bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "skill_name": "Chèn kết quả bảng tính vào bài trình chiếu", "skill_description": "Thực hiện sao chép kết quả tính toán từ phần mềm bảng tính (Excel) vào bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "skill_name": "Sử dụng hiệu ứng động trong bài trình chiếu", "skill_description": "Thực hành quan sát, phân tích và áp dụng các hiệu ứng cho đối tượng và hiệu ứng chuyển trang chiếu một cách hợp lí để hoàn thiện bài thuyết trình."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "skill_name": "Tạo hiệu ứng động cho đối tượng", "skill_description": "Thực hiện các bước chọn đối tượng trên trang chiếu, mở thẻ Animations, lựa chọn hiệu ứng xuất hiện, tùy chỉnh thời lượng, thứ tự xuất hiện và xem trước kết quả."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "skill_name": "Hoàn thiện bài trình chiếu", "skill_description": "Tổng hợp, sắp xếp, bổ sung các nội dung để hoàn thiện bài trình chiếu báo cáo dự án 'Trường học xanh'."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "skill_name": "Tạo hiệu ứng chuyển trang chiếu trong PowerPoint", "skill_description": "Thực hiện chọn thẻ Transitions, áp dụng các hiệu ứng chuyển trang, tuỳ chỉnh âm thanh, thời gian và xem trước hiệu ứng cho bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "skill_name": "Hoàn thiện và bổ sung hiệu ứng động", "skill_description": "Kiểm tra lại bố cục, nội dung, định dạng văn bản, hình ảnh và bổ sung hiệu ứng động cho tệp bài trình chiếu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "skill_name": "Mô phỏng thuật toán tìm kiếm tuần tự", "skill_description": "Thực hiện tìm kiếm lần lượt từng phần tử từ đầu đến cuối danh sách dựa trên các điều kiện kiểm tra dừng vòng lặp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "skill_name": "Thực hiện thuật toán tìm kiếm tuần tự bằng tay", "skill_description": "Đọc hiểu sơ đồ khối thuật toán tìm kiếm tuần tự và áp dụng vào bảng dữ liệu cụ thể để tìm kiếm thông tin theo yêu cầu."}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "skill_name": "Thực hiện thuật toán tìm kiếm tuần tự trên danh sách cụ thể", "skill_description": "Vận dụng các bước của thuật toán tìm kiếm tuần tự để tìm kiếm một phần tử (ví dụ tìm tên nước 'Iceland' hoặc tìm một cuốn sách) trong danh sách cho trước, điền kết quả vào bảng theo dõi các bước lặp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "skill_name": "Mô phỏng thuật toán tìm kiếm nhị phân", "skill_description": "Thực hiện các bước xác định vị trí giữa, so sánh giá trị cần tìm và thu hẹp phạm vi tìm kiếm sang nửa đầu hoặc nửa sau của danh sách đã sắp xếp."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "skill_name": "Áp dụng thuật toán tìm kiếm nhị phân", "skill_description": "Thực hiện tìm kiếm một phần tử trong danh sách đã sắp xếp bằng cách lặp lại việc chia đôi danh sách và so sánh giá trị ở giữa."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "skill_name": "Mô phỏng trò chơi tìm số bằng thuật toán tìm kiếm nhị phân", "skill_description": "Thực hiện trò chơi hai người với 10 tấm thẻ đã sắp xếp thứ tự từ bé đến lớn: người A úp thẻ, người B chọn tấm thẻ ở vị trí giữa, người A so sánh và trả lời ('bằng nhau', 'lớn hơn', hoặc 'bé hơn'), người B tiếp tục chọn nửa dãy tiếp theo để tìm kiếm cho đến khi tìm thấy hoặc hết dãy số."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "skill_name": "Hoán đổi giá trị", "skill_description": "Thực hiện các bước hoán đổi vị trí hoặc giá trị giữa hai đối tượng thông qua biến trung gian."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "skill_name": "Mô phỏng thuật toán sắp xếp nổi bọt", "skill_description": "Thực hiện các bước so sánh và đổi chỗ các phần tử liền kề từ cuối dãy lên đầu dãy để sắp xếp dãy số theo thứ tự tăng dần."}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "skill_name": "Mô phỏng từng bước thuật toán sắp xếp chọn", "skill_description": "Thực hiện lần lượt các vòng lặp để so sánh và hoán đổi giá trị các phần tử trong dãy số theo thuật toán sắp xếp chọn cho đến khi thu được dãy số có thứ tự tăng dần."}, {"grade_level": "Lớp 8", "lesson_id": "HD01", "skill_name": "Kỹ năng khai thác sách giáo khoa", "skill_description": "Biết cách sử dụng các chỉ dẫn, cấu trúc bài học, hộp kiến thức và bảng giải thích thuật ngữ để tự học và ôn tập môn Tin học hiệu quả."}, {"grade_level": "Lớp 8", "lesson_id": "MỤC LỤC", "skill_name": "Tra cứu tài liệu học tập", "skill_description": "Sử dụng bảng mục lục để tìm kiếm nhanh chóng nội dung bài học, chủ đề cần ôn tập hoặc nghiên cứu trước trong sách giáo khoa."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "skill_name": "Phân tích và liên hệ thực tiễn", "skill_description": "Vận dụng kiến thức về công nghệ số để lấy ví dụ minh họa, so sánh sự khác nhau giữa học tập truyền thống và học tập có sự hỗ trợ của thiết bị số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "skill_name": "Đưa ra dự báo công nghệ", "skill_description": "Quan sát xu hướng phát triển công nghệ hiện tại để đưa ra các dự báo hợp lý về ứng dụng của máy tính trong tương lai."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "skill_name": "Số hoá và chia sẻ thông tin số", "skill_description": "Sử dụng thiết bị số (điện thoại thông minh) để chụp ảnh, số hoá tài liệu/ảnh in và gửi qua môi trường mạng (thư điện tử) cho người khác."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "skill_name": "Nhận diện và đánh giá đặc điểm thông tin số", "skill_description": "Phân tích được các tình huống thực tế về việc chia sẻ, chỉnh sửa, lưu trữ và lan truyền thông tin số qua thư điện tử và mạng xã hội."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "skill_name": "Kỹ năng đánh giá độ tin cậy thông tin", "skill_description": "Thực hiện phân tích nguồn gốc, thời gian công bố, chứng cứ đi kèm và phân biệt rõ giữa ý kiến chủ quan và sự kiện khách quan của thông tin trên mạng hoặc trong đời sống."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "skill_name": "Nhiệm vụ 1: Hình thành ý tưởng và cấu trúc bài trình chiếu về chủ đề Năng lượng tái tạo", "skill_description": "Yêu cầu: Xây dựng ý tưởng cho bài trình chiếu; Xây dựng cấu trúc bài trình chiếu.\nHướng dẫn thực hiện:\n- Bước 1: Nêu một khía cạnh hay một vấn đề cụ thể về năng lượng tái tạo định trình bày (thuỷ điện, điện gió, điện mặt trời,... hoặc năng lượng tái tạo tại địa phương, nơi đang sinh sống).\n- Bước 2: Phát triển ý tưởng thành nội dung cụ thể của bài trình chiếu bằng cách sắp xếp theo trình tự logic và thể hiện dưới dạng các câu hỏi định hướng tìm tư liệu (ví dụ: Năng lượng tái tạo là gì? Nguồn năng lượng nào sản xuất ra điện ở nơi em sinh sống? Ưu, nhược điểm của nguồn năng lượng đó là gì?)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "skill_name": "Tìm kiếm và ghi chép thông tin trong môi trường số", "skill_description": "Sử dụng máy tìm kiếm với các từ khoá phù hợp (ví dụ: 'năng lượng tái tạo', 'năng lượng thay thế', 'ưu, nhược điểm của thuỷ điện',...). Ghi chép kết quả tìm kiếm vào bảng gồm nội dung, địa chỉ trang web, nguồn gốc và thời gian để thuận tiện cho việc đánh giá và trích dẫn tham khảo."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "skill_name": "Đánh giá chất lượng và độ tin cậy của thông tin", "skill_description": "Xem xét tính phù hợp của thông tin đối với mục tiêu trình bày và kiểm tra nguồn gốc phát hành (ưu tiên các cổng thông tin chính phủ, tổ chức chuyên ngành uy tín hơn các diễn đàn mở)."}, {"grade_level": "Lớp 8", "lesson_id": "Nhiệm vụ 3", "skill_name": "Tạo và biên tập bài trình chiếu", "skill_description": "Thực hiện tạo các trang trình chiếu theo dàn ý, soạn thảo nội dung phù hợp với lập luận và đưa dữ liệu thống kê, bảng biểu vào trang nội dung."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "skill_name": "Biên tập nội dung và chia sẻ bài trình chiếu", "skill_description": "Thực hiện cô đọng nội dung trang trình chiếu (tối đa 6 mục/trang, mỗi mục tối đa 2 dòng), sử dụng phần mềm xử lý hình ảnh minh họa và lựa chọn phương tiện số an toàn để chia sẻ bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "skill_name": "Nhận diện hành vi vi phạm đạo đức và pháp luật trên môi trường số", "skill_description": "Phân tích các tình huống thực tế để xác định hành vi nào vi phạm hoặc không vi phạm pháp luật, từ đó rút ra bài học kinh nghiệm phòng tránh cho bản thân khi sử dụng công nghệ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "skill_name": "Đánh giá tính hợp pháp và đạo đức của hành vi trên không gian mạng", "skill_description": "Phân tích các tình huống thực tế để xác định hành vi có vi phạm đạo đức, pháp luật hay văn hoá khi sử dụng công nghệ kĩ thuật số hay không."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "skill_name": "Tạo và trình bày bảng tính quản lý dữ liệu thực tế", "skill_description": "Sử dụng phần mềm bảng tính để nhập liệu, tổ chức bảng dữ liệu tính toán doanh thu sản phẩm."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "skill_name": "Viết và sao chép công thức chứa địa chỉ tương đối", "skill_description": "Thực hiện nhập công thức tính toán sử dụng địa chỉ ô (ví dụ =C4*D4) và kéo thả sao chép công thức xuống các ô bên dưới trong bảng tính Excel."}, {"grade_level": "Lớp 8", "lesson_id": "Bài", "skill_name": "Sử dụng địa chỉ tuyệt đối trong công thức bảng tính", "skill_description": "Thực hiện nhập công thức có chứa địa chỉ tuyệt đối bằng cách sử dụng dấu $ trước tên cột và tên hàng, hoặc sử dụng phím F4 để chuyển đổi địa chỉ ô khi lập bảng tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "skill_name": "Sử dụng địa chỉ tuyệt đối và tương đối trong bảng tính", "skill_description": "Thực hiện tạo bảng dữ liệu, lập công thức sử dụng kết hợp địa chỉ tương đối và tuyệt đối để tính Doanh thu của mỗi phần mềm và Doanh thu của công ti trên phần mềm Microsoft Excel."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "skill_name": "Sao chép bảng dữ liệu từ tệp văn bản/trình chiếu sang bảng tính", "skill_description": "1. Trong phần mềm soạn thảo văn bản hoặc phần mềm trình chiếu, chọn các hàng, cột của bảng.\n2. Chọn thẻ Home, chọn lệnh Copy hoặc nhấn tổ hợp phím Ctrl + C.\n3. Trong phần mềm bảng tính, mở bảng tính mới, chọn ô ở góc trên cùng bên trái của vùng muốn dán dữ liệu và chọn lệnh Paste.\n4. Đóng tệp văn bản hoặc tệp trình chiếu.\n5. Lưu tệp bảng tính với tên Khaosat.xlsx."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "skill_name": "Sắp xếp dữ liệu theo một tiêu chí", "skill_description": "Thực hiện chọn vùng dữ liệu cần sắp xếp, mở hộp thoại Sort trong thẻ Data, chọn cột tiêu chí sắp xếp (ví dụ cột Tên) và thiết lập thứ tự sắp xếp (A to Z) để tổ chức lại dữ liệu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "skill_name": "Sắp xếp dữ liệu theo nhiều tiêu chí trong Excel", "skill_description": "Thao tác mở hộp thoại Sort, sử dụng nút lệnh Add level để thêm tiêu chí sắp xếp phụ (Họ đệm) khi tiêu chí chính (Tên) bị trùng giá trị."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Sắp xếp dữ liệu theo nhiều tiêu chí", "skill_description": "Thực hiện sắp xếp bảng dữ liệu theo thứ tự ưu tiên nhiều cột khác nhau (như sắp xếp theo tên, sau đó sắp xếp theo họ đệm)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Lọc dữ liệu trên bảng tính", "skill_description": "Sử dụng công cụ Filter trong thẻ Data để chọn và hiển thị các dòng dữ liệu thỏa mãn điều kiện mong muốn, biết cách bỏ lọc bằng lệnh Select All."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "skill_name": "Sắp xếp dữ liệu đa tiêu chí trong Excel", "skill_description": "Thực hiện sắp xếp bảng dữ liệu theo thứ tự giá trị giảm dần của một cột hoặc kết hợp nhiều tiêu chí sắp xếp khác nhau."}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "skill_name": "Lọc dữ liệu với Number Filters", "skill_description": "Sử dụng tính năng lọc nâng cao Number Filters trên bảng tính điện tử để lọc ra các dòng dữ liệu thỏa mãn điều kiện số học cụ thể."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Nhận xét và so sánh trực quan dữ liệu", "skill_description": "Quan sát và so sánh cách trình bày dữ liệu giữa bảng số liệu và biểu đồ cột để thấy được tính trực quan, ưu điểm của biểu đồ trong việc so sánh nhanh chóng các số liệu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Tạo biểu đồ cột trong bảng tính điện tử", "skill_description": "Thực hiện khởi động phần mềm bảng tính, nhập dữ liệu, chọn vùng dữ liệu (B2:C8), vào thẻ Insert -> nhóm lệnh Charts -> chọn Insert Column or Bar Chart -> chọn kiểu 2-D Column (Clustered Column) để tạo biểu đồ cột so sánh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Thao tác với Chart Elements trên biểu đồ Excel", "skill_description": "Sử dụng nút lệnh Chart Elements để thêm bớt các thành phần như tiêu đề, nhãn dữ liệu, chú giải cho biểu đồ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Tạo biểu đồ hình quạt tròn (Pie Chart)", "skill_description": "Chọn vùng dữ liệu, sử dụng thẻ Insert để chèn biểu đồ hình quạt tròn và định dạng nhãn dữ liệu dạng phần trăm."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Sử dụng hàm SUM tính tổng dữ liệu", "skill_description": "Mở tệp bảng tính, sử dụng hàm SUM để tính tổng số học sinh sử dụng thiết bị số trong các khoảng thời gian."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Vẽ và chỉnh sửa biểu đồ cột và hình quạt tròn", "skill_description": "Thực hiện chọn vùng dữ liệu để vẽ biểu đồ cột thể hiện số học sinh hoặc biểu đồ hình quạt tròn thể hiện tỉ lệ phần trăm, thêm nhãn dữ liệu (Data Label)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "skill_name": "Tạo bảng dữ liệu từ biểu đồ", "skill_description": "Quan sát biểu đồ cột có sẵn để xây dựng lại bảng dữ liệu tương ứng trong phần mềm bảng tính."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "skill_name": "Tạo và trình bày danh sách dạng liệt kê", "skill_description": "Thực hiện các thao tác tạo danh sách dạng liệt kê để trình bày các mục thông tin một cách khoa học, tiết kiệm thời gian và tránh nhầm lẫn."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "skill_name": "Sử dụng danh sách dạng liệt kê", "skill_description": "Thao tác tạo, thêm, bớt và định dạng danh sách dấu đầu dòng (bullet) và danh sách có thứ tự (numbered list) trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "skill_name": "Chèn và chỉnh sửa hình ảnh trong văn bản", "skill_description": "Thực hiện chèn hình ảnh vào văn bản, thay đổi kích thước, vị trí và xoá bỏ hình ảnh khi cần thiết bằng phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "skill_name": "Vẽ hình đồ hoạ trong văn bản", "skill_description": "Sử dụng các mẫu hình đồ hoạ và công cụ vẽ hình có sẵn trong phần mềm soạn thảo văn bản để minh hoạ nội dung."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "skill_name": "Khởi động phần mềm và nhập nội dung", "skill_description": "Nháy đúp chuột vào biểu tượng phần mềm trên màn hình nền, nhập nội dung văn bản theo mẫu, sử dụng lệnh Insert/Symbol để nhập kí hiệu ô vuông."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "skill_name": "Tạo danh sách có thứ tự", "skill_description": "Chọn các đoạn văn bản muốn tạo danh sách có thứ tự, chọn thẻ Home, nháy chuột vào mũi tên cạnh lệnh Numbering và chọn kiểu danh sách phù hợp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "skill_name": "Lưu tệp văn bản", "skill_description": "Thực hiện thao tác chọn lệnh File/Save để lưu trữ tệp văn bản với tên chỉ định."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "skill_name": "Chèn và định dạng lớp ảnh trong phần mềm soạn thảo", "skill_description": "Thực hiện chèn hình ảnh bằng lệnh Insert/Picture, sử dụng tính năng Wrap Text (Behind Text) để sắp xếp thứ tự các lớp đối tượng (ảnh nền nằm dưới, văn bản nằm trên) và điều chỉnh kích thước ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "skill_name": "Thêm và thay đổi màu sắc hình đồ hoạ", "skill_description": "Thực hiện các thao tác chọn Insert, Shapes, chọn mẫu hình mũi tên, vẽ trên trang giấy và sử dụng Shape Fill để đổi màu sắc đối tượng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "skill_name": "Định dạng vị trí hình ảnh với văn bản", "skill_description": "Sử dụng lệnh Wrap Text chọn kiểu Square để bố trí hình ảnh hợp lý trong trang văn bản / tờ rơi."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "skill_name": "Nhận biết các thành phần đầu trang và chân trang trong tài liệu", "skill_description": "Quan sát, phân tích và so sánh các trang văn bản để nhận diện sự khác biệt khi có hoặc không có đầu trang và chân trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "skill_name": "Đánh số trang văn bản", "skill_description": "Thực hiện chèn và lựa chọn vị trí đặt số trang tự động ở đầu trang hoặc chân trang trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "skill_name": "Đánh số trang, thêm đầu trang và chân trang", "skill_description": "Thực hiện mở tệp văn bản, chọn thẻ Insert và sử dụng các lệnh Header, Footer, Page Number trong nhóm lệnh Header & Footer để bổ sung thông tin đầu trang, chân trang và đánh số trang cho văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "skill_name": "Đánh số trang và thêm đầu trang, chân trang", "skill_description": "Thực hiện các thao tác chọn Page Number để đánh số trang, chọn Header/Footer để nhập thông tin đầu trang và chân trang trong phần mềm soạn thảo văn bản."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "skill_name": "Soạn thảo và tóm tắt văn bản trên trang chiếu", "skill_description": "Thực hiện chắt lọc thông tin chi tiết từ tài liệu văn bản thành các ý ngắn gọn, súc tích để trình bày trên trang chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "skill_name": "Định dạng màu sắc và bố trí thông tin chân trang", "skill_description": "Thực hiện phối màu hợp lí cho trang chiếu và thêm số trang, đầu trang, chân trang vào bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Khởi động phần mềm trình chiếu và nhập nội dung", "skill_description": "Thực hiện mở ứng dụng Microsoft PowerPoint, chọn các mẫu Slide Layout (Title Slide, Title and Content) và nhập nội dung văn bản theo mẫu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Định dạng văn bản trên trang chiếu", "skill_description": "Thao tác chọn phông chữ Arial, tùy chỉnh cỡ chữ (60, 54, 32), màu sắc, kiểu chữ in đậm, căn lề và thay đổi vị trí hộp văn bản để bố cục cân đối."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Đánh số trang, thêm Header & Footer", "skill_description": "Sử dụng tính năng Insert / Header & Footer hoặc Slide Number trong phần mềm PowerPoint để đánh số trang và chèn tiêu đề đầu chân trang."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10a", "skill_name": "Đánh số trang và thêm đầu trang, chân trang trong PowerPoint", "skill_description": "Thao tác trên thanh công cụ chọn Insert -> Header & Footer, cấu hình các thông số ngày tháng, số trang, chân trang trong hộp thoại Header and Footer và áp dụng cho trang chiếu hoặc tài liệu in (Notes and Handouts)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Hoàn thiện và lưu bài trình chiếu", "skill_description": "Thực hiện áp dụng mẫu định dạng, tạo danh sách dấu đầu dòng và lưu tệp trình chiếu với tên định sẵn bằng lệnh File/Save."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "skill_name": "Sử dụng bản mẫu có sẵn (Template) trong phần mềm trình chiếu", "skill_description": "Thực hiện thao tác chọn File/New, tìm kiếm và lựa chọn bản mẫu theo chủ đề Education (như Lab Safety) để tạo nhanh bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11a", "skill_name": "Chỉnh sửa và hoàn thiện bài trình chiếu", "skill_description": "Thực hiện thay đổi phông chữ, cỡ chữ, màu nền, thêm bớt trang chiếu và nhập nội dung theo gợi ý của bản mẫu để hoàn thành bài trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "skill_name": "Chèn đường dẫn đến tệp video trong trình chiếu", "skill_description": "Thực hiện chọn đối tượng hình ảnh trên trang chiếu, chọn Insert/Links/Link, tìm và chọn tệp video cần liên kết trong cửa sổ Insert Hyperlink để mở video trong khi trình chiếu."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "skill_name": "Xác định nhu cầu chỉnh sửa ảnh", "skill_description": "Thực hiện liệt kê các yêu cầu muốn làm thay đổi một bức ảnh và xác định phần mềm ứng dụng hỗ trợ."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "skill_name": "Khởi động và làm quen giao diện GIMP", "skill_description": "Nháy đúp chuột vào biểu tượng GIMP trên màn hình nền để khởi động phần mềm, quan sát và nhận biết các khu vực chức năng trên giao diện."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8b", "skill_name": "Mở tệp ảnh và đọc thông tin ảnh", "skill_description": "Thực hiện thao tác chọn File/Open để mở tệp ảnh từ máy tính; sử dụng lệnh Image/Image Properties để mở cửa sổ xem các thông số kỹ thuật của ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "skill_name": "Cắt hình ảnh", "skill_description": "Sử dụng công cụ cắt (Crop) để loại bỏ các chi tiết không hợp lí, tạo bố cục chặt chẽ cho bức ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "skill_name": "Xoay hình ảnh", "skill_description": "Sử dụng công cụ xoay (Rotate) để khắc phục tình trạng ảnh bị nghiêng, không đúng hướng."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9b", "skill_name": "Cắt ảnh với công cụ Crop", "skill_description": "Thực hiện chọn công cụ Crop trên thanh công cụ, kéo thả chuột trên bức ảnh để bao quanh vùng ảnh cần giữ lại, sau đó nhấn phím Enter để xác nhận cắt ảnh và lưu lại tệp với định dạng .xcf."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Điều chỉnh độ sáng và độ tương phản của ảnh", "skill_description": "Thực hiện các thao tác trên phần mềm xử lí ảnh để thay đổi mức độ sáng/tối tổng thể và tăng/giảm độ tương phản nhằm khắc phục các bức ảnh quá sáng, quá tối hoặc làm nổi bật các chi tiết, chủ thể."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Sử dụng công cụ làm mờ và làm sắc nét (Blur, Sharpen)", "skill_description": "Thao tác chọn công cụ làm mờ hoặc làm sắc nét trên phần mềm xử lí ảnh để làm mờ phông nền hoặc làm nổi bật các đối tượng cụ thể trong bức ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Chèn văn bản vào ảnh", "skill_description": "Thực hiện chọn công cụ chèn văn bản, nháy chuột vào vị trí cần chèn, nhập nội dung chữ 'Vườn hồng' và định dạng văn bản trên ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Điều chỉnh độ mờ và hiệu ứng ảnh", "skill_description": "Sử dụng các công cụ làm mờ, điều chỉnh độ sáng, độ tương phản để làm nổi bật đối tượng chính trong ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "skill_name": "Điều chỉnh độ sáng và độ tương phản ảnh", "skill_description": "Thao tác trên hộp thoại Brightness-Contrast để thay đổi thông số ánh sáng và độ tương phản của ảnh số bằng phần mềm GIMP."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "skill_name": "Làm mờ và làm sắc nét vùng ảnh với Brush", "skill_description": "Sử dụng công cụ cọ vẽ kết hợp hiệu ứng Blur/Sharpen để xử lý chi tiết các vùng ảnh cục thể."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "skill_name": "Tập hợp và quản lý tài nguyên ảnh", "skill_description": "Thu thập và tổ chức các tệp ảnh đã chỉnh sửa vào một thư mục chung để chuẩn bị cho bài thực hành tổng hợp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "skill_name": "Thao tác với lớp (Layer) trong phần mềm GIMP", "skill_description": "Thực hiện tạo lớp mới qua lệnh Layer/New Layer, đặt tên lớp, quản lý thứ tự các lớp và ẩn/hiện lớp bằng biểu tượng con mắt trong cửa sổ Layer."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "skill_name": "Sử dụng công cụ Gradient", "skill_description": "Thực hiện chọn công cụ Gradient, thiết lập màu vẽ, màu nền và kéo thả chuột để tạo hiệu ứng chuyển màu cho lớp ảnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "skill_name": "Quản lý và trộn các lớp ảnh trong GIMP", "skill_description": "Sắp xếp thứ tự các lớp trong cửa sổ Layers, thay đổi kích thước lớp bằng công cụ Scale, trộn lớp bằng lệnh Layer/Merge Down và xuất tệp ảnh bằng File/Export As."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "skill_name": "Ghép ảnh vào tờ rơi, thêm văn bản và hoàn thiện sản phẩm bằng GIMP", "skill_description": "Thực hiện các thao tác: Chọn một ảnh làm nền tờ rơi; Chèn các ảnh đã tạo khung viền vào ảnh nền bằng lệnh File/Open as Layers (mỗi ảnh là một lớp); Dùng công cụ Move để di chuyển ảnh, Scale để chỉnh kích thước, Text để thêm văn bản, Rotate để xoay ảnh; Dùng các công cụ tăng độ sáng, tối, tương phản nếu cần; Xuất ảnh hoàn thiện bằng lệnh File/Export As với tên SchoolTour.jpg."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "skill_name": "Xác định góc quay và các bước thuật toán", "skill_description": "Xác định góc quay của nhân vật khi đi hết một cạnh và liệt kê lần lượt các bước của thuật toán điều khiển nhân vật bằng ngôn ngữ tự nhiên."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "skill_name": "Tạo chương trình điều khiển máy tính thực hiện thuật toán", "skill_description": "Thực hiện tạo chương trình điều khiển nhân vật di chuyển theo đường đi là một tam giác đều dựa trên sơ đồ khối thuật toán."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "skill_name": "Lập trình điều khiển nhân vật vẽ hình tam giác đều trong Scratch", "skill_description": "Sử dụng nhóm lệnh Bút vẽ (Bút vẽ mở rộng) kết hợp nhóm lệnh Điều khiển (vòng lặp 'lặp lại', lệnh 'đợi') và nhóm Chuyển động (di chuyển, xoay góc) để lập trình nhân vật di chuyển và vẽ thành hình tam giác đều, sau đó lưu tệp với tên VeHinh.sb3."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "skill_name": "Sử dụng phép toán với các kiểu dữ liệu trong Scratch", "skill_description": "Thực hiện kết hợp các khối lệnh phép toán tương ứng với kiểu số, xâu kí tự và lôgic để tạo ra biểu thức điều kiện hoặc giá trị tính toán trong chương trình Scratch."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "skill_name": "Sử dụng hằng, biến, biểu thức trong Scratch", "skill_description": "Thực hành mở tệp chương trình, bổ sung câu lệnh, tạo các biến n, số bước, góc quay và cập nhật chương trình để điều khiển nhân vật di chuyển theo hình đa giác đều với số cạnh nhập từ bàn phím."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "skill_name": "Tạo và sử dụng biến trong Scratch", "skill_description": "Thực hiện các thao tác nháy chuột vào nhóm lệnh 'Các biến số', tạo biến mới, kéo thả các biến vào vị trí tương ứng trong câu lệnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "skill_name": "Xây dựng biểu thức toán học trong Scratch", "skill_description": "Sử dụng nhóm lệnh 'Các phép toán' để tạo các biểu thức tính toán giá trị như chu vi, diện tích hình tròn, hoặc tính toán góc quay, số bước di chuyển cho nhân vật."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Biểu diễn cấu trúc tuần tự trong Scratch", "skill_description": "Sử dụng các khối lệnh trong môi trường lập trình trực quan Scratch để xây dựng chương trình theo cấu trúc tuần tự."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Sử dụng cấu trúc lặp trong Scratch", "skill_description": "Nhận biết và sử dụng đúng các khối lệnh lặp với số lần định trước, lặp vô hạn, và lặp có điều kiện kết thúc để giải quyết các bài toán lập trình."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Lập trình trò chơi đoán số trên Scratch", "skill_description": "Thực hiện tạo biến mới, sử dụng nhóm lệnh Cảm biến, ghép nối các khối lệnh theo cấu trúc tuần tự, lặp lại và rẽ nhánh để hoàn thiện trò chơi đoán số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Lập trình hoàn chỉnh trò chơi đoán số trong Scratch", "skill_description": "Thực hiện lắp ráp các khối lệnh rẽ nhánh, cảm biến và vòng lặp để tạo thành chương trình hoàn chỉnh."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Phân tích và ghép nối đoạn lệnh với hình vẽ", "skill_description": "Nhận diện số lần lặp và góc quay trong khối lệnh lập trình để suy ra hình học kết quả (tam giác, tứ giác, ngũ giác, lục giác)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Lắp ráp và hoàn chỉnh chương trình Scratch giải phương trình bậc nhất", "skill_description": "Thực hiện ghép các khối lệnh a, b, c, d vào các vị trí 1, 2, 3, 4 trong Hình 14.8 để tạo thành chương trình Scratch hoàn chỉnh giải phương trình ax + b = 0."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "skill_name": "Xây dựng chương trình tính ước chung lớn nhất bằng Scratch", "skill_description": "Chuyển đổi sơ đồ khối thuật toán tìm ƯCLN (Hình 14.9) thành các khối lệnh Scratch (Hình 14.10) theo đúng thứ tự logic để tạo ra chương trình chạy thực tế."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "skill_name": "Kiểm thử chương trình", "skill_description": "Thực hiện chạy thử chương trình trên phần mềm lập trình để kiểm tra sự phù hợp với kịch bản và phát hiện các tình huống bất thường (lỗi)."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "skill_name": "Chạy thử và gỡ lỗi chương trình", "skill_description": "Thực hiện chạy thử chương trình, quan sát kết quả thực tế so với kịch bản, phân tích biến và các khối lệnh để phát hiện, sửa chữa lỗi lôgic."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "skill_name": "Phát hiện và sửa lỗi lôgic trong chương trình Scratch", "skill_description": "Thực hiện phân tích lôgic, sử dụng tính năng hiển thị giá trị biến trực quan trên màn hình và chèn lệnh tạm dừng để theo dõi từng bước chạy của chương trình, từ đó định vị câu lệnh sai và bổ sung lệnh sửa lỗi phù hợp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "skill_name": "Kiểm thử và gỡ lỗi chương trình Scratch", "skill_description": "Thực hiện chạy thử chương trình, nhập các bộ dữ liệu kiểm thử, so sánh kết quả thực tế với kết quả mong đợi để phát hiện lỗi và sửa đổi các khối lệnh cho phù hợp."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "skill_name": "Sửa lỗi chương trình Scratch", "skill_description": "Thực hành phát hiện lỗi logic trong các khối lệnh điều kiện, vòng lặp và câu lệnh hiển thị, sau đó kéo thả, điều chỉnh lại các khối lệnh cho phù hợp với yêu cầu của bài toán đoán số."}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "skill_name": "Phân tích và đánh giá ứng dụng tin học trong đời sống", "skill_description": "Biết liên hệ thực tế các ứng dụng của tin học trong công việc chuyên môn của các ngành nghề như bác sĩ, giáo viên, kiến trúc sư, kế toán, nhà báo."}, {"grade_level": "Lớp 9", "lesson_id": "HDSD", "skill_name": "Khai thác và sử dụng sách giáo khoa hiệu quả", "skill_description": "Nhận diện đúng các biểu tượng chức năng để thực hiện tuần tự các hoạt động: Khởi động, Khám phá kiến thức mới, Tóm tắt ghi nhớ, Trả lời câu hỏi, Luyện tập và Vận dụng."}, {"grade_level": "Lớp 9", "lesson_id": "Mục lục", "skill_name": "Tra cứu tài liệu học tập", "skill_description": "Sử dụng trang mục lục để tìm kiếm nhanh chóng các bài học, chủ đề, nội dung lý thuyết và thực hành trong sách giáo khoa."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "skill_name": "Khai thác thông tin trên Internet", "skill_description": "Sử dụng máy tính hoặc thiết bị số kết nối Internet để tìm kiếm tài liệu học tập, tra cứu thông tin y tế, giao thông và sử dụng các dịch vụ số thiết yếu hằng ngày."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "skill_name": "Đánh giá chất lượng thông tin", "skill_description": "Phân tích, đánh giá độ tin cậy, tính mới, tính chính xác, tính đầy đủ và tính sử dụng được của thông tin thu thập được từ Internet phục vụ cho việc ra quyết định."}, {"grade_level": "Lớp 9", "lesson_id": "Bài", "skill_name": "Đánh giá chất lượng thông tin", "skill_description": "Thực hiện tìm kiếm và lựa chọn thông tin hữu ích giúp chọn trường THPT, phân tích lý do thông tin đó hữu ích đối với việc giải quyết vấn đề chọn trường."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 3", "skill_name": "Tìm kiếm thông tin theo mục đích, yêu cầu", "skill_description": "Xác định mục đích và từ khoá tìm kiếm, sử dụng máy tìm kiếm trên Internet để thu thập thông tin về các trường THPT tại địa phương và lưu trữ lại kết quả tìm được."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Sử dụng công cụ hội thoại thông minh để tìm kiếm thông tin", "skill_description": "Biết cách đặt câu hỏi, đưa ra yêu cầu cụ thể cho công cụ hội thoại thông minh tích hợp trí tuệ nhân tạo để khoanh vùng và thu thập thông tin chính xác."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Đánh giá và kiểm chứng độ tin cậy của thông tin trên Internet", "skill_description": "Xác định nguồn gốc thông tin, kiểm tra tính thẩm quyền của website (ví dụ đuôi .edu.vn của cơ quan quản lý giáo dục) và đối chiếu thông tin trước khi sử dụng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Thực hành đánh giá và lựa chọn thông tin", "skill_description": "Thực hành tìm kiếm thông tin trên Internet về các môn học ở bậc THPT và lập dự kiến chọn các môn học yêu thích. Tạo bài trình chiếu về chủ đề 'Chọn môi trường học tập sau khi kết thúc bậc THCS'."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "skill_name": "Thảo luận và phân tích tác động công nghệ", "skill_description": "Thảo luận với bạn bè để nhận diện, phân tích các tác động tiêu cực của công nghệ kĩ thuật số đối với đời sống con người và xã hội."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "skill_name": "Kỹ năng nhận diện và phòng tránh hành vi tiêu cực trên không gian mạng", "skill_description": "Phân biệt được các hành vi vi phạm pháp luật, trái đạo đức hoặc lừa đảo trực tuyến để từ chối tham gia và có cách ứng xử phù hợp."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 5", "skill_name": "Sử dụng phần mềm mô phỏng pha màu trực tuyến", "skill_description": "Truy cập trang web mô phỏng pha màu (như trycolour.com), lựa chọn và thay đổi tỉ lệ các màu sắc khác nhau, tương tác với giao diện phần mềm để quan sát kết quả màu tạo ra."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "skill_name": "Sử dụng phần mềm mô phỏng thí nghiệm", "skill_description": "Thực hiện tương tác với các đối tượng ảo trên phần mềm như kéo thả linh kiện lắp mạch điện hoặc thay đổi màu sắc trong phần mềm pha màu để quan sát kết quả."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "skill_name": "Mở và thiết lập phần mềm mô phỏng PhET", "skill_description": "Khởi động trình duyệt web, truy cập trang web phet.colorado.edu, chọn ngôn ngữ hiển thị là tiếng Việt, chọn lĩnh vực Hoá học và mở nội dung mô phỏng 'Các dạng và sự chuyển hoá năng lượng'."}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "skill_name": "Tương tác phần mềm mô phỏng năng lượng", "skill_description": "Thay đổi các nguồn năng lượng, thiết bị chuyển hoá và thiết bị tiêu thụ trên phần mềm mô phỏng để quan sát sự chuyển hoá năng lượng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài thực hành", "skill_name": "Lắp ráp mạch điện một chiều và đo cường độ dòng điện", "skill_description": "Truy cập phòng thí nghiệm ảo, kéo thả các thiết bị (Pin, Đèn tròn, Ampe kế, Công tắc, Dây nối) vào vùng hiển thị, kết nối mạch điện đúng kỹ thuật và mắc nối tiếp Ampe kế để đo cường độ dòng điện."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "skill_name": "Sử dụng phần mềm Geometer's Sketchpad mở tệp dữ liệu hình học", "skill_description": "Khởi động phần mềm Geometer's Sketchpad, mở tệp TyLeVang.gsp bằng cách chọn File/Open hoặc nhấn tổ hợp phím Ctrl + O và chọn tệp. Di chuyển ngôi sao bằng cách chọn đỉnh hoặc cạnh và kéo thả chuột, điều chỉnh kích thước bằng cách kéo thả điểm P hoặc điểm Q."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Đo độ dài đoạn thẳng trên phần mềm mô phỏng", "skill_description": "Sử dụng công cụ chọn đối tượng và lệnh Measure/Length trong Geometer's Sketchpad để đo độ dài các đoạn thẳng hình học."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "skill_name": "Tính toán giá trị và biểu thức trên phần mềm", "skill_description": "Sử dụng tính năng Measure/Calculate (hoặc phím tắt Alt + =) để thiết lập và tính tỉ lệ các đoạn thẳng trên phần mềm mô phỏng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 7", "skill_name": "Sử dụng sơ đồ tư duy và bài trình chiếu", "skill_description": "Thực hiện sử dụng sơ đồ tư duy hoặc bài trình chiếu để trình bày trực tiếp thông tin trong hoạt động nhóm và trao đổi hợp tác."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Trang 28)", "skill_name": "Sử dụng bài trình chiếu và sơ đồ tư duy trong trao đổi và hợp tác", "skill_description": "Thực hiện trình bày trực tiếp, chia sẻ để các thành viên khác xem độc lập, cập nhật độc lập hoặc cộng tác theo thời gian thực; áp dụng nguyên tắc sử dụng đúng công cụ trực quan và đảm bảo chất lượng dữ liệu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "skill_name": "Tạo sơ đồ tư duy đính kèm tệp", "skill_description": "Thực hành khởi động phần mềm MindMaple Lite, tạo sơ đồ tư duy mới, lưu tệp với tên LuocSu.emm và sử dụng chức năng Insert/Attachment để đính kèm các tệp bảng tính, hình ảnh, văn bản vào các nhánh tương ứng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "skill_name": "Đính kèm tệp vào sơ đồ tư duy", "skill_description": "Thao tác chọn nhánh, sử dụng tính năng Attachment để mở hộp thoại chọn tệp tin từ máy tính và đính kèm vào sơ đồ tư duy."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "skill_name": "Chèn đường liên kết vào sơ đồ tư duy", "skill_description": "Thao tác chọn nhánh, sử dụng lệnh Insert/Hyperlink và dán đường dẫn URL vào hộp thoại để liên kết sơ đồ với video hoặc trang web trên Internet."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "skill_name": "Trình bày sơ đồ tư duy", "skill_description": "Thực hiện thuyết trình sơ đồ tư duy trước nhóm, điều phối thảo luận và tiếp thu góp ý để hoàn thiện nội dung."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "skill_name": "Tạo bài trình chiếu đa phương tiện", "skill_description": "Sử dụng phần mềm trình chiếu để tạo trang tiêu đề, trang dàn ý và sắp xếp hợp lí hình ảnh, sơ đồ, video minh họa cho chủ đề lịch sử phát triển công cụ tính toán."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Xây dựng cấu trúc bảng tính quản lí tài chính", "skill_description": "Thiết kế và xác định các khoản mục thu, chi trong bảng tính điện tử nhằm phục vụ bài toán quản lí tài chính gia đình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Sử dụng công cụ xác thực dữ liệu Data Validation", "skill_description": "Thực hiện cấu hình giới hạn dữ liệu nhập vào ô tính bằng cách tạo danh sách chọn (List) hoặc thiết lập điều kiện kiểu số lớn hơn 0 để hạn chế sai sót khi nhập liệu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Sử dụng công cụ Data Validation trong Excel", "skill_description": "Thực hiện mở dải lệnh Data, chọn Data Validation trong nhóm Data Tools, cấu hình các tiêu chuẩn xác thực dữ liệu tại thẻ Settings để kiểm soát dữ liệu đầu vào trong ô tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Tạo trang tính và nhập dữ liệu khoản chi", "skill_description": "Khởi động phần mềm bảng tính, đặt tên trang tính hiện hành là Chi tiêu, tạo bảng và nhập dữ liệu khoản chi (cột F)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Sử dụng công cụ xác thực dữ liệu thuộc danh sách cho trước", "skill_description": "Chọn các ô của cột B để nhập dữ liệu thoả mãn điều kiện xác thực từ B3 đến B10. Trong nhóm lệnh Data Tools của dải lệnh Data, chọn Data Validation để mở hộp thoại Data Validation."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Tạo danh sách thả xuống bằng Data Validation", "skill_description": "Chọn vùng dữ liệu cần áp dụng, vào Data / Data Tools / Data Validation, chọn thẻ Settings, đặt Allow là List và chỉ định vùng nguồn tại Source rồi nhấn OK."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Giới hạn giá trị số lớn hơn 0 trong bảng tính", "skill_description": "Chọn trang tính Chi tiêu, chọn vùng dữ liệu D3:D10, mở hộp thoại Data Validation, thiết lập điều kiện Whole number lớn hơn 0 để kiểm soát dữ liệu nhập vào hợp lệ."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "skill_name": "Thiết lập thông báo hướng dẫn và cảnh báo lỗi trong Data Validation", "skill_description": "Thực hiện nhập nội dung thông báo trong thẻ Input Message và Error Alert để hỗ trợ người dùng nhập đúng dữ liệu vào bảng tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "skill_name": "Sử dụng hàm COUNTIF trong bảng tính", "skill_description": "Thực hiện nhập công thức hàm COUNTIF vào bảng tính điện tử để đếm số lần xuất hiện của các khoản chi theo điều kiện."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "skill_name": "Thực hành sử dụng hàm COUNTIF", "skill_description": "Thao tác nhập công thức hàm COUNTIF với các tham số vùng dữ liệu cố định ($B$3:$B$10) và điều kiện tham chiếu ô hoặc chuỗi trực tiếp trên phần mềm bảng tính Excel."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "skill_name": "Sao chép công thức", "skill_description": "Thực hiện sao chép công thức tính toán từ một ô sang các ô khác trong bảng tính điện tử."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "skill_name": "Sử dụng hàm COUNTIF trong thực tế", "skill_description": "Áp dụng hàm COUNTIF để tổng hợp dữ liệu khảo sát, đếm số lượng theo điều kiện cho trước."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "skill_name": "Sử dụng hàm SUMIF trong bảng tính", "skill_description": "Thực hiện nhập công thức hàm SUMIF với các tham số range, criteria, sum_range để tính tổng theo điều kiện trên trang tính Excel."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "skill_name": "Xây dựng công thức bảng tính với hàm IF", "skill_description": "Thực hiện viết công thức sử dụng hàm IF tại các ô trong cột M và cột N của bảng dữ liệu Excel để tổng hợp và đánh giá tình hình chi tiêu theo quy tắc tài chính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12", "skill_name": "Sử dụng hàm IF lồng nhau trong Excel", "skill_description": "Thực hiện nhập công thức chứa nhiều hàm IF lồng nhau vào các ô tính để phân loại và đưa ra nhận xét dữ liệu theo nhiều mức điều kiện khác nhau."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "skill_name": "Tạo bảng dữ liệu và bổ sung cột trong Excel", "skill_description": "Thực hiện mở tệp bảng tính TaiChinhGiaDinh.xlsx, chọn trang tính Chi tiêu, bổ sung tiêu đề cột 'Mục chi' và tạo bảng dữ liệu tổng hợp mục chi trong vùng K1:O5."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "skill_name": "Sử dụng hàm SUMIF để tính tổng theo điều kiện", "skill_description": "Nhập công thức hàm SUMIF với tham chiếu địa chỉ ô tuyệt đối và tương đối (ví dụ: =SUMIF($I$2:$I$10,K3,$H$2:$H$10)) tại ô M3 để tính tổng chi phí theo từng mục chi tiêu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "skill_name": "Thiết kế và liên kết dữ liệu giữa các trang tính", "skill_description": "Thực hiện tạo trang tính tổng hợp và xây dựng công thức để liên kết, tính toán tổng thu, tổng chi từ các trang tính Thu nhập và Chi tiêu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "skill_name": "Nhận biết các thành phần cơ bản của video", "skill_description": "Phân biệt và kết hợp được các dạng thông tin gồm văn bản, hình ảnh, âm thanh và video để chuẩn bị tư liệu cho việc xây dựng sản phẩm truyền thông."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "skill_name": "Sử dụng phần mềm Video Editor", "skill_description": "Nhận biết giao diện, khởi động và áp dụng các chức năng cơ bản của phần mềm Video Editor để tạo và chỉnh sửa video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9", "skill_name": "Khởi động phần mềm Video Editor và tạo dự án mới", "skill_description": "Thực hiện nháy đúp chuột vào biểu tượng phần mềm Video Editor trên màn hình nền, sau đó nháy chuột vào 'New video project' để tạo dự án làm video mới và nhập tên dự án theo yêu cầu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "skill_name": "Sử dụng phần mềm Video Editor biên tập video", "skill_description": "Khởi động phần mềm Video Editor, mở dự án, nhập các tệp dữ liệu vào thư viện, đưa dữ liệu vào bàn dựng, sử dụng các nút điều khiển để xem video, thực hiện thao tác xóa bỏ dữ liệu khỏi bàn dựng và thư viện."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "skill_name": "Thu thập và tổ chức dữ liệu làm phim", "skill_description": "Thu thập các tệp video, hình ảnh, tài liệu về các sản phẩm dự án (như Sổ lưu niệm, Trường học xanh, Thành lập CLB Tin học), lưu trữ có hệ thống vào thư mục 'DuLieuMyVideo' trên máy tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Xây dựng kịch bản và chuẩn bị dữ liệu làm video", "skill_description": "Thực hiện việc lên ý tưởng, viết kịch bản phân đoạn, thu thập hình ảnh, video, âm thanh và tổ chức lưu trữ các tệp dữ liệu vào một thư mục trên máy tính để chuẩn bị đưa vào phần mềm dựng video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Dựng và biên tập video cơ bản", "skill_description": "Thực hiện nhập dữ liệu vào phần mềm, sắp xếp các đoạn video, hình ảnh, thêm hiệu ứng chuyển cảnh, phụ đề và xuất tập tin video hoàn chỉnh."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Lập ý tưởng và xây dựng kịch bản video", "skill_description": "Xác định chủ đề, nội dung từng phân đoạn, thời lượng, hiệu ứng và âm thanh cho video giới thiệu sản phẩm."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Tổ chức và quản lý thư mục dữ liệu dự án", "skill_description": "Tạo thư mục gốc và các thư mục con chuyên biệt để phân loại tệp âm thanh, hình ảnh, video phục vụ việc làm video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Nhập dữ liệu vào Video Editor", "skill_description": "Khởi động phần mềm Video Editor, mở dự án đã tạo và nhập các tệp video, hình ảnh từ thư mục dữ liệu vào thư viện dự án."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Dựng video và tạo tiêu đề", "skill_description": "Thực hiện thêm tiêu đề (Add title card), nhập nội dung văn bản, lựa chọn kiểu hiển thị, định dạng vị trí và sử dụng các nút điều khiển để xem trước đoạn video tiêu đề."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "skill_name": "Cắt ngắn đoạn video (Trim video)", "skill_description": "Thao tác chọn đoạn video trên bàn dựng, sử dụng công cụ Trim, điều chỉnh các con chạy để cắt bỏ phần thừa và giữ lại thời lượng theo kịch bản."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "skill_name": "Tạo đoạn hoạt hình từ hình ảnh và chỉnh sửa thời gian hiển thị", "skill_description": "Kéo thả hình ảnh vào bàn dựng và sử dụng công cụ Duration để thay đổi thời gian hiển thị của từng bức ảnh theo yêu cầu."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Thay đổi thời gian hiển thị ảnh trong đoạn phim", "skill_description": "Thực hiện chọn ảnh trên timeline và điều chỉnh thông số thời gian hiển thị của từng hình ảnh."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "skill_name": "Thêm hiệu ứng chuyển động Motion", "skill_description": "Thao tác chọn ảnh, mở bảng chọn Motion, chọn kiểu hiệu ứng chuyển động phù hợp (ví dụ Zoom in center) và xác nhận hoàn thành."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "skill_name": "Thêm và chỉnh sửa hiệu ứng ba chiều (3D effects) trong Video Editor", "skill_description": "Thực hiện chọn ảnh trong bàn dựng, nhấp vào nút 3D effects, chọn kiểu hiệu ứng ba chiều mong muốn (ví dụ: Butterflies), điều chỉnh khoảng thời gian hiển thị hiệu ứng trên video và nhấn hoàn thành."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "skill_name": "Chỉnh sửa âm lượng âm thanh trong video", "skill_description": "Thực hiện nháy chuột chọn Edit, mở bảng điều khiển âm thanh và kéo thanh trượt Volume để điều chỉnh mức âm lượng cho hiệu ứng âm thanh."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11", "skill_name": "Thêm và áp dụng bộ lọc (Filters)", "skill_description": "Chọn ảnh hoặc đoạn video trong bàn dựng, chọn nút Filters, lựa chọn mẫu bộ lọc phù hợp trong danh sách (như Iceberg, Sepia, Inky,...) và nháy Done để hoàn tất."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "skill_name": "Thêm nhạc nền có sẵn vào video", "skill_description": "Nháy chọn nút Background music ở phía trên bên phải giao diện, chọn một bản nhạc trong danh sách, điều chỉnh âm lượng và nhấn Done để xác nhận."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11b", "skill_name": "Thêm phụ đề vào video", "skill_description": "Chọn đoạn video quay cuốn sổ lưu niệm, chọn công cụ Text rồi định dạng phụ đề theo yêu cầu kịch bản."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "skill_name": "Đưa âm thanh vào video", "skill_description": "Thực hiện sử dụng chức năng Custom audio để đưa các tệp âm thanh từ máy tính vào dự án video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "skill_name": "Xử lý video nâng cao", "skill_description": "Thực hiện các thao tác xoay hướng video (Rotate), phân chia video (Split) và áp dụng mẫu định dạng video (Themes) trong phần mềm dựng video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "skill_name": "Thêm âm thanh (Custom audio) vào dự án video", "skill_description": "Chọn khung hình video trong bàn dựng, chọn Custom audio, nháy chuột chọn Add audio file và chọn tệp âm thanh từ thư mục lưu trữ. Điều chỉnh âm lượng, thiết lập hiệu ứng Fade in, Fade out."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "skill_name": "Thêm và tùy chỉnh âm thanh trong video", "skill_description": "Thực hiện thêm tệp âm thanh tùy chỉnh vào dự án video, thiết lập hiệu ứng âm thanh tăng dần (Fade in) và giảm dần (Fade out)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "skill_name": "Phân chia đoạn video (Split)", "skill_description": "Thực hiện thao tác cắt tách một đoạn video thành các đoạn nhỏ hơn bằng công cụ Split và chèn hình ảnh minh họa vào giữa các đoạn video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13", "skill_name": "Loại bỏ thanh màu đen trong video", "skill_description": "Nháy chuột chọn ảnh trong bàn dựng, chọn biểu tượng chứa lệnh Remove black bar hoặc Shrink to fit để tự động thay đổi kích thước ảnh vừa với khung hình."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13", "skill_name": "Chỉnh lại thời gian hiển thị dữ liệu", "skill_description": "Nháy nút phải chuột vào khung hình tiêu đề trong bàn dựng, chọn Edit, chọn Text, sau đó dùng chuột kéo thả con chạy bên phải để điều chỉnh thời gian hiển thị mong muốn."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "skill_name": "Điều chỉnh thời lượng tiêu đề video", "skill_description": "Thao tác trên thanh Text duration để thiết lập chính xác khoảng thời gian xuất hiện của dòng tiêu đề hoặc hình ảnh trong video."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "skill_name": "Xuất tệp video định dạng MP4", "skill_description": "Thực hiện lệnh Finish video, lựa chọn chất lượng tệp (High 1080p), chọn Export, đặt tên tệp là SanPhamTinHoc.mp4 và lưu vào máy tính."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "skill_name": "Phân tích và tìm giải pháp cho vấn đề thực tế", "skill_description": "Thực hiện phân tích các yếu tố đầu vào, chia nhỏ vấn đề và áp dụng quy tắc ưu tiên (ví dụ: quy tắc bám tường phải) để tìm đường đi trong mê cung."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "skill_name": "Mô tả thuật toán bám tường", "skill_description": "Xác định hướng di chuyển của robot dựa trên trạng thái của tường ở phía trước và phía phải theo các quy tắc logic đã học."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "skill_name": "Mô tả thuật toán", "skill_description": "Thực hiện mô tả thuật toán bằng phương pháp liệt kê các bước hoặc sơ đồ khối để giải quyết bài toán thực tế."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "skill_name": "Xác định đầu vào và đầu ra", "skill_description": "Phân tích đề bài toán để xác định chính xác các giá trị đầu vào (dữ liệu đã biết) và đầu ra (kết quả cần tìm)."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "skill_name": "Phân tích và mô tả thuật toán bằng sơ đồ khối", "skill_description": "Thực hiện phân rã bài toán thành các bước nhỏ, sử dụng các khối lệnh điều kiện rẽ nhánh và cấu trúc lặp để phác thảo sơ đồ giải quyết bài toán."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "skill_name": "Gỡ lỗi và hiệu chỉnh chương trình", "skill_description": "Chạy thử chương trình với nhiều bộ dữ liệu đầu vào khác nhau, phát hiện lỗi logic hoặc cú pháp, sau đó thực hiện hiệu chỉnh mã nguồn để chương trình cho kết quả đúng."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "skill_name": "Xây dựng thuật toán và vẽ sơ đồ khối", "skill_description": "Thực hiện phân tích bài toán, liệt kê các bước thực hiện và vẽ sơ đồ khối sử dụng các cấu trúc điều khiển cơ bản."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "skill_name": "Lập trình tính toán tiền lương bằng Scratch", "skill_description": "Thực hiện tạo biến, xây dựng thuật toán có cấu trúc lặp với điều kiện trước và cài đặt chương trình tính tiền lương trên ngôn ngữ lập trình Scratch."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "skill_name": "Lập trình tìm giá trị lớn nhất trong Scratch", "skill_description": "Thực hiện tạo biến, sắp xếp và lắp ghép các khối lệnh điều kiện, vòng lặp trong phần mềm Scratch để giải quyết bài toán tìm giá trị lớn nhất của dãy số."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 16", "skill_name": "Gỡ lỗi và kiểm thử chương trình", "skill_description": "Nhập bộ dữ liệu kiểm thử vào chương trình Scratch qua bàn phím, kiểm tra tính đúng đắn của kết quả đầu ra và sửa lỗi nếu chương trình hoạt động sai."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "skill_name": "Tìm kiếm thông tin nghề nghiệp qua Internet", "skill_description": "Thực hiện tìm kiếm thông tin về công việc ở một số doanh nghiệp, công ty có sử dụng nhân lực thuộc các nhóm ngành tin học."}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "skill_name": "Phân tích định hướng nghề nghiệp bản thân", "skill_description": "Liên hệ năng lực, sở thích cá nhân (ví dụ tạo kịch bản, làm đồ họa, lập trình) với các nhóm nghề nghiệp thực tế trong lĩnh vực công nghệ thông tin."}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "skill_name": "Phân tích và lựa chọn nghề nghiệp tin học", "skill_description": "Đánh giá năng lực, sở thích cá nhân để lựa chọn định hướng nghề nghiệp phù hợp trong lĩnh vực Khoa học máy tính hoặc Tin học ứng dụng."}, {"grade_level": "Lớp 9", "lesson_id": "Giới thiệu", "skill_name": "Tra cứu học liệu điện tử", "skill_description": "Thực hiện cào lớp nhũ trên tem để quét mã xác thực hoặc truy cập vào trang web sách điện tử http://hanhtrangso.nxbgd.vn."}] AS row
MATCH (l:Lesson {id: toString(row.grade_level) + '_' + toString(row.lesson_id)})
MERGE (s:Skill {id: toString(row.grade_level) + '_' + toString(row.lesson_id) + '_' + toString(row.skill_name)})
ON CREATE SET s.name = toString(row.skill_name),
              s.description = toString(row.skill_description)
MERGE (l)-[:DEVELOPS_SKILL]->(s);

// --- 7. NẠP CÂU HỎI ĐÁNH GIÁ (323 CÂU HỎI) ---
UNWIND [{"grade_level": "Lớp 6", "lesson_id": "Bài 1", "question_id": "CH01", "question_content": "Em hãy thảo luận với bạn về lợi ích của mạng máy tính.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "question_id": "CH02", "question_content": "Mỗi dòng sau đây là thông tin hay dữ liệu? '16:00', '0123456789', 'Hãy gọi cho tôi lúc 16 giờ theo số điện thoại 0123456789.'", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "question_id": "LT1", "question_content": "Em hãy xem Bảng 1.1 và trả lời các câu hỏi sau:\na) Các con số trong cột tháng 9 là thông tin hay dữ liệu?\nb) Phát biểu “Tháng 6, Đà Nẵng ít mưa nhất so với các thành phố khác” là thông tin hay dữ liệu?\nc) Trả lời câu hỏi: “Huế ít mưa nhất vào tháng nào trong năm?”. Câu trả lời là thông tin hay dữ liệu?\nd) Câu trả lời cho câu c) có ảnh hưởng đến việc lựa chọn thời gian và địa điểm du lịch không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "question_id": "VD1", "question_content": "Em hãy lấy ví dụ cho thấy thông tin giúp em:\na) Có những lựa chọn trang phục tốt hơn.\nb) Đảm bảo an toàn khi tham gia giao thông.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "question_id": "VD2", "question_content": "Em hãy nêu ví dụ về vật mang tin giúp ích cho việc học tập của em.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 1", "question_id": "VD3", "question_content": "Em hãy lấy một ví dụ về dữ liệu trong cuộc sống. Bổ sung tình huống cho dữ liệu đó để nó trở thành thông tin.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "question_id": "HD1", "question_content": "Em hãy xem xét tình huống cầu thủ ghi bàn và trả lời các câu hỏi sau: 1. Bộ não của cầu thủ nhận được thông tin từ những giác quan nào? 2. Thông tin nào được bộ não cầu thủ ghi nhớ và sử dụng khi đá phạt? 3. Bộ não biến đổi thông tin nhận được thành thông tin nào? 4. Bộ não chuyển thông tin điều khiển thành thao tác nào của cầu thủ? 5. Quá trình xử lí thông tin của bộ não gồm những bước nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "question_id": "CH01", "question_content": "Em hãy chọn các phương án đúng: 1. Sơ đồ tư duy giúp chúng ta:", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 2", "question_id": "CH02", "question_content": "Em hãy chọn các phương án đúng: 2. Sơ đồ tư duy là:", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "question_id": "CH01", "question_content": "Thuật toán là gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "question_id": "CH02", "question_content": "Em hãy chọn các câu đúng.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "question_id": "HD02", "question_content": "Em hãy nêu một vài ví dụ về việc máy tính giúp con người trong các hoạt động sau: a) Thu nhận thông tin. b) Lưu trữ thông tin. c) Biến đổi thông tin. d) Truyền thông tin.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "question_id": "CH01", "question_content": "Dãy bit là gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 3", "question_id": "CH02", "question_content": "Máy tính sử dụng dãy bit để làm gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "CH01", "question_content": "1. Em hãy quan sát Hình 2.1 và cho biết:\na) Tên các thiết bị đầu cuối.\nb) Tên các thiết bị kết nối.\n2. Em hãy kể tên một số cách kết nối không dây mà em biết.\n3. Em hãy nêu ví dụ cho thấy kết nối không dây thuận tiện hơn kết nối có dây.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "CH02", "question_content": "Em hãy quan sát Hình 1.8 và cho biết mỗi tệp có dung lượng là bao nhiêu.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "LT1", "question_content": "Một GB tương đương với khoảng bao nhiêu byte?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "LT2", "question_content": "Giả sử một bức ảnh được chụp bằng một máy ảnh chuyên nghiệp có dung lượng khoảng 12 MB. Vậy một thẻ nhớ 16 GB có thể chứa bao nhiêu bức ảnh như vậy?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "LT3", "question_content": "Giả sử mỗi phút âm thanh chiếm 1 MB, mỗi bài hát trung bình có độ dài 6 phút. Một chiếc điện thoại thông minh còn trống 8 GB sẽ chứa được bao nhiêu bài hát như vậy?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "LT4", "question_content": "Giả sử mỗi giờ phim chiếm khoảng 4 GB, mỗi bộ phim có thời gian trung bình khoảng 1,5 giờ. Vậy một đĩa cứng 2 TB chứa được bao nhiêu bộ phim?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "VD1", "question_content": "Em hãy kiểm tra dung lượng các ổ đĩa của máy tính mà em đang sử dụng.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "VD2", "question_content": "Thực hiện tương tự như Hoạt động 1 với dãy các số từ 0 đến 15 để tìm mã hoá của các số từ 8 đến 15 và đưa ra nhận xét.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "LT01", "question_content": "1. Em hãy chọn các phương án đúng.\nMáy tính kết nối với nhau để:\nA. Chia sẻ các thiết bị.\nB. Tiết kiệm điện.\nC. Trao đổi dữ liệu.\nD. Thuận lợi cho việc sửa chữa.", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "LT02", "question_content": "2. Em hãy chọn các phương án đúng.\nThiết bị có kết nối không dây ở Hình 2.2 là:\nA. Máy tính để bàn.\nB. Máy tính xách tay.\nC. Điện thoại di động.\nD. Bộ định tuyến.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "VD01", "question_content": "1. Phòng thư viện của trường có 5 máy tính cần kết nối thành một mạng. Có thể có nhiều cách kết nối, ví dụ như Hình 2.3. Em hãy vẽ hai cách khác để kết nối chúng thành một mạng. So sánh cách của em với các bạn khác.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 4", "question_id": "VD02", "question_content": "2. Nhà bạn An có điện thoại di động của bố, của mẹ và một máy tính xách tay đang cùng truy cập mạng Internet. Theo em, các thiết bị đó có đang được kết nối thành một mạng máy tính không? Nếu có, hãy chỉ ra các thiết bị đầu cuối và thiết bị kết nối.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "question_id": "CH01", "question_content": "Em hãy kể hai công việc trong cuộc sống mà việc thực hiện gồm các bước được lặp lại nhiều lần.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "question_id": "LT01", "question_content": "Em hãy chọn phương án đúng. Internet là mạng:\nA. Kết nối hai máy tính với nhau.\nB. Kết nối các máy tính trong một nước.\nC. Kết nối nhiều máy tính trên phạm vi toàn cầu.\nD. Kết nối các máy tính trong một thành phố.", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "question_id": "LT02", "question_content": "Để máy tính kết nối được Internet ta cần làm gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "question_id": "VD01", "question_content": "Em hãy lấy ví dụ cho thấy Internet mang lại lợi ích cho việc học tập và giải trí.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "question_id": "VD02", "question_content": "Em hãy giải thích tại sao Internet lại được sử dụng rộng rãi và ngày càng phát triển.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "question_id": "CH01", "question_content": "Em hãy kể tên một số trình duyệt mà em biết.", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 8", "question_id": "CH02", "question_content": "Để truy cập một trang web ta cần làm thế nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài (tiếp theo)", "question_id": "LT01", "question_content": "Thông tin trên Internet được tổ chức như thế nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài (tiếp theo)", "question_id": "LT02", "question_content": "Em hãy ghép mỗi nội dung ở cột A với một nội dung phù hợp ở cột B: 1) Website là tập hợp; 2) Khi duyệt web, muốn chuyển đến một nội dung hoặc một trang web khác thì ta nháy chuột vào; 3) Để truy cập các trang web ta cần; 4) WWW là hệ thống các.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài (tiếp theo)", "question_id": "VD01", "question_content": "Có điểm gì khác nhau giữa cách tổ chức thông tin trong cuốn sách với cách tổ chức thông tin trên Internet?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài (tiếp theo)", "question_id": "VD02", "question_content": "Em hãy sử dụng trình duyệt web để truy cập vào trang web có địa chỉ: http://hoahoctro.tienphong.vn và http://vtv7.vtv.vn để xem thông tin có trên trang web (tên, biểu tượng, các mục chính,...) và theo các liên kết trỏ đến các trang web khác. Lưu địa chỉ các trang web em thích vào thanh Bookmark.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "TH01", "question_content": "Để tìm kiếm thông tin về 'vai trò của tầng ozon' bằng máy tìm kiếm Google, em thực hiện các bước nào sau đây?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "LT01", "question_content": "Thư điện tử có hạn chế nào dưới đây so với các hình thức gửi thư khác?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "LT02", "question_content": "Một người có thể mở được nhiều tài khoản thư điện tử không?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "LT03", "question_content": "Khi tạo tài khoản thư điện tử em không cần khai báo gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "VD01", "question_content": "Em hãy xác định xem thư nào có thể là thư rác trong các thư điện tử với tiêu đề sau: A. Cơ hội đầu tư kiếm được nhiều tiền hơn. B. Danh sách học sinh tham gia thi học sinh giỏi môn Tin học. C. Quà tặng miễn phí, hãy nháy chuột nhanh. D. Bạn đã trúng một chuyến đi miễn phí đến Mĩ. E. Ảnh tập thể lớp 6A ngày khai trường. F. Khuyến mãi, ưu đãi giá rẻ cho bạn.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "VD02", "question_content": "Em hãy soạn một thư điện tử có gửi kèm ảnh (hoặc tệp văn bản, thiệp chúc mừng,...) cho bạn hoặc người thân của em.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "CH01", "question_content": "Ưu điểm của việc tạo sơ đồ tư duy thủ công trên giấy là gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "CH02", "question_content": "Việc làm nào được khuyến khích khi sử dụng các dịch vụ trên Internet?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học (Tiếp theo)", "question_id": "HD04", "question_content": "1. Một bạn quen trên mạng xin số điện thoại và địa chỉ của em để gặp nhau nói chuyện. Em có nên cho không?\n2. Em được một bạn gửi qua mạng cho một số thông tin không tốt về một bạn khác cùng lớp. Em có nên đăng lên mạng để mọi người cùng biết không?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "LT1", "question_content": "1. Tìm câu sai.\na) Chương trình máy tính là một dãy các lệnh mà máy tính có thể hiểu và thực hiện được.\nb) Chương trình máy tính được viết bằng ngôn ngữ lập trình.\nc) Máy tính có thể thực hiện các lệnh trong chương trình theo trình tự tuỳ ý.", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "LT2", "question_content": "2. Cho chương trình Scratch như ở Hình 6.15. Em hãy trả lời các câu hỏi sau:\na) Chương trình đó thực hiện thuật toán nào?\nb) Xác định đầu vào, đầu ra của thuật toán đó.\nc) Hãy cho ví dụ cụ thể giá trị dữ liệu đầu vào và cho biết kết quả đầu ra tương ứng.\nd) Hãy trình bày thuật toán bằng sơ đồ khối.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "VD1", "question_content": "1. Em hãy vẽ sơ đồ khối mô tả thuật toán tìm số lớn hơn trong hai số a và b. Từ sơ đồ khối, hãy viết chương trình Scratch thực hiện thuật toán.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "VD2", "question_content": "2. Em hãy viết chương trình Scratch thực hiện thuật toán tính trung bình cộng của ba số.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "VD3", "question_content": "Em nên làm gì để bảo vệ thông tin và tài khoản cá nhân.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "question_id": "LT1", "question_content": "Em hãy bổ sung các nhánh nội dung còn thiếu cho sơ đồ tư duy ghi lại nội dung cuốn sổ lưu niệm của lớp em.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 9", "question_id": "VD1", "question_content": "Em hãy dùng sơ đồ tư duy (vẽ trên giấy hoặc tạo bằng phần mềm) trình bày tóm tắt nội dung Bài 9. An toàn thông tin trên Internet.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "question_id": "CH01", "question_content": "Để mở cửa sổ in văn bản (Print) trong phần mềm soạn thảo văn bản Microsoft Word, em chọn thẻ nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 13", "question_id": "CH02", "question_content": "Trong cửa sổ Print, để in tất cả các trang của tài liệu, em thường chọn mục nào trong phần Settings?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "question_id": "LT1", "question_content": "Em hãy chọn hướng trang phù hợp cho các văn bản sau:\na) Đơn xin nghỉ học.\nb) Báo cáo tổng kết năm học của lớp.\nc) Sổ lưu niệm của lớp.\nd) Sách ảnh chứa ảnh phong cảnh.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "question_id": "LT2", "question_content": "Em chọn loại căn lề nào khi trình bày nội dung bài thơ lục bát trên phần mềm soạn thảo văn bản? Tại sao?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "question_id": "LT3", "question_content": "Em hãy soạn thảo Đơn xin nghỉ học và thực hiện các thao tác định dạng hợp lí.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 14", "question_id": "VD1", "question_content": "Trong bài học trước, em đã cùng các bạn sử dụng sơ đồ tư duy để trình bày kết quả thảo luận về nội dung cuốn sổ lưu niệm của lớp. Em hãy thực hiện các công việc sau:\na) Soạn thảo thêm nội dung cho cuốn sổ lưu niệm (bài viết cảm nghĩ, bài viết giới thiệu hoạt động, sự kiện,...).\nb) Chèn thêm hình ảnh minh họa.\nc) Căn lề và định dạng trang để có được bố cục hợp lí và đẹp.\nd) Lưu lại tệp để dùng cho việc tạo cuốn sổ lưu niệm của lớp.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "question_id": "HD1", "question_content": "Hình 5.11 cho thấy hai cách trình bày danh sách học sinh trong cuốn sổ lưu niệm. Trang bên trái sử dụng bảng, trang bên phải liệt kê lần lượt danh sách các thành viên. Em hãy nhận xét về hai cách trình bày.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 12", "question_id": "HD2", "question_content": "Em sẽ lựa chọn cách nào để trình bày danh sách học sinh trong cuốn sổ lưu niệm của lớp em? Tại sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "question_id": "CH01", "question_content": "Trong phần mềm soạn thảo văn bản, để chèn bảng (Table), ta chọn thẻ nào trên thanh bảng chọn?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "question_id": "CH02", "question_content": "Việc trình bày thông tin dưới dạng bảng đem lại lợi ích gì so với văn bản dạng liệt kê thông thường?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 15", "question_id": "CH03", "question_content": "Đâu là thao tác đúng để chọn số cột và số hàng khi tạo bảng bằng lệnh Table trong thẻ Insert?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "question_id": "LT1", "question_content": "Tệp văn bản chứa các bài viết cảm nghĩ của An về trường, lớp, thầy cô và các bạn gồm nhiều trang. An muốn xem lại nội dung bài viết về nhóm bạn thân lớp 6A, nhưng không nhớ rõ ở trang nào. Vì vậy, An thực hiện thao tác tìm kiếm cụm từ 'nhóm bạn thân' trong tệp văn bản. An phải thực hiện thao tác gì để xem lần lượt các kết quả tìm thấy?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "question_id": "LT2", "question_content": "Em hãy sắp xếp lại các bước sau đây theo thứ tự đúng để thực hiện thao tác thay thế một từ hoặc cụm từ trong phần mềm soạn thảo văn bản.\na) Gõ từ, cụm từ cần thay thế.\nb) Nháy chuột vào thẻ Home.\nc) Trong nhóm lệnh Editing, chọn Replace.\nd) Gõ từ, cụm từ cần tìm.\ne) Nháy chuột vào nút Replace để thay thế lần lượt từng từ hoặc cụm từ.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài", "question_id": "VD1", "question_content": "Trong các bài học trước, em đã tạo ra một số tệp văn bản cho cuốn sổ lưu niệm. Em hãy xem lại các tệp văn bản này để rà soát lỗi chính tả. Em có thể sử dụng chức năng Tìm kiếm và Thay thế để chỉnh sửa các lỗi chính tả, thay thế các từ viết tắt,... để tệp văn bản hoàn chỉnh hơn.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 10", "question_id": "CH02", "question_content": "Bạn Khoa đang lập trình bằng Scratch, Khoa muốn các chú cá di chuyển 10 bước một liên tục cho đến khi chạm biên thì dừng lại. a) Điều kiện để chú cá dừng lại là gì? b) Hình 6.10 là sơ đồ khối mô tả thuật toán thực hiện yêu cầu của bạn Khoa. Em hãy vẽ sơ đồ khối đó vào vở và điền các bước để hoàn thành sơ đồ khối.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "LT1", "question_content": "Em hãy trình bày các câu sau đây dưới dạng sơ đồ khối cấu trúc rẽ nhánh:\na) Nếu có kẻ trên mạng đe doạ thì em cần nói cho cha mẹ biết.\nb) Nếu nhận được thư điện tử có đính kèm tệp từ địa chỉ không quen biết thì em không nên mở tệp đính kèm.\nc) Nếu có tin nhắn từ người không quen biết yêu cầu gửi thông tin cá nhân thì em không nên gửi.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "LT2", "question_content": "Trong các câu sau đây, câu nào có thể biểu diễn bằng sơ đồ khối có cấu trúc lặp? Hãy mô tả câu đó bằng sơ đồ khối:\na) Nếu sáng mai trời mưa, em sẽ mang theo áo mưa.\nb) Nếu vẫn chưa làm hết bài tập, em phải làm bài tập đến khi nào hết.\nc) Nếu được nghỉ ba ngày vào dịp Tết Dương lịch thì gia đình em sẽ đi du lịch, còn không sẽ có kế hoạch khác.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "LT3", "question_content": "Em hãy quan sát hai sơ đồ khối trong Hình 6.11a, Hình 6.11b và cho biết mỗi sơ đồ khối mô tả cấu trúc nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "VD1", "question_content": "Bạn An cho rằng: \"Sơ đồ khối ở Hình 6.12a thể hiện rằng nếu chưa hiểu bài thì việc đọc lại sách chỉ thực hiện một lần rồi làm bài tập. Còn sơ đồ khối ở Hình 6.12b thể hiện rằng nếu chưa hiểu bài thì việc đọc lại sách và làm bài tập sẽ thực hiện nhiều lần\". Em có đồng ý với ý kiến bạn An không? Nếu phải sửa nhận xét đó, em sẽ sửa như thế nào?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "VD2", "question_content": "Trong trò chơi ở phần khởi động, việc tính điểm cho mỗi cặp chơi là một hoạt động lặp. Hãy chỉ rõ công việc được lặp lại và vẽ sơ đồ khối cấu trúc lặp của hoạt động này.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "VD3", "question_content": "Cô giáo điểm danh bằng cách gọi tên từng bạn trong danh sách lớp. Nếu bạn nào trả lời có thì cô giáo gọi tên bạn tiếp theo, còn không thì cô giáo đánh dấu vắng mặt và gọi tên bạn tiếp theo. Việc điểm danh của cô giáo có thể mô tả bằng những cấu trúc nào? Em hãy vẽ sơ đồ khối mô tả các cấu trúc đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "CH01", "question_content": "Dựa vào chương trình tính tổng hai số bằng ngôn ngữ tự nhiên và chương trình Scratch ở Hình 6.13, em hãy bổ sung nội dung vào các dấu hỏi chấm trong bảng: Công việc 'Nhập dữ liệu đầu vào', 'Xử lí', 'Thông báo đầu ra'.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6", "question_id": "CH02", "question_content": "Câu \"Nếu trời mưa thì em không đi đá bóng\" có chứa cấu trúc nào? Em hãy mô tả câu này bằng sơ đồ khối.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 6", "lesson_id": "Bài 6 - Thực hành", "question_id": "VD1", "question_content": "Em hãy mô tả thuật toán giải quyết yêu cầu trên bằng sơ đồ khối và chương trình Scratch cho bài toán tính số tiền lãi hoặc lỗ khi bán thiệp.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 6", "lesson_id": "Bài học", "question_id": "LT3", "question_content": "3. Cho chương trình Scratch như ở Hình 6.16. Em hãy trả lời các câu hỏi sau:\na) Chương trình đó thực hiện công việc gì?\nb) Các cấu trúc điều khiển tuần tự, rẽ nhánh và lặp có được sử dụng trong chương trình không? Hãy nêu các câu lệnh trong chương trình thể hiện cấu trúc đó.\nc) Hãy thực hành tạo chương trình bằng Scratch.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "HD2", "question_content": "Mỗi thiết bị vào - ra trong Hình 1.2 làm việc với dạng thông tin nào? Thiết bị nào có cả hai chức năng vào và ra?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "HD2.2", "question_content": "Máy chiếu là thiết bị vào hay thiết bị ra? Máy chiếu làm việc với dạng thông tin nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "HD2.3", "question_content": "Bộ điều khiển game (Hình 1.3a) là thiết bị vào hay thiết bị ra?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "HD2.4", "question_content": "Màn hình cảm ứng (Hình 1.3b) là thiết bị vào, thiết bị ra hay có cả hai chức năng vào và ra?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "question_id": "CH01", "question_content": "Em hãy lắp các thiết bị sau vào đúng cổng của nó bằng cách ghép mỗi chữ cái với số tương ứng trong Hình 1.5: a) Bàn phím; b) Dây mạng; c) Chuột; d) Dây màn hình; e) Tai nghe; f) Dây nguồn.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài (tiếp theo)", "question_id": "CH02", "question_content": "Việc cấp nguồn điện cho máy tính cần được thực hiện trước hay sau các kết nối trên? Tại sao?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "CH01", "question_content": "Thao tác nào sau đây tắt máy tính một cách an toàn?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "CH02", "question_content": "Tại sao không nên vừa ăn vừa sử dụng máy tính?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "LT1", "question_content": "Một bộ tai nghe có gắn micro sử dụng cho máy tính là loại thiết bị gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "LT2", "question_content": "Máy tính của em đang làm việc với một tệp trên thẻ nhớ. Em hãy sắp xếp lại thứ tự các thao tác sau để tắt máy tính an toàn, không làm mất dữ liệu: a) Chọn nút lệnh Shut down để tắt máy tính. b) Đóng tệp đang mở trên thẻ nhớ. c) Chọn \"Safe To Remove Hardware\" để ngắt kết nối với thẻ nhớ. d) Lưu lại nội dung của tệp.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "VD1", "question_content": "Trên màn hình theo dõi, em thấy một người đứng trước camera an ninh. Người đó có biết em đang theo dõi không? Tại sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "VD2", "question_content": "Máy in của em in ra những kí hiệu không mong muốn và em biết lỗi này là do virus gây ra. Em cần phải diệt virus ở máy in hay máy tính? Tại sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 1", "question_id": "VD3", "question_content": "Em hãy đề xuất một số quy tắc để giúp các bạn sử dụng phòng máy tính an toàn.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "question_id": "CH01", "question_content": "Phần mềm nào sau đây không phải là một hệ điều hành?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học tiếp theo", "question_id": "CH02", "question_content": "Chức năng nào sau đây không phải của hệ điều hành?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "question_id": "CH01", "question_content": "Thiết bị lưu trữ nào sau đây có ưu điểm dung lượng lớn và tiện sử dụng nhưng có thể bị hỏng nếu bị rơi?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "question_id": "CH02", "question_content": "Đặc điểm nào sau đây tạo nên một mật khẩu mạnh?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "question_id": "LT01", "question_content": "Em hãy nêu các chức năng của hệ điều hành.", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "question_id": "LT02", "question_content": "Phát biểu nào sau đây là sai?\nA. Người sử dụng xử lí những yêu cầu cụ thể bằng phần mềm ứng dụng.\nB. Để phần mềm ứng dụng chạy được trên máy tính phải có hệ điều hành.\nC. Để máy tính hoạt động được phải có phần mềm ứng dụng.\nD. Để máy tính hoạt động được phải có hệ điều hành.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 3", "question_id": "VD01", "question_content": "Khi tải Scratch để cài đặt lên máy tính, tại sao cần phải chọn phiên bản phù hợp với hệ điều hành trên máy tính của em?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "CH01", "question_content": "Thuật toán tìm kiếm tuần tự thực hiện công việc gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "CH02", "question_content": "Thuật toán tìm kiếm tuần tự thực hiện công việc như thế nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "VD1", "question_content": "Em hãy lập danh sách những cuốn sách mà em có. Sau đó sử dụng thuật toán tìm kiếm tuần tự để tìm một cuốn sách trong danh sách đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "CH01", "question_content": "Không nên dùng mạng xã hội cho mục đích nào sau đây?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "CH02", "question_content": "\"Đưa thông tin sai sự thật lên mạng, sử dụng thông tin vào mục đích sai trái là hành vi bị nghiêm cấm và có thể bị phạt theo quy định của pháp luật\". Theo em điều đó là:", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "CH03", "question_content": "Thực hành tạo cây thư mục như Hình 3.3 và thực hiện: Đổi tên thư mục 'HoangHon' thành 'ChieuToi'; Di chuyển các tệp và thư mục con của thư mục 'BinhMinh' sang thư mục 'BanNgay'; Xoá thư mục 'BinhMinh'.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "LT1", "question_content": "Đâu là chương trình máy tính giúp em quản lí tệp và thư mục?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "LT2", "question_content": "Đâu là phần mềm có thể bảo vệ máy tính tránh được virus?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "VD1", "question_content": "Em hãy lựa chọn một thiết bị lưu trữ để sao lưu thư mục \"DuLich\". Giải thích tại sao em lựa chọn cách sao lưu đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "VD2", "question_content": "Sau khi học xong bài này và có thêm các kiến thức về sao lưu, bảo vệ dữ liệu, em có thay đổi cách bảo vệ dữ liệu mà em đã chọn trong Hoạt động 2 không? Tại sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 4", "question_id": "HĐ1", "question_content": "1. Ở lớp 6 em đã biết sử dụng Internet để nhận và gửi thông tin. Đó là cách nào?\n2. Em có biết cách trao đổi thông tin nào trên Internet đang được sử dụng nhiều nhất không? Tại sao?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "LT1", "question_content": "Cho danh sách tên các nước sau đây: Bolivia, Albania, Scotland, Canada, Vietnam, Iceland, Portugal, Greenland, Germany. Em hãy kẻ Bảng 14.3 vào vở và điền các bước thực hiện thuật toán tìm kiếm tuần tự để tìm tên nước Iceland trong danh sách trên (dòng 1 là ví dụ minh họa).", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "LT2", "question_content": "Theo em, hai hoạt động trên mạng nào sau đây dễ gây bệnh nghiện Internet nhất?\nA. Chơi trò chơi trực tuyến.\nB. Đọc tin tức.\nC. Sử dụng mạng xã hội.\nD. Học tập trực tuyến.\nE. Trao đổi thông tin qua thư điện tử.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "VD2", "question_content": "Nếu một trong những người bạn của em có biểu hiện nghiện trò chơi trực tuyến, em sẽ làm gì để giúp bạn?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "question_id": "CH01", "question_content": "Những cách ứng xử nào sau đây là hợp lí khi truy cập một trang web có nội dung xấu?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "question_id": "CH02", "question_content": "Theo em những đặc điểm khác nhau giữa giao tiếp gặp gỡ trực tiếp và giao tiếp qua mạng là gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 5", "question_id": "CH03", "question_content": "Tại sao có những bạn khi giao tiếp qua mạng lại thiếu văn minh hơn so với khi giao tiếp trực tiếp?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "question_id": "CH01", "question_content": "Một ô có thể coi là một vùng được không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "question_id": "CH02", "question_content": "Vùng A5:B10 có bao nhiêu ô?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "question_id": "CH03", "question_content": "Có thể chọn một vùng hình tam giác được không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "question_id": "HĐ3_CH01", "question_content": "Có thể nhập dữ liệu vào trang tính theo bao nhiêu cách? Hãy nêu các cách đó.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 6", "question_id": "HĐ3_CH02", "question_content": "Dữ liệu được nhập vào các ô sẽ được tự động căn chỉnh như thế nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "question_id": "LT1", "question_content": "Muốn xoá nhanh dữ liệu trong một vùng thì em làm thế nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "question_id": "LT2", "question_content": "Có bao nhiêu cách nhập dữ liệu vào trang tính? Em hãy mô tả các cách đó.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "question_id": "VD1", "question_content": "Vì sao khi nhập 12/15/2020 thì phần mềm tự động căn phải, nhưng nếu nhập 15/12/2020 thì phần mềm tự động căn trái?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (tiếp theo)", "question_id": "VD2", "question_content": "Em hãy tìm một số loại cây có thể mua và trồng cho dự án Trường học xanh. Em hãy tạo một bảng tính và đặt tên là Danh sách các loại cây. Bảng tính có ba cột là STT, Loại cây (Cây hoa, Cây ăn quả, Cây bóng mát) và Tên cây. Nhập dữ liệu vào bảng tính rồi chỉnh sửa và định dạng dữ liệu.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "question_id": "CH01", "question_content": "Trong phần mềm bảng tính, những công thức tính nào dưới đây sai? Vì sao?\nA. = 5^2 + 6*101\nB. = 6*(3 + 2)\nC. = 2(3 + 4)\nD. = 1^2 + 2^2", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 7", "question_id": "VD01", "question_content": "Em hãy cho biết, nếu nhập công thức vào một ô tính và tính toán với giá trị nằm ở ô khác thì phải làm thế nào?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học", "question_id": "CH03", "question_content": "Có nên viết nhiều chữ, dùng nhiều màu trên một trang không? Vì sao?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "question_id": "LT1", "question_content": "Em hãy tạo một trang tính mới trong bảng tính của dự án, đặt tên là 3. Tìm hiểu giống cây. Tiến hành nhập dữ liệu là danh sách các loại cây cụ thể và đơn giá. Định dạng cho trang tính như Hình 7.10 và lưu lại kết quả.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "question_id": "LT2", "question_content": "Nhập công thức = D4 * E4 vào ô F4. Sao chép ô F4 xuống các ô từ F5 đến F19 để tính giá trị của cột Thành tiền.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "question_id": "VD1", "question_content": "Phần mềm bảng tính mặc định căn phải dữ liệu là số và ngày tháng, căn trái dữ liệu là văn bản. Em có thể thay đổi lại cách căn lề cho dữ liệu số, ngày tháng và văn bản được không? Nếu có thì bằng lệnh nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài học (Tiếp theo)", "question_id": "VD2", "question_content": "Em hãy tạo một bảng tính mới, nhập dữ liệu cho bảng tính như Hình 7.11, nhập công thức tính tổng diện tích rừng cho tỉnh Hà Giang và sao chép công thức để tính cho các tỉnh còn lại. Lưu tệp bảng tính với tên Dientichrung.xlsx.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "question_id": "CH01", "question_content": "Mỗi hàm sau cho kết quả như thế nào?\na) SUM(1,3, \"Hà Nội\", \"Zero\", 5)\nb) MIN(3,5, \"One\", 1)\nc) COUNT(1,3,5,7)", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "question_id": "CH02", "question_content": "Các tham số của hàm có thể là địa chỉ ô hoặc vùng dữ liệu không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 8", "question_id": "CH03", "question_content": "Để tính giá trị trung bình cộng của một vùng dữ liệu từ ô C4 đến ô I8, hàm nào sau đây là đúng?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "question_id": "CH01", "question_content": "Để tính tổng số cây Hoa Mười giờ của các lớp từ cột D đến cột J tại ô K4, công thức nào sau đây là đúng?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành tổng hợp", "question_id": "CH02", "question_content": "Để tính số cây Hoa Mười giờ trung bình của mỗi lớp (từ cột D đến cột J) tại ô L4, công thức nào sau đây là chính xác?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "question_id": "LT1", "question_content": "Tại các ô K9, K17, K24 trong trang tính 4. Dự kiến kết quả có thể dùng công thức khác được không? Nếu có thì dùng công thức gì? Từ đó em rút ra điều gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "question_id": "LT2", "question_content": "Các công thức sau đây có cho kết quả giống nhau hay không?\na) =SUM(C3:K3)\nb) =C3 + SUM(D3:J3) + K3\nc) =SUM(C3:G3) + SUM(H3:K3)", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "question_id": "LT3", "question_content": "Dựa trên dữ liệu của Bảng 4. Dự kiến phân bổ cây cho các lớp, em hãy thực hành để:\na) Tìm số cây lớn nhất sẽ được trồng của các lớp.\nb) Tính số cây trung bình sẽ được trồng của các lớp.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài thực hành (hoặc Bài học tổng hợp)", "question_id": "VD1", "question_content": "Em hãy tạo bảng tính và nhập dữ liệu ghi lại các khoản chi tiêu của gia đình em trong một tháng. Sử dụng các hàm để tính toán và trả lời những câu hỏi sau:\na) Tổng số tiền chi tiêu một tháng là bao nhiêu?\nb) Khoảng chi nhiều nhất, ít nhất là bao nhiêu?\nc) Có bao nhiêu khoản đã chi?\nd) Trung bình mỗi ngày chi bao nhiêu tiền?\nEm hãy chia sẻ với bố mẹ những kết quả em tính toán được để cùng cân đối chi tiêu cho hợp lí.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "question_id": "CH01", "question_content": "Theo em việc định dạng dữ liệu và trình bày bảng tính có khác nhau không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài", "question_id": "CH02", "question_content": "Các lệnh trình bày bảng tính hay định dạng dữ liệu có làm thay đổi dữ liệu trên bảng tính không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "CH01", "question_content": "Trong bảng dữ liệu của Hình 9.12, các hàm SUM, AVERAGE, COUNT, MIN, MAX sẽ xử lý như thế nào đối với các ô chứa dữ liệu dạng văn bản (như 'Không', 'Đang làm') hoặc ô trống?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "CH02", "question_content": "Quan sát Hình 9.12, công thức tại ô J5 được viết như thế nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "CH03", "question_content": "Điều gì xảy ra với dữ liệu trong các ô khác (ngoài ô đầu tiên bên trái) khi em thực hiện thao tác gộp một vùng dữ liệu?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "LT1", "question_content": "Có thể sao chép công thức từ trang tính này sang trang tính khác được không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "LT2", "question_content": "Phần mềm bảng tính điện tử có thể gộp các ô trong một vùng không là hình chữ nhật không?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "VD1", "question_content": "Em hãy quan sát Bảng 5. Dự kiến phân bổ cây dự án Trường học xanh ở Hình 9.13 và hãy trả lời các câu hỏi sau: a) Tổng số cây của toàn bộ khối 7 sẽ trồng là bao nhiêu? b) Trung bình mỗi lớp sẽ trồng bao nhiêu cây?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 9", "question_id": "VD2", "question_content": "Giả sử trước khi thực hiện dự án nhà trường giao chỉ tiêu trồng mỗi loại cây hoa là 50, dựa trên dữ liệu trong Bảng 5. Dự kiến phân bổ cây dự án Trường học xanh, em hãy tính tỉ lệ phần trăm của từng loại cây hoa được phân bổ so với chỉ tiêu đã giao.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "question_id": "CH01", "question_content": "Để in một vùng dữ liệu được chọn trong bảng tính điện tử, tại hộp thoại Print, ta chọn tùy chọn nào ở mục vùng in?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "question_id": "LT1", "question_content": "Quan sát lệnh in một trang tính và so sánh với lệnh in văn bản mà em đã học ở lớp 6, có điểm gì khác nhau giữa hai lệnh in này?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "question_id": "LT2", "question_content": "Em hãy thực hiện lệnh in bảng dữ liệu rút gọn bằng cách ẩn đi tất cả các cột ứng với các lớp cụ thể từ 7A đến 7H.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 10", "question_id": "VD1", "question_content": "Em hãy giúp cô giáo tạo trang tính Điểm thi khảo sát có các cột Họ và tên, Toán, Ngữ văn, Tiếng Anh và Điểm trung bình. Dùng các hàm hay công thức để tính toán rồi trình bày trang tính.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "question_id": "LT1", "question_content": "Ưu điểm của việc sử dụng cấu trúc phân cấp trong bài trình chiếu là gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "question_id": "LT2", "question_content": "Em hãy tạo trang chiếu ghi các công việc cần làm trong ngày và sử dụng cấu trúc phân cấp để trình bày nội dung.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 11", "question_id": "VD1", "question_content": "Em hãy đề xuất một dự án mà em nhận thấy nó thiết thực với điều kiện hiện tại. (Ví dụ: Làm sạch đẹp cảnh quan ngôi nhà của em; Trang trí thư viện của trường để thu hút các bạn học sinh đến đọc sách; Tái chế rác thải;...). Tạo bài trình chiếu để trình bày dự án đó (mục tiêu, cách làm, tác dụng, hiệu ứng,...) với những người có liên quan để thuyết phục mọi người cùng thực hiện. Trong bài có trang tiêu đề, các trang nội dung có tiêu đề trang và sử dụng cấu trúc phân cấp. Ghi lại bài trình chiếu với tên Baitaptinhoc7.pptx.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "question_id": "HĐ1", "question_content": "Theo em có nên sử dụng hình ảnh để minh hoạ cho bài trình chiếu không? Vì sao? Em sẽ chọn hình ảnh gì để thêm vào bài trình chiếu báo cáo dự án?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "question_id": "CH01", "question_content": "Để đưa hình ảnh nằm phía sau lớp văn bản trong phần mềm trình chiếu, em sử dụng lệnh nào sau đây?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "question_id": "LT1", "question_content": "Em hãy bổ sung thêm một hình ảnh vào trang trình bày ý tưởng (Hình 12.5) rồi định dạng hình ảnh đó sao cho hợp lí.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "question_id": "LT2", "question_content": "Em hãy bổ sung kết quả tính toán của dự án Trường học xanh đã làm trong phần mềm bảng tính vào bài trình chiếu (có thể ở trang Dự kiến kết quả).", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "question_id": "LT3", "question_content": "Em hãy định dạng văn bản, biên tập nội dung cho các trang chiếu của tệp trình chiếu Truonghocxanh.pptx. Chọn mẫu định dạng phù hợp cho các trang chiếu.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 12", "question_id": "VD1", "question_content": "Em hãy mở tệp Baitaptinhoc7.pptx mà em đã tạo ở Bài 11, bổ sung thông tin vào các trang chiếu của bài trình chiếu (bằng cách sao chép dữ liệu từ tệp văn bản hoặc nhập mới từ bàn phím). Sau khi đã có nội dung em cần tạo cấu trúc phân cấp, chèn hình ảnh, chọn mẫu định dạng cho trang chiếu và định dạng cho văn bản, hình ảnh.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "question_id": "CH01", "question_content": "Em hãy ghép mỗi nội dung ở cột A với một nội dung phù hợp ở cột B.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "question_id": "CH02", "question_content": "Sử dụng hiệu ứng động cần lưu ý những điều gì? Tại sao?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "question_id": "LT1", "question_content": "Em hãy tạo hiệu ứng cho các trang và đối tượng để hoàn thiện bài trình chiếu báo cáo dự án của nhóm em.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 13", "question_id": "VD1", "question_content": "Em hãy bổ sung hiệu ứng động cho bài trình chiếu ghi trong tệp Baitaptinhoc7.pptx. Xem lại nội dung, định dạng, hiệu ứng của từng trang để hoàn thiện bài trình chiếu.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 14", "question_id": "HD01", "question_content": "Em hãy kẻ Bảng 14.2 vào vở và điền các bước thực hiện thuật toán tìm kiếm tuần tự để tìm ra địa chỉ của khách hàng có họ tên là 'Thanh Trúc'.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "question_id": "HD1", "question_content": "Em hãy cho biết thuật toán tìm kiếm tuần tự phải thực hiện bao nhiêu bước lặp để tìm được khách hàng tên \"Trúc\" trong danh sách ở Hình 15.1? Em hãy so sánh số bước lặp thực hiện của thuật toán tìm kiếm tuần tự với số bước lặp thực hiện của thuật toán tìm kiếm nhị phân.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "question_id": "HD2", "question_content": "Theo em trước khi thực hiện thuật toán tìm kiếm nhị phân, danh sách khách hàng cần thoả mãn điều kiện gì? Nếu không thoả mãn điều kiện đó, thuật toán tìm kiếm nhị phân có thực hiện được không?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "question_id": "CH01", "question_content": "Em hãy nêu ví dụ trong thực tế cho thấy mối liên quan giữa sắp xếp và tìm kiếm.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "question_id": "LT01", "question_content": "Cho danh sách tên các nước sau đây: Bolivia, Albania, Scotland, Canada, Vietnam, Iceland, Portugal, Greenland, Germany.\na) Em hãy sắp xếp danh sách tên các nước theo thứ tự trong bảng chữ cái.\nb) Em hãy liệt kê các bước lặp tìm kiếm tên nước Iceland trong danh sách đã sắp xếp theo thuật toán tìm kiếm nhị phân.\nc) Em hãy so sánh số bước lặp thực hiện tìm kiếm ở phần b với số bước lặp thực hiện tìm kiếm ở phần Luyện tập của bài 14.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "question_id": "LT02", "question_content": "Em hãy cho ví dụ một bài toán tìm kiếm trong thực tế mà có thể thực hiện bằng thuật toán tìm kiếm nhị phân. Hãy thực hiện thuật toán tìm kiếm nhị phân để giải quyết bài toán đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 15", "question_id": "VD01", "question_content": "Em tìm một từ tiếng Anh trong quyển từ điển theo cách nào? Tại sao em lại dùng cách đó?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 7", "lesson_id": "Bài 16", "question_id": "CH01", "question_content": "Thuật toán sắp xếp nổi bọt sắp xếp danh sách bằng cách:", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "question_id": "LT1", "question_content": "Em hãy nêu một ví dụ cho thấy sự khác nhau rõ ràng trong hoạt động học tập khi chưa có và khi có các thiết bị công nghệ số hiện nay.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "question_id": "LT2", "question_content": "Em hãy nêu ví dụ về một ứng dụng mà em cho là thông minh của những máy tính thế hệ mới.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "question_id": "VD1", "question_content": "Em hãy cho biết vào thời điểm đất nước ta hoàn toàn thống nhất năm 1975, những thế hệ máy tính điện tử nào đã xuất hiện ở nước ta?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "question_id": "VD2", "question_content": "Em hãy đưa ra một dự báo về ứng dụng của máy tính trong tương lai. Hãy giải thích cơ sở của dự báo đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "HĐ1_CH01", "question_content": "Trong Hoạt động 1, An có thể nhận được ảnh bằng cách nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "HĐ1_CH02", "question_content": "Sau khi An nhận được ảnh, Khoa có bị mất bức ảnh gốc không?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "HĐ1_CH03", "question_content": "An có thể lưu trữ ảnh vào những thiết bị nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "question_id": "CH01", "question_content": "Theo nội dung bài học, thông tin số có những đặc điểm chính nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 1", "question_id": "CH02", "question_content": "Khi An lấy bức ảnh ruộng bậc thang nhận được từ Khoa để làm nền cho ảnh của mình và đưa lên mạng xã hội, điều đó minh họa cho đặc điểm nào của thông tin số?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "LT1", "question_content": "Em hãy kể tên ba ứng dụng thu thập nhiều thông tin từ người sử dụng và cho biết: a) Tổ chức, cá nhân nào sở hữu các ứng dụng đó? b) Mỗi ứng dụng thu thập dạng thông tin nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "LT2", "question_content": "Em hãy đánh giá độ tin cậy của thông tin được cung cấp từ ba ứng dụng ở Câu 1.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "VD1", "question_content": "Em hãy tìm kiếm trên Internet thông tin về một đội bóng, một cầu thủ hoặc một nhân vật mà em yêu thích.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "VD2", "question_content": "Em hãy phân tích mức độ tin cậy của nguồn tin tìm được ở Câu 1 và trình bày một bài giới thiệu về đội bóng, cầu thủ nhân vật đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 2", "question_id": "VD3", "question_content": "Em hãy kể một ví dụ về tin đồn (trong cuộc sống hoặc trên mạng) và cho biết: a) Tin đồn đó xuất hiện từ sự việc nào? b) Tác hại của tin đồn đó là gì?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "question_id": "CH01", "question_content": "Để tìm hiểu về cách sử dụng một chiếc máy ảnh mới, nguồn thông tin nào sau đây cần được tham khảo nhất?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "question_id": "CH02", "question_content": "Để tìm hiểu về một đội bóng đá ở châu Phi, nguồn thông tin nào sau đây đáng tin cậy nhất?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "question_id": "CH03", "question_content": "Nếu được quyết định thiết kế một nhà máy điện, em sẽ chọn cách nào để sản xuất điện? Tại sao cách đó tốt hơn những cách khác?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 3", "question_id": "VD1", "question_content": "Em hãy tìm thông tin về một đội bóng, một cầu thủ hay một nghệ sĩ mà em hâm mộ. Hãy đánh giá những nguồn thông tin tìm được.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "CH01", "question_content": "Em có cảnh báo và lời khuyên gì với bạn trong tình huống: Bạn em quay video các bạn trong lớp có hành vi bạo lực và đăng lên mạng xã hội?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "CH02", "question_content": "Em có cảnh báo và lời khuyên gì với bạn trong tình huống: Một người bạn sử dụng ảnh em chụp để tham gia một cuộc thi ảnh nhưng chưa có sự đồng ý của em?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "LT01", "question_content": "Em hãy xác định các hành động dưới đây là vi phạm hay không vi phạm đạo đức, pháp luật và văn hoá khi sử dụng công nghệ kĩ thuật số: a) Chia sẻ thông tin mua bán động vật hoang dã quý hiếm.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "LT02", "question_content": "Em hãy xác định các hành động dưới đây là vi phạm hay không vi phạm đạo đức, pháp luật và văn hoá khi sử dụng công nghệ kĩ thuật số: b) Tạo một trang cá nhân để chia sẻ những kinh nghiệm học tập của mình.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "LT03", "question_content": "Em hãy xác định các hành động dưới đây là vi phạm hay không vi phạm đạo đức, pháp luật và văn hoá khi sử dụng công nghệ kĩ thuật số: c) Quay và lan truyền video bạo lực học đường.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "LT04", "question_content": "Em hãy xác định các hành động dưới đây là vi phạm hay không vi phạm đạo đức, pháp luật và văn hoá khi sử dụng công nghệ kĩ thuật số: d) Sáng tác một bài thơ về lớp và gửi bạn bè cùng đọc.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "LT05", "question_content": "Em hãy xác định các hành động dưới đây là vi phạm hay không vi phạm đạo đức, pháp luật và văn hoá khi sử dụng công nghệ kĩ thuật số: e) Tham gia cá cược bóng đá qua Internet.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "LT06", "question_content": "Em hãy xác định các hành động dưới đây là vi phạm hay không vi phạm đạo đức, pháp luật và văn hoá khi sử dụng công nghệ kĩ thuật số: f) Chia sẻ địa chỉ một website có chứa các bộ phim không có bản quyền sử dụng.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 4", "question_id": "VD01", "question_content": "Em hãy tạo một sản phẩm số theo cách sáng tạo để hướng dẫn các bạn hiểu đúng về việc sử dụng công nghệ kĩ thuật số. Em hãy đảm bảo sản phẩm của mình thể hiện được đạo đức, tính văn hoá và không vi phạm pháp luật nhé.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "question_id": "CH01", "question_content": "Trong Hình 5.3, công thức tại ô F5 là =E5*$F$2. Sao chép công thức này đến ô F6, kết quả sao chép là:", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài", "question_id": "CH01", "question_content": "Em hãy nhập công thức để tính Doanh thu của công ti cho phần mềm Quản lí thời gian và Trò chơi sáng tạo vào ô F4 và F5, biết rằng: Doanh thu của công ti = Doanh thu * Tỉ lệ (được lưu ở ô F2).", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài", "question_id": "CH02", "question_content": "Nếu sao chép công thức từ ô F4 vào ô F5 thì công thức nhận được tại ô F5 có đúng yêu cầu không? Vì sao?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 5", "question_id": "CH02", "question_content": "Cách nhập kí hiệu $ cho địa chỉ tuyệt đối là:", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 6", "question_id": "CH01", "question_content": "Em hãy nêu tiêu chí sắp xếp danh sách học sinh theo thứ tự của bảng chữ cái trong bảng kết quả ở Hình 6.2.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "question_id": "CH01", "question_content": "Theo em có thể sắp xếp bảng kết quả khảo sát lớp 8A (Hình 6.2) theo tổ, nếu cùng tổ sắp xếp theo tên, nếu cùng tên sắp xếp theo họ đệm được không? Hãy thực hiện sắp xếp trên bảng tính.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học (tiếp theo)", "question_id": "CH02", "question_content": "Chức năng lọc dữ liệu trong phần mềm bảng tính dùng để làm gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "question_id": "LT1", "question_content": "Đọc nội dung phần Luyện tập: Để phục vụ cho việc thành lập CLB Tin học của trường, các bạn học sinh lớp 8A đã thực hiện một cuộc khảo sát trong khối 8 để tìm hiểu sự ảnh hưởng của công nghệ kĩ thuật số đến cuộc sống của học sinh. Bảng dữ liệu dưới đây thống kê số học sinh của mỗi lớp đã trả lời câu hỏi “Bạn dành khoảng bao nhiêu giờ mỗi ngày sử dụng thiết bị số (điện thoại thông minh, máy tính bảng, máy tính,...) ngoài giờ học ở trường?”. Em hãy thực hiện: a) Tạo bảng dữ liệu và định dạng theo mẫu ở Hình 6.9 và lưu tệp với tên TGSDThietbiso.xlsx. b) Sắp xếp bảng dữ liệu theo thứ tự giá trị giảm dần của cột Không sử dụng. c) Sắp xếp bảng dữ liệu theo hai tiêu chí: giá trị giảm dần của cột Không sử dụng, nếu bằng nhau thì sắp xếp theo giá trị giảm dần của cột Dưới 1 giờ. d) Lọc danh sách các lớp không có học sinh sử dụng thiết bị số từ 5 giờ trở lên.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài học", "question_id": "VD1", "question_content": "Đọc nội dung phần Vận dụng: Ngoài các chức năng lọc mà em đã tìm hiểu trong phần thực hành, phần mềm bảng tính còn có chức năng lọc theo điều kiện. Khi nháy chuột vào nút lệnh lọc dữ liệu, em còn thấy tuỳ chọn Number Filters (hoặc Text Filters) nếu phần lớn các ô trong cột đó chứa dữ liệu số (hoặc kí tự). Em hãy mở tệp dữ liệu TGSDThietbiso.xlsx, tìm hiểu chức năng Number Filters để lọc danh sách các lớp có số học sinh sử dụng thiết bị số từ 3 đến 4 giờ lớn hơn hoặc bằng 10 học sinh.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "question_id": "HĐ1", "question_content": "1. Trong hai cách trình bày dữ liệu ở Hình 7.1 và Hình 7.2, cách nào hiệu quả hơn để so sánh trực quan số học sinh quan tâm các nội dung Tin học?\n2. Nếu cần so sánh tỉ lệ phần trăm số học sinh của mỗi nội dung Tin học trên tổng số học sinh được khảo sát, em sẽ dùng cách nào để thể hiện dữ liệu?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "question_id": "CH01", "question_content": "Em hãy nêu một số tình huống thực tế cần tạo biểu đồ.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "question_id": "LT1", "question_content": "Em hãy mở tệp TGSDThietbiso.xlsx đã lưu ở Bài 6. Dùng hàm SUM để tính tổng số học sinh sử dụng thiết bị số trong mỗi khoảng thời gian (kết quả tương tự như Hình 7.8) rồi thực hiện: a) Vẽ biểu đồ cột thể hiện số học sinh sử dụng thiết bị số của mỗi khoảng thời gian. Từ biểu đồ kết quả, em có nhận xét gì về tình hình sử dụng thiết bị của học sinh khối 8? b) Vẽ biểu đồ hình quạt tròn thể hiện tỉ lệ phần trăm của số học sinh sử dụng thiết bị số theo mỗi khoảng thời gian.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "question_id": "LT2", "question_content": "Cho biểu đồ về doanh thu công nghiệp phần mềm giai đoạn 2016 – 2020 như Hình 7.9. a) Từ biểu đồ, em có nhận xét gì về doanh thu công nghiệp phần mềm giai đoạn 2016 – 2020? b) Em hãy tạo bảng dữ liệu trong phần mềm bảng tính từ biểu đồ trên. c) Em hãy tạo biểu đồ cột từ bảng dữ liệu có được ở câu b.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 7", "question_id": "VD1", "question_content": "Từ bảng dữ liệu về doanh thu công nghiệp phần mềm giai đoạn 2016 – 2020 đã tạo ra trên phần mềm bảng tính ở Câu 2, phần Luyện tập, em hãy tạo biểu đồ đường thẳng, từ đó nhận xét xu hướng của dữ liệu.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "HĐ1", "question_content": "Em hãy quan sát Hình 8a.2, Hình 8a.3 và cho nhận xét về hai cách trình bày nội dung.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "question_content": "Với danh sách có thứ tự ở Hình 8a.4a, nếu em đặt con trỏ soạn thảo ở cuối dòng thứ hai rồi nhấn phím Enter để thêm một đoạn văn bản mới thì em sẽ thu được kết quả như ở Hình 8a.4b hay Hình 8a.4c?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH02", "question_content": "Theo em, tờ rơi ở Hình 8a.5 hay Hình 8a.6 có hiệu quả trực quan và thu hút người đọc hơn?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "CH01", "question_content": "Em hãy chọn phương án đúng: A. Văn bản trên trang chiếu cần ngắn gọn, súc tích. B. Văn bản trên trang chiếu càng chi tiết, đầy đủ càng tốt. C. Sử dụng càng nhiều màu sắc cho văn bản trên trang chiếu càng giúp người nghe tập trung. D. Sử dụng nhiều loại phông chữ cho văn bản trên trang chiếu sẽ thu hút được sự chú ý của người nghe.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "LT1", "question_content": "Em hãy sử dụng phần mềm soạn thảo văn bản để nhập dữ liệu cho dự án Thành lập CLB Tin học, tạo danh sách dạng liệt kê cho dữ liệu theo mẫu ở Hình 8a.3 và lưu lại tệp với tên CLBTinhoc.docx.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "VD1", "question_content": "Ngoài các mẫu danh sách liệt kê mà phần mềm soạn thảo cung cấp, người sử dụng có thể tự tạo các mẫu dấu đầu dòng, mẫu thứ tự theo ý thích của mình. Em hãy tìm hiểu cách làm và tạo ba mẫu dấu đầu dòng, mẫu thứ tự mới.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "VD2", "question_content": "Em hãy sử dụng phần mềm soạn thảo văn bản để tạo một tờ rơi quảng cáo cho CLB Tiếng Anh (hoặc CLB Rubik, CLB bóng rổ,... của trường). Trong tờ rơi có sử dụng hình ảnh minh hoạ và hình đồ hoạ, sử dụng mẫu dấu đầu dòng, mẫu thứ tự mà em đã tạo ở Câu 1.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9a", "question_id": "CH01", "question_content": "Em hãy chọn phương án sai trong các phương án sau:\nA. Đánh số trang giúp người đọc biết độ dài của văn bản (nhìn số trang cuối).\nB. Đánh số trang, cùng với mục lục, giúp người đọc dễ dàng tìm thấy các phần cụ thể của văn bản.\nC. Đánh số trang cho phép trích dẫn một trang cụ thể của văn bản.\nD. Phần mềm soạn thảo văn bản không có chức năng đánh số trang tự động.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "question_id": "LT1", "question_content": "Em hãy mở tệp CLBTinhoc.docx và thực hiện các yêu cầu sau đây: a) Bổ sung thêm tên người hoặc tên nhóm thực hiện dự án vào đầu trang. b) Đặt lại số trang vào vị trí bên trái của chân trang.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 9", "question_id": "VD1", "question_content": "Em hãy tìm hiểu cách thêm hình ảnh, hình đồ hoạ vào chân trang và đầu trang rồi bổ sung vào đầu trang và chân trang trong tệp CLBTinhoc.docx một đường thẳng theo mẫu như Hình 9a.7.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "CH02", "question_content": "Theo em, các trang chiếu có cần đánh số không? Có cần thêm các thông tin vào đầu trang và chân trang không? Vì sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "question_id": "LT1", "question_content": "Em hãy chọn phương án sai trong các phương án sau:\nA. Đầu trang và chân trang có thể được định dạng phông chữ, cỡ chữ, màu chữ khác nhau.\nB. Có thể bỏ phần đầu trang và chân trang khỏi trang chiếu tiêu đề.\nC. Có thể tự động cập nhật thời gian vào thông tin ở đầu trang và chân trang.\nD. Những thông tin lựa chọn và nhập vào cửa sổ Header & Footer được tự động áp dụng cho tất cả các trang chiếu trong bài trình chiếu.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "question_id": "VD1", "question_content": "Em hãy tạo bài trình chiếu giới thiệu một nội dung Tin học mà em chọn (ví dụ: giới thiệu một ngôn ngữ lập trình, giới thiệu về bảng tính điện tử,...) để trình chiếu trong buổi sinh hoạt CLB Tin học của trường. Hãy vận dụng kiến thức và kĩ năng đã biết để chọn màu sắc, định dạng văn bản, bày các trang chiếu hài hòa, hợp lí với nội dung; đánh số trang, thêm đầu trang, chân trang,...", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "question_id": "LT1", "question_content": "Phương án nào sau đây mô tả các bước sử dụng bản mẫu?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "question_id": "LT2", "question_content": "Em hãy thêm vào trang chiếu tiêu đề của tệp trình chiếu AnToanPhongThucHanh.pptx đường dẫn đến tệp văn bản lưu trữ các kí hiệu cảnh báo trong phòng thực hành để có thể mở ra giới thiệu cho người nghe trong khi trình chiếu.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11", "question_id": "VD1", "question_content": "Em hãy tìm một bản mẫu (có sẵn trong phần mềm trình chiếu hoặc được chia sẻ trên mạng) và sử dụng để tạo lại bài trình chiếu trong tệp LeRaMatCLBTinhoc.pptx. Thực hiện thay đổi các định dạng cần thiết để tạo một bản mẫu phù hợp với bài trình chiếu. Ghi lại tệp trình chiếu dưới dạng bản mẫu, tên tệp có dạng .potx để tái sử dụng và chia sẻ khi cần.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "question_id": "CH01", "question_content": "Chọn phát biểu đúng nhất về hoạt động gỡ lỗi.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "question_id": "LT1", "question_content": "Em hãy sử dụng phần mềm GIMP để mở các tệp ảnh trong thư mục HINHANH đã lưu ở Bài 9b. Sử dụng các công cụ hiệu ứng cho ảnh để điều chỉnh độ sáng, độ tương phản, làm mờ,... bổ sung văn bản vào ảnh (nếu cần) để có được những bức ảnh đẹp giới thiệu về ngôi trường của em.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10b", "question_id": "VD1", "question_content": "Em hãy sử dụng phần mềm chỉnh sửa ảnh để mở các tệp ảnh trong thư mục đã lưu ở phần Vận dụng, Bài 9b. Sử dụng các công cụ tạo hiệu ứng cho ảnh để điều chỉnh độ sáng, độ tương phản, làm mờ,... bổ sung văn bản vào ảnh (nếu cần) để có được những bức ảnh đẹp giới thiệu về chủ đề mà em yêu thích.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "question_id": "LT1", "question_content": "Em hãy sử dụng phần mềm GIMP và những tệp ảnh trong thư mục HINHANH mà em đã chỉnh sửa trong các phần Luyện tập ở các bài trước để tạo thành một tờ rơi giới thiệu về ngôi trường của em.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 11b", "question_id": "VD1", "question_content": "Từ các hình ảnh về chủ đề mà em yêu thích đã được chỉnh sửa, hãy sử dụng các phần mềm ứng dụng đã biết (phần mềm chỉnh sửa ảnh, phần mềm soạn thảo văn bản, phần mềm trình chiếu, phần mềm sơ đồ tư duy,...) để tạo một sản phẩm số đơn giản (ví dụ một cuốn sách ảnh, một bài trình chiếu,...).", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "question_id": "CH01", "question_content": "Bạn An muốn bổ sung lệnh đợi 1 giây để điều khiển nhân vật dừng lại 1 giây sau khi đi hết mỗi cạnh của tam giác. Em hãy bổ sung lệnh này vào sơ đồ khối mô tả thuật toán và nêu vị trí đặt câu lệnh trong chương trình Scratch tương ứng ở Hình 12.3.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "question_id": "LT1", "question_content": "Em hãy mô tả thuật toán bằng sơ đồ khối trong trường hợp đường đi của nhân vật là một hình vuông.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "question_id": "LT2", "question_content": "Em hãy nâng cấp chương trình VeHinh.sb3 bằng cách bổ sung một nhân vật mới và lập trình để khi nháy chuột vào nhân vật này thì chương trình thực hiện thuật toán vẽ hình vuông.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "question_id": "LT3_a", "question_content": "Bạn Khoa viết kịch bản mô tả hoạt động của xe ô tô chạy trên đường như sau: Khi xe cách hòn đá nhỏ hơn 120 bước, xe sẽ dừng lại (Hình 12.5). Em hãy hoàn thành sơ đồ khối theo kịch bản trên bằng cách ghép mỗi lệnh dưới đây với một ô phù hợp được đánh số 1 và 2 trong Hình 12.6:\n- 'Di chuyển 5 bước'\n- 'Cách hòn đá < 120 bước?'", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "question_id": "LT3_b", "question_content": "Em hãy viết chương trình Scratch thực hiện thuật toán xe dừng lại khi cách hòn đá nhỏ hơn 120 bước theo kịch bản của bạn Khoa.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 12", "question_id": "VD1", "question_content": "Trong bài học trên, đường đi của nhân vật là hình tam giác đều. Đường đi đó có thể là hình vuông, lục giác đều,... Khi đó các con số nào trong chương trình ở Hình 12.3 cần phải thay đổi?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "question_id": "CH01", "question_content": "Em hãy chỉ ra hằng, biến, biểu thức và kiểu dữ liệu tương ứng được sử dụng trong chương trình ở Hình 13.4.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "question_id": "LT01", "question_content": "Giả sử r là biến lưu giá trị của bán kính hình tròn. Em hãy cho biết giá trị trả lại của các biểu thức sau và kiểu dữ liệu của chúng trong ngôn ngữ lập trình Scratch với trường hợp r = 5: a) (r > 0), b) (2 * 3.14 * r), c) (kết hợp 'Chu vi đường tròn là' (2 * 3.14 * r)).", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "question_id": "LT02", "question_content": "Em hãy sử dụng ngôn ngữ lập trình trực quan để viết chương trình tính chu vi đường tròn, diện tích hình tròn với giá trị của bán kính được nhập vào từ bàn phím, thông báo kết quả ra màn hình.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 13", "question_id": "VD01", "question_content": "Em hãy viết chương trình Scratch của riêng mình để giải quyết một bài toán cụ thể trong một môn học như Khoa học tự nhiên, Toán học,... trong đó có sử dụng hằng, biến và biểu thức để thực hiện thuật toán.", "difficulty": "Vận dụng cao"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "question_id": "CH01", "question_content": "Cấu trúc lặp nào sau đây không được cho trước trong các nhóm lệnh của Scratch?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "question_id": "LT1", "question_content": "Em hãy ghép mỗi đoạn lệnh ở hàng trên với kết quả tương ứng mà đoạn lệnh đó vẽ ở hàng dưới trong Bảng 14.1.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "question_id": "VD1", "question_content": "Em hãy ghép các khối lệnh a, b, c, d vào các vị trí tương ứng 1, 2, 3, 4 ở Hình 14.8 để được thuật toán giải phương trình ax + b = 0 trong ngôn ngữ lập trình Scratch với các giá trị a, b nhập từ bàn phím.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 14", "question_id": "VD2", "question_content": "Ước chung lớn nhất của hai số không thay đổi nếu thay số lớn bằng phần dư trong phép chia của nó cho số bé. Dựa trên nhận xét đó, ước chung lớn nhất của hai số không âm có thể được tính theo thuật toán được biểu diễn bằng sơ đồ khối trong Hình 14.9. Em hãy ghép các khối lệnh Scratch trong Hình 14.10 thành chương trình tính ước chung lớn nhất của hai số nguyên không âm.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "question_id": "HĐ1", "question_content": "Trong trò chơi Đoán số ở Bài 14, ai đoán đúng số bí mật với ít lần đoán hơn sẽ là người thắng cuộc. Ở chương trình trong Hình 15.1, biến số lần đoán được bổ sung để đếm số lần người chơi đoán và thông báo giá trị này khi người chơi đoán đúng số bí mật. Trước khi chia sẻ trò chơi của mình, em quyết định kiểm tra xem trò chơi có hoạt động tốt không. Hãy cho biết kết quả của việc kiểm thử đó bằng cách mô tả tình huống chương trình chạy không đúng kịch bản (nếu có).", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "question_id": "HĐ2", "question_content": "Em hãy cho biết, chương trình đã cho trong Hình 15.1 không hoạt động được hay nó hoạt động nhưng đã thực hiện không đúng kịch bản?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 10", "question_id": "HĐ3", "question_content": "Xét tình huống máy tính hiển thị số lần đoán không đúng với số lần đoán thực tế của người chơi. Em hãy trả lời các câu hỏi: 1. Theo kịch bản, biến số lần đoán sẽ thay đổi trong tình huống nào? 2. Những khối lệnh nào làm thay đổi biến số lần đoán? 3. Có điều gì khác nhau giữa kịch bản và những khối lệnh tương ứng?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "question_id": "CH01", "question_content": "Em hãy gỡ lỗi đoạn chương trình xác định một số n được nhập từ bàn phím là số chẵn hay số lẻ được cho trong Hình 15.3.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "question_id": "CH02", "question_content": "Giả sử trong trò chơi Đoán số, không ai được đoán quá 7 lần. Em hãy gỡ lỗi chương trình trò chơi Đoán số trong Hình 15.4.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "question_id": "LT1", "question_content": "Em hãy chọn một cách khác với cách đã nêu trong phần b) Sửa lỗi của mục 2 để sửa lỗi của chương trình được cho trong Hình 15.1.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 15", "question_id": "VD1", "question_content": "Đổi vai trò máy tính và người chơi trong trò chơi Đoán số. Em chọn một số nguyên trong khoảng từ 1 đến 120 và viết số đó ra giấy. Máy tính sẽ hiển thị một số mà em phải trả lời bằng các phím 'đ', 'c' hoặc 't' tương ứng với tình huống số máy tính hiển thị đúng, cao hơn hay thấp hơn số em đã chọn. Hãy viết chương trình để sau một số bước, càng ít càng tốt, máy tính tìm ra số em đã chọn. Chạy thử, phát hiện và sửa các lỗi của chương trình đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "question_id": "CH01", "question_content": "Hãy ghép mỗi ứng dụng ở cột B với một nghề phù hợp nhất ở cột A để chứng minh cho việc ứng dụng của tin học có thể tăng hiệu quả công việc: 1) Bác sĩ, 2) Giáo viên, 3) Kiến trúc sư, 4) Kế toán, 5) Nhà báo.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "question_id": "CH02", "question_content": "Em hãy kể ra những ứng dụng tin học mà các thầy cô giáo đã sử dụng để giúp em nâng cao hiệu quả của việc học tập.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "question_id": "CH03", "question_content": "Nếu có bạn nào đó nói với em 'Nghề nghiệp trong lĩnh vực tin học chỉ nên dành cho nam giới', em sẽ trả lời bạn như thế nào? Tại sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 8", "lesson_id": "Bài 16", "question_id": "CH04", "question_content": "Em biết những ngành nghề nào thuộc lĩnh vực tin học đang có nhiều phụ nữ làm việc?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 1", "question_id": "CH01", "question_content": "Em hãy kể một số ví dụ cho thấy tác động của công nghệ thông tin lên giáo dục và xã hội.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "question_id": "CH01", "question_content": "Trong khi tìm thông tin về các trường THPT, bạn An đã không để ý đến thời gian đăng kí nguyện vọng dự thi và xét tuyển vào lớp 10 các trường THPT công lập. Theo em: a) Sơ suất này vi phạm tiêu chí nào về chất lượng thông tin? b) Điều đó có thể dẫn đến khó khăn gì cho bạn An?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài", "question_id": "CH01", "question_content": "KOL là thuật ngữ viết tắt của Key Opinion Leader có nghĩa là người dẫn dắt dư luận chủ chốt hay người có ảnh hưởng. Khi em thấy một KOL quảng cáo sản phẩm trên mạng, em sẽ ứng xử thế nào?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "question_id": "LT1", "question_content": "Để chuẩn bị cho chuyến tham quan một nông trại, An gọi đến số điện thoại liên lạc được cung cấp trên trang web của nông trại nhưng không được. Minh cho rằng có thể đầu số điện thoại đã thay đổi nhưng nông trại chưa kịp cập nhật lên trang web nên đã tìm kiếm thông tin trên website của các nhà cung cấp dịch vụ viễn thông. Nhờ đó, Minh đã liên hệ thành công với nông trại. Em hãy nhận xét về chất lượng của thông tin (theo 4 tính chất ở Hình 2.2) mà mỗi bạn thu nhận được.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 2", "question_id": "VD1", "question_content": "Em hãy tìm trên Internet thông tin về chiếc máy tính điện tử kĩ thuật số đầu tiên trên thế giới. Đánh giá chất lượng thông tin tìm được.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "question_id": "LT1", "question_content": "Em hãy nêu giải pháp đo điện áp giữa hai đầu một điện trở bằng cách sử dụng phần mềm mô phỏng.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (tiếp theo)", "question_id": "VD1", "question_content": "Trong phần mềm mô phỏng, em có thể lắp ráp mạch điện gồm: nguồn điện, công tắc, điện trở, ampe kế, vôn kế. Bằng cách thay đổi trị số của các linh kiện, hãy khám phá quy luật phụ thuộc lẫn nhau giữa điện trở, cường độ dòng điện qua nó và điện áp giữa hai đầu điện trở đó.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "question_id": "CH01", "question_content": "Phương án nào sau đây không phải là tác động tiêu cực của công nghệ kĩ thuật số đến đời sống con người?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 4", "question_id": "CH02", "question_content": "Những phương án nào sau đây là tác động tiêu cực của công nghệ kĩ thuật số đến xã hội?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "question_id": "CH01", "question_content": "Hành vi nào sau đây khi hoạt động trong môi trường số không vi phạm pháp luật, trái đạo đức, thiếu văn hóa?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "question_id": "CH02", "question_content": "Minh nhận được một liên kết lạ từ một bạn mới quen trên mạng yêu cầu chia sẻ liên kết này cho 5 bạn và truy cập liên kết để nhận được một phần quà là chiếc ba lô rất đẹp. Theo em, Minh có nên làm theo yêu cầu đó không? Tại sao?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "question_id": "LT01", "question_content": "Em hãy cho biết những cách nào sau đây giúp em tránh được các tác động tiêu cực khi sử dụng công nghệ kĩ thuật số?\nA. Không sử dụng thiết bị số trong thời gian dài và liên tục.\nB. Không xem các video phản cảm.\nC. Giảm thời gian dùng điện thoại để nói chuyện với gia đình.\nD. Tham gia luyện tập thể thể thao.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "question_id": "LT02", "question_content": "Em hãy lấy ví dụ về một hành vi vi phạm pháp luật, một hành vi trái đạo đức khi hoạt động trong môi trường số.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (trang 19)", "question_id": "VD01", "question_content": "Em hãy tìm hiểu các hành vi bị cấm trong Luật Công nghệ thông tin số 67/2006/QH11 và Nghị định số 72/2013/NĐ-CP. Hai văn bản này giống và khác nhau như thế nào?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "question_id": "CH01", "question_content": "Em hãy kể tên một phần mềm mô phỏng mà em biết. Phần mềm đó mô phỏng hoạt động của đối tượng nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học", "question_id": "CH02", "question_content": "Phần mềm mô phỏng pha màu có những lợi ích gì trong việc tìm hiểu và tập pha trộn màu theo cách thông thường?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "question_id": "CH01", "question_content": "Để mở một tệp dữ liệu có sẵn trong phần mềm Geometer's Sketchpad, em thực hiện thao tác nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 6", "question_id": "CH02", "question_content": "Trong phần mềm Geometer's Sketchpad, để thay đổi kích thước của hình sao sao cho độ dài đoạn thẳng thay đổi, em thực hiện thao tác nào?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Trang 28)", "question_id": "CH01", "question_content": "Em hãy chỉ ra những kiến thức về tạo sơ đồ tư duy và bài trình chiếu mà em cần được bổ sung để việc trao đổi, hợp tác được hiệu quả.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "question_id": "CH01", "question_content": "Khi tạo trang dàn ý cho bài trình chiếu về chủ đề 'Lược sử công cụ tính toán', nội dung nào sau đây thường được đặt ở vị trí trung tâm hoặc mục đầu tiên để định hướng toàn bài?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 8", "question_id": "VD01", "question_content": "Em hãy thực hành khởi động phần mềm trình chiếu, tạo trang tiêu đề và trang dàn ý theo Hình 8.5, sau đó thêm sơ đồ dòng thời gian về các thế hệ máy tính.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9a", "question_id": "CH01", "question_content": "Trang tính Thu nhập trong Hình 9a.6 lưu dữ liệu về các khoản thu của gia đình. Em hãy quan sát Hình 9a.6 và cho biết dữ liệu ở cột B cần được thiết lập để thoả mãn điều kiện xác thực nào.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "question_id": "CH01", "question_content": "Trong hàm COUNTIF(range, criteria), tham số 'range' có ý nghĩa gì?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10a", "question_id": "CH02", "question_content": "Để đếm số lượng các ô trong vùng từ A1 đến A5 có giá trị lớn hơn hoặc bằng 50, em sử dụng công thức nào sau đây?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "question_id": "LT1", "question_content": "Em hãy bổ sung thêm một số dòng dữ liệu thu, chi vào cả hai trang tính Thu nhập và Chi tiêu. Hãy điều chỉnh công thức COUNTIF ở cột G để kết quả tổng hợp số lần thu, chi của mỗi khoản được chính xác.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "question_id": "LT2", "question_content": "Em hãy thực hiện cuộc khảo sát về việc chọn trường THPT của các bạn trong lớp. Nhập thông tin mà em thu thập được vào bảng tính và sử dụng hàm COUNTIF để tổng hợp kết quả khảo sát như minh hoạ ở Hình 10a.6.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10", "question_id": "VD1", "question_content": "Em hãy mở bảng tính KinhPhiTrienLam.xlsx đã tạo ở phần Vận dụng, Bài 9a và sử dụng hàm COUNTIF để tính số lần thu của mỗi khoản thu, số lần chi của mỗi khoản chi của dự án Triển lãm tin học. Lưu tệp sau khi hoàn thành công việc.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "question_id": "CH01", "question_content": "Hình 11a.3 minh họa dữ liệu của trang tính Thu nhập. Em hãy cho biết công thức cần nhập vào ô H2 là gì? Giá trị của ô H2 có ý nghĩa gì?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "question_id": "LT1", "question_content": "Em hãy bổ sung thêm một số dòng dữ liệu thu, chi vào cuối phần dữ liệu của cả hai trang tính Thu nhập và Chi tiêu. Hãy điều chỉnh công thức SUMIF ở cột H để kết quả tổng tiền của mỗi khoản thu, chi được chính xác.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 11a", "question_id": "VD1", "question_content": "Em hãy mở bảng tính KinhPhiTrienLam.xlsx đã lưu ở phần Vận dụng, Bài 10a và sử dụng hàm SUMIF để tính tổng các khoản thu, chi của dự án Triển lãm tin học. Lưu tệp sau khi hoàn thành công việc.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12a", "question_id": "HĐ1", "question_content": "1. Em hãy nêu công thức ở các ô của cột M và cột N trong bảng dữ liệu Hình 12a.3.\n2. Em hãy viết quy tắc để đưa ra nhận xét tình trạng chi tiêu như minh hoạ ở cột O trong Hình 12a.3 dựa trên quy tắc quản lí tài chính 50-30-20.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12", "question_id": "VD1", "question_content": "Em hãy viết công thức trong các ô O4 và O5 ở Hình 12a.3 để nhận xét về tình trạng của mục Mong muốn cá nhân và Tiết kiệm dựa trên quy tắc 50-30-20.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13a", "question_id": "CH01", "question_content": "Trong dự án quản lí tài chính gia đình, trang tính Tổng hợp có vai trò gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "question_id": "CH01", "question_content": "Phần mềm làm video là gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9", "question_id": "CH01", "question_content": "Chọn phương án ghép sai:\nVideo Editor là phần mềm làm video\nA. có giao diện thân thiện, dễ sử dụng.\nB. hỗ trợ nhiều định tệp.\nC. được tích hợp sẵn trong tất cả các hệ điều hành.\nD. có đầy đủ những chức năng làm video cơ bản và nâng cao.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "question_id": "LT1", "question_content": "Em hãy nêu các chức năng chính của phần mềm làm video.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "question_id": "LT2", "question_content": "Em hãy thu thập các tệp video, hình ảnh, tài liệu về các sản phẩm em đã làm được trong quá trình thực hiện các dự án (ví dụ Sổ lưu niệm, Trường học xanh, Thành lập CLB Tin học) khi học môn Tin học. Lưu các tệp vào một thư mục trong máy tính và thực hiện: a) Khởi động phần mềm Video Editor, mở dự án làm video SanPhamTinHoc. b) Nhập các tệp dữ liệu em đã thu thập vào thư viện dữ liệu. c) Đưa dữ liệu vào bàn dựng. d) Dùng các nút điều khiển ở màn hình xem trước để xem video. e) Xoá bỏ lần lượt từng dữ liệu khỏi bàn dựng, quan sát xem dữ liệu trong thư viện có bị mất không. f) Xoá bỏ lần lượt từng dữ liệu khỏi thư viện.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 9b", "question_id": "VD1", "question_content": "Em hãy làm video để giới thiệu về một vấn đề mà em quan tâm, ví dụ một cuốn sách, một môn học, một địa danh ở địa phương,... Bắt đầu bằng việc thực hiện các công việc sau đây: a) Dùng máy quay phim, điện thoại thông minh,... quay video, chụp ảnh; tìm kiếm các thông tin liên quan đến vấn đề em muốn giới thiệu. Lưu các tệp dữ liệu em thu thập được vào một thư mục trong máy tính có tên là DuLieuMyVideo. b) Sử dụng phần mềm Video Editor tạo một dự án làm video mới có tên MyVideo.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "question_id": "CH01", "question_content": "Em hãy sắp xếp lại các bước tạo video sau đây theo đúng thứ tự: a) Nhập dữ liệu, dựng video. b) Chuẩn bị dữ liệu. c) Lên ý tưởng, xây dựng kịch bản. d) Xuất video. e) Biên tập video.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "question_id": "LT1", "question_content": "Em hãy tạo đoạn hoạt hình dài 3 giây từ những hình ảnh chụp tờ rơi, tài liệu của dự án Thành lập CLB Tin học.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "question_id": "LT2", "question_content": "Em hãy thêm hiệu ứng chuyển động vào ảnh đầu của đoạn hoạt hình đã tạo ở câu 1.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 10b", "question_id": "VD1", "question_content": "Em hãy thực hiện các nhiệm vụ tương tự trong phần Thực hành với dự án MyVideo (em đã tạo ở phần Vận dụng, Bài 9b) với các dữ liệu đã thu thập được lưu trong thư mục DuLieuMyVideo.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 12b", "question_id": "CH01", "question_content": "Em hãy chọn phương án sai.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13", "question_id": "CH01", "question_content": "Em hãy chọn những công việc cần làm trong bước biên tập video:\na) Thu thập dữ liệu.\nb) Kiểm tra nội dung video xem có đúng theo kịch bản không.\nc) Nhập dữ liệu.\nd) Kiểm tra phụ đề, âm thanh xem có khớp với hình ảnh không.\ne) Kiểm tra xem đã đủ dữ liệu chưa.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "question_id": "LT1", "question_content": "Em hãy xem lại toàn bộ video trong màn hình xem trước và thực hiện các công việc: a) Nếu thấy ảnh nào trong video còn thanh màu đen thì loại bỏ. b) Điều chỉnh lại thời gian hiển thị các dữ liệu nếu thấy cần thiết. c) Xuất lại video với tên SanPhamTinHoc-Version2.mp4. d) Xem lại hai video kết quả ở hai tệp SanPhamTinHoc.mp4 và SanPhamTinHoc-Version2.mp4, so sánh và chọn một bản phù hợp để trình chiếu trong buổi Triển lãm tin học.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 13b", "question_id": "VD1", "question_content": "Em hãy thực hiện các nhiệm vụ tương tự trong phần Thực hành với dự án MyVideo.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "question_id": "CH01", "question_content": "Em hãy trình bày các bước giải quyết vấn đề chọn trường sau khi tốt nghiệp THCS dưới dạng liệt kê các bước hoặc sơ đồ khối.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "question_id": "CH02", "question_content": "Trong Hoạt động 1, để tìm đường thoát khỏi mê cung không có bản đồ, robot đã dựa vào yếu tố nào để quyết định hướng đi?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "question_id": "LT1", "question_content": "Em hãy mô tả thuật toán bám tường bên trái để tìm đường thoát khỏi mê cung.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 14", "question_id": "VD1", "question_content": "Em hãy lập chương trình trong ngôn ngữ Scratch mô phỏng thuật toán bám tường.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "question_id": "LT1", "question_content": "Vẽ sơ đồ của thuật toán giải bài toán xác định một số có phải số nguyên tố hay không bằng cách chỉ sử dụng những cấu trúc điều khiển cơ bản.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "question_id": "CH01", "question_content": "Một bài toán tin học được xác định bởi những yếu tố nào?", "difficulty": "Nhận biết"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "question_id": "CH02", "question_content": "Tại sao giá trị khởi đầu của biến max lại được gán bằng 0 trong bài toán tìm số lớn nhất từ dãy số nguyên dương?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "question_id": "VD1", "question_content": "Hãy mô tả đầu vào, đầu ra của bài toán sắp xếp một dãy số theo thứ tự tăng dần.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 15", "question_id": "VD2", "question_content": "Vẽ sơ đồ khối của giải thuật sắp xếp nổi bọt để sắp xếp một dãy số theo thứ tự tăng dần.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "question_id": "CH01", "question_content": "Ba người bạn An, Minh, Khoa trong phần khởi động có thể làm những nghề nghiệp gì trong lĩnh vực tin học?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài 17", "question_id": "CH02", "question_content": "Đặc thù công việc và sản phẩm chính của những nghề nghiệp đó là gì?", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "question_id": "CH01", "question_content": "Em hãy chọn phát biểu đúng.", "difficulty": "Thông hiểu"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "question_id": "LT01", "question_content": "Hãy kể tên hai công việc liên quan đến nghề nghiệp tin học trong lĩnh vực khác như y tế, giáo dục, nông nghiệp, xây dựng, giao thông,...", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "question_id": "LT02", "question_content": "Em hãy nêu ví dụ về một nghề tin học mà theo em, lao động nữ có ưu thế. Giải thích cho câu trả lời của mình.", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "question_id": "VD01", "question_content": "Hãy kể về một nghề tin học mà em quan tâm. Nghề nghiệp đó theo định hướng Khoa học máy tính hay Tin học ứng dụng?", "difficulty": "Vận dụng"}, {"grade_level": "Lớp 9", "lesson_id": "Bài học (Tiếp theo)", "question_id": "VD02", "question_content": "Em cần bổ sung những kiến thức hay kĩ năng nào để có thể trở thành người lao động trong nghề nghiệp mà em quan tâm ở câu 1?", "difficulty": "Vận dụng"}] AS row
MATCH (l:Lesson {id: toString(row.grade_level) + '_' + toString(row.lesson_id)})
MERGE (q:Question {id: toString(row.grade_level) + '_' + toString(row.lesson_id) + '_' + toString(row.question_id)})
ON CREATE SET q.question_id = toString(row.question_id),
              q.content = toString(row.question_content),
              q.difficulty = toString(row.difficulty)
MERGE (l)-[:EVALUATED_BY]->(q);

