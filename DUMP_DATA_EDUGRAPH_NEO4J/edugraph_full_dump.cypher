n", "is_correct": true}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "HĐ1", "option_key": "", "content": "Tự luận", "is_correct": true}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "option_key": "A", "content": "Phần mềm soạn thảo văn bản cung cấp hai kiểu danh sách dạng liệt kê.", "is_correct": false}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "option_key": "B", "content": "Danh sách dạng liệt kê không tự động cập nhật khi thêm hoặc bớt đoạn văn.", "is_correct": true}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "option_key": "C", "content": "Chỉ có thể sử dụng một kiểu danh sách dạng liệt kê cho một văn bản.", "is_correct": true}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "option_key": "D", "content": "Có thể sử dụng kết hợp danh sách dấu đầu dòng và danh sách có thứ tự.", "is_correct": false}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "option_key": "A", "content": "Hình 8a.4b", "is_correct": true}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH01", "option_key": "B", "content": "Hình 8a.4c", "is_correct": false}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH02", "option_key": "A", "content": "Hình 8a.5", "is_correct": false}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8a", "question_id": "CH02", "option_key": "B", "content": "Hình 8a.6", "is_correct": true}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "CH01", "option_key": "A", "content": "Có thể chèn hình ảnh vào văn bản để minh hoạ cho nội dung.", "is_correct": false}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "CH01", "option_key": "B", "content": "Có thể vẽ hình đồ hoạ trong phần mềm soạn thảo văn bản.", "is_correct": false}, {"grade_level": "Lớp 8", "lesson_id": "Bài 8", "question_id": "CH01", "option_key": "C", "content": "Có thể chèn thêm, xoá bỏ, thay đổi kích thước của h